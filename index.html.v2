<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
<meta charset="utf-8">

<meta name="viewport" content="width=device-width,initial-scale=1">
<title>بلوک — اکوسیستم صنعت ساختمان</title>
<link rel="preconnect" href="https://fonts.googleapis.com/">
<link rel="preconnect" href="https://fonts.gstatic.com/" crossorigin="">
<link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
<style>
*{box-sizing:border-box}
html,body{margin:0;min-height:100%;background:#dfe6e3;font-family:"Vazirmatn",Tahoma,Arial,sans-serif}
body{display:flex;align-items:center;justify-content:center;padding:26px 10px}

:root{
  --bg:#0B1412;--surface:#111E1B;--surface2:#0E1917;--surface3:#132420;
  --ink:#EAF3F1;--muted:#9BB0AC;
  --accent:#0F9C88;--accent-soft:#132924;--on-accent:#FFFFFF;
  --accent2:#F97316;--accent2-soft:#2B1B0E;--on-warm:#2A1607;
  --tone-mint:#0F9C88;--tone-mint-soft:#132924;
  --tone-blue:#5EA8FF;--tone-blue-soft:rgba(94,168,255,.16);
  --tone-violet:#A98CFF;--tone-violet-soft:rgba(169,140,255,.16);
  --danger:#FF6B6B;--danger-soft:rgba(255,107,107,.13);
  --line:#1E2E2B;--line-strong:#2B3E3A;
  --bezel:#000;--shadow:0 24px 60px rgba(0,0,0,.5);
}
[data-mode="light"]{
  --bg:#F5F8F7;--surface:#FFFFFF;--surface2:#F1F5F3;--surface3:#EAF0EE;
  --ink:#0F172A;--muted:#5C6B68;
  --accent:#0F766E;--accent-soft:#E4F3F1;--on-accent:#FFFFFF;
  --accent2:#F97316;--accent2-soft:#FFEDE0;--on-warm:#2A1607;
  --tone-mint:#0F766E;--tone-mint-soft:#E4F3F1;
  --tone-blue:#255E97;--tone-blue-soft:#E9F0F7;
  --tone-violet:#6845A5;--tone-violet-soft:#EFEAF7;
  --danger:#C0392B;--danger-soft:#FBEAE8;
  --line:#E3EAE8;--line-strong:#CBD8D4;
  --bezel:#122622;--shadow:0 24px 60px rgba(18,38,34,.2);
}
.phone[data-contrast="high"]{--muted:#B7C7C1;--line:rgba(255,255,255,.22);--line-strong:rgba(255,255,255,.38)}
.phone[data-mode="light"][data-contrast="high"]{--muted:#344D45;--line:#A7BBB4;--line-strong:#78968B}
.phone[data-reduce-motion="true"] *{animation:none!important;transition:none!important;scroll-behavior:auto!important}

.phone{width:380px;height:800px;max-height:94vh;border-radius:42px;overflow:hidden;position:relative;background:var(--bg);box-shadow:0 0 0 8px var(--bezel),var(--shadow);transition:background .25s}
.statusbar{height:30px;display:flex;align-items:center;justify-content:space-between;padding:0 20px;font-size:.62rem;font-weight:700;color:var(--muted)}
.modebtn{border:1px solid var(--line);background:var(--surface);color:var(--ink);width:24px;height:24px;border-radius:8px;display:flex;align-items:center;justify-content:center;cursor:pointer}
.modebtn svg{width:13px;height:13px}
#view{position:absolute;inset:30px 0 0;display:flex;flex-direction:column;overflow:hidden}

.icon{stroke:currentColor;fill:none;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round;display:block;flex:none}
.hexlogo{width:52px;height:52px;position:relative;flex:none}
.hexlogo-pulse{animation:hexPulse 1.4s ease-in-out infinite}
@keyframes hexPulse{0%,100%{transform:scale(1);opacity:1}50%{transform:scale(.88);opacity:.7}}
.trust-card-brand{display:flex;align-items:center;justify-content:center;gap:6px;margin-top:14px;padding-top:12px;border-top:1px dashed var(--line-strong)}
.trust-card-brand span{font-size:.46rem;color:var(--muted);font-weight:700}
.trust-card-brand strong{color:var(--accent);font-weight:900}
.hexlogo-mini{width:14px;height:14px;position:relative;flex:none;display:block}
.hexlogo-mini b{position:absolute;inset:0;background:var(--accent);clip-path:polygon(50% 0,95% 25%,95% 75%,50% 100%,5% 75%,5% 25%)}
.hexlogo i{position:absolute;inset:0;background:var(--surface);border:1px solid var(--accent);clip-path:polygon(50% 0,95% 25%,95% 75%,50% 100%,5% 75%,5% 25%)}
.hexlogo i:after{content:"";position:absolute;inset:8px;background:var(--accent);clip-path:polygon(50% 0,95% 25%,95% 75%,50% 100%,5% 75%,5% 25%)}

.page{flex:1;overflow:auto;padding:18px 20px 110px;animation:pageIn .32s cubic-bezier(.22,1,.36,1)}
@keyframes pageIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}
button,.chip,.quick-filter,.list-row,.choice,.home-shortcut{transition:transform .12s ease}
button:active,.chip:active,.quick-filter:active,.list-row:active,.choice:active,.home-shortcut:active{transform:scale(.96)}
.page::-webkit-scrollbar{display:none}
.page.no-nav{padding-bottom:24px}

.topbar{display:flex;align-items:center;gap:10px;padding:6px 20px 4px;flex:none}
.topbar-action-btn{margin-right:auto;width:36px;height:36px;border-radius:11px;border:1px solid var(--line-strong);background:var(--surface);color:var(--muted);display:flex;align-items:center;justify-content:center;cursor:pointer;transition:transform .15s}
.topbar-action-btn svg{fill:none;stroke:currentColor;stroke-width:2}
.topbar-action-btn.active{border-color:var(--danger);background:var(--danger-soft);color:var(--danger)}
.topbar-action-btn.active svg{fill:var(--danger)}
.topbar-action-btn:active{transform:scale(.88)}
.backbtn{width:34px;height:34px;border-radius:11px;border:1px solid var(--line);background:var(--surface);color:var(--ink);display:flex;align-items:center;justify-content:center;cursor:pointer;flex:none}
.backbtn:focus-visible,.nav-btn:focus-visible,.choice:focus-visible,.quick-btn:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
.backbtn svg{width:16px;height:16px}
.topbar-title{flex:1;min-width:0}
.topbar-title b{display:block;font-size:.86rem;color:var(--ink)}
.topbar-title span{display:block;font-size:.58rem;color:var(--muted);margin-top:1px}

h1,h2,h3{color:var(--ink);margin:0;font-weight:800}
p{color:var(--muted);margin:0}

.btn-primary{width:100%;height:50px;border:0;border-radius:15px;background:var(--accent);color:var(--on-accent);font-size:.78rem;font-weight:800;cursor:pointer}
.btn-primary:active{transform:scale(.99)}
.btn-primary[disabled]{opacity:.45;pointer-events:none}
.btn-secondary{width:100%;height:46px;border-radius:14px;border:1px solid var(--line-strong);background:transparent;color:var(--ink);font-size:.74rem;font-weight:700;cursor:pointer}
.btn-ghost{border:0;background:transparent;color:var(--accent);font-size:.66rem;font-weight:800;cursor:pointer;padding:6px 0}

.card{background:var(--surface);border:1px solid var(--line);border-radius:16px;padding:14px}
.eyebrow{font-size:.56rem;font-weight:800;color:var(--accent);letter-spacing:.02em}

.trust-row{display:flex;gap:6px;justify-content:center;flex-wrap:wrap}
.trust-row span{background:var(--surface);border:1px solid var(--line);color:var(--accent);font-size:.55rem;font-weight:800;padding:6px 9px;border-radius:8px}

.field{margin-bottom:14px}
.field-group-label{font-size:.5rem;font-weight:800;color:var(--muted);margin:20px 2px 10px;padding-top:14px;border-top:1px solid var(--line)}
.field-group-label:first-child{margin-top:0;padding-top:0;border-top:none}
.field label{display:block;font-size:.6rem;font-weight:800;color:var(--ink);margin:0 2px 7px}
.field.field-warning{outline:1px solid color-mix(in srgb,var(--accent2) 42%,transparent);outline-offset:2px;border-radius:11px;animation:warning-breathe 2.8s ease-in-out infinite}
.field.field-warning .input,.field.field-warning .textarea{border-color:var(--line)}
@keyframes warning-breathe{
  0%,100%{outline-color:color-mix(in srgb,var(--accent2) 30%,transparent);box-shadow:0 0 0 1px transparent}
  50%{outline-color:color-mix(in srgb,var(--accent2) 72%,transparent);box-shadow:0 0 0 2px var(--accent2-soft)}
}
.field.field-disabled{opacity:.55}
.warning-card{margin-bottom:14px;border:1px solid var(--accent2);background:var(--accent2-soft);border-radius:15px;padding:12px}
.warning-card b{display:block;font-size:.62rem;color:var(--accent2)}
.warning-card p{font-size:.54rem;line-height:1.75;margin-top:4px;color:var(--ink)}
.input,.textarea{width:100%;border:1px solid var(--line);border-radius:13px;background:var(--surface2);color:var(--ink);outline:0;font-size:.68rem;padding:0 12px;font-family:inherit}
.input{height:46px}
.textarea{height:80px;padding-top:10px;resize:none}
.input:focus,.textarea:focus{border-color:var(--accent)}
.input::placeholder,.textarea::placeholder{color:var(--muted)}

.choice-grid{display:grid;grid-template-columns:1fr 1fr;gap:9px}
.choice{border:1px solid var(--line);background:var(--surface);border-radius:16px;padding:12px;cursor:pointer;text-align:right;position:relative}
.choice .cicon{width:36px;height:36px;border-radius:11px;background:var(--surface2);color:var(--accent);display:flex;align-items:center;justify-content:center;margin-bottom:8px}
.choice b{display:block;font-size:.68rem;color:var(--ink)}
.choice p{font-size:.53rem;line-height:1.6;margin-top:2px}
.choice.active{border-color:var(--accent);background:var(--accent-soft)}
.choice.active .cicon{background:var(--accent);color:var(--on-accent)}
.choice-business{border-color:var(--tone-violet-soft)}
.choice-business .cicon{background:var(--tone-violet-soft);color:var(--tone-violet)}
.choice-business.active{border-color:var(--tone-violet);background:var(--tone-violet-soft)}
.choice-business.active .cicon{background:var(--tone-violet);color:var(--on-accent)}
.product-row .price-view{font-size:.56rem;font-weight:800;color:var(--accent);white-space:nowrap;padding:5px 9px;border-radius:9px;border:1px dashed var(--accent)}
.price-edit-input{width:90px;font-family:inherit;font-size:.56rem;font-weight:800;color:var(--ink);border:1px solid var(--accent);border-radius:9px;padding:5px 8px;background:var(--surface)}
.machine-card{border:1px solid var(--line);border-radius:16px;padding:12px;margin-bottom:9px;background:var(--surface)}
.machine-card .list-row{border:none;padding:0;margin-bottom:8px}
.machine-cal-label{font-size:.5rem;color:var(--muted);margin-bottom:6px;font-weight:700}
.machine-cal-strip{gap:5px;margin:0}
.machine-cal-strip .cal-pill{padding:6px 2px}
.machine-cal-strip .cal-pill span{font-size:.44rem}
.machine-cal-strip .cal-pill b{font-size:.48rem;margin-top:2px}
.role-section-label{margin:18px 2px 9px;padding-top:14px;border-top:1px solid var(--line)}
.role-section-label span{display:block;font-size:.56rem;font-weight:800;color:var(--tone-violet)}
.role-section-label p{font-size:.56rem;color:var(--muted);margin-top:3px}
.choice-check{position:absolute;left:10px;top:10px;width:16px;height:16px;border:1.5px solid var(--line-strong);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:.48rem;color:var(--on-accent)}
.choice.active .choice-check{background:var(--accent);border-color:var(--accent)}

.chip-row{display:flex;flex-wrap:wrap;gap:7px}
.chip-row .chip{flex:1 1 auto;text-align:center}
.chip{border:1px solid var(--line-strong);background:var(--surface);color:var(--muted);font-size:.6rem;font-weight:700;padding:8px 13px;border-radius:999px;cursor:pointer}
.chip.active{background:var(--accent);border-color:var(--accent);color:var(--on-accent)}
.chip-compact{padding:6px 10px;font-size:.56rem}

.progress{display:flex;gap:5px;margin-bottom:16px}
.progress i{flex:1;height:4px;border-radius:99px;background:var(--line)}
.progress i.done{background:var(--accent)}

.search{height:46px;border:1px solid var(--line);border-radius:14px;background:var(--surface);display:flex;align-items:center;gap:9px;padding:0 13px;margin-bottom:12px}
.search svg{width:17px;height:17px;color:var(--muted)}
.search input{flex:1;border:0;outline:0;background:transparent;color:var(--ink);font-size:.68rem;font-family:inherit}

.stats-row{display:grid;grid-template-columns:repeat(3,1fr);gap:9px}
.stat-card{background:var(--surface);border:1px solid var(--line);border-radius:15px;padding:12px 8px;text-align:center}
.stat-card strong{display:block;font-size:1rem;color:var(--accent);font-variant-numeric:tabular-nums}
.stat-card span{display:block;font-size:.5rem;color:var(--muted);margin-top:3px}

.sec-head{display:flex;align-items:center;justify-content:space-between;margin:20px 0 10px}
.sec-head b{font-size:.74rem;color:var(--ink)}

.list-row{display:flex;align-items:center;gap:11px;background:var(--surface);border:1px solid var(--line);border-radius:15px;padding:12px;margin-bottom:8px;cursor:pointer}
.list-row .ricon{width:38px;height:38px;border-radius:12px;background:var(--surface2);color:var(--accent);display:flex;align-items:center;justify-content:center;flex:none}
.list-row .rcopy{flex:1;min-width:0}
.list-row .rcopy b{display:block;font-size:.67rem;color:var(--ink);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.list-row .rcopy span{display:block;font-size:.55rem;color:var(--muted);margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.list-row .rarrow{color:var(--muted);font-size:.9rem;flex:none}
.badge{font-size:.5rem;font-weight:800;padding:4px 8px;border-radius:8px;background:var(--accent2-soft);color:var(--accent2);flex:none}
.badge-complete{background:var(--accent-soft);color:var(--accent)}
.badge-incomplete{background:var(--accent2-soft);color:var(--accent2)}
.skill-rate-card{background:var(--surface);border:1px solid var(--line);border-radius:15px;padding:12px;margin-bottom:8px}
.skill-rate-card>div{display:flex;align-items:flex-start;justify-content:space-between;gap:10px}
.skill-rate-card b{font-size:.66rem;color:var(--ink)}
.skill-rate-card strong{font-size:.62rem;color:var(--accent);white-space:nowrap}
.skill-rate-card p{font-size:.53rem;line-height:1.7;margin-top:5px}

.switch{width:42px;height:25px;border-radius:99px;background:var(--surface2);border:1px solid var(--line-strong);padding:2px;cursor:pointer;flex:none;transition:.2s}
.switch i{display:block;width:19px;height:19px;border-radius:50%;background:var(--muted);transition:.2s}
.switch.on{background:var(--accent);border-color:var(--accent)}
.switch.on i{background:var(--on-accent);transform:translateX(-17px)}

.bottom-nav{position:absolute;right:12px;left:12px;bottom:12px;min-height:72px;padding:7px 6px;border-radius:21px;background:var(--surface);border:1px solid var(--line-strong);box-shadow:0 10px 28px rgba(0,0,0,.18);display:grid;grid-template-columns:repeat(5,1fr);align-items:center;justify-items:stretch;z-index:12}
.nav-btn{min-width:0;min-height:54px;padding:5px 2px;border:1px solid transparent;border-radius:14px;background:transparent;color:var(--muted);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;font-family:inherit;font-size:.53rem;line-height:1;font-weight:900;cursor:pointer}
.nav-btn svg{width:21px;height:21px;stroke-width:2}
.nav-btn span:last-child{white-space:nowrap}
.nav-btn.active{color:var(--accent);background:var(--accent-soft);border-color:color-mix(in srgb,var(--accent) 26%,transparent)}
.nav-btn.active span:last-child{color:var(--ink)}

.avatar{width:44px;height:44px;border-radius:14px;background:var(--surface2);border:1px solid var(--accent);color:var(--accent);display:flex;align-items:center;justify-content:center;font-size:.72rem;font-weight:800;flex:none;position:relative}
.avatar img{width:100%;height:100%;display:block;object-fit:cover;border-radius:inherit}

.sheet-backdrop{position:absolute;inset:0;background:rgba(0,0,0,.5);z-index:20;opacity:0;pointer-events:none;transition:.2s}
.sheet-backdrop.show{opacity:1;pointer-events:auto}
.sheet{position:absolute;right:0;left:0;bottom:0;max-height:82%;background:var(--surface);border-radius:22px 22px 0 0;padding:20px 20px 26px;z-index:21;transform:translateY(110vh);transition:.28s cubic-bezier(.2,.8,.2,1);border-top:1px solid var(--line);display:flex;flex-direction:column}
.sheet.show{transform:translateY(0)}
.sheet h3{font-size:.86rem;margin-bottom:4px}
.sheet p{font-size:.62rem;margin-bottom:14px}
.otp-row{display:flex;gap:8px;direction:ltr;margin-bottom:16px}
.otp-row input{width:100%;height:52px;text-align:center;font-size:1rem;border:1px solid var(--line);border-radius:13px;background:var(--surface2);color:var(--ink);outline:0}
.otp-row input:focus{border-color:var(--accent)}

.state{text-align:center;padding:40px 16px 10px}
.state-symbol{width:80px;height:80px;margin:0 auto 18px;border-radius:26px;background:var(--accent-soft);color:var(--accent);display:flex;align-items:center;justify-content:center}
.state-symbol svg{width:34px;height:34px}
.state h2{font-size:1rem;margin-bottom:6px}
.state p{font-size:.63rem;line-height:1.8;max-width:270px;margin:0 auto}

.chat-thread{display:flex;flex-direction:column;gap:9px;padding-top:2px}
.bubble{max-width:75%;padding:10px 12px;border-radius:16px 16px 4px 16px;background:var(--accent);color:var(--on-accent);font-size:.63rem;line-height:1.7;margin-right:auto}
.bubble.other{margin-right:0;margin-left:auto;background:var(--surface);border:1px solid var(--line);color:var(--ink);border-radius:16px 16px 16px 4px}
.bubble small{display:block;opacity:.7;font-size:.48rem;margin-top:4px;direction:ltr}
.message-head{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:12px}.message-head h2{font-size:1rem}.head-actions{display:flex;gap:7px}.icon-btn{width:36px;height:36px;border-radius:11px;border:1px solid var(--line);background:var(--surface);color:var(--muted);display:flex;align-items:center;justify-content:center;cursor:pointer;position:relative}.icon-btn:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
.inbox-search{height:44px;border:1px solid var(--line);background:var(--surface);border-radius:14px;display:flex;align-items:center;gap:8px;padding:0 12px;margin-bottom:10px}.inbox-search svg{color:var(--muted)}.inbox-search input{border:0;outline:0;background:transparent;color:var(--ink);font-family:inherit;font-size:.62rem;min-width:0;flex:1}.message-tabs{display:flex;gap:7px;overflow:auto;margin:0 -2px 12px;padding:2px}.message-tabs::-webkit-scrollbar{display:none}.message-tab{border:1px solid var(--line);background:var(--surface);color:var(--muted);font-family:inherit;font-size:.53rem;font-weight:800;padding:8px 12px;border-radius:999px;white-space:nowrap;cursor:pointer}.message-tab.active{background:var(--accent);border-color:var(--accent);color:var(--on-accent)}
.conversation-card{border:1px solid var(--line);background:var(--surface);border-radius:17px;padding:12px;display:flex;align-items:flex-start;gap:10px;margin-bottom:8px;cursor:pointer;position:relative}.conversation-card.unread{border-color:rgba(52,210,166,.38);background:linear-gradient(135deg,var(--surface),var(--accent-soft))}.conversation-avatar{width:45px;height:45px;border-radius:14px;background:var(--surface2);border:1px solid var(--line-strong);display:flex;align-items:center;justify-content:center;color:var(--accent);font-size:.68rem;font-weight:900;flex:none;position:relative}.online-dot{position:absolute;width:10px;height:10px;border-radius:50%;background:var(--accent);border:2px solid var(--surface);right:-2px;bottom:-2px}.conversation-copy{flex:1;min-width:0}.conversation-title{display:flex;align-items:center;gap:5px}.conversation-title b{font-size:.64rem;color:var(--ink);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.verified-mini{width:15px;height:15px;border-radius:50%;background:var(--accent-soft);color:var(--accent);display:flex;align-items:center;justify-content:center;flex:none}.conversation-copy>p{font-size:.53rem;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-top:3px}.conversation-context{display:inline-flex;align-items:center;gap:4px;margin-top:7px;border-radius:8px;padding:4px 7px;background:var(--surface2);color:var(--muted);font-size:.45rem;max-width:100%}.conversation-context span{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.conversation-meta{display:flex;flex-direction:column;align-items:flex-end;gap:7px;flex:none}.conversation-meta time{font-size:.43rem;color:var(--muted)}.unread-count{min-width:19px;height:19px;border-radius:99px;background:var(--accent);color:var(--on-accent);display:flex;align-items:center;justify-content:center;font-size:.46rem;font-weight:900;padding:0 5px}.pin-mark{color:var(--accent);font-size:.52rem}.inbox-summary{display:flex;align-items:center;justify-content:space-between;border:1px solid var(--line);background:var(--surface2);border-radius:13px;padding:9px 11px;margin-bottom:10px}.inbox-summary span{font-size:.5rem;color:var(--muted)}.inbox-summary button{border:0;background:transparent;color:var(--accent);font-family:inherit;font-size:.5rem;font-weight:800;cursor:pointer}
.chat-context-card{border:1px solid var(--line);background:var(--surface);border-radius:14px;padding:10px 11px;margin-bottom:12px;display:flex;align-items:center;gap:9px;cursor:pointer}.chat-context-card>i{width:34px;height:34px;border-radius:10px;background:var(--accent-soft);color:var(--accent);display:flex;align-items:center;justify-content:center;flex:none}.chat-context-card div{flex:1;min-width:0}.chat-context-card b{display:block;font-size:.55rem;color:var(--ink);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.chat-context-card p{font-size:.46rem;margin-top:2px}.chat-context-card>span{font-size:.8rem;color:var(--muted)}.chat-safety{display:flex;align-items:flex-start;gap:7px;border-radius:12px;background:var(--accent2-soft);color:var(--ink);padding:9px 10px;margin-bottom:12px;font-size:.45rem;line-height:1.65}.chat-safety svg{color:var(--accent2);flex:none;margin-top:1px}.chat-day{display:flex;align-items:center;gap:8px;color:var(--muted);font-size:.43rem;margin:5px 0}.chat-day:before,.chat-day:after{content:"";height:1px;background:var(--line);flex:1}.system-message{align-self:center;max-width:86%;text-align:center;background:var(--surface2);border-radius:10px;padding:7px 10px;color:var(--muted);font-size:.44rem;line-height:1.65}.bubble-meta{display:flex;align-items:center;gap:4px;justify-content:flex-end;opacity:.72;font-size:.43rem;margin-top:4px;direction:ltr}.message-file{display:flex;align-items:center;gap:8px;min-width:170px}.message-file i{width:32px;height:32px;border-radius:9px;background:rgba(255,255,255,.15);display:flex;align-items:center;justify-content:center}.message-file b{font-size:.5rem;direction:rtl}.message-file span{display:block;font-size:.42rem;opacity:.75;direction:rtl}.composer{height:auto;min-height:54px}.composer-action{width:32px;border:0;background:transparent;color:var(--muted);display:flex;align-items:center;justify-content:center;cursor:pointer;flex:none}.chat-menu-btn{position:absolute;left:20px;top:4px;z-index:3}
.empty-inbox{text-align:center;border:1px dashed var(--line-strong);border-radius:17px;padding:30px 18px}.empty-inbox i{width:54px;height:54px;border-radius:17px;background:var(--accent-soft);color:var(--accent);display:flex;align-items:center;justify-content:center;margin:0 auto 10px}.empty-inbox b{display:block;font-size:.68rem;color:var(--ink)}.empty-inbox p{font-size:.52rem;line-height:1.7;margin-top:4px}
.notification-summary{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:11px}.notification-summary>div{border:1px solid var(--line);background:var(--surface);border-radius:14px;padding:11px}.notification-summary strong{display:block;color:var(--accent);font-size:.9rem}.notification-summary span{display:block;color:var(--muted);font-size:.45rem;margin-top:2px}.notification-day{font-size:.5rem;color:var(--muted);font-weight:800;margin:15px 2px 7px}.notif-row{position:relative}.notif-row .notif-action{display:inline-block;color:var(--accent);font-size:.46rem;font-weight:800;font-style:normal;margin-top:5px}.notif-row.unread{background:linear-gradient(135deg,var(--surface),var(--accent-soft))}.notification-pref{display:flex;align-items:center;justify-content:space-between;gap:12px;border:1px solid var(--line);background:var(--surface);border-radius:15px;padding:12px;margin-bottom:8px}.notification-pref b{display:block;font-size:.61rem;color:var(--ink)}.notification-pref p{font-size:.49rem;line-height:1.65;margin-top:2px}.setting-section-title{font-size:.54rem;color:var(--muted);margin:17px 2px 8px;font-weight:800}
.profile-hero{background:linear-gradient(145deg,var(--surface),var(--surface2));border:1px solid var(--line);border-radius:22px;padding:16px;margin-bottom:12px}.profile-identity{display:flex;align-items:center;gap:12px}.profile-identity .avatar{width:58px;height:58px;border-radius:18px;font-size:.85rem}.profile-copy{flex:1;min-width:0}.profile-copy h2{font-size:.82rem}.profile-copy p{font-size:.52rem;margin-top:3px}.profile-status-row{display:flex;gap:6px;flex-wrap:wrap;margin-top:8px}.status-pill{display:inline-flex;align-items:center;gap:4px;border-radius:8px;background:var(--accent-soft);color:var(--accent);padding:4px 7px;font-size:.43rem;font-weight:800}.status-pill.warning{background:var(--accent2-soft);color:var(--accent2)}.profile-progress{margin-top:14px;border-top:1px solid var(--line);padding-top:12px}.profile-progress-head{display:flex;justify-content:space-between;align-items:center;font-size:.5rem}.profile-progress-head b{color:var(--ink)}.profile-progress-head span{color:var(--accent);font-weight:900}.profile-progress-track{height:6px;background:var(--line);border-radius:99px;overflow:hidden;margin-top:7px}.profile-progress-track i{display:block;height:100%;background:var(--accent);border-radius:99px}.profile-actions{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:16px}.profile-action{border:1px solid var(--line);background:var(--surface);border-radius:14px;padding:11px;text-align:right;font-family:inherit;cursor:pointer}.profile-action i{width:30px;height:30px;border-radius:9px;background:var(--accent-soft);color:var(--accent);display:flex;align-items:center;justify-content:center;margin-bottom:7px}.profile-action b{display:block;font-size:.54rem;color:var(--ink)}.profile-action span{display:block;font-size:.43rem;color:var(--muted);margin-top:2px}
.settings-group{background:var(--surface);border:1px solid var(--line);border-radius:18px;overflow:hidden;margin-bottom:12px}.settings-group-title{font-size:.49rem;color:var(--muted);font-weight:900;margin:16px 3px 7px}.settings-row{width:100%;border:0;border-bottom:1px solid var(--line);background:transparent;padding:11px 12px;display:flex;align-items:center;gap:10px;text-align:right;font-family:inherit;cursor:pointer;color:var(--ink)}.settings-row:last-child{border-bottom:0}.settings-row:focus-visible{outline:2px solid var(--accent);outline-offset:-2px}.settings-row-icon{width:34px;height:34px;border-radius:10px;background:var(--surface2);color:var(--accent);display:flex;align-items:center;justify-content:center;flex:none}.settings-row-copy{flex:1;min-width:0}.settings-row-copy b{display:block;font-size:.58rem}.settings-row-copy span{display:block;font-size:.45rem;color:var(--muted);margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.settings-row-arrow{color:var(--muted);font-size:.8rem}.settings-row.danger .settings-row-icon{background:var(--danger-soft);color:var(--danger)}.settings-row.danger b{color:var(--danger)}
.legal-consent{border:1px solid var(--line);background:var(--surface);border-radius:15px;padding:12px;display:flex;align-items:flex-start;gap:10px;cursor:pointer}.legal-consent.error{border-color:var(--accent2);background:var(--accent2-soft)}.legal-check{width:22px;height:22px;border-radius:7px;border:1.5px solid var(--line-strong);display:flex;align-items:center;justify-content:center;color:var(--on-accent);flex:none;margin-top:1px}.legal-consent.checked .legal-check{background:var(--accent);border-color:var(--accent)}.legal-consent-copy{font-size:.52rem;line-height:1.85;color:var(--muted)}.legal-consent-copy b{color:var(--ink)}.legal-link{border:0;background:transparent;color:var(--accent);font:inherit;font-weight:900;cursor:pointer;padding:0}.legal-error{font-size:.47rem;color:var(--accent2);margin:6px 3px 0}.legal-hero{border:1px solid rgba(52,210,166,.28);background:linear-gradient(145deg,var(--surface),var(--accent-soft));border-radius:19px;padding:15px;margin-bottom:13px}.legal-hero i{width:38px;height:38px;border-radius:12px;background:var(--accent);color:var(--on-accent);display:flex;align-items:center;justify-content:center;margin-bottom:10px}.legal-hero h2{font-size:.78rem}.legal-hero p{font-size:.5rem;line-height:1.8;margin-top:4px}.legal-meta{display:flex;gap:6px;flex-wrap:wrap;margin-top:10px}.legal-meta span{background:var(--surface);border:1px solid var(--line);border-radius:8px;padding:4px 7px;font-size:.42rem;color:var(--muted)}.legal-section{background:var(--surface);border:1px solid var(--line);border-radius:16px;padding:13px;margin-bottom:9px}.legal-section h3{font-size:.63rem}.legal-section p,.legal-section li{font-size:.5rem;line-height:1.9;color:var(--muted)}.legal-section p{margin-top:5px}.legal-section ul{padding-right:18px;margin:7px 0 0}.legal-acceptance-card{display:flex;align-items:flex-start;gap:9px;border:1px solid var(--line);background:var(--surface);border-radius:15px;padding:12px;margin-bottom:12px}.legal-acceptance-card>i{width:34px;height:34px;border-radius:10px;background:var(--accent-soft);color:var(--accent);display:flex;align-items:center;justify-content:center;flex:none}.legal-acceptance-card b{font-size:.57rem;color:var(--ink)}.legal-acceptance-card p{font-size:.46rem;line-height:1.7;margin-top:2px}
.account-card{background:var(--surface);border:1px solid var(--line);border-radius:16px;padding:13px;margin-bottom:9px}.account-card-head{display:flex;align-items:center;gap:9px}.account-card-head i{width:34px;height:34px;border-radius:10px;background:var(--accent-soft);color:var(--accent);display:flex;align-items:center;justify-content:center}.account-card-head div{flex:1}.account-card-head b{display:block;font-size:.6rem;color:var(--ink)}.account-card-head span{display:block;font-size:.46rem;color:var(--muted);margin-top:2px}.account-fact{display:flex;justify-content:space-between;gap:10px;border-top:1px solid var(--line);padding-top:9px;margin-top:9px;font-size:.5rem}.account-fact span{color:var(--muted)}.account-fact b{color:var(--ink);text-align:left}.privacy-preview{border-radius:14px;background:var(--surface2);padding:11px;margin-bottom:12px}.privacy-preview b{font-size:.57rem;color:var(--ink)}.privacy-preview p{font-size:.48rem;line-height:1.75;margin-top:3px}.faq-item{border:1px solid var(--line);background:var(--surface);border-radius:14px;margin-bottom:8px;overflow:hidden}.faq-question{width:100%;border:0;background:transparent;color:var(--ink);font-family:inherit;font-size:.56rem;font-weight:800;text-align:right;padding:12px;display:flex;justify-content:space-between;gap:8px;cursor:pointer}.faq-answer{border-top:1px solid var(--line);padding:10px 12px;font-size:.5rem;line-height:1.85;color:var(--muted)}.danger-zone{border:1px solid rgba(255,107,107,.35);background:var(--danger-soft);border-radius:16px;padding:13px;margin-top:14px}.danger-zone h3{color:var(--danger);font-size:.63rem}.danger-zone p{font-size:.48rem;line-height:1.75;margin:4px 0 10px}.version-row{text-align:center;color:var(--muted);font-size:.44rem;padding:8px 0 20px}.confirm-check{display:flex;align-items:flex-start;gap:9px;border:1px solid var(--line);background:var(--surface);border-radius:13px;padding:11px;margin:10px 0;cursor:pointer}.confirm-check i{width:21px;height:21px;border:1px solid var(--line-strong);border-radius:6px;display:flex;align-items:center;justify-content:center;color:var(--on-accent);flex:none}.confirm-check.active i{background:var(--danger);border-color:var(--danger)}.confirm-check span{font-size:.49rem;line-height:1.7;color:var(--ink)}
.composer{position:absolute;right:14px;left:14px;bottom:14px;min-height:54px;height:auto;border:1px solid var(--line);background:var(--surface);border-radius:16px;padding:6px;display:flex;gap:7px;z-index:10}
.composer input{flex:1;border:0;outline:0;background:transparent;color:var(--ink);padding:0 8px;font-size:.63rem;font-family:inherit}
.sendbtn{width:40px;border:0;border-radius:12px;background:var(--accent);color:var(--on-accent);display:flex;align-items:center;justify-content:center;cursor:pointer;flex:none}
.sendbtn svg{width:17px;height:17px}

.toast{position:absolute;right:18px;left:18px;bottom:84px;background:var(--ink);color:var(--bg);border-radius:13px;padding:11px 14px;font-size:.62rem;font-weight:700;text-align:center;z-index:60;opacity:0;transform:translateY(12px);transition:.22s;pointer-events:none}
.toast.show{opacity:1;transform:translateY(0)}

.quick-row{display:grid;grid-template-columns:1fr 1fr;gap:9px;margin:14px 0 4px}
.quick-btn{min-height:76px;background:var(--surface);border:1px solid var(--line);border-radius:15px;padding:13px;text-align:right;cursor:pointer;display:flex;flex-direction:column;justify-content:space-between;gap:10px;transition:transform .18s,border-color .18s,background .18s}
.quick-btn:active{transform:scale(.98);border-color:var(--accent);background:var(--accent-soft)}
.quick-btn .qicon{width:36px;height:36px;border-radius:11px;background:var(--accent-soft);color:var(--accent);display:flex;align-items:center;justify-content:center}
.quick-btn b{font-size:.62rem;color:var(--ink);font-weight:800}

/* Home: calm, visual and role-aware */
.home-page{padding:12px 16px 108px}.home-header{display:flex;align-items:center;gap:10px;margin-bottom:13px}.home-header .avatar{width:42px;height:42px;border-radius:13px}.home-welcome{flex:1;min-width:0}.home-welcome b{display:block;color:var(--ink);font-size:.78rem}.home-welcome span{display:block;color:var(--muted);font-size:.5rem;margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.home-alert{width:38px;height:38px;border:1px solid var(--line);border-radius:12px;background:var(--surface);color:var(--ink);display:flex;align-items:center;justify-content:center;position:relative;cursor:pointer}
.home-primary{min-height:148px;border:1px solid rgba(52,210,166,.35);border-radius:23px;background:linear-gradient(145deg,var(--accent-soft),var(--surface) 64%);padding:16px;display:flex;gap:12px;position:relative;overflow:hidden;cursor:pointer;margin-bottom:12px}.home-primary:after{content:"";position:absolute;width:140px;height:140px;border:1px solid var(--accent);border-radius:50%;left:-64px;bottom:-84px;opacity:.18}.home-primary-copy{flex:1;position:relative;z-index:1}.home-primary-copy>span{display:inline-flex;font-size:.43rem;font-weight:900;color:var(--accent);background:var(--accent-soft);padding:5px 8px;border-radius:8px}.home-primary-copy h2{font-size:.9rem;line-height:1.6;margin-top:9px}.home-primary-copy p{font-size:.51rem;line-height:1.75;margin-top:4px;max-width:205px}.home-primary-action{display:inline-flex;align-items:center;gap:5px;color:var(--accent);font-size:.5rem;font-weight:900;margin-top:11px}.home-primary-icon{width:78px;min-width:78px;border-radius:19px;background:linear-gradient(145deg,var(--accent),#137a67);color:#fff;display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden}.home-primary-icon svg{width:31px;height:31px}.home-primary-icon:after{content:"";position:absolute;width:60px;height:60px;border:1px solid rgba(255,255,255,.26);border-radius:50%;left:-25px;top:-18px}
.home-shortcuts{display:grid;grid-template-columns:repeat(4,1fr);gap:7px;margin-bottom:14px}.home-shortcut{min-width:0;min-height:78px;border:1px solid transparent;background:var(--surface2);border-radius:15px;padding:9px 5px 7px;color:var(--ink);font-family:inherit;cursor:pointer;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:7px;text-align:center}.home-shortcut i{width:31px;height:31px;border-radius:10px;background:var(--surface2);color:var(--accent);display:flex;align-items:center;justify-content:center}.home-shortcut b{font-size:.48rem;line-height:1.5}.home-shortcut:active{border-color:var(--accent);background:var(--accent-soft)}
.home-section-head{display:flex;align-items:flex-end;justify-content:space-between;gap:9px;margin:17px 2px 9px}.home-section-head b{font-size:.69rem;color:var(--ink)}.home-section-head span{display:block;font-size:.44rem;color:var(--muted);margin-top:2px}.home-section-head button{border:0;background:transparent;color:var(--accent);font-family:inherit;font-size:.49rem;font-weight:900;cursor:pointer}
.home-schedule{border:none;background:transparent;border-radius:19px;padding:0 0 13px;margin-bottom:2px}.home-schedule-head{display:flex;align-items:center;gap:9px;margin-bottom:10px}.home-schedule-head i{width:34px;height:34px;border-radius:11px;background:var(--accent-soft);color:var(--accent);display:flex;align-items:center;justify-content:center}.home-schedule-head div{flex:1}.home-schedule-head b{display:block;font-size:.59rem;color:var(--ink)}.home-schedule-head span{display:block;font-size:.45rem;color:var(--muted);margin-top:2px}.home-schedule-head button{border:0;background:transparent;color:var(--accent);font-family:inherit;font-size:.47rem;font-weight:900;cursor:pointer}.home-cal-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:5px}.home-cal-day{min-width:0;border:1px solid var(--line);background:var(--surface2);border-radius:10px;padding:6px 1px;text-align:center;cursor:pointer}.home-cal-day span{display:block;font-size:.39rem;color:var(--muted)}.home-cal-day b{display:block;font-size:.53rem;color:var(--ink);margin-top:3px}.home-cal-day.available{border-color:var(--accent);background:var(--accent-soft)}.home-cal-day.available b{color:var(--accent)}.home-cal-day.booked{border-color:var(--accent2);background:var(--accent2-soft)}.home-cal-day.booked b{color:var(--accent2)}.home-cal-day.off{opacity:.45}
.home-opportunity-rail{display:flex;gap:9px;overflow-x:auto;margin:0 -16px;padding:0 16px 4px;scrollbar-width:none;scroll-snap-type:x mandatory}.home-opportunity-rail::-webkit-scrollbar{display:none}.home-opportunity-card{width:215px;min-width:215px;border:1px solid var(--line);background:var(--surface);border-radius:18px;padding:13px;scroll-snap-align:start;cursor:pointer;position:relative;overflow:hidden}.home-opportunity-card:before{content:"";position:absolute;right:0;top:0;bottom:0;width:3px;background:var(--job-tone)}.home-opportunity-card.orange{--job-tone:#FF9F43}.home-opportunity-card.mint{--job-tone:#34D2A6}.home-opportunity-card.violet{--job-tone:#A98CFF}.home-opportunity-card.blue{--job-tone:#5EA8FF}.home-job-top{display:flex;align-items:center;justify-content:space-between;gap:7px}.home-job-top span{font-size:.42rem;font-weight:900;color:var(--job-tone);background:var(--surface2);padding:4px 6px;border-radius:7px}.home-job-top em{font-style:normal;font-size:.41rem;color:var(--muted)}.home-opportunity-card h3{font-size:.64rem;line-height:1.65;margin-top:9px;height:42px;overflow:hidden}.home-opportunity-card p{font-size:.46rem;line-height:1.65;margin-top:3px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.home-job-meta{display:flex;gap:5px;flex-wrap:wrap;margin-top:10px}.home-job-meta span{font-size:.41rem;color:var(--ink);background:var(--surface2);border:1px solid var(--line);padding:4px 6px;border-radius:7px}
.home-active-card{border:1px solid var(--line);border-radius:18px;background:linear-gradient(135deg,var(--surface),var(--surface2));padding:13px;display:flex;align-items:center;gap:10px;cursor:pointer}.home-active-card>i{width:42px;height:42px;border-radius:13px;background:var(--accent-soft);color:var(--accent);display:flex;align-items:center;justify-content:center}.home-active-card>div{flex:1;min-width:0}.home-active-card b{display:block;font-size:.6rem;color:var(--ink);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.home-active-card p{font-size:.46rem;margin-top:3px}.home-active-card>span{font-size:.43rem;font-weight:900;color:var(--accent2);background:var(--accent2-soft);padding:5px 7px;border-radius:8px}
.profile-setup-card{border:1px solid var(--accent);background:linear-gradient(145deg,var(--accent-soft),var(--surface));border-radius:18px;padding:13px;margin:20px 0 12px}.profile-setup-head{display:flex;align-items:flex-start;gap:9px;margin-bottom:10px}.profile-setup-head>i{width:34px;height:34px;border-radius:11px;background:var(--accent-soft);color:var(--accent);display:flex;align-items:center;justify-content:center;flex:none}.profile-setup-head>div{flex:1}.profile-setup-head b{display:block;font-size:.61rem;color:var(--ink)}.profile-setup-head p{font-size:.47rem;line-height:1.65;margin-top:2px}.profile-setup-head button{border:0;background:transparent;color:var(--muted);font-family:inherit;font-size:.45rem;font-weight:800;cursor:pointer}.profile-setup-list{display:grid;gap:7px}.profile-setup-task{min-height:48px;border:1px solid var(--line);background:var(--surface);border-radius:13px;padding:8px 10px;display:flex;align-items:center;gap:9px;color:var(--ink);font-family:inherit;text-align:right;cursor:pointer}.profile-setup-task i{width:30px;height:30px;border-radius:9px;background:var(--accent2-soft);color:var(--accent2);display:flex;align-items:center;justify-content:center;flex:none}.profile-setup-task span{flex:1;min-width:0}.profile-setup-task b{display:block;font-size:.53rem}.profile-setup-task small{display:block;font-size:.43rem;color:var(--muted);margin-top:2px}.profile-setup-task>em{font-style:normal;color:var(--accent);font-size:.75rem}.profile-photo-card{border:1px solid var(--line);background:var(--surface);border-radius:20px;padding:16px;text-align:center}.profile-photo-preview{width:132px;height:132px;border-radius:38px;border:1px solid var(--accent);background:var(--surface2);color:var(--accent);display:flex;align-items:center;justify-content:center;margin:0 auto 14px;font-size:1.3rem;font-weight:900;overflow:hidden}.profile-photo-preview img{width:100%;height:100%;object-fit:cover}.profile-photo-card h2{font-size:.82rem}.profile-photo-card p{font-size:.53rem;line-height:1.75;margin:5px auto 14px;max-width:265px}
.feature-hub-grid{display:grid;grid-template-columns:1fr 1fr;gap:9px}.feature-tile{min-height:118px;border:1px solid var(--line);background:var(--surface);border-radius:18px;padding:13px;text-align:right;font-family:inherit;cursor:pointer}.feature-tile i{width:37px;height:37px;border-radius:12px;background:var(--accent-soft);color:var(--accent);display:flex;align-items:center;justify-content:center;margin-bottom:12px}.feature-tile b{display:block;color:var(--ink);font-size:.6rem}.feature-tile span{display:block;color:var(--muted);font-size:.45rem;line-height:1.65;margin-top:3px}
.jobs-grid{display:grid;grid-template-columns:1fr 1fr;gap:9px}.jobs-grid .home-opportunity-card{width:auto;min-width:0}.job-detail-hero{border:1px solid var(--line);background:linear-gradient(145deg,var(--accent-soft),var(--surface));border-radius:21px;padding:16px;margin-bottom:10px}.job-detail-hero>span{font-size:.44rem;font-weight:900;color:var(--accent)}.job-detail-hero h2{font-size:.86rem;line-height:1.7;margin-top:7px}.job-detail-hero p{font-size:.5rem;line-height:1.75;margin-top:4px}.job-facts{display:grid;grid-template-columns:1fr 1fr;gap:7px;margin-bottom:10px}.job-facts>div{border:1px solid var(--line);background:var(--surface);border-radius:13px;padding:10px}.job-facts span{display:block;font-size:.41rem;color:var(--muted)}.job-facts b{display:block;font-size:.53rem;color:var(--ink);margin-top:3px}.public-slot-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:14px}.public-slot{border:1px solid var(--accent2);background:var(--accent2-soft);border-radius:14px;padding:10px;text-align:right;font-family:inherit;color:var(--ink);cursor:pointer}.public-slot i{width:29px;height:29px;border-radius:9px;background:var(--accent2);color:var(--on-warm);display:flex;align-items:center;justify-content:center;margin-bottom:7px}.public-slot b{display:block;font-size:.52rem;line-height:1.55}.public-slot span{display:block;font-size:.42rem;color:var(--accent2);font-weight:800;margin-top:3px}.availability-sheet-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:9px 0 14px}.availability-sheet-grid button{min-height:55px;border:1px solid var(--line);background:var(--surface2);color:var(--ink);border-radius:13px;font-family:inherit;font-size:.52rem;font-weight:800;cursor:pointer}.availability-sheet-grid button.active{border-color:var(--accent);background:var(--accent-soft);color:var(--accent)}

/* Shared Block identity, reputation and system states */
.home-theme{height:38px;min-width:67px;border:1px solid var(--line);border-radius:12px;background:var(--surface);color:var(--ink);display:flex;align-items:center;justify-content:center;gap:5px;padding:0 8px;font-family:inherit;font-size:.43rem;font-weight:900;cursor:pointer}.home-theme svg{color:var(--accent)}
.trust-card{border:1px solid rgba(52,210,166,.34);background:linear-gradient(145deg,var(--surface),var(--accent-soft));border-radius:22px;padding:14px;margin-bottom:12px;position:relative;overflow:hidden}.trust-card:after{content:"";position:absolute;width:105px;height:105px;border:1px solid var(--accent);border-radius:50%;left:-57px;top:-62px;opacity:.13}.trust-card-head{display:flex;align-items:center;gap:10px;position:relative;z-index:1}.trust-card-head .avatar{width:49px;height:49px;border-radius:15px}.trust-card-person{flex:1;min-width:0}.trust-card-person b{display:flex;align-items:center;gap:5px;font-size:.69rem;color:var(--ink);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.trust-card-person p{font-size:.46rem;margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.trust-verified{width:17px;height:17px;border-radius:50%;background:var(--accent);color:var(--on-accent);display:inline-flex;align-items:center;justify-content:center;flex:none}.trust-score{width:54px;height:54px;border-radius:17px;background:var(--accent);color:var(--on-accent);display:flex;flex-direction:column;align-items:center;justify-content:center;flex:none}.trust-score strong{font-size:.85rem;line-height:1}.trust-score span{font-size:.35rem;margin-top:3px;font-weight:800}.trust-tier{display:flex;align-items:center;justify-content:space-between;gap:8px;margin:11px 0 9px;border-radius:10px;background:var(--surface2);padding:7px 9px}.trust-tier b{font-size:.48rem;color:var(--accent)}.trust-tier span{font-size:.39rem;color:var(--muted)}.trust-facts{display:grid;grid-template-columns:1fr 1fr;gap:6px}.trust-fact{background:var(--surface2);border:none;border-radius:11px;padding:8px}.trust-fact span{display:block;font-size:.38rem;color:var(--muted)}.trust-fact b{display:block;font-size:.5rem;color:var(--ink);margin-top:3px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.trust-skills{display:flex;gap:5px;overflow:hidden;margin-top:8px}.trust-skills span{font-size:.39rem;color:var(--ink);background:var(--surface2);border:1px solid var(--line);border-radius:7px;padding:4px 6px;white-space:nowrap}.trust-comment{margin-top:8px;padding-top:8px;border-top:1px solid var(--line);display:flex;align-items:center;gap:7px}.trust-comment i{color:var(--accent2)}.trust-comment p{flex:1;font-size:.42rem;line-height:1.65;color:var(--ink)}.trust-card-action{width:100%;border:0;background:transparent;color:var(--accent);font-family:inherit;font-size:.46rem;font-weight:900;text-align:center;padding:9px 0 0;cursor:pointer}.trust-explain{border:1px solid var(--line);background:var(--surface);border-radius:16px;padding:12px;margin-bottom:10px}.trust-explain h3{font-size:.61rem}.trust-explain p{font-size:.47rem;line-height:1.8;margin-top:4px}.trust-meter{height:8px;border-radius:99px;background:var(--line);overflow:hidden;margin:10px 0 5px}.trust-meter i{display:block;height:100%;background:linear-gradient(90deg,var(--accent2),var(--accent));border-radius:99px}.trust-breakdown{display:grid;grid-template-columns:1fr 1fr;gap:7px}.trust-breakdown div{border:1px solid var(--line);background:var(--surface2);border-radius:12px;padding:9px}.trust-breakdown span{display:block;font-size:.4rem;color:var(--muted)}.trust-breakdown b{display:block;font-size:.53rem;color:var(--ink);margin-top:2px}
.network-banner{position:absolute;right:10px;left:10px;top:7px;z-index:18;border:1px solid var(--accent2);background:var(--accent2-soft);color:var(--ink);border-radius:12px;padding:8px 10px;display:flex;align-items:center;gap:7px;box-shadow:0 7px 18px rgba(0,0,0,.18)}.network-banner span{flex:1;font-size:.44rem;font-weight:800}.network-banner button{border:0;background:transparent;color:var(--accent2);font-family:inherit;font-size:.43rem;font-weight:900;cursor:pointer}.system-state{padding:55px 21px 24px;text-align:center}.system-state-art{width:82px;height:82px;border-radius:27px;background:var(--accent-soft);color:var(--accent);display:flex;align-items:center;justify-content:center;margin:0 auto 17px}.system-state-art.warning{background:var(--accent2-soft);color:var(--accent2)}.system-state-art.danger{background:var(--danger-soft);color:var(--danger)}.system-state h2{font-size:.91rem}.system-state p{font-size:.56rem;line-height:1.85;margin:6px auto 17px;max-width:285px}.skeleton-card{height:94px;border-radius:17px;background:linear-gradient(90deg,var(--surface) 25%,var(--surface2) 45%,var(--surface) 65%);background-size:220% 100%;animation:loading 1.15s infinite;margin-bottom:9px;border:1px solid var(--line)}@keyframes loading{0%{background-position:100% 0}100%{background-position:-100% 0}}.system-check{display:flex;align-items:center;gap:9px;border:1px solid var(--line);background:var(--surface);border-radius:14px;padding:11px;margin-bottom:8px;text-align:right}.system-check>i{width:34px;height:34px;border-radius:11px;background:var(--accent-soft);color:var(--accent);display:flex;align-items:center;justify-content:center}.system-check>div{flex:1}.system-check b{display:block;font-size:.56rem;color:var(--ink)}.system-check span{display:block;font-size:.43rem;color:var(--muted);margin-top:2px}.system-check em{font-style:normal;font-size:.42rem;font-weight:900;color:var(--accent)}
.request-tabs{display:grid;grid-template-columns:1fr 1fr;gap:6px;background:var(--surface2);padding:5px;border-radius:14px;margin-bottom:12px}.request-tabs button{height:39px;border:0;border-radius:10px;background:transparent;color:var(--muted);font-family:inherit;font-size:.51rem;font-weight:900;cursor:pointer}.request-tabs button.active{background:var(--surface);color:var(--accent);box-shadow:0 2px 8px rgba(0,0,0,.12)}.request-card{border:1px solid var(--line);background:var(--surface);border-radius:17px;padding:12px;margin-bottom:8px}.request-card-head{display:flex;align-items:flex-start;gap:9px}.request-card-head>i{width:36px;height:36px;border-radius:11px;background:var(--accent-soft);color:var(--accent);display:flex;align-items:center;justify-content:center}.request-card-head>div{flex:1;min-width:0}.request-card-head b{display:block;font-size:.58rem;color:var(--ink)}.request-card-head span{display:block;font-size:.44rem;color:var(--muted);margin-top:2px}.request-card p{font-size:.47rem;line-height:1.7;margin-top:8px}.request-actions{display:grid;grid-template-columns:1fr 1fr;gap:7px;margin-top:10px}.request-actions button{height:38px;border-radius:11px;font-family:inherit;font-size:.48rem;font-weight:900;cursor:pointer}.request-actions .accept{border:0;background:var(--accent);color:var(--on-accent)}.request-actions .decline{border:1px solid var(--danger);background:transparent;color:var(--danger)}.status-icon{display:inline-flex;align-items:center;gap:4px;border-radius:8px;padding:5px 7px;font-size:.42rem;font-weight:900}.status-icon.pending{background:var(--accent2-soft);color:var(--accent2)}.status-icon.accepted{background:var(--accent-soft);color:var(--accent)}.status-icon.declined{background:var(--danger-soft);color:var(--danger)}

.cal-strip{display:flex;gap:6px;margin:4px 0 8px}
.cal-pill{flex:1;background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:8px 2px;text-align:center;cursor:pointer;font-family:inherit}
.cal-pill span{display:block;font-size:.5rem;color:var(--muted)}
.cal-pill b{display:block;font-size:.62rem;margin-top:4px;color:var(--ink)}
.cal-pill em{display:block;font-style:normal;font-size:.38rem;color:var(--muted);margin-top:3px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.cal-pill.cal-available{border-color:var(--accent);background:var(--accent-soft)}
.cal-pill.cal-available b{color:var(--accent)}
.cal-pill.cal-booked{background:var(--accent2-soft);border-color:var(--accent2)}
.cal-pill.cal-booked b{color:var(--accent2)}
.cal-pill.cal-off{opacity:.45}
.cal-legend{display:flex;gap:12px;flex-wrap:wrap;font-size:.5rem;color:var(--muted);margin-bottom:12px}
.cal-legend i{display:inline-block;width:8px;height:8px;border-radius:50%;margin-left:4px;vertical-align:middle}
.dot-available{background:var(--accent)}
.dot-booked{background:var(--accent2)}
.dot-off{background:var(--line-strong)}
.calendar-summary{border:1px solid rgba(52,210,166,.28);background:linear-gradient(145deg,var(--accent-soft),var(--surface));border-radius:19px;padding:14px;margin-bottom:13px}.calendar-summary span{font-size:.44rem;color:var(--accent);font-weight:900}.calendar-summary h2{font-size:.78rem;margin-top:4px}.calendar-summary p{font-size:.48rem;line-height:1.75;margin-top:4px}.calendar-booking-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px}.calendar-booking{border:1px solid var(--line);background:var(--surface);border-radius:15px;padding:11px;cursor:pointer}.calendar-booking i{width:31px;height:31px;border-radius:10px;background:var(--accent-soft);color:var(--accent);display:flex;align-items:center;justify-content:center;margin-bottom:8px}.calendar-booking b{display:block;font-size:.53rem;color:var(--ink);line-height:1.55}.calendar-booking span{display:block;font-size:.42rem;color:var(--muted);line-height:1.6;margin-top:4px}.calendar-request{border:1px solid var(--line);background:var(--surface);border-radius:16px;padding:12px;margin-bottom:8px}.calendar-request-head{display:flex;align-items:center;gap:9px}.calendar-request-head i{width:34px;height:34px;border-radius:11px;background:var(--accent2-soft);color:var(--accent2);display:flex;align-items:center;justify-content:center}.calendar-request-head div{flex:1}.calendar-request-head b{display:block;font-size:.56rem;color:var(--ink)}.calendar-request-head span{display:block;font-size:.44rem;color:var(--muted);margin-top:2px}.calendar-request-actions{display:grid;grid-template-columns:1fr 1fr;gap:7px;margin-top:10px}.calendar-request-actions button{height:37px;border-radius:11px;font-family:inherit;font-size:.49rem;font-weight:900;cursor:pointer}.calendar-request-actions .accept{border:0;background:var(--accent);color:var(--on-accent)}.calendar-request-actions .decline{border:1px solid var(--danger);background:transparent;color:var(--danger)}
.badge-pending{background:var(--accent2-soft);color:var(--accent2)}
.badge-confirmed{background:var(--accent-soft);color:var(--accent)}
.badge-declined{background:var(--danger-soft);color:var(--danger)}

.badge-proposed{background:var(--surface2);color:var(--muted)}
.badge-agreed{background:var(--accent2-soft);color:var(--accent2)}
.badge-inprogress{background:var(--accent-soft);color:var(--accent)}
.badge-done{background:var(--accent-soft);color:var(--accent)}

.stepper{display:flex;align-items:center;margin:14px 0 18px}
.stepper .stepdot{width:22px;height:22px;border-radius:50%;background:var(--surface2);border:1px solid var(--line-strong);color:var(--muted);display:flex;align-items:center;justify-content:center;font-size:.5rem;font-weight:800;flex:none}
.stepper .stepdot.done{background:var(--accent);border-color:var(--accent);color:var(--on-accent)}
.stepper .stepline{flex:1;height:2px;background:var(--line-strong)}
.stepper .stepline.done{background:var(--accent)}
.steplabels{display:flex;justify-content:space-between;font-size:.46rem;color:var(--muted);margin-bottom:16px}

.stars{display:flex;gap:6px;justify-content:center;margin:10px 0 16px;direction:ltr}
.star{width:34px;height:34px;cursor:pointer;color:var(--line-strong)}
.star.on{color:var(--accent2)}
.stars-static{display:flex;gap:2px;direction:ltr}
.stars-static .star{width:13px;height:13px;cursor:default}

.notif-row{display:flex;align-items:flex-start;gap:11px;padding:12px;border-radius:14px;margin-bottom:6px;cursor:pointer}
.notif-row.unread{background:var(--surface);border:1px solid var(--line)}
.notif-row .ricon{width:34px;height:34px;border-radius:11px;background:var(--surface2);color:var(--accent);display:flex;align-items:center;justify-content:center;flex:none}
.notif-row .rcopy b{font-size:.64rem;color:var(--ink);display:block}
.notif-row .rcopy p{font-size:.56rem;margin-top:2px;line-height:1.6}
.notif-row .rcopy span{font-size:.48rem;color:var(--muted);display:block;margin-top:4px}
.notif-dot{width:7px;height:7px;border-radius:50%;background:var(--accent);flex:none;margin-top:6px}

.nav-badge{position:absolute;top:-2px;left:calc(50% - 16px);background:var(--danger);color:#fff;font-size:.4rem;font-weight:800;min-width:14px;height:14px;border-radius:8px;display:flex;align-items:center;justify-content:center;padding:0 3px;box-shadow:0 4px 12px rgba(255,107,107,.36);animation:badgeFloat 2.4s ease-in-out infinite}
.nav-btn{position:relative}
.dot-indicator{position:absolute;top:6px;left:8px;width:8px;height:8px;border-radius:50%;background:var(--danger);border:2px solid var(--surface)}

.portfolio-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.portfolio-card{border-radius:16px;overflow:hidden;border:1px solid var(--line);background:var(--surface)}
.portfolio-thumb{height:90px;display:flex;align-items:center;justify-content:center;color:#fff}
.portfolio-card b{display:block;font-size:.6rem;padding:8px 9px 2px;color:var(--ink)}
.portfolio-card span{display:block;font-size:.5rem;padding:0 9px 9px;color:var(--muted)}

.mapbox{position:relative;height:260px;border-radius:16px;border:1px solid var(--line);background:
  linear-gradient(var(--line) 1px,transparent 1px) 0 0/26px 26px,
  linear-gradient(90deg,var(--line) 1px,transparent 1px) 0 0/26px 26px,
  var(--surface2);overflow:hidden;margin-bottom:10px}
.mappin{position:absolute;transform:translate(-50%,-100%);cursor:pointer;text-align:center}
.mappin i{display:block;width:14px;height:14px;border-radius:50% 50% 50% 0;background:var(--accent);border:2px solid var(--surface);transform:rotate(-45deg);margin:0 auto}
.mappin span{display:none;position:absolute;bottom:20px;right:50%;transform:translateX(50%);background:var(--ink);color:var(--bg);font-size:.44rem;padding:3px 7px;border-radius:6px;white-space:nowrap}
.mappin:hover span,.mappin:active span{display:block}

/* Explore: compact categories, layered filters and visual discovery cards */
.explore-page{padding:12px 16px 108px}
.explore-head{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:13px}
.explore-head span{display:block;font-size:.5rem;font-weight:800;color:var(--accent);margin-bottom:2px}
.explore-head h2{font-size:1.02rem;line-height:1.45}
.explore-view-btn{height:34px;border:1px solid var(--line);background:var(--surface);color:var(--ink);border-radius:11px;padding:0 10px;display:flex;align-items:center;gap:6px;font-family:inherit;font-size:.54rem;font-weight:800;cursor:pointer;white-space:nowrap}
.explore-view-btn svg{color:var(--accent)}
.explore-search{height:50px;border:1px solid var(--line);border-radius:16px;background:linear-gradient(135deg,var(--surface),var(--surface2));display:flex;align-items:center;gap:9px;padding:0 13px;box-shadow:0 12px 30px rgba(0,0,0,.11);margin-top:2px}
.explore-search svg{color:var(--accent);width:18px;height:18px}
.explore-search input{flex:1;min-width:0;border:0;outline:0;background:transparent;color:var(--ink);font-size:.66rem;font-family:inherit}
.explore-search input::placeholder{color:var(--muted)}
.explore-role-rail{display:flex;gap:7px;overflow-x:auto;margin:12px -16px 0;padding:0 16px 5px;scroll-snap-type:x proximity;scrollbar-width:none}
.explore-role-rail::-webkit-scrollbar,.discovery-rail::-webkit-scrollbar,.active-filter-row::-webkit-scrollbar{display:none}
.explore-role-pill{min-width:64px;height:62px;border:1px solid var(--line);background:var(--surface);border-radius:16px;color:var(--muted);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:5px;font-family:inherit;font-size:.48rem;font-weight:800;cursor:pointer;scroll-snap-align:start;transition:.18s}
.explore-role-pill i{width:28px;height:28px;border-radius:9px;background:var(--surface2);display:flex;align-items:center;justify-content:center;color:var(--accent)}
.explore-role-pill.active{border-color:var(--accent);background:var(--accent-soft);color:var(--ink)}
.explore-role-pill.active i{background:var(--accent);color:var(--on-accent)}
.quick-filter-row{display:flex;gap:7px;overflow:auto;margin:15px -2px 0;padding:0 2px 2px;scrollbar-width:none}
.quick-filter{height:32px;border:1px solid var(--line);background:var(--surface2);color:var(--muted);border-radius:10px;padding:0 12px;font-family:inherit;font-size:.53rem;font-weight:800;white-space:nowrap;cursor:pointer}
.quick-filter.active{border-color:var(--accent);background:var(--accent-soft);color:var(--accent)}
.explore-toolbar{display:grid;grid-template-columns:1fr auto;gap:8px;margin-top:15px}
.explore-filter-btn,.explore-sort-btn{height:39px;border:1px solid var(--line);background:var(--surface);color:var(--ink);border-radius:12px;padding:0 11px;display:flex;align-items:center;justify-content:center;gap:7px;font-family:inherit;font-size:.56rem;font-weight:800;cursor:pointer}
.explore-filter-btn{justify-content:flex-start}
.explore-filter-btn svg{color:var(--accent)}
.explore-filter-count{min-width:19px;height:19px;border-radius:7px;background:var(--accent);color:var(--on-accent);display:flex;align-items:center;justify-content:center;font-size:.46rem;margin-right:auto}
.explore-sort-btn{color:var(--muted);white-space:nowrap}
.active-filter-row{display:flex;gap:6px;overflow-x:auto;margin:8px -16px 0;padding:0 16px 2px;scrollbar-width:none}
.active-filter-chip{height:26px;border:0;border-radius:9px;background:var(--accent-soft);color:var(--accent);padding:0 9px;font-family:inherit;font-size:.48rem;font-weight:800;white-space:nowrap;cursor:pointer}
.explore-section-head{display:flex;align-items:flex-end;justify-content:space-between;margin:18px 1px 9px}
.explore-section-head b{font-size:.72rem;color:var(--ink)}
.explore-section-head span{font-size:.48rem;color:var(--muted)}
.tone-mint{--card-tone:var(--tone-mint);--card-soft:var(--tone-mint-soft)}
.tone-orange{--card-tone:var(--accent2);--card-soft:var(--accent2-soft)}
.tone-blue{--card-tone:var(--tone-blue);--card-soft:var(--tone-blue-soft)}
.tone-violet{--card-tone:var(--tone-violet);--card-soft:var(--tone-violet-soft)}
.explore-feature{min-height:174px;border:1px solid color-mix(in srgb,var(--card-tone) 42%,var(--line));border-radius:21px;background:linear-gradient(145deg,var(--card-soft),var(--surface) 62%);padding:17px;position:relative;overflow:hidden;cursor:pointer;display:flex;align-items:stretch;gap:8px;box-shadow:0 16px 36px rgba(0,0,0,.14)}
.explore-feature:after{content:"";position:absolute;width:135px;height:135px;border:1px solid var(--card-tone);border-radius:50%;left:-60px;bottom:-75px;opacity:.16}
.explore-feature-copy{flex:1;min-width:0;position:relative;z-index:1}
.explore-feature-label{display:inline-flex;align-items:center;gap:4px;font-size:.46rem;font-weight:900;color:var(--card-tone);background:var(--card-soft);padding:5px 8px;border-radius:8px;margin-bottom:10px}
.explore-feature h3{font-size:.82rem;line-height:1.65;max-width:195px}
.explore-feature p{font-size:.53rem;line-height:1.7;margin-top:4px;max-width:205px}
.explore-feature-meta{display:flex;gap:5px;flex-wrap:wrap;margin-top:12px}
.explore-feature-meta span{font-size:.46rem;font-weight:800;color:var(--ink);background:rgba(255,255,255,.05);border:1px solid var(--line);padding:5px 7px;border-radius:8px}
.explore-feature-art{width:86px;flex:none;border-radius:18px;background:radial-gradient(circle at 70% 22%,rgba(255,255,255,.17) 0 8px,transparent 9px),linear-gradient(145deg,var(--card-tone),color-mix(in srgb,var(--card-tone) 50%,#0A1420));display:flex;align-items:center;justify-content:center;color:#fff;position:relative;overflow:hidden}
.explore-feature-art svg{width:36px;height:36px;position:relative;z-index:1}
.explore-feature-art:before,.explore-feature-art:after{content:"";position:absolute;border:1px solid rgba(255,255,255,.22);border-radius:50%}
.explore-feature-art:before{width:70px;height:70px;right:-24px;bottom:-20px}.explore-feature-art:after{width:38px;height:38px;left:-14px;top:15px}
.discovery-rail{display:flex;gap:9px;overflow-x:auto;margin:0 -16px;padding:0 16px 4px;scroll-snap-type:x mandatory;scrollbar-width:none}
.discovery-mini{width:146px;min-width:146px;border:1px solid var(--line);border-radius:17px;background:var(--surface);overflow:hidden;cursor:pointer;scroll-snap-align:start}
.discovery-mini-art{height:68px;background:linear-gradient(140deg,var(--card-soft),var(--surface2));display:flex;align-items:center;justify-content:center;color:var(--card-tone);position:relative}
.discovery-mini-art svg{width:27px;height:27px}
.discovery-mini-art span{position:absolute;top:7px;right:7px;font-size:.42rem;font-weight:900;background:var(--surface);color:var(--card-tone);padding:3px 6px;border-radius:7px}
.discovery-mini-copy{padding:9px 10px 10px}
.discovery-mini-copy b{display:block;color:var(--ink);font-size:.58rem;line-height:1.55;height:36px;overflow:hidden}
.discovery-mini-copy span{display:block;color:var(--muted);font-size:.46rem;margin-top:5px}
.discovery-grid{display:grid;grid-template-columns:1fr 1fr;gap:11px}
.discovery-card{border:1px solid var(--line);border-radius:18px;background:var(--surface);overflow:hidden;cursor:pointer;min-width:0;transition:transform .16s,border-color .16s}
.discovery-card:active{transform:scale(.985);border-color:var(--card-tone)}
.discovery-card-art{height:100px;background:radial-gradient(circle at 82% 18%,rgba(255,255,255,.12) 0 8px,transparent 9px),linear-gradient(145deg,var(--card-soft),var(--surface2));display:flex;align-items:center;justify-content:center;color:var(--card-tone);position:relative}
.discovery-card-art>svg{width:29px;height:29px}
.discover-type{position:absolute;right:8px;top:8px;font-size:.42rem;font-weight:900;padding:4px 6px;border-radius:7px;background:var(--surface);color:var(--card-tone)}
.discover-verified{position:absolute;left:8px;top:8px;width:20px;height:20px;border-radius:7px;background:var(--accent);color:var(--on-accent);display:flex;align-items:center;justify-content:center}
.discovery-card-copy{padding:12px 13px}
.discovery-card-copy h3{font-size:.64rem;line-height:1.5;height:39px;overflow:hidden}
.discovery-card-copy p{font-size:.52rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-top:4px;color:var(--muted)}
.discover-skill{display:inline-block;max-width:100%;font-size:.47rem;font-weight:800;color:var(--card-tone);background:var(--card-soft);border-radius:7px;padding:5px 8px;margin-top:9px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.discover-card-foot{display:flex;align-items:center;justify-content:space-between;border-top:1px solid var(--line);padding-top:9px;margin-top:10px;color:var(--muted);font-size:.47rem}
.discover-card-foot strong{color:var(--ink);font-size:.52rem}
.explore-empty{text-align:center;border:1px dashed var(--line-strong);border-radius:20px;padding:28px 20px;margin-top:18px;background:var(--surface2)}
.explore-empty i{width:52px;height:52px;border-radius:17px;background:var(--accent-soft);color:var(--accent);display:flex;align-items:center;justify-content:center;margin:0 auto 12px}
.explore-empty b{display:block;color:var(--ink);font-size:.72rem}.explore-empty p{font-size:.54rem;line-height:1.8;margin:5px 0 13px}
.filter-sheet-head{display:flex;align-items:flex-start;justify-content:space-between;gap:10px;flex:none}
.filter-sheet-head h3{margin:0}.filter-sheet-head p{margin:3px 0 0;font-size:.52rem}
.sheet-close{width:30px;height:30px;border:1px solid var(--line);border-radius:10px;background:var(--surface2);color:var(--muted);font-size:1rem;cursor:pointer}
.explore-filter-scroll{overflow:auto;margin:10px -4px 12px;padding:0 4px;scrollbar-width:none}
.explore-filter-scroll::-webkit-scrollbar{display:none}
.filter-group{padding:12px 0;border-bottom:1px solid var(--line)}.filter-group:first-child{padding-top:3px}.filter-group:last-child{border-bottom:0}
.filter-group>b{display:block;color:var(--ink);font-size:.59rem;margin-bottom:8px}.filter-group>b span{color:var(--accent2);font-size:.42rem;margin-right:4px}
.filter-options{display:flex;flex-wrap:wrap;gap:6px}
.filter-option{min-height:31px;border:1px solid var(--line);border-radius:10px;background:var(--surface2);color:var(--muted);padding:5px 9px;display:flex;align-items:center;gap:5px;font-family:inherit;font-size:.49rem;font-weight:800;cursor:pointer}
.filter-option.active{border-color:var(--accent);background:var(--accent-soft);color:var(--accent)}
.filter-sheet-actions{display:grid;grid-template-columns:84px 1fr;gap:8px;flex:none}
.filter-clear,.filter-apply{height:43px;border-radius:13px;font-family:inherit;font-size:.58rem;font-weight:900;cursor:pointer}.filter-clear{border:1px solid var(--line);background:transparent;color:var(--muted)}.filter-apply{border:0;background:var(--accent);color:var(--on-accent)}

/* Publish hub and targeted ad wizard */
.publish-page{padding:13px 16px 108px}
.publish-head{margin-bottom:13px}.publish-head span{font-size:.5rem;font-weight:900;color:var(--accent)}.publish-head h2{font-size:1.02rem;margin-top:2px}.publish-head p{font-size:.55rem;line-height:1.75;margin-top:5px}
.publish-hero{border:1px solid rgba(52,210,166,.28);border-radius:20px;background:linear-gradient(140deg,var(--accent-soft),var(--surface));padding:15px;display:flex;gap:12px;align-items:center;margin-bottom:17px;position:relative;overflow:hidden}
.publish-hero:after{content:"";position:absolute;width:90px;height:90px;border:1px solid var(--accent);border-radius:50%;left:-42px;bottom:-55px;opacity:.15}
.publish-hero i{width:42px;height:42px;border-radius:14px;background:var(--accent);color:var(--on-accent);display:flex;align-items:center;justify-content:center;flex:none}.publish-hero b{display:block;color:var(--ink);font-size:.65rem}.publish-hero p{font-size:.5rem;line-height:1.75;margin-top:3px}
.publish-section-title{display:flex;align-items:center;justify-content:space-between;margin:18px 1px 9px}.publish-section-title b{font-size:.7rem;color:var(--ink)}.publish-section-title span{font-size:.46rem;color:var(--muted)}
.publish-option-list{display:flex;flex-direction:column;gap:8px}
.publish-option{border:1px solid var(--line);border-radius:18px;background:var(--surface);padding:13px;display:flex;align-items:center;gap:11px;cursor:pointer;position:relative;overflow:hidden}
.publish-option:after{content:"";position:absolute;right:0;top:0;bottom:0;width:3px;background:var(--option-tone)}
.publish-option.mint{--option-tone:var(--tone-mint);--option-soft:var(--tone-mint-soft)}.publish-option.orange{--option-tone:var(--accent2);--option-soft:var(--accent2-soft)}.publish-option.violet{--option-tone:var(--tone-violet);--option-soft:var(--tone-violet-soft)}
.publish-option>i{width:42px;height:42px;border-radius:13px;background:var(--option-soft);color:var(--option-tone);display:flex;align-items:center;justify-content:center;flex:none}.publish-option-copy{flex:1;min-width:0}.publish-option-copy b{display:block;color:var(--ink);font-size:.64rem}.publish-option-copy p{font-size:.49rem;line-height:1.65;margin-top:3px}.publish-option>span{color:var(--muted);font-size:1rem}
.publish-route-note{display:flex;gap:9px;align-items:flex-start;background:var(--accent2-soft);border:1px solid rgba(255,159,67,.28);border-radius:15px;padding:11px;margin-top:12px}.publish-route-note i{color:var(--accent2);display:flex}.publish-route-note b{display:block;font-size:.56rem;color:var(--ink)}.publish-route-note p{font-size:.47rem;line-height:1.7;margin-top:2px}
.direct-route-card{border:1px solid var(--line);border-radius:17px;background:var(--surface2);padding:12px;display:flex;align-items:center;gap:10px;cursor:pointer;margin-bottom:8px}.direct-route-card>i{width:38px;height:38px;border-radius:12px;background:var(--surface);color:var(--accent);display:flex;align-items:center;justify-content:center}.direct-route-card div{flex:1}.direct-route-card b{display:block;color:var(--ink);font-size:.6rem}.direct-route-card p{font-size:.47rem;margin-top:2px}.direct-route-card>span{font-size:.8rem;color:var(--muted)}
.ad-page{padding:10px 16px 105px}
.ad-progress{display:grid;grid-template-columns:repeat(3,1fr);gap:5px;margin:2px 0 15px}.ad-progress i{height:4px;border-radius:99px;background:var(--line)}.ad-progress i.done{background:var(--accent)}
.ad-step-copy{margin-bottom:14px}.ad-step-copy span{font-size:.47rem;font-weight:900;color:var(--accent)}.ad-step-copy h2{font-size:.9rem;margin-top:3px}.ad-step-copy p{font-size:.52rem;line-height:1.75;margin-top:4px}
.fixed-ad-title{border:1px solid rgba(52,210,166,.3);background:var(--accent-soft);border-radius:15px;padding:12px 13px;margin-bottom:11px}.fixed-ad-title span{display:block;color:var(--muted);font-size:.45rem;margin-bottom:3px}.fixed-ad-title b{display:block;color:var(--ink);font-size:.7rem}.fixed-ad-title p{font-size:.47rem;line-height:1.65;margin-top:4px}.audience-limit{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-top:8px;color:var(--muted);font-size:.44rem}.audience-limit strong{color:var(--accent);font-size:.47rem}
.ad-block{border:1px solid var(--line);border-radius:17px;background:var(--surface);padding:13px;margin-bottom:10px}.ad-block-head{margin-bottom:9px}.ad-block-head b{display:block;color:var(--ink);font-size:.62rem}.ad-block-head p{font-size:.48rem;line-height:1.65;margin-top:2px}
.audience-grid{display:grid;grid-template-columns:1fr 1fr;gap:7px}.audience-choice{min-height:54px;border:1px solid var(--line);background:var(--surface2);color:var(--muted);border-radius:12px;padding:8px;display:flex;align-items:center;gap:7px;font-family:inherit;font-size:.5rem;font-weight:900;cursor:pointer;text-align:right}.audience-choice i{width:28px;height:28px;border-radius:9px;background:var(--surface);color:var(--accent);display:flex;align-items:center;justify-content:center;flex:none}.audience-choice.active{border-color:var(--accent);background:var(--accent-soft);color:var(--ink)}.audience-choice.active i{background:var(--accent);color:var(--on-accent)}
.audience-choice span{flex:1}.audience-choice em{font-style:normal;font-size:.39rem;color:var(--accent);white-space:nowrap}.ad-block-warning{outline:1px solid color-mix(in srgb,var(--accent2) 42%,transparent);outline-offset:2px;background:var(--surface);animation:warning-breathe 2.8s ease-in-out infinite}
.ad-chip-wrap{display:flex;gap:6px;flex-wrap:wrap}.ad-chip{min-height:31px;border:1px solid var(--line);background:var(--surface2);color:var(--muted);border-radius:10px;padding:6px 9px;font-family:inherit;font-size:.49rem;font-weight:800;cursor:pointer}.ad-chip.active{border-color:var(--accent);background:var(--accent-soft);color:var(--accent)}
.ad-form-note{border:1px solid var(--accent2);background:var(--accent2-soft);border-radius:13px;padding:10px;margin-bottom:12px}.ad-form-note b{display:block;font-size:.54rem;color:var(--accent2)}.ad-form-note p{font-size:.47rem;line-height:1.7;margin-top:2px;color:var(--ink)}
.ad-preview-card{border:1px solid var(--line);border-radius:20px;background:linear-gradient(140deg,var(--accent-soft),var(--surface));padding:16px;margin-bottom:11px}.ad-preview-card>span{display:inline-flex;font-size:.44rem;font-weight:900;color:var(--accent);background:var(--accent-soft);padding:5px 8px;border-radius:8px}.ad-preview-card h3{font-size:.78rem;line-height:1.65;margin-top:10px}.ad-preview-card p{font-size:.52rem;line-height:1.7;margin-top:4px}.ad-preview-tags{display:flex;gap:5px;flex-wrap:wrap;margin-top:11px}.ad-preview-tags span{font-size:.44rem;color:var(--ink);background:var(--surface2);border:1px solid var(--line);padding:5px 7px;border-radius:8px}
.required-mark{display:inline-flex;font-size:.38rem;font-weight:900;color:var(--accent2);background:var(--accent2-soft);border-radius:6px;padding:2px 5px;margin-right:4px;vertical-align:middle}.optional{color:var(--muted);font-size:.4rem;font-weight:600}.profile-source-card{display:flex;align-items:flex-start;gap:10px;border:1px solid rgba(52,210,166,.3);background:var(--accent-soft);border-radius:17px;padding:13px;margin-bottom:10px}.profile-source-card>i{width:36px;height:36px;border-radius:12px;background:var(--accent);color:var(--on-accent);display:flex;align-items:center;justify-content:center;flex:none}.profile-source-card>div{flex:1;min-width:0}.profile-source-card b{display:block;color:var(--ink);font-size:.6rem}.profile-source-card p{font-size:.48rem;line-height:1.7;margin:3px 0 8px}.profile-source-card.missing{border-color:var(--accent2);background:var(--accent2-soft)}.profile-source-card.missing>i{background:var(--accent2);color:#211203}.profile-source-card.compact{margin:0 0 10px}.profile-source-card.compact p{margin-bottom:0}.profile-category-inline{display:flex;align-items:center;justify-content:space-between;gap:8px;border:1px solid var(--line);background:var(--surface);border-radius:13px;padding:11px 12px;margin-bottom:14px}.profile-category-inline span{font-size:.49rem;color:var(--muted)}.profile-category-inline b{font-size:.55rem;color:var(--accent)}
.ad-location-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px}.ad-location-grid .field{min-width:0}.field-help{font-size:.46rem;line-height:1.7;margin:-2px 0 8px}.ad-attachment{border:1px dashed var(--line-strong);background:var(--surface);border-radius:15px;padding:11px;margin-bottom:14px}.ad-attachment>label:first-child{display:block;font-size:.56rem;font-weight:800;color:var(--ink);margin-bottom:8px}.ad-attachment>label:first-child span{font-size:.42rem;color:var(--muted);font-weight:500}.ad-attachment>img,.ad-review-image,.ad-detail-image{display:block;width:100%;max-height:190px;object-fit:cover;border-radius:12px;margin:0 0 9px}.ad-upload{height:42px;border:1px solid var(--line);border-radius:12px;color:var(--accent);display:flex;align-items:center;justify-content:center;gap:6px;font-size:.52rem;font-weight:900;cursor:pointer;background:var(--surface2)}.ad-upload input{display:none}.ad-review-image{margin-top:11px;margin-bottom:0}.ad-detail-image{margin-top:10px;margin-bottom:0}
.chat-only-card{border:1px solid rgba(52,210,166,.28);background:var(--surface);border-radius:15px;padding:11px;display:flex;align-items:flex-start;gap:9px;margin-bottom:14px}.chat-only-card>i{width:34px;height:34px;border-radius:11px;background:var(--accent-soft);color:var(--accent);display:flex;align-items:center;justify-content:center;flex:none}.chat-only-card b{display:block;font-size:.56rem;color:var(--ink)}.chat-only-card p{font-size:.46rem;line-height:1.7;margin-top:2px}.ad-preview-description{font-size:.5rem;line-height:1.85;color:var(--ink);border-top:1px solid var(--line);margin-top:12px;padding-top:10px}.ad-review-grid,.ad-detail-grid{display:grid;grid-template-columns:1fr 1fr;gap:7px;margin-bottom:11px}.ad-review-grid>div,.ad-detail-grid>div{border:1px solid var(--line);background:var(--surface);border-radius:12px;padding:10px}.ad-review-grid span,.ad-detail-grid span{display:block;font-size:.42rem;color:var(--muted)}.ad-review-grid b,.ad-detail-grid b{display:block;font-size:.52rem;color:var(--ink);margin-top:3px;line-height:1.55}.dashboard-profile-signal{display:flex;align-items:flex-start;gap:9px;border:1px solid var(--line);background:var(--surface);border-radius:15px;padding:11px;margin-bottom:14px}.dashboard-profile-signal>i{width:31px;height:31px;border-radius:10px;background:var(--accent-soft);color:var(--accent);display:flex;align-items:center;justify-content:center;flex:none}.dashboard-profile-signal b{display:block;font-size:.55rem;color:var(--ink)}.dashboard-profile-signal p{font-size:.46rem;margin-top:2px;color:var(--accent)}
.discover-ad-summary{font-size:.44rem!important;line-height:1.6!important;white-space:normal!important;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;margin-top:7px!important}.ad-detail-page{padding-top:10px}.ad-detail-hero{border:1px solid var(--line);background:linear-gradient(140deg,var(--accent-soft),var(--surface));border-radius:21px;padding:16px;margin-bottom:11px}.ad-detail-hero>span{font-size:.43rem;font-weight:900;color:var(--accent)}.ad-detail-hero h2{font-size:.9rem;line-height:1.7;margin-top:5px}.ad-detail-hero p{font-size:.52rem;margin-top:3px}.ad-owner-card{display:flex;align-items:center;gap:9px;border:1px solid var(--line);background:var(--surface);border-radius:16px;padding:11px;margin-bottom:11px}.ad-owner-card>.avatar{width:38px;height:38px;border-radius:12px;font-size:.58rem}.ad-owner-card>div:nth-child(2){flex:1;min-width:0}.ad-owner-card b{display:block;font-size:.58rem;color:var(--ink)}.ad-owner-card p{font-size:.45rem;margin-top:2px}.ad-owner-card>span{display:flex;align-items:center;gap:3px;font-size:.4rem;color:var(--accent);white-space:nowrap}.ad-detail-section{border:1px solid var(--line);background:var(--surface);border-radius:16px;padding:13px;margin-bottom:10px}.ad-detail-section>b{display:block;font-size:.6rem;color:var(--ink);margin-bottom:6px}.ad-detail-section p{font-size:.5rem;line-height:1.85;color:var(--ink)}.ad-detail-section.profile-context{background:var(--accent-soft);border-color:rgba(52,210,166,.25)}
.notify-preview{border:1px solid rgba(52,210,166,.3);background:var(--accent-soft);border-radius:17px;padding:13px;display:flex;align-items:flex-start;gap:10px}.notify-preview>i{width:36px;height:36px;border-radius:12px;background:var(--accent);color:var(--on-accent);display:flex;align-items:center;justify-content:center;flex:none}.notify-preview b{display:block;color:var(--ink);font-size:.62rem}.notify-preview strong{color:var(--accent);font-size:.76rem}.notify-preview p{font-size:.48rem;line-height:1.7;margin-top:3px}
.ad-dock{position:absolute;right:0;left:0;bottom:0;padding:12px 16px 20px;background:linear-gradient(0deg,var(--bg) 72%,transparent)}
.ad-success-flow{display:flex;align-items:center;justify-content:center;margin:18px 0}.ad-success-flow span{font-size:.45rem;color:var(--muted);text-align:center}.ad-success-flow i{width:30px;height:2px;background:var(--accent);margin:0 6px}
.ad-success-audience{background:var(--surface);border:1px solid var(--line);border-radius:16px;padding:12px;margin:12px 0}.ad-success-audience b{font-size:.58rem;color:var(--ink)}.ad-success-audience p{font-size:.49rem;line-height:1.75;margin-top:4px}

.composer-action.recording{color:var(--danger);background:var(--danger-soft);border-radius:10px;animation:voicePulse 1s infinite}
.voice-message{display:flex;align-items:center;gap:8px;min-width:174px}.voice-message i{width:34px;height:34px;border-radius:50%;background:rgba(255,255,255,.15);display:flex;align-items:center;justify-content:center}.voice-message>div{flex:1}.voice-wave{height:18px;display:flex;align-items:center;gap:2px;direction:ltr}.voice-wave span{display:block;width:2px;border-radius:9px;background:currentColor;opacity:.7}.voice-message small{margin:0!important;direction:rtl!important;font-size:.4rem!important}.chat-contact-card{border:1px solid var(--line);background:var(--surface);border-radius:16px;padding:11px;margin-bottom:10px}.chat-contact-head{display:flex;align-items:center;gap:8px}.chat-contact-head>i{width:34px;height:34px;border-radius:11px;background:var(--accent-soft);color:var(--accent);display:flex;align-items:center;justify-content:center}.chat-contact-head div{flex:1}.chat-contact-head b{display:block;color:var(--ink);font-size:.56rem}.chat-contact-head p{font-size:.46rem;line-height:1.6;margin-top:2px}.chat-contact-actions{display:grid;grid-template-columns:1fr 1fr;gap:7px;margin-top:9px}.chat-contact-actions button{min-height:38px;border-radius:11px;font-family:inherit;font-size:.49rem;font-weight:900;cursor:pointer}.chat-contact-actions .share{border:0;background:var(--accent);color:var(--on-accent)}.chat-contact-actions .request{border:1px solid var(--line-strong);background:transparent;color:var(--ink)}.shared-phone{display:flex;align-items:center;gap:9px;margin-top:9px;padding:9px;border-radius:12px;background:var(--accent-soft);border:1px solid rgba(52,210,166,.28)}.shared-phone div{flex:1}.shared-phone a{font-size:.64rem;font-weight:900;color:var(--accent);text-decoration:none;direction:ltr;display:inline-block}.shared-phone span{display:block;color:var(--muted);font-size:.43rem;margin-top:2px}.shared-phone button{border:0;background:transparent;color:var(--danger);font-family:inherit;font-size:.44rem;font-weight:800;cursor:pointer}
.agreement-card{border:1px solid rgba(52,210,166,.34);background:linear-gradient(145deg,var(--surface),var(--accent-soft));border-radius:17px;padding:12px;margin-bottom:11px}.agreement-card-head{display:flex;align-items:flex-start;gap:9px}.agreement-card-head>i{width:35px;height:35px;border-radius:11px;background:var(--accent);color:var(--on-accent);display:flex;align-items:center;justify-content:center;flex:none}.agreement-card-head div{flex:1}.agreement-card-head b{display:block;color:var(--ink);font-size:.59rem}.agreement-card-head p{font-size:.46rem;line-height:1.7;margin-top:2px}.agreement-parties{display:grid;grid-template-columns:1fr 1fr;gap:7px;margin-top:10px}.agreement-party{border:1px solid var(--line);background:var(--surface);border-radius:11px;padding:8px}.agreement-party span{display:block;color:var(--muted);font-size:.4rem}.agreement-party b{display:flex;align-items:center;gap:4px;color:var(--ink);font-size:.47rem;margin-top:4px}.agreement-party.confirmed b{color:var(--accent)}.agreement-card .btn-primary{height:42px;margin-top:10px;font-size:.6rem}.agreement-complete{margin-top:10px;border-radius:11px;padding:9px;background:var(--accent);color:var(--on-accent);font-size:.48rem;font-weight:900;text-align:center}
.trust-skills-label{display:flex;align-items:center;gap:5px;margin:12px 1px 7px;color:var(--ink);font-size:.52rem;font-weight:900}.trust-skills-label i{color:var(--accent)}.trust-skills-label em{font-style:normal;font-size:.4rem;color:var(--muted);font-weight:700;margin-right:auto}.trust-card .trust-skills{display:grid;grid-template-columns:1fr 1fr;gap:6px;margin-top:0;overflow:visible}.trust-card .trust-skills span{min-height:34px;display:flex;align-items:center;justify-content:center;text-align:center;font-size:.51rem;font-weight:900;line-height:1.5;color:var(--ink);background:var(--surface);border:1px solid var(--line-strong);border-radius:10px;padding:7px 8px;white-space:normal}.trust-card .trust-comment{margin-top:10px;padding-top:9px}.trust-card .trust-card-action{font-size:.48rem;padding-top:10px}
.trust-skills span.skill-tap{cursor:pointer;border-color:var(--accent);color:var(--accent);gap:4px}
.trust-skills span.skill-tap i{font-style:normal;font-size:.6rem}
.skill-rate-tap{cursor:pointer}
.skill-rate-tap:active{background:var(--accent-soft)}
.skill-rate-tap .rarrow{color:var(--accent);font-weight:900}
.chip.skill-tap{cursor:pointer;border-color:var(--accent);color:var(--accent)}
.chat-fab{position:fixed;bottom:22px;left:16px;width:52px;height:52px;border-radius:50%;background:linear-gradient(135deg,var(--tone-violet),#6C5CE7);display:flex;align-items:center;justify-content:center;border:none;cursor:pointer;z-index:40;box-shadow:0 10px 24px rgba(108,92,231,.45)}
.chat-fab svg{width:21px;height:21px;color:#fff;position:relative;z-index:1}
.chat-fab::before{content:'';position:absolute;inset:-7px;border-radius:50%;border:2px solid var(--tone-violet);opacity:.55;animation:fabPulse 2.4s ease-out infinite}
@keyframes fabPulse{0%{transform:scale(.82);opacity:.6}100%{transform:scale(1.4);opacity:0}}
.explore-mode-switch{position:relative;display:grid;grid-template-columns:1fr 1fr;gap:0;margin:10px 0;background:var(--surface-2,var(--surface));border:1px solid var(--line);border-radius:14px;padding:4px}
.explore-mode-thumb{position:absolute;top:4px;bottom:4px;width:calc(50% - 4px);border-radius:11px;background:var(--accent);transition:transform .28s cubic-bezier(.3,.8,.4,1);z-index:0}
.explore-mode-switch[data-active="0"] .explore-mode-thumb{transform:translateX(0)}
.explore-mode-switch[data-active="1"] .explore-mode-thumb{transform:translateX(-100%)}
.explore-mode-switch button{position:relative;z-index:1;display:flex;align-items:center;justify-content:center;gap:6px;font-family:inherit;font-size:.58rem;font-weight:800;padding:10px 6px;border-radius:11px;border:none;background:transparent;color:var(--muted);cursor:pointer;transition:color .2s}
.explore-mode-switch button svg{width:14px;height:14px}
.explore-mode-switch button.active{color:var(--on-accent)}
.home-dashboard{background:var(--surface);border:1px solid var(--line);border-radius:18px;padding:14px;margin:12px 0;cursor:pointer;animation:dashCardIn .4s cubic-bezier(.22,1,.36,1)}
@keyframes dashCardIn{from{opacity:0;transform:translateY(10px) scale(.98)}to{opacity:1;transform:translateY(0) scale(1)}}
.dash-top{display:flex;align-items:center;gap:12px}
.dash-score-ring{width:60px;height:60px;min-width:60px;border-radius:50%;background:conic-gradient(var(--accent) calc(var(--pct)*1%),var(--line) 0);display:flex;align-items:center;justify-content:center;position:relative;animation:ringGrow .7s cubic-bezier(.22,1,.36,1)}
@keyframes ringGrow{from{transform:scale(.5);opacity:0}to{transform:scale(1);opacity:1}}
.dash-stats-row .dash-stat{opacity:0;animation:dashBadgeIn .4s cubic-bezier(.22,1.4,.36,1) forwards;animation-delay:calc(var(--si,0)*80ms + .15s)}
.dash-stats-row .dash-stat:nth-child(1){--si:0}.dash-stats-row .dash-stat:nth-child(2){--si:1}.dash-stats-row .dash-stat:nth-child(3){--si:2}
.dash-score-ring::before{content:'';position:absolute;inset:5px;border-radius:50%;background:var(--surface)}
.dash-score-ring b{position:relative;font-size:.8rem;font-weight:900;color:var(--ink);line-height:1}
.dash-score-ring span{position:relative;font-size:.36rem;color:var(--muted);margin-top:1px}
.dash-score-ring b,.dash-score-ring span{display:block;text-align:center}
.dash-top-copy{flex:1;min-width:0}
.dash-top-copy>b{font-size:.68rem;font-weight:900;color:var(--ink);display:block}
.dash-top-copy>p{font-size:.5rem;color:var(--accent);margin-top:2px;font-weight:700}
.dash-badges{display:flex;flex-wrap:wrap;gap:5px;margin-top:6px}
.dash-badge{display:flex;align-items:center;gap:3px;font-size:.42rem;font-weight:800;color:var(--ink);background:var(--accent-soft);border-radius:999px;padding:3px 7px;position:relative;overflow:hidden;opacity:0;transform:translateY(4px) scale(.9);animation:dashBadgeIn .45s cubic-bezier(.22,1.4,.36,1) forwards;animation-delay:calc(var(--i,0)*90ms)}
.dash-badge:nth-child(2){background:var(--accent2-soft)}
.dash-badge:nth-child(2) svg{color:var(--accent2)}
.dash-badge:nth-child(3){background:var(--tone-blue-soft)}
.dash-badge:nth-child(3) svg{color:var(--tone-blue)}
.dash-badge:nth-child(1){--i:0}.dash-badge:nth-child(2){--i:1}.dash-badge:nth-child(3){--i:2}
.dash-badge::after{content:'';position:absolute;inset:0;background:linear-gradient(100deg,transparent 30%,rgba(255,255,255,.5) 45%,transparent 60%);background-size:220% 100%;background-position:150% 0;animation:dashBadgeShine 2.6s ease-in-out .6s infinite}
.dash-badge svg{width:9px;height:9px;color:var(--accent);position:relative;z-index:1}
.dash-badge span,.dash-badge{position:relative}
@keyframes dashBadgeIn{to{opacity:1;transform:translateY(0) scale(1)}}
@keyframes dashBadgeShine{0%{background-position:150% 0}30%,100%{background-position:-50% 0}}
.dash-stats-row{display:grid;grid-template-columns:repeat(3,1fr);gap:6px;margin-top:12px;padding-top:12px;border-top:1px solid var(--line)}
.dash-stat{text-align:center}
.dash-stat b{display:block;font-size:.78rem;font-weight:900}
.dash-stat span{font-size:.42rem;color:var(--muted);font-weight:700}
.dash-stat.tone-a b{color:var(--tone-mint)}
.dash-stat.tone-b b{color:var(--accent2)}
.dash-stat.tone-c b{color:var(--tone-blue)}
.dash-skills{margin-top:12px;padding-top:12px;border-top:1px solid var(--line)}
.dash-skills>b{font-size:.56rem;font-weight:900;color:var(--ink);display:block;margin-bottom:8px}
.dash-skill-row{display:flex;align-items:center;justify-content:space-between;margin-bottom:6px}
.dash-skill-row:last-child{margin-bottom:0}
.dash-skill-row>span{font-size:.54rem;font-weight:700;color:var(--ink)}
.dash-stars{display:flex;gap:1px;direction:ltr}
.dash-stars i{font-style:normal;font-size:.6rem;color:var(--line-strong)}
.dash-stars i.on{color:var(--accent2)}
.home-msg-rail{display:flex;flex-direction:column;gap:8px}
.home-msg-card{display:flex;align-items:center;gap:10px;border:1px solid var(--line);background:var(--surface);border-radius:15px;padding:10px;cursor:pointer}
.home-msg-copy{flex:1;min-width:0}
.home-msg-copy>b{display:flex;align-items:center;gap:6px;font-size:.6rem;font-weight:800;color:var(--ink)}
.home-msg-copy>p{font-size:.52rem;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-top:3px}
.home-msg-badge{min-width:16px;height:16px;padding:0 5px;border-radius:99px;background:var(--accent);color:var(--on-accent);font-size:.42rem;font-weight:900;display:flex;align-items:center;justify-content:center}
.home-msg-time{font-size:.44rem;color:var(--muted);flex:none}
.home-activity-rail{display:flex;flex-direction:column;gap:8px}
.home-activity-card{display:flex;align-items:center;gap:10px;border:1px solid var(--line);background:var(--surface);border-radius:15px;padding:10px;cursor:pointer;overflow:hidden;max-height:80px;transition:max-height .26s ease,opacity .26s ease,padding .26s ease,margin .26s ease,transform .26s ease}
.home-activity-card .ricon{width:34px;height:34px;min-width:34px;border-radius:11px;background:var(--accent-soft);color:var(--accent);display:flex;align-items:center;justify-content:center}
.home-activity-card.tone-b .ricon{background:var(--tone-blue-soft);color:var(--tone-blue)}
.home-activity-card.tone-c .ricon{background:var(--accent2-soft);color:var(--accent2)}
.home-activity-card .rcopy{flex:1;min-width:0}
.home-activity-card .rcopy b{display:block;font-size:.6rem;font-weight:800;color:var(--ink);margin:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.home-activity-card .rcopy p{font-size:.51rem;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin:3px 0 0}
.activity-dismiss{width:26px;height:26px;min-width:26px;border-radius:9px;border:1px solid var(--line-strong);background:var(--surface2);color:var(--muted);display:flex;align-items:center;justify-content:center;cursor:pointer}
.activity-dismiss:active{transform:scale(.88)}
.activity-leave{max-height:0!important;opacity:0!important;padding-top:0!important;padding-bottom:0!important;margin-bottom:-8px!important;transform:scale(.9)!important;border-width:0;pointer-events:none}
.delivery-day-row{display:flex;flex-wrap:wrap;gap:6px}
.delivery-day-chip{font-family:inherit;font-size:.54rem;font-weight:800;padding:8px 12px;border-radius:11px;border:1px solid var(--line-strong);background:var(--surface);color:var(--ink);cursor:pointer}
.delivery-day-chip.active{border-color:var(--accent);background:var(--accent);color:var(--on-accent)}
.delivery-slot-row{display:flex;flex-wrap:wrap;gap:6px}
.delivery-slot-chip{font-family:inherit;font-size:.52rem;font-weight:800;padding:8px 10px;border-radius:11px;border:1px dashed var(--line-strong);background:var(--surface);color:var(--ink);cursor:pointer}
.delivery-slot-chip.active{border-style:solid;border-color:var(--accent);background:var(--accent);color:var(--on-accent)}
.delivery-slot-chip.booked{opacity:.4;text-decoration:line-through;cursor:not-allowed}

.verify-badge{display:inline-flex;align-items:center;gap:4px;font-size:.48rem;font-weight:800;color:var(--accent);background:var(--accent-soft);padding:3px 8px;border-radius:8px}
.tier-badge{display:inline-flex;font-size:.48rem;font-weight:800;color:var(--accent2);background:var(--accent2-soft);padding:3px 8px;border-radius:8px}
.badge-row{display:flex;gap:6px;justify-content:center;flex-wrap:wrap;margin-top:8px}

.dock{position:absolute;right:0;left:0;bottom:0;padding:14px 20px 20px;background:linear-gradient(0deg,var(--bg) 65%,transparent)}
.reviewrow{display:flex;justify-content:space-between;gap:10px;padding:7px 0;border-bottom:1px solid var(--line);font-size:.6rem}
.reviewrow:last-child{border-bottom:0}
.reviewrow span:first-child{color:var(--muted);flex:none}
.reviewrow span:last-child{color:var(--ink);font-weight:700;text-align:left}

@keyframes badgeFloat{0%,100%{transform:translateY(0)}50%{transform:translateY(-2px)}}
@keyframes voicePulse{0%,100%{transform:scale(1)}50%{transform:scale(.9)}}
@media (prefers-reduced-motion:reduce){.nav-badge{animation:none}.quick-btn{transition:none}}

/* Theme contrast safety: every decorative tone follows the active palette. */
.conversation-card.unread{border-color:color-mix(in srgb,var(--accent) 38%,transparent)}
.home-primary,.trust-card{border-color:color-mix(in srgb,var(--accent) 34%,transparent)}
.calendar-summary,.publish-hero,.chat-only-card,.shared-phone{border-color:color-mix(in srgb,var(--accent) 28%,transparent)}
.fixed-ad-title,.profile-source-card,.notify-preview{border-color:color-mix(in srgb,var(--accent) 30%,transparent)}
.ad-detail-section.profile-context{border-color:color-mix(in srgb,var(--accent) 25%,transparent)}
.agreement-card{border-color:color-mix(in srgb,var(--accent) 34%,transparent)}
.publish-route-note{border-color:color-mix(in srgb,var(--accent2) 28%,transparent)}
.home-primary-icon{background:linear-gradient(145deg,var(--accent),color-mix(in srgb,var(--accent) 82%,#0A1420));color:var(--on-accent)}
.home-opportunity-card.orange{--job-tone:var(--accent2)}
.home-opportunity-card.mint{--job-tone:var(--tone-mint)}
.home-opportunity-card.violet{--job-tone:var(--tone-violet)}
.home-opportunity-card.blue{--job-tone:var(--tone-blue)}
.profile-source-card.missing>i{color:var(--on-warm)}
[data-mode="light"] .explore-search,[data-mode="light"] .explore-feature,[data-mode="light"] .bottom-nav{box-shadow:0 12px 28px rgba(18,38,34,.09)}
[data-mode="light"] .explore-feature-meta span{background:rgba(18,38,34,.035)}

@media (max-width:520px){
  html,body{width:100%;height:100%;background:var(--bg)}
  body{padding:0;align-items:stretch;justify-content:stretch}
  .phone{width:100vw;height:100dvh;max-height:none;border-radius:0;box-shadow:none}
  .statusbar{padding-top:env(safe-area-inset-top);height:calc(30px + env(safe-area-inset-top))}
  #view{top:calc(30px + env(safe-area-inset-top))}
  .bottom-nav{bottom:max(10px,env(safe-area-inset-bottom))}
}
</style>
</head>
<body>
<div class="phone" data-mode="light" data-contrast="high" id="phone">
  <div class="statusbar">
