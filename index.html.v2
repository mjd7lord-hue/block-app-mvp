function portfolioCollectionFor(sourceCollectionKey,sourceField){
  return {
    label:"نمونه‌کارها",
    singular:"نمونه‌کار",
    addLabel:"افزودن نمونه‌کار",
    icon:"portfolio",
    imageLabel:"این بخش فقط برای نمایش یک کار واقعی و انجام‌شده است؛ ثبت آن اختیاری است.",
    emptyHint:"هنوز نمونه‌کاری اضافه نکرده‌اید. اگر فعلاً عکس یا پروژه‌ای برای نمایش ندارید، می‌توانید این مرحله را رد کنید.",
    titleKey:"title",
    summaryKeys:["skill","city","year"],
    requiredKeys:["title"],
    fields:[
      {key:"title",label:"عنوان نمونه‌کار",placeholder:"مثلاً اجرای نمای خشک مجتمع ساحل"},
      {key:"skill",label:"این نمونه‌کار مربوط به کدام مهارت یا خدمت است؟",sourceCollection:sourceCollectionKey||"skills",sourceField:sourceField||"name",allowCustom:true,placeholder:"مهارت یا خدمت را انتخاب کنید یا بنویسید"},
      {key:"city",label:"محل انجام کار",placeholder:"شهر یا منطقه",optional:true},
      {key:"year",label:"سال انجام",placeholder:"مثلاً 1404",ltr:true,optional:true},
      {key:"description",label:"توضیح کوتاه",placeholder:"نقش شما و کاری که انجام دادید",optional:true},
      {kind:"photo",key:"image",label:"عکس نمونه‌کار",optional:true}
    ],
    seeds:[]
  };
}

