function latinDigits(value){return String(value||'').replace(/[۰-۹]/g,function(char){return '۰۱۲۳۴۵۶۷۸۹'.indexOf(char)})}
function ageFromBirthDate(value){var year=parseInt(latinDigits(value).slice(0,4),10);return year>1200&&year<1406?(1405-year)+' سال':''}
function defaultRoleSkills(role){
  var schema=roleSchemas[role]||roleSchemas.worker,col=schema.collections&&schema.collections[schema.primaryCollection],items=col&&col.seeds||[];
  return uniqueText(items.map(function(item){return item[col.titleKey]})).slice(0,4);
}
function myTrustPerson(role){
  var schema=roleSchemas[role],org=['company','store','machinery'].indexOf(role)>-1,skills=profileAdCategories();if(!skills.length)skills=defaultRoleSkills(role);
  var rating=parseFloat((schema.stats&&schema.stats[0]&&schema.stats[0][0])||'4.6')||4.6;
  var prefs=getAccountPrefs(),birthPlace=state.values.foreignNational?(state.values.birthCountry||'کشور ثبت‌نشده'):(state.values.birthProvince||state.values.quickCity||schema.location.split('·')[0].split('،')[0]);
  var age=org?(state.values.foundedYear?'فعال از '+state.values.foundedYear:'سابقه مجموعه'):(ageFromBirthDate(state.values.birthDate)||({worker:'۳۴ سال',specialist:'۳۸ سال',engineer:'۴۱ سال',contractor:'۴۳ سال',general:'۳۶ سال'}[role]||'ثبت‌نشده'));
  return {name:displayNameFor(role),role:schema.profileTitle||schema.label,initials:schema.initials,location:displayCityFor(role),rating:rating,completed:myCompletedCount(role),verified:state.profileComplete,entityType:org?'organization':'person',age:prefs.publicAge?age:'خصوصی',birthPlace:prefs.publicBirthPlace?(birthPlace||'ثبت‌نشده'):'خصوصی',phone:prefs.publicPhone?chatPhoneNumber():'',experience:profileExperienceSummary()||({worker:'بیش از ۳ سال',specialist:'۵ تا ۱۰ سال',engineer:'۱۲ سال',contractor:'بیش از ۱۰ سال',company:'۱۱ سال',machinery:'بیش از ۱۰ سال',store:'۱۳ سال فعالیت',general:'۴ سال فعالیت پروژه‌ای'}[role]||'ثبت‌نشده'),activityRange:state.values.activityRadius||'ثبت‌نشده',skills:skills,skillDetails:profileSkillDetails(),reviews:cloneData(MY_REVIEW_SEED[role]||[])};
}
function blockTrustScore(person){
  var rating=Math.max(0,Math.min(5,Number(person.rating)||0)),completed=Math.max(0,Number(person.completed)||0),reviews=(person.reviews||[]).length;
  return Math.min(100,Math.round(rating/5*55+Math.min(completed,40)/40*25+Math.min(reviews,5)/5*10+(person.verified?10:0)));
}
function trustTier(score){if(score>=90)return 'اعتبار عالی';if(score>=78)return 'همکار قابل اعتماد';if(score>=62)return 'سابقهٔ رو به رشد';return 'عضو تازهٔ بلوک'}
function trustStatus(status){var labels={pending:'در انتظار پاسخ',accepted:'تأیید شده',declined:'رد شده'},ic=status==='accepted'?'check':status==='declined'?'alert':'calendar';return '<span class="status-icon '+status+'">'+icon(ic,10)+esc(labels[status]||status)+'</span>'}
function renderPublicTrustCard(person,personId){
  if(!person)return '';
  var score=blockTrustScore(person),reviews=person.reviews||[],skills=person.skills||[],org=person.entityType==='organization',latest=reviews[0],action=personId==='ad'?'openAdTrustCard()':"openTrustCard('"+personId+"')",actionButton=state.page==='trustCard'?'':'<button class="trust-card-action" onclick="'+action+'">دیدن کارت کامل، '+reviews.length+' نظر و جزئیات اعتبار ‹</button>';
  var canRequest=personId&&personId!=='self'&&personId!=='ad'&&!isBlocked(personId);
  var skillChips=skills.slice(0,4).map(function(skill){
    var safe=String(skill).replace(/'/g,"\\'");
    return canRequest?'<span class="skill-tap" onclick="openTargetedProject(\''+personId+'\',\''+safe+'\')">'+esc(skill)+'<i>‹</i></span>':'<span>'+esc(skill)+'</span>';
  }).join('');
  return '<section class="trust-card"><div class="trust-card-head"><div class="avatar">'+esc(person.initials||'ب')+'</div><div class="trust-card-person"><b>'+esc(person.name||'کاربر بلوک')+(person.verified?'<i class="trust-verified" aria-label="هویت تأییدشده">'+icon('check',10)+'</i>':'')+'</b><p>'+esc(person.role||'عضو بلوک')+' · '+esc(person.location||'')+'</p></div><div class="trust-score"><strong>'+score+'</strong><span>اعتبار از ۱۰۰</span></div></div><div class="trust-tier"><b>'+trustTier(score)+'</b><span>براساس سابقهٔ واقعی در بلوک</span></div><div class="trust-facts"><div class="trust-fact"><span>'+(org?'قدمت مجموعه':'سن')+'</span><b>'+esc(person.age||'ثبت‌نشده')+'</b></div><div class="trust-fact"><span>'+(org?'محل ثبت':'محل تولد')+'</span><b>'+esc(person.birthPlace||'ثبت‌نشده')+'</b></div><div class="trust-fact"><span>سابقهٔ کلی</span><b>'+esc(person.experience||'ثبت‌نشده')+'</b></div><div class="trust-fact"><span>محدودهٔ فعالیت</span><b>'+esc(person.activityRange||'ثبت‌نشده')+'</b></div><div class="trust-fact"><span>پروژهٔ تکمیل‌شده در بلوک</span><b>'+esc(person.completed||0)+' پروژه</b></div>'+(person.phone?'<div class="trust-fact"><span>شمارهٔ تماس</span><b dir="ltr" style="unicode-bidi:plaintext">'+esc(person.phone)+'</b></div>':'')+'</div>'+(skills.length?'<div class="trust-skills-label"><i>'+icon('wrench',12)+'</i>مهارت‌های اصلی'+(canRequest?'<em>برای درخواست لمس کنید</em>':'')+'</div><div class="trust-skills">'+skillChips+'</div>':'')+(latest?'<div class="trust-comment"><i>'+icon('message',13)+'</i><p>«'+esc(latest.comment)+'» · '+esc(latest.from)+'</p></div>':'<div class="trust-comment"><i>'+icon('message',13)+'</i><p>هنوز نظری برای این حساب ثبت نشده است.</p></div>')+actionButton+'<div class="trust-card-brand"><i class="hexlogo-mini"><b></b></i><span>صادرشده و تأییدشده در <strong>بلوک</strong></span></div></section>';
}
function openTrustCard(id){state.trustPersonId=id;go('trustCard')}
function openAdTrustCard(){state.trustPersonId='ad';go('trustCard')}
function adTrustPerson(ad){var profile=ad&&ad.profile||{};return {name:profile.name||'کاربر بلوک',role:profile.profileTitle||profile.roleLabel||'عضو بلوک',initials:profile.initials||'ب',location:profile.city||ad.city||'',rating:profile.rating||4.5,completed:profile.completed||0,verified:!!profile.verified,age:profile.age||'ثبت‌نشده',birthPlace:profile.birthPlace||profile.city||'ثبت‌نشده',experience:profile.experience||'ثبت‌نشده',skills:profile.categories||ad.categories||[],skillDetails:profile.skillDetails||[],reviews:profile.reviews||[]}}
function currentTrustPerson(){if(state.trustPersonId==='self')return myTrustPerson(state.role||'worker');if(state.trustPersonId==='ad')return adTrustPerson(currentAdDetail());return PEOPLE_SEED[state.trustPersonId]||myTrustPerson(state.role||'worker')}
function openPersonProfile(id){state.viewingPerson=id;go('viewProfile')}
function renderPortfolioCards(items){
  if(!items||!items.length)return '<p style="font-size:.58rem">نمونه‌کاری ثبت نشده است.</p>';
  return '<div class="portfolio-grid">'+items.map(function(it){
    var thumb=it.image?'<div class="portfolio-thumb" style="background-image:url('+it.image+');background-size:cover;background-position:center"></div>':'<div class="portfolio-thumb" style="background:'+(it.color||'var(--accent)')+'">'+icon('portfolio',22)+'</div>';
    return '<div class="portfolio-card">'+thumb+'<b>'+esc(it.title)+'</b><span>'+esc(it.city||'')+'</span></div>';
  }).join('')+'</div>';
}
function openTargetedProject(personId,prefillTitle){
  state.projectTarget=personId;
  state.projectDraft=prefillTitle?{title:prefillTitle}:{};
  go('postProject');
}
function openBookingRequestSheet(personId,slotIdx){
  var p=PEOPLE_SEED[personId],slot=p.slots[slotIdx];
  state.bookingRequestDraft={note:''};
  var requestLabel=p.requestKind==='service'?'درخواست خدمت':'درخواست رزرو';
  var html='<h3>'+requestLabel+'</h3><p>'+esc(p.name)+' · '+esc(slot)+'</p><div class="field"><label>یادداشت (اختیاری)</label><textarea class="textarea" oninput="state.bookingRequestDraft.note=this.value" placeholder="توضیح کوتاه دربارهٔ نیاز شما…"></textarea></div><button class="btn-primary" onclick="confirmBookingRequest(\''+personId+'\','+slotIdx+')">ارسال '+requestLabel+'</button>';
  openSheet(html);
}
function confirmBookingRequest(personId,slotIdx){
  var p=PEOPLE_SEED[personId],slot=p.slots[slotIdx];
  var requestLabel=p.requestKind==='service'?'درخواست خدمت':'درخواست رزرو';
  var title=requestLabel+' · '+slot,projects=getProjects(state.role);
  if(projects.some(function(project){return project.title===title&&project.who===p.name})){closeSheet();toast('این درخواست قبلاً ارسال شده است');return}
  projects.push({title:title,who:p.name,personId:personId,stage:'proposed',rating:0,direction:'outgoing'});
  addOutgoingRequest('calendar',title,p.name,state.bookingRequestDraft.note||'در انتظار پاسخ');
  getNotifications().unshift({title:'درخواست هماهنگی ارسال شد',sub:p.name+' · '+slot,time:'همین حالا',day:'امروز',read:false,icon:'calendar',type:'project',target:'myProjects',action:'پیگیری درخواست'});
  closeSheet();render();toast(requestLabel+' برای '+p.name+' ارسال شد');
}
function openProductOrderSheet(personId,prodIdx){
  var p=PEOPLE_SEED[personId],prod=p.products[prodIdx];
  state.orderDraft={qty:''};
  var html='<h3>سفارش '+esc(prod.name)+'</h3><p>'+esc(prod.price)+' / '+esc(prod.unit)+'</p><div class="field"><label>تعداد یا مقدار</label><input class="input" oninput="state.orderDraft.qty=this.value" placeholder="مثلاً ۲۰ کیسه"></div><button class="btn-primary" onclick="confirmProductOrder(\''+personId+'\','+prodIdx+')">ثبت درخواست سفارش</button>';
  openSheet(html);
}
function confirmProductOrder(personId,prodIdx){
  var p=PEOPLE_SEED[personId],prod=p.products[prodIdx];
  var q=state.orderDraft.qty;
  var title='سفارش '+prod.name+(q?' · '+q:'');
  getProjects(state.role).push({title:title,who:p.name,personId:personId,stage:'proposed',rating:0,direction:'outgoing'});
  addOutgoingRequest('order',title,p.name,prod.price+' / '+prod.unit);
  closeSheet();render();toast('درخواست سفارش برای '+p.name+' ارسال شد');
}
/* Appointment-based delivery booking for supplier companies (concrete, تیرچه ...): qty/spec + location + a real day+time slot picked from the supplier's calendar. */
var DELIVERY_TIME_SLOTS=['۸:۰۰ - ۱۰:۰۰','۱۰:۰۰ - ۱۲:۰۰','۱۴:۰۰ - ۱۶:۰۰','۱۶:۰۰ - ۱۸:۰۰'];
function deliveryCalendarDays(personId){
  if(!state.supplierCalendar)state.supplierCalendar={};
  if(!state.supplierCalendar[personId]){
    state.supplierCalendar[personId]=[0,1,2,3,4,5].map(function(i){
      return {label:(12+i)+' مرداد',slots:DELIVERY_TIME_SLOTS.map(function(s,si){return {time:s,status:(i===0&&si===0)||(i===2&&si===2)?'booked':'available'}})};
    });
  }
  return state.supplierCalendar[personId];
}
function openDeliveryRequestSheet(personId,prodIdx){
  var p=PEOPLE_SEED[personId],prod=p.products[prodIdx];
  state.orderDraft={qty:'',location:'',dayIdx:0,slotIdx:null};
  renderDeliverySheet(personId,prodIdx);
}
function renderDeliverySheet(personId,prodIdx){
  var p=PEOPLE_SEED[personId],prod=p.products[prodIdx],draft=state.orderDraft,days=deliveryCalendarDays(personId);
  var dayChips=days.map(function(d,i){return '<button class="delivery-day-chip'+(draft.dayIdx===i?' active':'')+'" onclick="selectDeliveryDay(\''+personId+'\','+prodIdx+','+i+')">'+esc(d.label)+'</button>'}).join('');
  var slots=days[draft.dayIdx].slots;
  var slotChips=slots.map(function(s,i){
    var cls=s.status==='booked'?'delivery-slot-chip booked':'delivery-slot-chip'+(draft.slotIdx===i?' active':'');
    return '<button class="'+cls+'" '+(s.status==='booked'?'disabled':'onclick="selectDeliverySlot(\''+personId+'\','+prodIdx+','+i+')"')+'>'+esc(s.time)+(s.status==='booked'?' · پر':'')+'</button>';
  }).join('');
  var html='<h3>رزرو نوبت: '+esc(prod.name)+'</h3><p>'+esc(prod.price)+' / '+esc(prod.unit)+'</p>'
  +'<div class="field"><label>'+esc(prod.qtyLabel||'تعداد یا مقدار')+'</label><input class="input" id="deliveryQty" value="'+esc(draft.qty)+'" oninput="state.orderDraft.qty=this.value" placeholder="'+esc(prod.qtyPlaceholder||'مثلاً ۲۰ کیسه')+'"></div>'
  +(prod.needsLocation?'<div class="field"><label>محل تحویل</label><input class="input" id="deliveryLoc" value="'+esc(draft.location)+'" oninput="state.orderDraft.location=this.value" placeholder="مثلاً قشم، فاز ۲، پلاک ۱۴"></div>':'')
  +'<div class="field"><label>روز تحویل</label><div class="delivery-day-row">'+dayChips+'</div></div>'
  +'<div class="field"><label>ساعت تحویل</label><div class="delivery-slot-row">'+slotChips+'</div></div>'
  +'<button class="btn-primary" onclick="confirmDeliveryOrder(\''+personId+'\','+prodIdx+')">ثبت و رزرو نوبت</button>';
  openSheet(html);
}
function selectDeliveryDay(personId,prodIdx,dayIdx){state.orderDraft.dayIdx=dayIdx;state.orderDraft.slotIdx=null;renderDeliverySheet(personId,prodIdx)}
function selectDeliverySlot(personId,prodIdx,slotIdx){state.orderDraft.slotIdx=slotIdx;renderDeliverySheet(personId,prodIdx)}
function confirmDeliveryOrder(personId,prodIdx){
  var p=PEOPLE_SEED[personId],prod=p.products[prodIdx],draft=state.orderDraft,days=deliveryCalendarDays(personId);
  if(!draft.qty){toast(prod.qtyLabel||'مقدار را وارد کنید');return}
  if(prod.needsLocation&&!draft.location){toast('محل تحویل را وارد کنید');return}
  if(draft.slotIdx===null||draft.slotIdx===undefined){toast('یک ساعت تحویل را انتخاب کنید');return}
  var day=days[draft.dayIdx],slot=day.slots[draft.slotIdx];
  slot.status='booked';
  var title='سفارش '+prod.name+' · '+draft.qty+(draft.location?' · '+draft.location:'')+' · '+day.label+' '+slot.time;
  getProjects(state.role).push({title:title,who:p.name,personId:personId,stage:'proposed',rating:0,direction:'outgoing'});
  addOutgoingRequest('order',title,p.name,prod.price+' / '+prod.unit);
  closeSheet();render();toast('نوبت تحویل برای '+day.label+'، '+slot.time+' رزرو شد');
}
function reviewStars(n){var out='';for(var i=1;i<=5;i++)out+='<svg class="star" style="width:11px;height:11px;color:'+(i<=n?'var(--accent2)':'var(--line-strong)')+'" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.1 6.3 6.9 1-5 4.9 1.2 6.9-6.2-3.3-6.2 3.3 1.2-6.9-5-4.9 6.9-1z"/></svg>';return '<div style="display:flex;gap:2px;direction:ltr">'+out+'</div>'}
function renderReviews(reviews){
  if(!reviews||!reviews.length)return '<p style="font-size:.58rem">هنوز نظری ثبت نشده است.</p>';
  return reviews.map(function(r){return '<div class="card" style="margin-bottom:8px"><div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:4px"><b style="font-size:.62rem">'+esc(r.from)+'</b>'+reviewStars(r.rating)+'</div><p style="font-size:.58rem;line-height:1.7">'+esc(r.comment)+'</p><span style="font-size:.48rem;color:var(--muted);display:block;margin-top:4px">'+esc(r.date)+'</span></div>'}).join('');
}

/* ---------- report / block ---------- */
function isBlocked(id){return state.blockedUsers.indexOf(id)>-1}
function openReportSheet(personId){
  state.reportDraft={personId:personId,reason:'',note:''};
  renderReportSheet();
}
function setReportReason(r){state.reportDraft.reason=r;renderReportSheet()}
function setReportNote(v){state.reportDraft.note=v}
function renderReportSheet(){
  var id=state.reportDraft.personId;
  var reasons=['رفتار نامناسب','کلاهبرداری یا کالای غیرواقعی','اسپم یا تبلیغ نامرتبط','سایر'];
  var chips=reasons.map(function(r){return '<div class="chip'+(state.reportDraft.reason===r?' active':'')+'" onclick="setReportReason(\''+r+'\')">'+r+'</div>'}).join('');
  var html='<h3>گزارش کاربر</h3><p>دلیل گزارش را انتخاب کنید.</p><div class="chip-row" style="margin-bottom:12px">'+chips+'</div><div class="field"><textarea class="textarea" oninput="setReportNote(this.value)" placeholder="توضیح بیشتر (اختیاری)"></textarea></div><button class="btn-primary" onclick="submitReport()">ارسال گزارش</button><div style="height:8px"></div><button class="btn-secondary" style="color:var(--danger);border-color:var(--danger)" onclick="toggleBlock(\''+id+'\')">'+(isBlocked(id)?'لغو مسدودیت این کاربر':'مسدودکردن این کاربر')+'</button>';
  openSheet(html);
}
function submitReport(){
  if(!state.reportDraft.reason){toast('لطفاً دلیل گزارش را انتخاب کنید');return}
  closeSheet();toast('گزارش شما ثبت شد و بررسی می‌شود');
}
function toggleBlock(id){
  var i=state.blockedUsers.indexOf(id);
  if(i>-1)state.blockedUsers.splice(i,1);else state.blockedUsers.push(id);
  closeSheet();render();toast(i>-1?'مسدودیت لغو شد':'این کاربر مسدود شد');
}


function go(page){state.stack.push(state.page);if(typeof PAGES!=='undefined'&&PAGES[page])state.page=page;else{state.unavailableTarget=page;state.page='unavailable'}render()}
function back(){state.page=state.stack.pop()||'splash';render()}
function toast(msg){var t=document.getElementById('toast');t.textContent=msg;t.classList.add('show');clearTimeout(window._tt);window._tt=setTimeout(function(){t.classList.remove('show')},1800)}
function openSheet(html){var s=document.getElementById('sheet');s.innerHTML=html;s.setAttribute('aria-hidden','false');s.inert=false;document.getElementById('backdrop').classList.add('show');s.classList.add('show')}
function closeSheet(){var s=document.getElementById('sheet');document.getElementById('backdrop').classList.remove('show');s.classList.remove('show');s.setAttribute('aria-hidden','true');s.inert=true}
function setMode(m){state.mode=m;document.getElementById('phone').setAttribute('data-mode',m);document.getElementById('modeBtn').innerHTML=icon(m==='dark'?'moon':'sun',13);try{localStorage.setItem('block-mode',m)}catch(e){}render()}
function toggleModeQuick(){setMode(state.mode==='dark'?'light':'dark');toast(state.mode==='dark'?'حالت تیره فعال شد':'حالت روشن فعال شد')}
function openDataPage(page,label){
  if(!state.online){state.unavailableTarget=page;go('offline');return}
  state.loadingTarget=page;state.loadingLabel=label||'در حال دریافت اطلاعات';state.stack.push(state.page);state.page='loading';render();clearTimeout(window._loadPageTimer);window._loadPageTimer=setTimeout(function(){state.page=page;state.loadingTarget=null;render()},420);
}
function retryConnection(){state.online=typeof navigator==='undefined'?true:navigator.onLine!==false;if(state.online){var target=state.unavailableTarget&&PAGES[state.unavailableTarget]?state.unavailableTarget:'home';state.unavailableTarget=null;state.stack=[];state.page=target;render();toast('اتصال اینترنت برقرار شد')}else{render();toast('هنوز اتصال اینترنت برقرار نیست')}}
function openAccessDenied(title,message,backTarget){state.accessState={title:title,message:message,backTarget:backTarget||'home'};go('permissionDenied')}
function requestPermission(kind){
  var labels={location:'موقعیت مکانی',camera:'دوربین',microphone:'میکروفن',files:'فایل‌ها'};
  if(state.permissionPrefs[kind]==='denied'){openAccessDenied('دسترسی '+labels[kind]+' خاموش است','برای استفاده از این قابلیت، دسترسی '+labels[kind]+' را از تنظیمات دستگاه فعال کنید.','systemStatus');return}
  state.permissionPrefs[kind]='granted';render();toast('دسترسی '+labels[kind]+' فعال شد');
}
function renderNetworkBanner(){return state.online?'':'<div class="network-banner">'+icon('alert',13)+'<span>اینترنت قطع است؛ تغییرات روی این دستگاه نگه داشته می‌شود.</span><button onclick="go(\'offline\')">بررسی</button></div>'}

function topbar(title,sub,onBack){return '<div class="topbar"><button class="backbtn" aria-label="بازگشت" onclick="'+(onBack||'back()')+'">'+icon('back',16)+'</button><div class="topbar-title"><b>'+esc(title)+'</b>'+(sub?'<span>'+esc(sub)+'</span>':'')+'</div></div>'}
function topbarWithAction(title,sub,onBack,actionHtml){return '<div class="topbar"><button class="backbtn" aria-label="بازگشت" onclick="'+(onBack||'back()')+'">'+icon('back',16)+'</button><div class="topbar-title"><b>'+esc(title)+'</b>'+(sub?'<span>'+esc(sub)+'</span>':'')+'</div>'+actionHtml+'</div>'}
function ensureSavedPeople(){if(!state.savedPeople)state.savedPeople=[];return state.savedPeople}
function isSaved(id){return ensureSavedPeople().indexOf(id)>-1}
function toggleSaved(id){
  var list=ensureSavedPeople(),idx=list.indexOf(id);
  if(idx>-1){list.splice(idx,1);toast('از علاقه‌مندی‌ها حذف شد')}
  else{list.unshift(id);toast('به علاقه‌مندی‌ها اضافه شد')}
  render();
}

function bottomNav(active){
  var isBusiness=BUSINESS_ROLES.indexOf(state.role)>-1;
  var addItem=isBusiness?['myProducts','plus','افزودن']:['newRequest','plus','ثبت'];
  var secondItem=isBusiness?['orders','truck','سفارش‌ها']:['explore','search','جست‌وجو'];
  var items=[['home','home','خانه'],secondItem,addItem,['messages','message','پیام‌ها'],['profile','user','من']];
  return '<div class="bottom-nav">'+items.map(function(i){
    var unread=i[0]==='messages'?unreadMessageCount():0,badge=unread?'<span class="nav-badge">'+unread+'</span>':'';
    var action=(i[0]==='explore'||i[0]==='messages')?"state.stack=[];openDataPage('"+i[0]+"','"+(i[0]==='explore'?'در حال آماده‌کردن نتایج مرتبط':'در حال دریافت پیام‌ها')+"')":"state.stack=[];go('"+i[0]+"')";
    return '<button class="nav-btn '+(active===i[0]?'active':'')+'" '+(active===i[0]?'aria-current="page"':'')+' aria-label="'+i[2]+'" onclick="'+action+'">'+badge+icon(i[1],21)+'<span>'+i[2]+'</span></button>';
  }).join('')+'</div>'
}
function progressDots(total,current){var out='';for(var i=0;i<total;i++)out+='<i class="'+(i<=current?'done':'')+'"></i>';return '<div class="progress">'+out+'</div>'}
function activeRole(){return roleSchemas[state.role||'worker']}
function tierLabel(completed){if(completed>=30)return 'همکار برتر';if(completed>=15)return 'همکار معتمد';return 'عضو بلوک'}
function myCompletedCount(role){
  var done=getProjects(role).filter(function(p){return p.stage==='done'}).length;
  var r=roleSchemas[role];
  var base=parseInt((r.stats&&r.stats[1]&&r.stats[1][0])||'0',10)||0;
  return base+done;
}
function displayNameFor(role){
  var fn=state.values.firstName,ln=state.values.lastName;
  if(fn||ln)return ((fn||'')+' '+(ln||'')).trim();
  return state.values.quickName||roleSchemas[role].name||'';
}
function displayCityFor(role){
  var city=state.values.workCity||state.values.city;
  if(city==='سایر')city=state.values.cityOther||city;
  return state.values.quickCity||city||state.values.activityCity||roleSchemas[role].location||'';
}
function renderMyAvatar(role){
  var schema=roleSchemas[role]||activeRole(),photo=state.values.profilePhoto;
  return '<div class="avatar">'+(photo?'<img src="'+photo+'" alt="عکس پروفایل">':esc(schema.initials||'ب'))+'</div>';
}
function profileSetupTasks(role){
  var tasks=[];
  if(!state.profileComplete)tasks.push({icon:'doc',title:'تکمیل اطلاعات اصلی',sub:'مهارت، سابقه و شهر',action:'startFullProfile()'});
  if(!state.values.profilePhoto)tasks.push({icon:'user',title:'افزودن عکس پروفایل',sub:'بعد از ثبت‌نام و بدون عجله',action:"go('profilePhoto')"});
  if(professionalJobRole(role)&&!state.portfolioSetupCompleted)tasks.push({icon:'portfolio',title:'افزودن نمونه‌کار',sub:'عکس یک کار واقعی انجام‌شده',action:"go('portfolio')"});
  return tasks;
}
function renderProfileSetupNudge(role){
  var tasks=profileSetupTasks(role);
  if(!tasks.length||state.dashboardSetupDismissed)return '';
  return '<section class="profile-setup-card"><div class="profile-setup-head"><i>'+icon('check',16)+'</i><div><b>پروفایل را کم‌کم کامل کنید</b><p>این کارها از ثبت‌نام جدا هستند و اجباری نیستند.</p></div><button onclick="dismissProfileSetup()">بعداً</button></div><div class="profile-setup-list">'+tasks.map(function(task){return '<button class="profile-setup-task" onclick="'+task.action+'"><i>'+icon(task.icon,15)+'</i><span><b>'+esc(task.title)+'</b><small>'+esc(task.sub)+'</small></span><em>‹</em></button>'}).join('')+'</div></section>';
}
function dismissProfileSetup(){state.dashboardSetupDismissed=true;render();toast('از بخش «من» هر زمان خواستید ادامه دهید')}
function saveProfilePhoto(){
  if(!state.values.profilePhoto){toast('ابتدا یک عکس انتخاب کنید');return}
  state.dashboardSetupDismissed=false;state.stack=[];state.page='home';render();toast('عکس پروفایل ذخیره شد');
}

/* ---------- account, settings & legal ---------- */
function settingsRow(ic,title,sub,action,danger){return '<button class="settings-row'+(danger?' danger':'')+'" onclick="'+action+'"><i class="settings-row-icon">'+icon(ic,16)+'</i><span class="settings-row-copy"><b>'+esc(title)+'</b><span>'+esc(sub||'')+'</span></span><span class="settings-row-arrow">‹</span></button>'}
function getAccountPrefs(){if(!state.accountPrefs)state.accountPrefs={publicProfile:true,onlineStatus:true,preciseLocation:false,activitySuggestions:true,publicAge:true,publicBirthPlace:true,publicPhone:false};return state.accountPrefs}
function toggleAccountPref(key){var prefs=getAccountPrefs();prefs[key]=!prefs[key];render()}
function toggleLegalConsent(){state.legalConsent=!state.legalConsent;state.legalError=false;render()}
function isLegalCurrent(){return !!state.legalAcceptedAt&&state.acceptedLegalVersion===LEGAL_VERSION}
function legalAcceptanceText(){return isLegalCurrent()?'پذیرفته‌شده · نسخهٔ '+esc(state.acceptedLegalVersion):'نیازمند پذیرش نسخهٔ فعلی'}
function acceptCurrentLegal(){state.legalConsent=true;state.legalAcceptedAt='همین حالا';state.acceptedLegalVersion=LEGAL_VERSION;render();toast('پذیرش نسخهٔ فعلی قوانین ثبت شد')}
function completeLogin(){closeSheet();state.stack=[];state.page=isLegalCurrent()?'home':'legalGate';render()}
function acceptLegalAndContinue(){if(!isLegalCurrent()&&!state.legalConsent){state.legalError=true;render();toast('پذیرش قوانین برای ورود لازم است');return}if(!isLegalCurrent()){state.legalAcceptedAt='همین حالا';state.acceptedLegalVersion=LEGAL_VERSION}state.stack=[];state.page='home';render()}
function setTextSize(value){state.textSize=value;document.documentElement.style.fontSize=value==='large'?'17.5px':value==='larger'?'19px':'16px';try{localStorage.setItem('block-text-size',value)}catch(e){}render()}
function toggleHighContrast(){state.highContrast=!state.highContrast;document.getElementById('phone').setAttribute('data-contrast',state.highContrast?'high':'normal');try{localStorage.setItem('block-high-contrast',state.highContrast?'true':'false')}catch(e){}render()}
function toggleReduceMotion(){state.reduceMotion=!state.reduceMotion;document.getElementById('phone').setAttribute('data-reduce-motion',state.reduceMotion?'true':'false');render()}
function toggleHelp(index){state.helpOpen=state.helpOpen===index?-1:index;render()}
function switchAccountRole(role){if(!roleSchemas[role])return;state.role=role;render();toast('نقش فعال به «'+roleSchemas[role].label+'» تغییر کرد')}
function openSupportChat(){var support=findConversation('block-support');if(support){openConversation('block-support');return}toast('گفت‌وگوی پشتیبانی در دسترس است')}
function openChangePhoneSheet(){state.phoneChangeDraft='';openSheet('<h3>تغییر شماره موبایل</h3><p>برای حفظ امنیت حساب، شمارهٔ جدید باید با کد یک‌بارمصرف تأیید شود.</p><div class="field"><label>شمارهٔ جدید</label><input id="newPhone" class="input" dir="ltr" placeholder="09xx xxx xxxx" oninput="state.phoneChangeDraft=this.value"></div><button class="btn-primary" onclick="savePhoneChange()">ارسال کد تأیید</button>')}
function savePhoneChange(){var value=(state.phoneChangeDraft||'').trim();if(value.length<10){toast('شماره موبایل معتبر وارد کنید');return}openSheet('<h3>تأیید شمارهٔ جدید</h3><p>کد ۴ رقمی ارسال‌شده به '+esc(value)+' را وارد کنید.</p><div class="otp-row"><input maxlength="1"><input maxlength="1"><input maxlength="1"><input maxlength="1"></div><button class="btn-primary" onclick="confirmPhoneChange()">تأیید و ذخیره</button>')}
function confirmPhoneChange(){state.values.signupPhone=state.phoneChangeDraft;closeSheet();render();toast('شمارهٔ جدید تأیید و ذخیره شد')}
function openIssueSheet(){state.appIssueDraft='';openSheet('<h3>گزارش مشکل در بلوک</h3><p>صفحه یا رفتاری را که مشکل دارد کوتاه توضیح دهید.</p><div class="field"><label>شرح مشکل</label><textarea class="textarea" placeholder="مثلاً در صفحهٔ ثبت آگهی…" oninput="state.appIssueDraft=this.value"></textarea></div><button class="btn-primary" onclick="submitAppIssue()">ارسال برای پشتیبانی</button>')}
function submitAppIssue(){if(!(state.appIssueDraft||'').trim()){toast('شرح مشکل را بنویسید');return}closeSheet();getNotifications().unshift({title:'گزارش شما ثبت شد',sub:'پشتیبانی بلوک نتیجهٔ بررسی را از همین بخش اطلاع می‌دهد',time:'همین حالا',day:'امروز',read:false,icon:'help',type:'account',target:'supportCenter',action:'پیگیری'});render();toast('گزارش برای پشتیبانی ارسال شد')}
function openLogoutSheet(){openSheet('<h3>خروج از حساب</h3><p>پس از خروج، برای ورود دوباره باید شمارهٔ موبایل خود را تأیید کنید.</p><button class="btn-primary" onclick="performLogout()">خروج از حساب</button><div style="height:8px"></div><button class="btn-secondary" onclick="closeSheet()">انصراف</button>')}
function performLogout(){closeSheet();state.stack=[];state.page='splash';render();toast('از حساب خارج شدید')}
function setDeleteReason(value){state.deleteReason=value;render()}
function toggleDeleteConfirm(){state.deleteConfirm=!state.deleteConfirm;render()}
function deleteAccount(){if(!state.deleteReason){toast('دلیل حذف حساب را انتخاب کنید');return}if(!state.deleteConfirm){toast('تأیید نهایی حذف حساب لازم است');return}var mode=state.mode,textSize=state.textSize;state.role=null;state.values={};state.collections={};state.projects={};state.notifications=null;state.notificationPrefs=null;state.conversations=null;state.messagePrefs=null;state.currentConversationId=null;state.portfolio={};state.guarantors={};state.accountPrefs=null;state.blockedUsers=[];state.profileComplete=false;state.dashboardSetupDismissed=false;state.portfolioSetupCompleted=false;state.legalConsent=false;state.legalAcceptedAt=null;state.acceptedLegalVersion=null;state.deleteConfirm=false;state.deleteReason='';state.stack=[];state.page='splash';state.mode=mode;state.textSize=textSize;render();toast('درخواست حذف حساب ثبت شد')}
function unblockUser(id){var index=state.blockedUsers.indexOf(id);if(index>-1)state.blockedUsers.splice(index,1);render();toast('مسدودیت کاربر لغو شد')}

/* ---------- role select ---------- */
function pickRole(k){state.role=k;render()}
function continueFromRoleSelect(){
  if(!state.role)return;
  if(state.role==='contractor'){go('contractorTypeChoice');return}
  startRegistration();
}
function pickContractorType(type){state.role=type;startRegistration()}
function startRegistration(){if(!state.role)return;state.otpStage='phone';go('phoneVerify')}
function submitPhoneStage(){
  if(!state.values.signupPhone){toast('شماره موبایل را وارد کنید');return}
  if(!state.legalConsent){state.legalError=true;render();toast('پذیرش قوانین و حریم خصوصی برای ساخت حساب لازم است');return}
  state.otpStage='code';render();
}
function confirmSignupOtp(){if(!state.legalConsent){state.legalError=true;state.otpStage='phone';render();return}state.legalAcceptedAt='همین حالا';state.acceptedLegalVersion=LEGAL_VERSION;state.otpStage='phone';go('pathChoice')}
function choosePathQuick(){state.values.quickName='';state.values.quickCity='';go('quickSetup')}
function choosePathFull(){state.step=0;state.editMode=false;state.collections={};state.stepWarnings={};go('regStep')}
function submitQuickSetup(){
  if(!state.values.quickName){toast('نام خود را وارد کنید');return}
  state.step=0;state.collections={};
  state.stack=[];state.page='setupDone';render();
}
function startFullProfile(){state.step=0;state.editMode=false;state.stepWarnings={};go('regStep')}
var PERSIAN_MONTHS=['فروردین','اردیبهشت','خرداد','تیر','مرداد','شهریور','مهر','آبان','آذر','دی','بهمن','اسفند'];
function formatJDate(v){
  if(!v||!v.day||!v.month||!v.year)return '';
  return v.day+' '+v.month+' '+v.year;
}
function formatControlValue(c){
  var v=state.values[c.key];
  if(c.kind==='phones')return (v||[]).filter(Boolean).join('، ');
  if(c.kind==='jdate')return formatJDate(v);
  if(c.kind==='toggle')return v?'بله':'';
  if(c.kind==='photo')return v?'عکس افزوده شد':'';
  if(Array.isArray(v))return v.join('، ');
  return v;
}
function stepSummary(step){
  if(step.collection){
    syncCollectionSelections(step.collection);
    var items=state.collections[step.collection]||[];
    var complete=items.filter(function(item){return isCollectionItemComplete(activeRole().collections[step.collection],item)}).length;
    return items.length?complete+' از '+items.length+' مورد کامل شده':'هنوز موردی اضافه نشده';
  }
  var parts=(step.controls||[]).map(formatControlValue).filter(Boolean);
  return parts.length?parts.join(' · '):'هنوز تکمیل نشده';
}
function openEditStep(idx){state.editMode=true;state.step=idx;go('regStep')}
function exitEditStep(){state.editMode=false;state.stack=[];go('editProfile')}
function saveEditStep(){
  var step=activeRole().steps[state.step];
  if(!validateRegistrationStep(step))return;
  exitEditStep();
}

/* ---------- registration engine ---------- */
function currentStepWarningKey(){return (state.role||'general')+':'+state.step}
function currentStepWarningsShown(){return !!state.stepWarnings[currentStepWarningKey()]}
function controlHasValue(key){
  var value=state.values[key];
  if(Array.isArray(value))return value.some(Boolean);
  if(value&&typeof value==='object')return Object.keys(value).every(function(part){return !!value[part]});
  return value!==undefined&&value!==null&&String(value).trim()!=='';
}
function effectiveRequiredKeys(col){var fieldKeys=(col.fields||[]).map(function(f){return f.key});return (col.requiredKeys||[]).filter(function(key){return fieldKeys.indexOf(key)>-1})}
function isCollectionItemComplete(col,item){return effectiveRequiredKeys(col).every(function(key){return !!item[key]})}
function controlIsActive(control){
  if(control.conditionalOn&&!state.values[control.conditionalOn])return false;
  if(control.disabledWhen&&state.values[control.disabledWhen])return false;
  return true;
}
function missingControlKeys(step){
  var controls=step.controls||[];
  var required=(step.requiredControls||[]).slice();
  controls.forEach(function(control){
    if(control.conditionalOn&&!control.optional&&required.indexOf(control.key)===-1)required.push(control.key);
  });
  return required.filter(function(key){
    var control=controls.find(function(item){return item.key===key});
    return control&&controlIsActive(control)&&!controlHasValue(key);
  });
}
function missingCollectionItems(step){
  if(!step.collection)return [];
  syncCollectionSelections(step.collection);
  var col=activeRole().collections[step.collection];
  return (state.collections[step.collection]||[]).filter(function(item){return !isCollectionItemComplete(col,item)});
}
function hasStepIssues(step){
  if(step.collection){
    syncCollectionSelections(step.collection);
    var items=state.collections[step.collection]||[];
    return (!step.skippable&&!items.length)||missingCollectionItems(step).length>0;
  }
  return missingControlKeys(step).length>0;
}
function validateRegistrationStep(step){
  if(hasStepIssues(step)&&!currentStepWarningsShown()){
    state.stepWarnings[currentStepWarningKey()]=true;
    render();
    toast('موارد ناقص نارنجی شدند؛ می‌توانید تکمیل کنید یا با همین وضعیت ادامه دهید');
    return false;
  }
  return true;
}
function renderStepWarningBanner(step){
  return '';
}
function regNext(){var schema=activeRole(),step=schema.steps[state.step];if(!validateRegistrationStep(step))return;if(state.step<schema.steps.length-1){state.step++;render()}}
function skipRegStep(){var schema=activeRole();if(state.step<schema.steps.length-1){state.step++;render()}}
function regBack(){if(state.step>0){state.step--;render()}else back()}

var PERSIAN_ONLY_FIELDS=['firstName','lastName'];
function setVal(k,v){
  if(PERSIAN_ONLY_FIELDS.indexOf(k)>-1)v=v.replace(/[0-9٠-٩a-zA-Z@#$%^&*()_+=\[\]{};:"\\|,.<>/?~`]/g,'');
  state.values[k]=v;render();
}
function toggleVal(k,v){var a=state.values[k]||(state.values[k]=[]);var i=a.indexOf(v);if(i>-1)a.splice(i,1);else a.push(v);render()}
function toggleBool(k){
  state.values[k]=!state.values[k];
  if(k==='foreignNational'){
    if(state.values[k])state.values.birthProvince='';
    else state.values.birthCountry='';
  }
  if(k==='travelReady'&&!state.values[k])state.values.travelRange='';
  render();
}
function setDatePart(k,part,v){var d=state.values[k]||(state.values[k]={day:'',month:'',year:''});d[part]=v;render()}
function addOther(k){var el=document.getElementById('oi_'+k);if(!el)return;var v=(el.value||'').trim();if(!v)return;var target=CUSTOM_LINKS[k];var arr=state.values[target]||(state.values[target]=[]);if(arr.indexOf(v)===-1)arr.push(v);render()}
function setPhone(k,i,v){(state.values[k]||[])[i]=v}
function addPhone(k){var a=state.values[k]||(state.values[k]=['']);a.push('');render()}
function handlePhotoField(input,key){
  var f=input.files&&input.files[0];if(!f)return;
  var reader=new FileReader();
  reader.onload=function(e){state.values[key]=e.target.result;render()};
  reader.readAsDataURL(f);
}

function renderStepControls(controls){
  var groupLabel=function(kind,key){
    if(kind==='phones')return 'اطلاعات تماس';
    if(kind==='toggle')return 'ترجیحات';
    return null;
  };
  var out='',lastGroup=null,seenGroups={};
  controls.forEach(function(c){
    var g=groupLabel(c.kind,c.key);
    if(g&&g!==lastGroup&&!seenGroups[g]){
      out+='<div class="field-group-label">'+esc(g)+'</div>';
      seenGroups[g]=true;
    }
    lastGroup=g;
    out+=renderControl(c);
  });
  return out;
}

function renderControl(c){
  if(c.conditionalOn&&!state.values[c.conditionalOn])return '';
  var disabled=!!(c.disabledWhen&&state.values[c.disabledWhen]);
  var warning=currentStepWarningsShown()&&missingControlKeys(activeRole().steps[state.step]).indexOf(c.key)>-1;
  var fieldClass='field'+(warning?' field-warning':'')+(disabled?' field-disabled':'');
  var disabledAttr=disabled?' disabled aria-disabled="true"':'';
  var disabledHint=disabled&&c.disabledHint?'<p style="font-size:.52rem;color:var(--accent2);margin-top:6px">'+esc(c.disabledHint)+'</p>':'';
  if(c.kind==='text'){
    if(CUSTOM_LINKS[c.key]){
      return '<div class="'+fieldClass+'"><label>'+esc(c.label)+'</label><div style="display:flex;gap:8px"><input class="input" id="oi_'+c.key+'" placeholder="'+esc(c.placeholder||'')+'"'+disabledAttr+'><button class="btn-secondary" style="width:70px;height:46px;padding:0;flex:none" onclick="addOther(\''+c.key+'\')"'+disabledAttr+'>افزودن</button></div>'+disabledHint+'</div>';
    }
    return '<div class="'+fieldClass+'"><label>'+esc(c.label)+(c.optional?' <span style="color:var(--muted);font-weight:400">(اختیاری)</span>':'')+'</label><input id="f_'+c.key+'" class="input" '+(c.ltr?'dir="ltr"':'')+' placeholder="'+esc(c.placeholder||'')+'" value="'+esc(state.values[c.key]||'')+'" oninput="setVal(\''+c.key+'\',this.value)"'+disabledAttr+'>'+disabledHint+'</div>';
  }
  if(c.kind==='phones'){
    var arr=state.values[c.key]||(state.values[c.key]=['']);
    var rows=arr.map(function(v,i){return '<input class="input" style="margin-bottom:8px" dir="ltr" placeholder="09xx xxx xxxx" value="'+esc(v)+'" oninput="setPhone(\''+c.key+'\','+i+',this.value)"'+disabledAttr+'>'}).join('');
    return '<div class="'+fieldClass+'"><label>'+esc(c.label)+'</label>'+rows+'<button class="btn-ghost" onclick="addPhone(\''+c.key+'\')"'+disabledAttr+'>+ افزودن شماره دیگر</button>'+disabledHint+'</div>';
  }
  if(c.kind==='photo'){
    var img=state.values[c.key];
    return '<div class="'+fieldClass+'"><label>'+esc(c.label)+'</label>'
      +(img?'<img src="'+img+'" alt="پیش‌نمایش '+esc(c.label)+'" style="width:100%;height:130px;object-fit:cover;border-radius:14px;margin-bottom:8px">':'')
      +'<label class="btn-secondary" style="height:56px;border-style:dashed;display:flex;align-items:center;justify-content:center;gap:6px;cursor:pointer">'+icon('portfolio',16)+' '+(img?'تغییر عکس':'افزودن عکس')+'<input type="file" accept="image/*" style="display:none" onchange="handlePhotoField(this,\''+c.key+'\')"></label></div>';
  }
  if(c.kind==='toggle'){
    var on=!!state.values[c.key];
    return '<div class="'+fieldClass+'" style="display:flex;align-items:center;justify-content:space-between;gap:10px;background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:12px 14px;margin-bottom:14px"><div style="flex:1"><label style="margin:0;font-size:.62rem">'+esc(c.label)+'</label>'+(c.help?'<p style="font-size:.47rem;line-height:1.6;margin-top:3px">'+esc(c.help)+'</p>':'')+'</div><div class="switch '+(on?'on':'')+'" role="switch" aria-checked="'+(on?'true':'false')+'" onclick="toggleBool(\''+c.key+'\')"><i></i></div></div>';
  }
  if(c.kind==='jdate'){
    var d=state.values[c.key]||{day:'',month:'',year:''};
    var days=[];for(var di=1;di<=31;di++)days.push(String(di));
    var years=[];for(var yi=1388;yi>=1300;yi--)years.push(String(yi));
    function opts(list,cur){return list.map(function(o){return '<option value="'+o+'" '+(cur===o?'selected':'')+'>'+o+'</option>'}).join('')}
    return '<div class="'+fieldClass+'"><label>'+esc(c.label)+'</label><div style="display:flex;gap:7px">'
      +'<select class="input" style="padding:0 6px" onchange="setDatePart(\''+c.key+'\',\'day\',this.value)"><option value="">روز</option>'+opts(days,d.day)+'</select>'
      +'<select class="input" style="padding:0 6px" onchange="setDatePart(\''+c.key+'\',\'month\',this.value)"><option value="">ماه</option>'+opts(PERSIAN_MONTHS,d.month)+'</select>'
      +'<select class="input" style="padding:0 6px" onchange="setDatePart(\''+c.key+'\',\'year\',this.value)"><option value="">سال</option>'+opts(years,d.year)+'</select>'
      +'</div></div>';
  }
  var multi=c.kind==='multi';
  var current=state.values[c.key];
  var baseOptions=c.options||[];
  if(c.dynamicOptions){
    var driver=state.values[c.dynamicOptions];
    var lookup=c.optionsSource==='province'?PROVINCE_CITIES:SPECIALTY_OPTIONS;
    baseOptions=(lookup[driver]||[]);
    if(!driver){
      var hintLabel=c.optionsSource==='province'?'استان را در بالا انتخاب کنید':'ابتدا شاخهٔ اصلی را در مرحلهٔ قبل انتخاب کنید';
      return '<div class="'+fieldClass+'"><label>'+esc(c.label)+'</label><p style="font-size:.56rem;color:var(--muted)">'+hintLabel+'.</p></div>';
    }
  }
  var extra=multi?(current||[]).filter(function(v){return baseOptions.indexOf(v)===-1}):[];
  var allOpts=baseOptions.concat(extra);
  if(!multi&&allOpts.length>8){
    var tags=allOpts.map(function(o){return '<option value="'+esc(o)+'" '+(current===o?'selected':'')+'>'+esc(o)+'</option>'}).join('');
    return '<div class="'+fieldClass+'"><label>'+esc(c.label)+'</label><select class="input" onchange="setVal(\''+c.key+'\',this.value)"'+disabledAttr+'><option value="">انتخاب کنید</option>'+tags+'</select>'+disabledHint+'</div>';
  }
  var chips=allOpts.map(function(o){
    var active=multi?(current||[]).indexOf(o)>-1:current===o;
    var safe=String(o).replace(/'/g,"\\'");
    var fn=disabled?'':(multi?"toggleVal('"+c.key+"','"+safe+"')":"setVal('"+c.key+"','"+safe+"')");
    return '<div class="chip'+(c.compact?' chip-compact':'')+(active?' active':'')+'"'+(fn?' onclick="'+fn+'"':'')+'>'+esc(o)+'</div>';
  }).join('');
  return '<div class="'+fieldClass+'"><label>'+esc(c.label)+'<span style="color:var(--muted);font-weight:400"> · '+(multi?'چند مورد':'یک مورد')+'</span></label><div class="chip-row">'+(chips||'<p style="font-size:.56rem;color:var(--muted)">برای این شاخه گزینه‌ای ثبت نشده — از فیلد «عنوان دیگر» زیر استفاده کنید.</p>')+'</div>'+disabledHint+'</div>';
}

function renderCollectionBody(step){
  var role=state.role,colKey=step.collection,col=activeRole().collections[colKey];
  syncCollectionSelections(colKey);
  var items=state.collections[colKey]||[];
  var rows=items.map(function(item,idx){
    var title=item[col.titleKey]||item[col.syncFieldKey]||col.singular;
    var sub=(col.summaryKeys||[]).map(function(k){return item[k]}).filter(Boolean).join(' · ');
    var complete=isCollectionItemComplete(col,item);
    return '<div class="list-row" onclick="openCollectionSheet(\''+colKey+'\','+idx+')"><div class="ricon">'+icon(mapIcon(col.icon),18)+'</div><div class="rcopy"><b>'+esc(title)+'</b><span>'+esc(sub||(complete?'اطلاعات کامل است':'برای تکمیل لمس کنید'))+'</span></div><span class="badge '+(complete?'badge-complete':'badge-incomplete')+'">'+(complete?'کامل':'نیازمند تکمیل')+'</span><button class="btn-ghost" style="color:var(--danger)" onclick="removeItem(\''+colKey+'\','+idx+',event)">حذف</button></div>';
  }).join('');
  var emptyHint=items.length?'':'<p style="font-size:.58rem;line-height:1.8;margin-bottom:12px">'+esc(col.emptyHint||'هنوز موردی اضافه نکرده‌اید؛ از نمونه‌های زیر شروع کنید یا مورد تازه بسازید.')+'</p>';
  var syncNote=col.syncFromValueKey&&items.length?'<div class="card" style="margin-bottom:12px;border-color:var(--accent);background:var(--accent-soft)"><b style="font-size:.61rem">'+items.length+' انتخاب از مرحلهٔ قبل منتقل شد</b><p style="font-size:.53rem;line-height:1.7;margin-top:3px">هر ردیف را باز کنید؛ عنوان، سابقه و مبلغ را می‌توانید همین‌جا اصلاح کنید.</p></div>':'';
  var seeds=(col.seeds||[]).map(function(s,i){return '<div class="chip" onclick="addSeed(\''+colKey+'\','+i+')">+ '+esc(s[col.titleKey])+'</div>'}).join('');
  var addText=/^افزودن/.test(col.addLabel||'')?col.addLabel:'افزودن '+(col.addLabel||col.singular);
  return syncNote+emptyHint+(rows?'<div style="margin-bottom:12px">'+rows+'</div>':'')+(seeds?'<div class="field"><label>افزودن سریع از نمونه‌ها</label><div class="chip-row">'+seeds+'</div></div>':'')+'<button class="btn-secondary" onclick="openCollectionSheet(\''+colKey+'\',-1)">'+icon('plus',14)+' '+esc(addText)+'</button>';
}
function syncCollectionSelections(colKey){
  var col=activeRole().collections&&activeRole().collections[colKey];
  if(!col||!col.syncFromValueKey)return;
  var selected=(state.values[col.syncFromValueKey]||[]).filter(Boolean);
  var fieldKey=col.syncFieldKey||col.titleKey;
  var items=state.collections[colKey]||(state.collections[colKey]=[]);
  items=items.filter(function(item){return !item._sourceValue||selected.indexOf(item._sourceValue)>-1});
  selected.forEach(function(value){
    var match=items.find(function(item){return item._sourceValue===value||item[fieldKey]===value});
    if(match){match._sourceValue=value;return}
    var item={_sourceValue:value};item[fieldKey]=value;items.push(item);
  });
  state.collections[colKey]=items;
}
function addSeed(colKey,seedIdx){var col=activeRole().collections[colKey];var seed=cloneData(col.seeds[seedIdx]);(state.collections[colKey]=state.collections[colKey]||[]).push(seed);render()}
function removeItem(colKey,idx,ev){
  if(ev)ev.stopPropagation();
  var col=activeRole().collections[colKey],item=state.collections[colKey][idx];
  if(col.syncFromValueKey&&item&&item._sourceValue){
    var selected=state.values[col.syncFromValueKey]||[];
    var sourceIndex=selected.indexOf(item._sourceValue);if(sourceIndex>-1)selected.splice(sourceIndex,1);
  }
  state.collections[colKey].splice(idx,1);render();
}

function openCollectionSheet(colKey,idx){
  state.draftCollection=colKey;state.draftIndex=idx;
  state.draftWarningsShown=false;
  var col=activeRole().collections[colKey];
  state.draft=idx>-1?Object.assign({},state.collections[colKey][idx]):{};
  renderCollectionSheet();
}
function renderCollectionSheet(){
  var colKey=state.draftCollection,col=activeRole().collections[colKey];
  var missingKeys=effectiveRequiredKeys(col).filter(function(key){return !state.draft[key]});
  var fieldsHtml=col.fields.map(function(f){
    var fieldClass='field'+(state.draftWarningsShown&&missingKeys.indexOf(f.key)>-1?' field-warning':'');
    if(f.kind==='photo'){
      var img=state.draft[f.key];
      return '<div class="'+fieldClass+'"><label>'+esc(f.label)+(f.optional?' <span style="color:var(--muted);font-weight:400">(اختیاری)</span>':'')+'</label>'
        +(img?'<img src="'+img+'" alt="پیش‌نمایش '+esc(f.label)+'" style="width:100%;height:130px;object-fit:cover;border-radius:14px;margin-bottom:8px">':'')
        +'<label class="btn-secondary" style="height:56px;border-style:dashed;display:flex;align-items:center;justify-content:center;gap:6px;cursor:pointer">'+icon('portfolio',16)+' '+(img?'تغییر عکس':'انتخاب عکس')+'<input type="file" accept="image/*" style="display:none" onchange="handleDraftPhoto(this,\''+f.key+'\')"></label></div>';
    }
    var options=(f.options||[]).slice();
    if(f.sourceValueKey)options=options.concat(state.values[f.sourceValueKey]||[]);
    if(f.sourceCollection){
      options=options.concat((state.collections[f.sourceCollection]||[]).map(function(item){return item[f.sourceField||'name']}).filter(Boolean));
    }
    options=options.filter(function(value,index,array){return value&&array.indexOf(value)===index});
    if(options.length||f.allowCustom){
      var chips=options.map(function(o){var safe=String(o).replace(/'/g,"\\'");return '<div class="chip'+(state.draft[f.key]===o?' active':'')+'" onclick="setDraft(\''+f.key+'\',\''+safe+'\')">'+esc(o)+'</div>'}).join('');
      var manual=f.allowCustom?'<input class="input" style="margin-top:8px" placeholder="'+esc(f.placeholder||'یا خودتان بنویسید')+'" value="'+esc(state.draft[f.key]||'')+'" oninput="setDraft(\''+f.key+'\',this.value,false)">':'';
      return '<div class="'+fieldClass+'"><label>'+esc(f.label)+(f.optional?' <span style="color:var(--muted);font-weight:400">(اختیاری)</span>':'')+'</label>'+(chips?'<div class="chip-row">'+chips+'</div>':'')+manual+'</div>';
    }
    return '<div class="'+fieldClass+'"><label>'+esc(f.label)+(f.optional?' <span style="color:var(--muted);font-weight:400">(اختیاری)</span>':'')+'</label><input class="input" '+(f.ltr?'dir="ltr"':'')+' placeholder="'+esc(f.placeholder||'')+'" value="'+esc(state.draft[f.key]||'')+'" oninput="setDraft(\''+f.key+'\',this.value,false)"></div>';
  }).join('');
  var warningBanner='';
  var saveLabel=state.draftWarningsShown&&missingKeys.length?'ذخیره با موارد ناقص':'ذخیره';
  var html='<h3>'+(state.draftIndex>-1?'ویرایش '+esc(col.singular):esc(col.addLabel))+'</h3><p>'+esc(col.imageLabel||'')+'</p>'+warningBanner+'<div style="overflow:auto;flex:1;margin-bottom:14px;padding-left:2px">'+fieldsHtml+'</div><button class="btn-primary" onclick="saveDraft()">'+saveLabel+'</button>'+(state.draftIndex>-1?'<div style="height:8px"></div><button class="btn-secondary" style="color:var(--danger);border-color:var(--danger)" onclick="deleteDraft()">حذف این مورد</button>':'');
  openSheet(html);
}
function setDraft(k,v,shouldRender){state.draft[k]=v;if(shouldRender!==false)renderCollectionSheet()}
function handleDraftPhoto(input,key){
  var f=input.files&&input.files[0];if(!f)return;
  var reader=new FileReader();
  reader.onload=function(e){state.draft[key]=e.target.result;renderCollectionSheet()};
  reader.readAsDataURL(f);
}
function saveDraft(){
  var col=activeRole().collections[state.draftCollection];
  var missing=effectiveRequiredKeys(col).filter(function(key){return !state.draft[key]});
  if(missing.length&&!state.draftWarningsShown){
    state.draftWarningsShown=true;
    renderCollectionSheet();
    toast('قسمت‌های ناقص نارنجی شدند؛ می‌توانید تکمیل کنید یا با همین وضعیت ذخیره کنید');
    return;
  }
  state.draft._incomplete=missing.length>0;
  var arr=state.collections[state.draftCollection]||(state.collections[state.draftCollection]=[]);
  if(col.syncFromValueKey){
    var fieldKey=col.syncFieldKey||col.titleKey;
    var source=state.values[col.syncFromValueKey]||(state.values[col.syncFromValueKey]=[]);
    var previous=state.draftIndex>-1&&arr[state.draftIndex]?arr[state.draftIndex]._sourceValue:null;
    var next=state.draft[fieldKey];
    if(next){
      if(previous){var sourceIndex=source.indexOf(previous);if(sourceIndex>-1)source[sourceIndex]=next}
      else if(source.indexOf(next)===-1)source.push(next);
      state.draft._sourceValue=next;
    }
  }
  if(state.draftIndex>-1)arr[state.draftIndex]=state.draft;else arr.push(state.draft);
  closeSheet();render();
}
function deleteDraft(){removeItem(state.draftCollection,state.draftIndex);closeSheet()}

function renderReview(){
  var schema=activeRole();
  var blocks=schema.steps.filter(function(s){return !s.review}).map(function(s){
    if(s.collection){
      syncCollectionSelections(s.collection);
      var items=state.collections[s.collection]||[];
      var col=schema.collections[s.collection];
      if(!items.length)return '';
      var rows=items.map(function(it){return '<div class="reviewrow"><span>'+esc(it[col.titleKey]||col.singular)+'</span><span>'+esc((col.summaryKeys||[]).map(function(k){return it[k]}).filter(Boolean).join(' · '))+'</span></div>'}).join('');
      return '<div class="card" style="margin-bottom:10px"><b style="font-size:.66rem">'+esc(s.title)+'</b><div style="margin-top:6px">'+rows+'</div></div>';
    }
    var rows=(s.controls||[]).map(function(c){
      var v=formatControlValue(c);
      if(!v)return '';
      return '<div class="reviewrow"><span>'+esc(c.label)+'</span><span>'+esc(v)+'</span></div>';
    }).join('');
    if(!rows)return '';
    return '<div class="card" style="margin-bottom:10px"><b style="font-size:.66rem">'+esc(s.title)+'</b><div style="margin-top:6px">'+rows+'</div></div>';
  }).join('');
  return topbar('مرور پروفایل '+schema.label,'پیش از انتشار بررسی کنید','regBack()')
    +'<div class="page"><div class="eyebrow">آخرین مرحله</div><h2 style="margin:8px 0 12px;font-size:1rem">همه‌چیز درست به‌نظر می‌رسد؟</h2>'
    +(blocks||'<p style="font-size:.62rem">هنوز اطلاعاتی ثبت نشده — به مراحل قبل برگردید.</p>')
    +'</div><div class="dock"><button class="btn-primary" onclick="finishSetup()">ثبت نهایی پروفایل</button></div>';
}
function finishSetup(){
  var portfolioItems=state.collections.portfolioItems||[];
  if(!portfolioItems.length&&(state.role==='contractor'||state.role==='company')){
    portfolioItems=(state.collections.projects||[]).map(function(item){return {title:item.name,city:item.location||item.type||'',image:item.image||null} });
  }
  if(portfolioItems.length){
    state.portfolio[state.role]=portfolioItems.map(function(item,index){return {title:item.title,city:item.city||item.skill||'',image:item.image||null,color:index%2?'var(--tone-mint)':'var(--accent2)'} });
  }
  state.profileComplete=true;state.stack=[];state.page='setupDone';render();
}

/* ---------- static content helpers ---------- */
function feedRow(ic,title,sub,personId){return '<div class="list-row" onclick="'+(personId?"openPersonProfile('"+personId+"')":"toast('جزئیات نمایش داده شد')")+'"><div class="ricon">'+icon(ic,18)+'</div><div class="rcopy"><b>'+esc(title)+'</b><span>'+esc(sub)+'</span></div><span class="rarrow">‹</span></div>'}
function listRow(ic,title,sub,target,danger){return '<div class="list-row" onclick="'+(target?"go('"+target+"')":"toast('باز شد')")+'"><div class="ricon" style="'+(danger?'color:var(--danger);background:var(--danger-soft)':'')+'">'+icon(ic,18)+'</div><div class="rcopy"><b style="'+(danger?'color:var(--danger)':'')+'">'+esc(title)+'</b>'+(sub?'<span>'+esc(sub)+'</span>':'')+'</div><span class="rarrow">‹</span></div>'}
function renderConversationCard(c){
  var context=c.context?'<div class="conversation-context">'+icon(c.context.icon||'briefcase',11)+'<span>'+esc(c.context.label+': '+c.context.title)+'</span></div>':'';
  return '<article class="conversation-card'+(c.unread?' unread':'')+'" onclick="openConversation(\''+c.id+'\')"><div class="conversation-avatar">'+esc(c.initials)+(c.online?'<span class="online-dot"></span>':'')+'</div><div class="conversation-copy"><div class="conversation-title"><b>'+esc(c.name)+'</b>'+(c.verified?'<i class="verified-mini">'+icon('check',9)+'</i>':'')+(c.muted?'<span style="color:var(--muted)">'+icon('mute',11)+'</span>':'')+'</div><p>'+esc(c.lastMessage)+'</p>'+context+'</div><div class="conversation-meta"><time>'+esc(c.time)+'</time>'+(c.unread?'<span class="unread-count">'+c.unread+'</span>':c.pinned?'<span class="pin-mark">'+icon('pin',12)+'</span>':'')+'</div></article>';
}
function choiceStatic(ic,title,sub){return '<div class="choice" role="button" tabindex="0" onkeydown="if(event.key===\'Enter\'||event.key===\' \'){event.preventDefault();toast(\'درخواست شروع شد\')}" onclick="toast(\'درخواست شروع شد\')"><div class="cicon">'+icon(ic,18)+'</div><b>'+esc(title)+'</b><p>'+esc(sub)+'</p></div>'}

function renderPublicSkillDetails(person,personId){
  var canRequest=personId&&personId!=='self'&&personId!=='ad'&&!isBlocked(personId);
  if(person.skillDetails&&person.skillDetails.length){
    return '<div class="sec-head"><b>'+esc(person.skillSectionTitle||'مهارت، سابقه و دستمزد')+'</b>'+(canRequest?'<span style="font-size:.46rem;color:var(--muted)">برای درخواست لمس کنید</span>':'')+'</div>'+person.skillDetails.map(function(item){
      var safe=String(item.name).replace(/'/g,"\\'");
      var tap=canRequest?' role="button" tabindex="0" onclick="openTargetedProject(\''+personId+'\',\''+safe+'\')"':'';
      return '<div class="skill-rate-card'+(canRequest?' skill-rate-tap':'')+'"'+tap+'><div><b>'+esc(item.name)+'</b><strong>'+esc(item.rateAmount)+'</strong></div><p>'+esc(item.experience)+' · '+esc(item.rateType)+(canRequest?' <span class="rarrow">‹</span>':'')+'</p></div>';
    }).join('');
  }
  if(!(person.skills&&person.skills.length))return '';
  var chips=person.skills.map(function(skill){
    var safe=String(skill).replace(/'/g,"\\'");
    return canRequest?'<div class="chip chip-compact skill-tap" onclick="openTargetedProject(\''+personId+'\',\''+safe+'\')">'+esc(skill)+'</div>':'<div class="chip chip-compact">'+esc(skill)+'</div>';
  }).join('');
  return '<div class="sec-head"><b>مهارت‌ها و تخصص‌ها</b></div><div class="chip-row" style="margin-bottom:16px">'+chips+'</div>';
}
function renderMyRatePreview(){
  var schema=activeRole(),collectionKeys=['skills','services','capabilities'];
  var colKey=collectionKeys.find(function(key){return schema.collections&&schema.collections[key]&&(state.collections[key]||[]).length});
  if(!colKey)return '';
  syncCollectionSelections(colKey);
  var col=schema.collections[colKey],items=state.collections[colKey]||[];
  if(!items.length)return '';
  return '<div class="sec-head"><b>نمایش عمومی دستمزدها</b></div><div class="card" style="margin-bottom:10px"><p style="font-size:.54rem;line-height:1.7;margin-bottom:10px">این اطلاعات برای کارفرماها و مخاطبان پروفایل شما نمایش داده می‌شود.</p>'+items.map(function(item){
    var title=item[col.titleKey]||item[col.syncFieldKey]||col.singular;
    var rate=[item.rateAmount,item.rateType].filter(Boolean).join(' · ');
    return '<div class="reviewrow"><span>'+esc(title)+'</span><span>'+esc(rate||'مبلغ هنوز کامل نشده')+'</span></div>';
  }).join('')+'</div>';
}
/* Business/supplier roles (machinery, store, materialsSupplier): quick add + inline price edit for their product/fleet catalog. */
function renderMyProductsPreview(){
  var role=state.role;
  if(BUSINESS_ROLES.indexOf(role)===-1)return '';
  var schema=activeRole(),colKey=schema.primaryCollection,col=schema.collections&&schema.collections[colKey];
  if(!col)return '';
  var items=state.collections[colKey]||[];
  var priceField=(col.fields||[]).find(function(f){return f.key==='price'})||(col.fields||[]).find(function(f){return f.key==='rate'});
  var addText=/^افزودن/.test(col.addLabel||'')?col.addLabel:'افزودن '+(col.addLabel||col.singular);
  var isMachines=colKey==='machines';
  var rows=items.map(function(item,idx){
    var title=item[col.titleKey]||col.singular;
    var sub=(col.summaryKeys||[]).map(function(k){return item[k]}).filter(Boolean).join(' · ');
    var priceVal=priceField?(item[priceField.key]||''):'';
    var priceBlock=priceField?'<span class="price-view" id="pv-'+colKey+'-'+idx+'" onclick="event.stopPropagation();startPriceEdit(\''+colKey+'\','+idx+',\''+priceField.key+'\')">'+esc(priceVal||'ثبت قیمت')+'</span>':'';
    var row='<div class="list-row product-row" onclick="openCollectionSheet(\''+colKey+'\','+idx+')"><div class="ricon">'+icon(mapIcon(col.icon),18)+'</div><div class="rcopy"><b>'+esc(title)+'</b><span>'+esc(sub||'برای ویرایش کامل لمس کنید')+'</span></div>'+priceBlock+'</div>';
    if(isMachines)return '<div class="machine-card">'+row+renderMachineCalendarStrip(idx)+'</div>';
    return row;
  }).join('');
  var empty=items.length?'':'<p style="font-size:.56rem;line-height:1.8;margin-bottom:10px">هنوز '+esc(col.singular)+'ای ثبت نکرده‌اید؛ با دکمهٔ زیر شروع کنید.</p>';
  return '<div class="sec-head"><b>'+esc(col.label)+'</b><button class="btn-ghost" onclick="openCollectionSheet(\''+colKey+'\',-1)">'+icon('plus',12)+' افزودن</button></div>'+empty+rows+(items.length?'<div style="height:6px"></div>':'');
}
function startPriceEdit(colKey,idx,fieldKey){
  var el=document.getElementById('pv-'+colKey+'-'+idx);
  if(!el)return;
  var current=(state.collections[colKey]&&state.collections[colKey][idx]&&state.collections[colKey][idx][fieldKey])||'';
  el.outerHTML='<input class="price-edit-input" id="pv-'+colKey+'-'+idx+'" value="'+esc(current)+'" dir="ltr" onclick="event.stopPropagation()" onblur="savePriceEdit(\''+colKey+'\','+idx+',\''+fieldKey+'\',this.value)" onkeydown="if(event.key===\'Enter\')this.blur()">';
  var input=document.getElementById('pv-'+colKey+'-'+idx);
  if(input){input.focus();input.select()}
}
function savePriceEdit(colKey,idx,fieldKey,value){
  if(state.collections[colKey]&&state.collections[colKey][idx]){
    state.collections[colKey][idx][fieldKey]=value;
  }
  render();
  toast('قیمت به‌روزرسانی شد');
}

function quickActionsRow(role){
  var acts=QUICK_ACTIONS[role]||[];
  if(!acts.length)return '';
  return '<div class="quick-row">'+acts.map(function(a){return '<div class="quick-btn" role="button" tabindex="0" onkeydown="if(event.key===\'Enter\'||event.key===\' \'){event.preventDefault();go(\''+a[2]+'\')}" onclick="go(\''+a[2]+'\')"><div class="qicon">'+icon(a[0],16)+'</div><b>'+esc(a[1])+'</b></div>'}).join('')+'</div>';
}

function calendarWidgetHome(role){
  var type=calendarType(role);
  if(!type)return '';
  var data=getCalendar(role);
  var head='<div class="sec-head"><b>'+(type==='availability'?'تقویم دسترسی':type==='appointments'?'رزروهای من':'تقویم پروژه‌ها')+'</b><button class="btn-ghost" onclick="go(\'calendar\')">مدیریت کامل</button></div>';
  if(type==='availability'){
    var strip='<div class="cal-strip">'+data.days.map(function(d,i){
      var cls=d.status==='available'?'cal-available':d.status==='booked'?'cal-booked':'cal-off';
      return '<div class="cal-pill '+cls+'" onclick="cycleDay('+i+')"><span>'+DAY_NAMES[i]+'</span><b>'+d.date+'</b></div>';
    }).join('')+'</div>';
    var legend='<div class="cal-legend"><span><i class="dot-available"></i>آزاد</span><span><i class="dot-booked"></i>رزروشده</span><span><i class="dot-off"></i>غیرفعال</span></div>';
    var reqs=data.requests.length?data.requests.map(function(r,i){return '<div class="list-row"><div class="ricon">'+icon('calendar',16)+'</div><div class="rcopy"><b>'+esc(r.title)+'</b><span>'+esc(r.date)+' · '+esc(r.who)+'</span></div><button class="btn-ghost" onclick="acceptRequest('+i+')">تأیید</button></div>'}).join(''):'<p style="font-size:.56rem;margin-bottom:8px">درخواست رزرو جدیدی ندارید.</p>';
    return head+strip+legend+reqs;
  }
  var list=data.slice(0,2);
  var rows=list.length?list.map(function(b){return '<div class="list-row" onclick="go(\'calendar\')"><div class="ricon">'+icon('calendar',16)+'</div><div class="rcopy"><b>'+esc(b.title)+'</b><span>'+esc(b.date)+' · '+esc(b.time)+' · '+esc(b.who)+'</span></div><span class="rarrow">‹</span></div>'}).join(''):'<p style="font-size:.56rem;margin-bottom:8px">رزروی ثبت نشده است.</p>';
  return head+rows;
}

function ordersWidgetHome(){
  var orders=getOrders().slice(0,2);
  var head='<div class="sec-head"><b>سفارش‌ها و استعلام‌ها</b><button class="btn-ghost" onclick="go(\'orders\')">مشاهده همه</button></div>';
  var rows=orders.map(function(o){return '<div class="list-row" onclick="go(\'orders\')"><div class="ricon">'+icon('truck',16)+'</div><div class="rcopy"><b>'+esc(o.title)+'</b><span>'+esc(o.who)+' · '+esc(o.date)+'</span></div><span class="badge badge-'+o.status+'">'+esc(ORDER_STATUS_LABEL[o.status])+'</span></div>'}).join('');
  return head+rows;
}

function professionalJobRole(role){return ['worker','specialist','engineer','contractor','company','machinery'].indexOf(role)>-1}
/* Business/supplier roles (machinery, store, materialsSupplier) provide services, they don't browse a job feed. */
function jobFeedRole(role){return professionalJobRole(role)&&BUSINESS_ROLES.indexOf(role)===-1}
function jobMatchScore(job){
  var role=state.role||'worker',score=job.targetRoles.indexOf(role)>-1?20:0;
  var city=displayCityFor(role),categories=profileAdCategories();
  if(city&&job.city&&city.indexOf(job.city)>-1)score+=6;
  categories.forEach(function(category){
    var text=String(category);if(job.skills.some(function(skill){return text.indexOf(skill)>-1||skill.indexOf(text)>-1}))score+=4;
  });
  return score-Math.min(job.distance||0,20)/10;
}
function relevantJobItems(limit){
  var role=state.role||'worker';
  if(!jobFeedRole(role))return [];
  var items=JOB_OPPORTUNITIES.filter(function(job){return job.targetRoles.indexOf(role)>-1}).sort(function(a,b){return jobMatchScore(b)-jobMatchScore(a)});
  return typeof limit==='number'?items.slice(0,limit):items;
}
/* Two-way explore switch: "پیدا کردن کار" (browse job postings) vs "پیدا کردن نیروی کار" (browse people/businesses).
   Default follows the role's natural intent but the person can always switch manually. */
var JOB_SEEKER_DEFAULT_ROLES=["worker","specialist"];
function defaultExploreMode(){return JOB_SEEKER_DEFAULT_ROLES.indexOf(state.role)>-1?'jobs':'workers'}
function ensureExploreMode(){if(!state.exploreMode)state.exploreMode=defaultExploreMode();return state.exploreMode}
function setExploreMode(mode){state.exploreMode=mode;state.exploreQuery='';render()}
function ensureJobQuick(){if(!state.jobQuick)state.jobQuick={near:false,soon:false,projectBased:false};return state.jobQuick}
function toggleJobQuick(key){var q=ensureJobQuick();q[key]=!q[key];render()}
function filteredJobOpportunities(){
  var q=(state.exploreQuery||'').trim(),quick=ensureJobQuick();
  var items=JOB_OPPORTUNITIES.filter(function(job){
    var matchesCity=state.exploreCity==='all'||job.city===state.exploreCity;
    var matchesQuery=!q||job.title.indexOf(q)>-1||(job.employer||'').indexOf(q)>-1||(job.skills||[]).some(function(s){return s.indexOf(q)>-1});
    var matchesNear=!quick.near||(job.distance||99)<=5;
    var matchesSoon=!quick.soon||/فوری|امروز|این هفته/.test(job.start||'');
    var matchesProject=!quick.projectBased||/پروژه‌ای/.test(job.pay||'');
    return matchesCity&&matchesQuery&&matchesNear&&matchesSoon&&matchesProject;
  });
  if(state.exploreSort==='nearest')items.sort(function(a,b){return (a.distance||99)-(b.distance||99)});
  else items.sort(function(a,b){return jobMatchScore(b)-jobMatchScore(a)});
  return items;
}
function openRelevantJobs(){if(!jobFeedRole(state.role||'worker')){openAccessDenied('فرصت‌های حرفه‌ای','این صفحه برای نقش‌های کاری و حرفه‌ای فعال می‌شود. از بخش نقش‌های حساب، یک نقش حرفه‌ای را اضافه یا فعال کنید.','roleManagement');return}openDataPage('relevantJobs','در حال تطبیق مهارت‌ها و فرصت‌ها')}
function openJobOpportunity(id){state.viewingJobId=id;go('jobDetail')}
function currentJobOpportunity(){return JOB_OPPORTUNITIES.find(function(job){return job.id===state.viewingJobId})||JOB_OPPORTUNITIES[0]}
function sendJobInterest(id){
  var job=JOB_OPPORTUNITIES.find(function(item){return item.id===id});if(!job)return;
  if(state.jobInterestIds.indexOf(id)>-1){toast('درخواست شما قبلاً برای این کار ارسال شده است');return}
  state.jobInterestIds.push(id);
  getProjects(state.role||'worker').push({title:job.title,who:job.employer,personId:job.person||null,stage:'proposed',rating:0,direction:'outgoing'});
  addOutgoingRequest('job',job.title,job.employer,job.pay+' · '+job.start);
  getNotifications().unshift({title:'درخواست همکاری ارسال شد',sub:'برای «'+job.title+'»؛ پاسخ کارفرما در پیام‌ها نمایش داده می‌شود.',time:'همین حالا',day:'امروز',read:false,icon:'briefcase',type:'project',target:'myProjects',action:'پیگیری درخواست'});
  render();toast('درخواست همکاری با موفقیت ارسال شد');
}
function renderHomeJobCard(job){
  return '<article class="home-opportunity-card '+esc(job.tone)+'" onclick="openJobOpportunity(\''+job.id+'\')"><div class="home-job-top"><span>مناسب پروفایل شما</span><em>'+esc(job.distance).replace('.', '٫')+' کیلومتر</em></div><h3>'+esc(job.title)+'</h3><p>'+esc(job.employer)+' · '+esc(job.city)+'</p><div class="home-job-meta"><span>'+esc(job.pay)+'</span><span>'+esc(job.start)+'</span></div></article>';
}
function homePrimary(role){
  if(role==='materialsSupplier')return {icon:'calendar',eyebrow:'تأمین‌کننده من',title:'نوبت‌های تحویل و سفارش‌ها',desc:'درخواست‌های تازه و نوبت‌های هماهنگ‌شده.',action:"go('orders')",cta:'دیدن سفارش‌ها'};
  if(role==='store')return {icon:'truck',eyebrow:'فروشگاه من',title:'سفارش‌ها و استعلام‌ها',desc:'سفارش‌های تازه و درخواست‌های قیمت.',action:"go('orders')",cta:'دیدن سفارش‌ها'};
  if(role==='machinery')return {icon:'truck',eyebrow:'ارائه‌دهندهٔ خدمات من',title:'سفارش‌ها و درخواست‌های خدمت',desc:'درخواست‌های تازه برای ماشین‌آلات و رزروهای هماهنگ‌شده.',action:"go('orders')",cta:'دیدن سفارش‌ها'};
  if(jobFeedRole(role))return {icon:'briefcase',eyebrow:'پیشنهاد برای شما',title:'کارهای مناسب من',desc:'کارهای هماهنگ با مهارت و شهر شما.',action:'openRelevantJobs()',cta:'دیدن کارها'};
  return {icon:'search',eyebrow:'شروع سریع',title:'چه چیزی لازم دارید؟',desc:'فرد مناسب را پیدا کنید یا نیازتان را ثبت کنید.',action:"go('newRequest')",cta:'شروع'};
}
function homeShortcutItems(role){
  var requests='درخواست‌ها'+(pendingRequestCount()?' ('+pendingRequestCount()+')':'');
  if(role==='materialsSupplier')return [['calendar','نوبت‌های تحویل',"go('calendar')"],['check',requests,"go('requestsCenter')"],['message','پیام‌ها',"openDataPage('messages','در حال دریافت پیام‌ها')"],['more','همه امکانات',"go('featureHub')"]];
  if(role==='store')return [['truck','سفارش‌ها',"go('orders')"],['check',requests,"go('requestsCenter')"],['message','پیام‌ها',"openDataPage('messages','در حال دریافت پیام‌ها')"],['more','همه امکانات',"go('featureHub')"]];
  if(role==='machinery')return [['truck','سفارش‌ها',"go('orders')"],['calendar','تقویم رزرو',"go('calendar')"],['check',requests,"go('requestsCenter')"],['more','همه امکانات',"go('featureHub')"]];
  if(role==='general')return [['search','جست‌وجو',"openDataPage('explore','در حال آماده‌کردن نتایج مرتبط')"],['plus','ثبت نیاز',"go('newRequest')"],['check',requests,"go('requestsCenter')"],['more','همه امکانات',"go('featureHub')"]];
  return [['briefcase','فرصت‌ها','openRelevantJobs()'],['check',requests,"go('requestsCenter')"],['calendar','تقویم',"go('calendar')"],['more','همه امکانات',"go('featureHub')"]];
}
function homeActivityItems(role){
  var items=[];
  getIncomingRequests().forEach(function(r){
    if(r.status==='pending'&&!r.seenOnHome)items.push({kind:'request',icon:'check',tone:'a',title:r.title,sub:r.from+(r.detail?' · '+r.detail:''),action:"go('requestsCenter')",seenKey:r.id});
  });
  getConversations().forEach(function(c){
    if((c.unread||0)>0)items.push({kind:'message',icon:'message',tone:'b',title:c.name,sub:c.lastMessage||'',action:"openConversation('"+c.id+"')",seenKey:c.id});
  });
  getNotifications().forEach(function(n,index){
    if(!n.read)items.push({kind:'notification',icon:n.icon||'bell',tone:'c',title:n.title,sub:n.sub||'',action:n.target?"go('"+n.target+"')":"go('notifications')",seenKey:'n'+index});
  });
  return items.slice(0,6);
}
function markHomeActivitySeen(kind,seenKey){
  if(kind==='request'){var r=getIncomingRequests().find(function(x){return x.id===seenKey});if(r)r.seenOnHome=true}
  else if(kind==='message'){var c=findConversation(seenKey);if(c)c.unread=0}
  else if(kind==='notification'){var idx=parseInt(String(seenKey).slice(1));var n=getNotifications()[idx];if(n)n.read=true}
}
function openHomeActivity(kind,seenKey){
  markHomeActivitySeen(kind,seenKey);
  if(kind==='request')go('requestsCenter');
  else if(kind==='message')openConversation(seenKey);
  else{
    var idx=parseInt(String(seenKey).slice(1),10);var n=getNotifications()[idx];
    if(n&&n.target)go(n.target);else go('notifications');
  }
}
function dismissHomeActivity(el,kind,seenKey){
  if(el)el.classList.add('activity-leave');
  setTimeout(function(){markHomeActivitySeen(kind,seenKey);render()},260);
}
function renderHomeActivityFeed(role){
  var items=homeActivityItems(role);
  if(!items.length)return '';
  return '<div class="home-section-head"><div><b>تمام رخدادها</b><span>درخواست، پیام و اعلان‌های تازه</span></div><button onclick="go(\'notifications\')">همه</button></div><div class="home-activity-rail">'+items.map(function(it){
    return '<div class="home-activity-card tone-'+it.tone+'" onclick="openHomeActivity(\''+it.kind+'\',\''+it.seenKey+'\')"><div class="ricon">'+icon(it.icon,16)+'</div><div class="rcopy"><b>'+esc(it.title)+'</b><p>'+esc(it.sub)+'</p></div><button class="activity-dismiss" aria-label="دیده شد" onclick="event.stopPropagation();dismissHomeActivity(this.closest(\'.home-activity-card\'),\''+it.kind+'\',\''+it.seenKey+'\')">'+icon('check',13)+'</button></div>';
  }).join('')+'</div>';
}
function renderHomeShortcuts(role){return '<div class="home-shortcuts">'+homeShortcutItems(role).map(function(item){return '<button class="home-shortcut" onclick="'+item[2]+'"><i>'+icon(item[0],15)+'</i><b>'+esc(item[1])+'</b></button>'}).join('')+'</div>'}
/* Rich "at a glance" profile dashboard for the home page: trust score ring, key stats, skill levels, and free-day/booking count — all derived from real profile data. */
function renderHomeDashboardCard(role){
  var trust=myTrustPerson(role),score=blockTrustScore(trust),tier=trustTier(score);
  var completion=state.profileComplete?Math.max(88,activeRole().completion||0):(activeRole().completion||35);
  var type=calendarType(role),fourthStat=null;
  if(type==='availability'){
    var avail=getCalendar(role);
    if(avail&&avail.days)fourthStat=[avail.days.filter(function(d){return d.status==='available'}).length,'روز آزاد این هفته'];
  } else if(type==='bookings'){
    var bookings=getCalendar(role);
    if(bookings&&bookings.length!==undefined)fourthStat=[bookings.length,'نوبت پیش‌رو'];
  }
  if(!fourthStat)fourthStat=[completion+'٪','تکمیل پروفایل'];
  var skillDetails=(trust.skillDetails||[]).slice(0,3);
  var skillRows=skillDetails.map(function(item){
    var digits=String(item.experience||'').replace(/[۰-۹]/g,function(d){return '0123456789'['۰۱۲۳۴۵۶۷۸۹'.indexOf(d)]});
    var m=digits.match(/\d+/);
    var years=m?parseInt(m[0]):0;
    var level=years>=8?5:years>=6?4:years>=4?3:years>=2?2:1;
    return '<div class="dash-skill-row"><span>'+esc(item.name)+'</span><div class="dash-stars">'+[1,2,3,4,5].map(function(i){return '<i class="'+(i<=level?'on':'')+'">★</i>'}).join('')+'</div></div>';
  }).join('');
  var badges=[];
  if(state.profileComplete)badges.push('هویت تأییدشده');
  if((trust.completed||0)>=5)badges.push((trust.completed)+'+ پروژهٔ تکمیل‌شده');
  if(score>=78)badges.push('اعتماد بالا');
  if(fourthStat[1]==='روز آزاد این هفته'&&fourthStat[0]>=3)badges.push('این هفته آماده به کار');
  var badgeRow=badges.length?'<div class="dash-badges">'+badges.slice(0,3).map(function(b){return '<span class="dash-badge">'+icon('check',10)+esc(b)+'</span>'}).join('')+'</div>':'';
  return '<section class="home-dashboard" role="button" tabindex="0" onclick="go(\'myPublicProfile\')" onkeydown="if(event.key===\'Enter\')go(\'myPublicProfile\')">'
    +'<div class="dash-top"><div class="dash-score-ring" style="--pct:'+score+'"><b>'+score+'</b><span>از ۱۰۰</span></div><div class="dash-top-copy"><b>'+esc(tier)+'</b><p>نمایش عمومی پروفایل شما ‹</p>'+badgeRow+'</div></div>'
    +'<div class="dash-stats-row"><div class="dash-stat tone-a"><b>'+(trust.completed||0)+'</b><span>پروژهٔ تکمیل‌شده</span></div><div class="dash-stat tone-b"><b>'+(trust.rating||0)+' ★</b><span>امتیاز همکاری</span></div><div class="dash-stat tone-c"><b>'+fourthStat[0]+'</b><span>'+fourthStat[1]+'</span></div></div>'
    +(skillRows?'<div class="dash-skills"><b>مهارت‌های من</b>'+skillRows+'</div>':'')
  +'</section>';
}
function renderHomeSchedule(role){
  var type=calendarType(role);if(!type)return '';
  var data=getCalendar(role),title=type==='availability'?'زمان‌های آزاد من':type==='appointments'?'رزرو بعدی':'برنامه نزدیک من';
  if(type==='availability'){
    var days=data.days.map(function(day,index){var cls=day.status==='available'?'available':day.status==='booked'?'booked':'off';return '<button class="home-cal-day '+cls+'" onclick="openAvailabilityDaySheet('+index+')"><span>'+DAY_NAMES[index]+'</span><b>'+esc(day.date)+'</b></button>'}).join('');
    return '<div class="home-schedule"><div class="home-schedule-head"><i>'+icon('calendar',15)+'</i><div><b>'+title+'</b><span>برای تغییر، روز را لمس کنید</span></div><button onclick="go(\'calendar\')">همه</button></div><div class="home-cal-grid">'+days+'</div></div>';
  }
  var next=data[0];
  return '<div class="home-schedule" onclick="go(\'calendar\')"><div class="home-schedule-head" style="margin-bottom:0"><i>'+icon('calendar',15)+'</i><div><b>'+title+'</b><span>'+(next?esc(next.title)+' · '+esc(next.date)+' · '+esc(next.time):'هنوز برنامه‌ای ثبت نشده است')+'</span></div><button>همه</button></div></div>';
}
function renderOwnPublicAvailability(role){
  if(calendarType(role)!=='availability')return '';
  var days=getCalendar(role).days.filter(function(day){return day.status==='available'});
  return '<div class="sec-head"><b>زمان‌های آزاد برای هماهنگی</b><button class="btn-ghost" onclick="go(\'calendar\')">ویرایش</button></div>'+(days.length?'<div class="public-slot-grid">'+days.map(function(day){return '<button class="public-slot" onclick="go(\'calendar\')"><i>'+icon('calendar',14)+'</i><b>'+esc(day.label||('روز '+day.date))+'</b><span>'+esc(day.time||'با هماهنگی')+'</span></button>'}).join('')+'</div>':'<div class="privacy-preview"><b>روز آزادی ثبت نشده است</b><p>تقویم دسترسی را باز کنید و روزهای مناسب خود را مشخص کنید.</p></div>');
}
function renderPublicBookingCalendar(id,p){
  if(!p.slots||!p.slots.length)return '';
  return '<div class="sec-head"><b>'+esc(p.availabilityTitle||'روزهای آزاد برای هماهنگی')+'</b><span style="font-size:.46rem;color:var(--accent2);font-weight:800">برای درخواست لمس کنید</span></div><div class="public-slot-grid">'+p.slots.map(function(slot,index){return '<button class="public-slot" onclick="openBookingRequestSheet(\''+id+'\','+index+')"><i>'+icon('calendar',14)+'</i><b>'+esc(slot)+'</b><span>ثبت درخواست ‹</span></button>'}).join('')+'</div>';
}
function requestTypeIcon(type){return {job:'briefcase',project:'building',proposal:'building',consult:'message',calendar:'calendar',service:'gear',order:'truck',agreement:'check'}[type]||'doc'}
function renderRequestCard(item,direction){
  var person=direction==='incoming'?item.from:item.to,actions=direction==='incoming'&&item.status==='pending'?'<div class="request-actions"><button class="accept" onclick="respondToRequest(\''+item.id+'\',\'accepted\')">'+icon('check',12)+' تأیید</button><button class="decline" onclick="respondToRequest(\''+item.id+'\',\'declined\')">رد</button></div>':direction==='outgoing'&&item.status==='pending'?'<button class="btn-secondary" style="margin-top:10px;color:var(--danger);border-color:var(--danger)" onclick="cancelOutgoingRequest(\''+item.id+'\')">لغو درخواست</button>':'';
  return '<article class="request-card"><div class="request-card-head"><i>'+icon(requestTypeIcon(item.type),15)+'</i><div><b>'+esc(item.title)+'</b><span>'+(direction==='incoming'?'از طرف ':'ارسال به ')+esc(person||'کاربر بلوک')+'</span></div>'+trustStatus(item.status)+'</div><p>'+esc(item.detail||'جزئیات از طریق پیام‌های بلوک هماهنگ می‌شود.')+'</p>'+actions+'</article>';
}
function openOrderDetail(index){state.viewingOrderIndex=index;go('orderDetail')}
function currentOrder(){return getOrders()[state.viewingOrderIndex]}
function respondToOrder(status){
  var order=currentOrder();if(!order||order.status!=='pending')return;order.status=status==='accepted'?'confirmed':'declined';
  if(status==='accepted')getProjects(state.role||'store').unshift({title:order.title,who:order.who,stage:'agreed',rating:0,direction:'incoming'});
  getNotifications().unshift({title:status==='accepted'?'سفارش تأیید شد':'سفارش رد شد',sub:order.title+' · '+order.who,time:'همین حالا',day:'امروز',read:false,icon:status==='accepted'?'check':'alert',type:'project',target:'orders',action:'دیدن سفارش‌ها'});render();toast(status==='accepted'?'سفارش تأیید و برای آماده‌سازی ثبت شد':'سفارش رد شد');
}
function setPermissionState(kind,value){state.permissionPrefs[kind]=value;render();toast(value==='granted'?'دسترسی فعال شد':'دسترسی خاموش شد')}

function exploreDistance(value){return String(value).replace('.', '٫')+' کیلومتر'}
function renderExploreRoleRail(){
  return '<div class="explore-role-rail">'+['all'].concat(mvpVisibleRoles).map(function(key){
    var role=roleSchemas[key],ic=key==='all'?'search':mapIcon(role.icon);
    return '<button class="explore-role-pill'+(state.exploreRole===key?' active':'')+'" onclick="setExploreRole(\''+key+'\')"><i>'+icon(ic,16)+'</i><span>'+esc(EXPLORE_ROLE_LABELS[key])+'</span></button>';
  }).join('')+'</div>';
}
function renderExploreActiveFilters(){
  var f=ensureExploreFilters(),items=[];
  if(state.exploreRole!=='all')items.push([EXPLORE_ROLE_LABELS[state.exploreRole],'role','']);
  if(state.exploreCity!=='all')items.push([state.exploreCity,'city','']);
  f.skills.forEach(function(skill){items.push([skill,'skill',skill])});
  if(f.range!=='all')items.push(['تا '+f.range+' کیلومتر','range','']);
  if(f.experience!=='all')items.push([{junior:'کمتر از ۳ سال',mid:'۳ تا ۷ سال',senior:'بیش از ۷ سال'}[f.experience],'experience','']);
  if(f.availability!=='all')items.push([{now:'همین حالا',today:'امروز',week:'این هفته',flexible:'با هماهنگی'}[f.availability],'availability','']);
  if(f.resultType!=='all')items.push([{provider:'متخصص و مجری',opportunity:'فرصت پروژه',store:'فروشگاه'}[f.resultType],'resultType','']);
  if(f.verified)items.push(['تأییدشده','verified','']);
  if(f.rating!=='all')items.push(['امتیاز ۴٫۵+','rating','']);
  return items.length?'<div class="active-filter-row">'+items.map(function(item){return '<button class="active-filter-chip" onclick="removeExploreFilter(\''+item[1]+'\',\''+item[2]+'\')">'+esc(item[0])+' ×</button>'}).join('')+'</div>':'';
}
function renderExploreFeature(item){
  return '<div class="explore-feature tone-'+item.tone+'" onclick="'+openExploreItem(item)+'">'
    +'<div class="explore-feature-copy"><span class="explore-feature-label">'+icon('check',10)+' پیشنهاد ویژه بلوک</span><h3>'+esc(item.title)+'</h3><p>'+esc(item.city)+' · '+esc(item.sub)+'</p>'
    +'<div class="explore-feature-meta"><span>'+(item.rating?'★ '+esc(item.rating):esc(item.resultLabel))+'</span><span>'+esc(item.experienceLabel)+'</span><span>'+esc(item.availabilityLabel)+'</span></div></div>'
    +'<div class="explore-feature-art">'+icon(item.icon,36)+'</div></div>';
}
function renderExploreMini(item){
  return '<div class="discovery-mini tone-'+item.tone+'" onclick="'+openExploreItem(item)+'"><div class="discovery-mini-art"><span>'+esc(item.availabilityLabel)+'</span>'+icon(item.icon,27)+'</div><div class="discovery-mini-copy"><b>'+esc(item.title)+'</b><span>'+esc(exploreDistance(item.distance))+(item.rating?' · ★ '+esc(item.rating):'')+'</span></div></div>';
}
function renderExploreCard(item){
  return '<div class="discovery-card tone-'+item.tone+'" onclick="'+openExploreItem(item)+'"><div class="discovery-card-art"><span class="discover-type">'+esc(item.resultLabel)+'</span>'+(item.verified?'<i class="discover-verified">'+icon('check',11)+'</i>':'')+icon(item.icon,29)+'</div>'
    +'<div class="discovery-card-copy"><h3>'+esc(item.title)+'</h3><p>'+esc(item.city)+' · '+esc(item.availabilityLabel)+'</p><span class="discover-skill">'+esc(item.skills[0])+'</span>'+(item.isAd?'<p class="discover-ad-summary">'+esc(item.description)+'</p>':'')+'<div class="discover-card-foot">'+(item.rating?'<strong>★ '+esc(item.rating)+'</strong>':'<strong>'+esc(item.profile&&item.profile.roleLabel||'آگهی تازه')+'</strong>')+'<span>'+esc(exploreDistance(item.distance))+'</span></div></div></div>';
}
function renderExploreEmpty(){
  return '<div class="explore-empty"><i>'+icon('search',22)+'</i><b>نتیجه‌ای با این ترکیب پیدا نشد</b><p>محدوده یا یکی از فیلترها را بازتر کنید تا گزینه‌های بیشتری ببینید.</p><button class="btn-ghost" onclick="clearExploreFilters(true)">پاک کردن جست‌وجو و فیلترها</button></div>';
}

function renderAdProgress(){return '<div class="ad-progress">'+[0,1].map(function(index){return '<i class="'+(state.adStep>=index?'done':'')+'"></i>'}).join('')+'</div>'}
function renderAdAudienceChoices(){
  var config=activeAdConfig(),selected=state.adDraft.targetRoles||[];
  return '<div class="audience-grid">'+config.roles.map(function(role){var schema=roleSchemas[role],active=selected.indexOf(role)>-1;return '<button aria-pressed="'+(active?'true':'false')+'" class="audience-choice'+(active?' active':'')+'" onclick="chooseAdRole(\''+role+'\')"><i>'+icon(mapIcon(schema.icon),15)+'</i><span>'+esc(AD_ROLE_LABELS[role])+'</span><em>'+(active?'انتخاب شد':'')+'</em></button>'}).join('')+'</div><div class="audience-limit"><span>حداکثر سه گزینه انتخاب کنید</span><strong>'+selected.length+' از ۳</strong></div>';
}
function renderAdProfileNotice(){
  var categories=profileAdCategories(),warning=state.adWarnings.category;
  if(!categories.length){
    return '<div class="profile-source-card missing"><i>'+icon('alert',17)+'</i><div><b>مهارت‌های پروفایل کامل نیست</b><p>برای اینکه آگهی به افراد مرتبط نشان داده شود، ابتدا مهارت یا حوزهٔ کاری خود را در پروفایل کامل کنید.</p><button class="btn-ghost" onclick="startFullProfile()">تکمیل پروفایل</button></div></div>';
  }
  return '<div class="profile-source-card'+(warning?' missing':'')+' compact"><i>'+icon('check',17)+'</i><div><b>اطلاعات پروفایل خودکار اضافه می‌شود</b><p>مهارت‌ها، سابقه و دستمزد ثبت‌شده همراه آگهی نمایش داده می‌شود و لازم نیست دوباره آن‌ها را وارد کنید.</p></div></div>';
}
function renderAdChoiceChips(values,key){
  return '<div class="ad-chip-wrap">'+values.map(function(value){return '<button class="ad-chip'+(state.adDraft[key]===value?' active':'')+'" onclick="chooseAdField(\''+key+'\',\''+value+'\')">'+esc(value)+'</button>'}).join('')+'</div>';
}
function renderAdLocationFields(){
  var d=state.adDraft,cities=PROVINCE_CITIES[d.province]||[];
  var provinceOptions=PROVINCES.map(function(value){return '<option value="'+esc(value)+'" '+(d.province===value?'selected':'')+'>'+esc(value)+'</option>'}).join('');
  var cityOptions=cities.map(function(value){return '<option value="'+esc(value)+'" '+(d.city===value?'selected':'')+'>'+esc(value)+'</option>'}).join('');
  return '<div class="ad-location-grid"><div class="'+adFieldClass('province')+'"><label>استان پروژه '+requiredMark()+'</label><select class="input" onchange="setAdProvince(this.value)"><option value="">انتخاب استان</option>'+provinceOptions+'</select></div><div class="'+adFieldClass('city')+'"><label>شهر پروژه '+requiredMark()+'</label><select class="input" onchange="chooseAdField(\'city\',this.value)" '+(!d.province?'disabled':'')+'><option value="">'+(d.province?'انتخاب شهر':'ابتدا استان را انتخاب کنید')+'</option>'+cityOptions+'</select></div></div>';
}
function renderAdAttachmentField(){
  if(state.adDraft.type!=='consult')return '';
  var image=state.adDraft.attachment;
  return '<div class="ad-attachment"><label>عکس مرتبط با پرسش <span>اختیاری</span></label>'+(image?'<img src="'+image+'" alt="تصویر پیوست پرسش">':'')+'<label class="ad-upload">'+icon('portfolio',16)+' '+(image?'تغییر عکس':'افزودن عکس')+'<input type="file" accept="image/*" onchange="handleAdAttachment(this)"></label></div>';
}
function adFieldClass(key){return 'field'+(state.adWarnings&&state.adWarnings[key]?' field-warning':'')}
function requiredMark(){return '<span class="required-mark">ضروری</span>'}
function adAudienceTitle(type){return type==='work'?'چه کسانی آگهی کار شما را ببینند؟':type==='workforce'?'به چه نیرویی نیاز دارید؟':'چه کسانی به پرسش شما پاسخ بدهند؟'}
function renderAdReview(){
  var d=state.adDraft,config=activeAdConfig(),roles=adRoleNames(),profile=adProfileSnapshot();
  var location=d.type==='consult'?d.range:d.type==='work'?(profile.city+(profile.province?'، '+profile.province:'')||d.range):(d.city+'، '+d.province),categoryTags=(d.categories||[]).map(function(value){return '<span>'+esc(value)+'</span>'}).join('');
  var projectFacts=d.type==='consult'?'':'<div><span>دستمزد</span><b>'+esc(d.budget||'توافقی')+'</b></div><div><span>'+(d.type==='work'?'شروع همکاری':'زمان شروع')+'</span><b>'+esc(d.startTime||'با هماهنگی')+'</b></div>';
  return '<div class="ad-preview-card"><span>پیش‌نمایش در اکسپلور</span><h3>'+esc(d.title)+'</h3><p>'+esc(location)+' · '+esc(config.exploreSub)+'</p><div class="ad-preview-tags"><span>'+esc(config.shortLabel)+'</span>'+categoryTags+roles.map(function(role){return '<span>'+esc(role)+'</span>'}).join('')+(d.type!=='consult'&&d.startTime?'<span>'+esc(d.startTime)+'</span>':'')+'</div>'+(d.description?'<div class="ad-preview-description">'+esc(d.description)+'</div>':'')+(d.attachment?'<img class="ad-review-image" src="'+d.attachment+'" alt="تصویر آگهی">':'')+'</div>'
    +'<div class="ad-review-grid">'+projectFacts+'<div><span>محدوده اعلان</span><b>'+esc(d.range)+'</b></div><div><span>ارتباط</span><b>چت، ویس و تماس با اجازه</b></div><div><span>ثبت‌کننده</span><b>'+esc(profile.name)+'</b></div></div>'
    +'<div class="profile-source-card compact"><i>'+icon('user',17)+'</i><div><b>اطلاعات همراه آگهی از پروفایل</b><p>'+esc(profile.roleLabel)+' · '+esc(profile.profileTitle)+(profile.experience?' · '+esc(profile.experience):'')+'</p></div></div>'
    +'<div class="notify-preview"><i>'+icon('bell',17)+'</i><div><b>اعلان هدفمند برای <strong>'+adAudienceCount()+' کاربر</strong></b><p>پس از انتشار، گروه‌های '+esc(roles.join('، '))+' در محدودهٔ '+esc(d.range)+' اعلان دریافت می‌کنند.</p></div></div>'
    +'<div class="publish-route-note"><i>'+icon('eye',15)+'</i><div><b>این آگهی عمومی است</b><p>هم‌زمان در اکسپلور نمایش داده می‌شود و بعداً از «کارهای فعال من» قابل ویرایش خواهد بود.</p></div></div>';
}
function renderDashboardProfileReuse(){
  var categories=profileAdCategories();if(!categories.length)return '';
  return '<div class="dashboard-profile-signal"><i>'+icon('check',15)+'</i><div><b>پیشنهادها با اطلاعات پروفایل شما تنظیم شده‌اند</b><p>'+categories.slice(0,3).map(esc).join(' · ')+'</p></div></div>';
}

var PAGES={

splash:function(){
  return '<div class="page no-nav" style="display:flex;flex-direction:column;align-items:center;justify-content:space-between;text-align:center;padding:50px 26px 26px">'
  +'<div style="flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:14px">'
  +'<div class="hexlogo"><i></i></div>'
  +'<h1 style="font-size:1.8rem">بلوک</h1>'
  +'<p style="font-size:.68rem">اکوسیستم هوشمند صنعت ساختمان — کارگر، مهندس، پیمانکار و تأمین‌کننده در یک شبکهٔ امن</p>'
  +'<div class="trust-row" style="margin-top:6px"><span>هویت واقعی</span><span>تصمیم دقیق</span><span>ارتباط امن</span></div>'
  +'</div>'
  +'<div style="width:100%">'
  +'<button class="btn-primary" onclick="go(\'roleSelect\')">شروع کار با بلوک</button>'
  +'<div style="height:8px"></div>'
  +'<button class="btn-secondary" onclick="openLoginSheet()">ورود به حساب</button>'
  +'<p style="font-size:.5rem;line-height:1.8;margin-top:12px">پیش از ساخت حساب، <button class="legal-link" onclick="go(\'terms\')">قوانین استفاده</button> و <button class="legal-link" onclick="go(\'privacyPolicy\')">حریم خصوصی</button> را مرور و به‌صورت جداگانه تأیید می‌کنید.</p>'
  +'</div></div>'
},

phoneVerify:function(){
  var stage=state.otpStage||'phone';
  return topbar('تأیید شماره موبایل','این مرحله برای همه — افراد و شرکت‌ها — الزامی است')
  +'<div class="page">'
  +'<div class="card" style="margin-bottom:16px"><div style="display:flex;align-items:center;gap:10px"><div class="cicon">'+icon('shield',18)+'</div><div><b style="font-size:.66rem">چرا شماره موبایل لازم است؟</b><p style="font-size:.55rem;margin-top:2px">برای امنیت حساب و اعتماد طرف مقابل، هویت هر کاربر یا کسب‌وکار در بلوک با یک شمارهٔ تأییدشده گره می‌خورد.</p></div></div></div>'
  +(stage==='phone'
    ?'<div class="field"><label>شماره موبایل</label><input id="signupPhone" class="input" dir="ltr" value="'+esc(state.values.signupPhone||'')+'" oninput="setVal(\'signupPhone\',this.value)" placeholder="09xx xxx xxxx"></div><div class="legal-consent'+(state.legalConsent?' checked':'')+(state.legalError?' error':'')+'" role="checkbox" aria-checked="'+(state.legalConsent?'true':'false')+'" tabindex="0" onclick="toggleLegalConsent()" onkeydown="if(event.key===\'Enter\'||event.key===\' \'){event.preventDefault();toggleLegalConsent()}"><i class="legal-check">'+(state.legalConsent?icon('check',13):'')+'</i><div class="legal-consent-copy"><b>قوانین را مطالعه کردم و می‌پذیرم.</b><br>با ثبت‌نام، <button class="legal-link" onclick="event.stopPropagation();go(\'terms\')">قوانین استفاده</button> و <button class="legal-link" onclick="event.stopPropagation();go(\'privacyPolicy\')">سیاست حریم خصوصی</button> نسخهٔ '+LEGAL_VERSION+' را تأیید می‌کنم.</div></div>'+(state.legalError?'<p class="legal-error">برای ساخت حساب، این تأیید الزامی است.</p>':'')
    :'<div class="field"><label>کد تأیید</label><div class="otp-row"><input maxlength="1"><input maxlength="1"><input maxlength="1"><input maxlength="1"></div><p style="font-size:.55rem">کد ۴ رقمی به شمارهٔ '+esc(state.values.signupPhone||'')+' پیامک شد.</p></div><div class="legal-acceptance-card"><i>'+icon('shield',15)+'</i><div><b>پذیرش قوانین همراه این تأیید ثبت می‌شود</b><p>نسخهٔ '+LEGAL_VERSION+' · می‌توانید همیشه از بخش «من» آن را دوباره ببینید.</p></div></div>')
  +'</div>'
  +'<div class="dock"><button class="btn-primary" onclick="'+(stage==='phone'?'submitPhoneStage()':'confirmSignupOtp()')+'">'+(stage==='phone'?'دریافت کد':'تأیید و ادامه')+'</button></div>'
},

legalGate:function(){
  var accepted=isLegalCurrent();
  return '<div class="page no-nav" style="padding-top:26px"><div class="legal-hero"><i>'+icon('shield',18)+'</i><h2>پیش از ورود، قوانین بلوک را تأیید کنید</h2><p>نسخهٔ '+LEGAL_VERSION+' شامل قواعد حساب، انتشار آگهی، گفت‌وگوی امن و نحوهٔ استفاده از اطلاعات شماست.</p><div class="legal-meta"><span>نسخهٔ '+LEGAL_VERSION+'</span><span>به‌روزرسانی '+LEGAL_UPDATED+'</span></div></div><div class="settings-group">'+settingsRow('doc','قوانین استفاده','حقوق و مسئولیت کاربران',"go('terms')")+settingsRow('lock','سیاست حریم خصوصی','داده‌های دریافتی و کنترل شما',"go('privacyPolicy')")+settingsRow('users','قواعد انتشار و رفتار','محتوای مجاز و گزارش تخلف',"go('communityRules')")+'</div>'+(accepted?'<div class="legal-acceptance-card"><i>'+icon('check',16)+'</i><div><b>نسخهٔ فعلی را پذیرفته‌اید</b><p>برای ورود به بلوک ادامه دهید.</p></div></div>':'<div class="legal-consent'+(state.legalConsent?' checked':'')+(state.legalError?' error':'')+'" role="checkbox" aria-checked="'+(state.legalConsent?'true':'false')+'" tabindex="0" onclick="toggleLegalConsent()"><i class="legal-check">'+(state.legalConsent?icon('check',13):'')+'</i><div class="legal-consent-copy"><b>قوانین استفاده و سیاست حریم خصوصی نسخهٔ '+LEGAL_VERSION+' را می‌پذیرم.</b></div></div>')+'<button class="btn-primary" style="margin-top:12px" onclick="acceptLegalAndContinue()">'+(accepted?'ورود به بلوک':'تأیید و ورود')+'</button></div>';
},

pathChoice:function(){
  return topbar('چطور شروع می‌کنید؟')
  +'<div class="page">'
  +'<div class="choice" style="margin-bottom:12px" onclick="choosePathQuick()"><div class="cicon">'+icon('plus',18)+'</div><b>شروع سریع</b><p>همین الان با نام و شهر وارد بلوک شوید؛ تکمیل اطلاعات را بعداً از داشبورد انجام دهید.</p></div>'
  +'<div class="choice active" onclick="choosePathFull()"><div class="cicon">'+icon('shield',18)+'</div><b>تکمیل کامل اطلاعات <span style="color:var(--accent);font-weight:400">(پیشنهاد بلوک)</span></b><p>بلوک بر پایهٔ همین اطلاعاته — هرچه پروفایل شما کامل‌تر باشد، پیشنهادها و اعتماد طرف مقابل دقیق‌تر خواهد بود.</p></div>'
  +'</div>'
},

quickSetup:function(){
  var r=roleSchemas[state.role];
  return topbar('اطلاعات پایه','برای شروع همین کافی است')
  +'<div class="page">'
  +'<div class="card" style="margin-bottom:16px"><div style="display:flex;align-items:center;gap:10px"><div class="cicon">'+icon(mapIcon(r.icon),18)+'</div><div><b style="font-size:.66rem">نقش شما: '+esc(r.label)+'</b><p style="font-size:.55rem;margin-top:2px">می‌توانید بعداً از پروفایل، جزئیات بیشتری مثل مهارت‌ها و نمونه‌کارها اضافه کنید.</p></div></div></div>'
  +'<div class="field"><label>نام و نام خانوادگی</label><input id="qName" class="input" value="'+esc(state.values.quickName||'')+'" oninput="setVal(\'quickName\',this.value)" placeholder="مثلاً رضا توکلی"></div>'
  +'<div class="field"><label>شهر فعالیت</label><input id="qCity" class="input" value="'+esc(state.values.quickCity||'')+'" oninput="setVal(\'quickCity\',this.value)" placeholder="مثلاً قشم یا بندرعباس"></div>'
  +'</div>'
  +'<div class="dock"><button class="btn-primary" onclick="submitQuickSetup()">شروع استفاده از بلوک</button></div>'
},

roleSelect:function(){
  var personKeys=mvpVisibleRoles.filter(function(k){return BUSINESS_ROLES.indexOf(k)===-1});
  var businessKeys=MVP_HIDE_BUSINESS_ROLES?[]:roleOrder.filter(function(k){return BUSINESS_ROLES.indexOf(k)>-1});
  var buildCard=function(k,variant){
    var r=roleSchemas[k];
    return '<div class="choice '+variant+' '+(state.role===k?'active':'')+'" onclick="pickRole(\''+k+'\')"><span class="choice-check">'+(state.role===k?icon('check',10):'')+'</span><div class="cicon">'+icon(mapIcon(r.icon),18)+'</div><b>'+esc(r.label)+'</b><p>'+esc(r.summary)+'</p></div>';
  };
  var personCards=personKeys.map(function(k){return buildCard(k,'')}).join('');
  var businessCards=businessKeys.map(function(k){return buildCard(k,'choice-business')}).join('');
  return topbar('انتخاب نقش')
  +'<div class="page">'
  +'<div class="eyebrow">مسیر هوشمند ثبت‌نام</div>'
  +'<h2 style="margin:8px 0 4px;font-size:1rem">در بلوک چه نقشی دارید؟</h2>'
  +'<p style="font-size:.62rem;margin-bottom:16px">هر نقش، فرم، مدارک و داشبورد اختصاصی خودش را دارد. بعداً هم می‌توانید نقش دیگری اضافه کنید.</p>'
  +'<div class="choice-grid">'+personCards+'</div>'
  +(businessKeys.length?'<div class="role-section-label"><span>کسب‌وکار و تأمین‌کننده</span><p>فروش، اجاره یا تأمین با ساختار متفاوت از نقش‌های فردی بالا.</p></div><div class="choice-grid">'+businessCards+'</div>':'')
  +'</div>'
  +'<div class="dock"><button class="btn-primary" '+(state.role?'':'disabled')+' onclick="continueFromRoleSelect()">ادامه'+(state.role?' با نقش '+esc(roleSchemas[state.role].label):'')+'</button></div>'
},

contractorTypeChoice:function(){
  return topbar('نوع حساب')
  +'<div class="page">'
  +'<div class="eyebrow">قبل از ادامه</div>'
  +'<h2 style="margin:8px 0 4px;font-size:1rem">چه نوع حسابی می‌سازید؟</h2>'
  +'<p style="font-size:.62rem;margin-bottom:16px">مسیر ثبت‌نام و پروفایل شرکت و پیمانکار مستقل از هم است.</p>'
  +'<div class="choice" style="margin-bottom:10px" onclick="pickContractorType(\'company\')"><div class="cicon">'+icon('building',18)+'</div><b>شرکت ساختمانی</b><p>دارای ثبت رسمی؛ تیم اجرایی و پروژه‌های بزرگ‌تر.</p></div>'
  +'<div class="choice" onclick="pickContractorType(\'contractor\')"><div class="cicon">'+icon('briefcase',18)+'</div><b>پیمانکار</b><p>پیمانکار حقیقی با اکیپ اجرایی خودتان.</p></div>'
  +'</div>'
},

regStep:function(){
  var schema=activeRole();
  var step=schema.steps[state.step];
  var total=schema.steps.length;
  if(step.review)return renderReview();
  var body=step.collection?renderCollectionBody(step):renderStepControls(step.controls||[]);
  var warningBanner=renderStepWarningBanner(step);
  var continueLabel=currentStepWarningsShown()&&hasStepIssues(step)?'ادامه با اطلاعات ناقص':'ذخیره و ادامه';
  var isLast=state.step===total-2;
  if(state.editMode){
    return topbar(schema.label,'ویرایش این بخش','exitEditStep()')
    +'<div class="page">'
    +'<h2 style="font-size:.92rem;margin-bottom:4px">'+esc(step.title)+'</h2>'
    +'<p style="font-size:.6rem;margin-bottom:16px">'+esc(step.desc)+'</p>'
    +(step.note?'<div class="card" style="margin-bottom:14px;border-color:var(--accent);background:var(--accent-soft);display:flex;gap:9px;align-items:flex-start"><div style="color:var(--accent);margin-top:1px">'+icon('alert',15)+'</div><p style="font-size:.57rem;line-height:1.8;color:var(--ink)">'+esc(step.note)+'</p></div>':'')
    +warningBanner
    +body
    +'</div>'
    +'<div class="dock"><button class="btn-primary" onclick="saveEditStep()">'+(currentStepWarningsShown()&&hasStepIssues(step)?'ذخیرهٔ ناقص و بازگشت':'ذخیره و بازگشت')+'</button></div>';
  }
  return topbar(schema.label,'مرحله '+(state.step+1)+' از '+total,'regBack()')
  +'<div class="page">'
  +progressDots(total,state.step)
  +'<h2 style="font-size:.92rem;margin-bottom:4px">'+esc(step.title)+'</h2>'
  +'<p style="font-size:.6rem;margin-bottom:16px">'+esc(step.desc)+'</p>'
  +(step.note?'<div class="card" style="margin-bottom:14px;border-color:var(--accent);background:var(--accent-soft);display:flex;gap:9px;align-items:flex-start"><div style="color:var(--accent);margin-top:1px">'+icon('alert',15)+'</div><p style="font-size:.57rem;line-height:1.8;color:var(--ink)">'+esc(step.note)+'</p></div>':'')
  +warningBanner
  +body
  +'</div>'
  +'<div class="dock"><button class="btn-primary" onclick="regNext()">'+(isLast?'ادامه به مرور نهایی':continueLabel)+'</button>'
  +(step.skippable?'<button class="btn-ghost" style="width:100%;text-align:center;margin-top:6px" onclick="skipRegStep()">فعلاً رد می‌شوم</button>':'')
  +'</div>'
},

setupDone:function(){
  var schema=activeRole();
  var full=state.profileComplete;
  return '<div class="page no-nav">'
  +'<div class="state"><div class="state-symbol">'+icon('check',30)+'</div><h2>'+(full?'اطلاعات اصلی ثبت شد':'حساب شما آماده است')+'</h2><p>'+(full?'عکس پروفایل و نمونه‌کار از ثبت‌نام جدا شده‌اند؛ بعد از ورود، هر زمان آماده بودید آن‌ها را اضافه کنید.':'حالا وارد خانه شوید. تکمیل اطلاعات، عکس و نمونه‌کار مرحله‌به‌مرحله از داشبورد در دسترس است.')+'</p></div>'
  +'<div style="padding:0 6px;margin-top:18px"><button class="btn-primary" onclick="state.stack=[];go(\'home\')">رفتن به داشبورد</button></div>'
  +'</div>'
},

home:function(){
  var role=state.role||'worker',r=activeRole(),unreadN=unreadNotifCount(),displayName=displayNameFor(role),projects=getProjects(role).filter(function(project){return project.stage!=='done'&&project.stage!=='declined'}),jobs=relevantJobItems(3),firstProject=projects[0];
  var opportunitySection=jobs.length?'<div class="home-section-head"><div><b>کارهای مناسب شما</b><span>هماهنگ با پروفایل شما</span></div><button onclick="openRelevantJobs()">دیدن همه</button></div><div class="home-opportunity-rail">'+jobs.map(renderHomeJobCard).join('')+'</div>':'';
  var activeSection=firstProject?'<div class="home-section-head"><div><b>کار در حال پیگیری</b><span>'+projects.length+' مورد فعال</span></div><button onclick="go(\'myProjects\')">همه</button></div><div class="home-active-card" onclick="openProjectDetail('+getProjects(role).indexOf(firstProject)+')"><i>'+icon('building',17)+'</i><div><b>'+esc(firstProject.title)+'</b><p>'+esc(firstProject.who)+'</p></div><span>'+esc(STAGE_LABELS[firstProject.stage])+'</span></div>':'';
  return '<div class="page home-page">'
    +'<header class="home-header">'+renderMyAvatar(role)+'<div class="home-welcome"><b>سلام '+esc((displayName||'کاربر بلوک').split(' ')[0])+'</b><span>'+esc(r.profileTitle||r.label)+' · '+esc(displayCityFor(role))+'</span></div><button class="home-theme" aria-label="تغییر حالت روشن و تیره" onclick="toggleModeQuick()">'+icon(state.mode==='dark'?'moon':'sun',13)+'<span>'+(state.mode==='dark'?'تیره':'روشن')+'</span></button><button class="home-alert" aria-label="اعلان‌ها" onclick="go(\'notifications\')">'+(unreadN?'<span class="dot-indicator"></span>':'')+icon('bell',16)+'</button></header>'
    +renderHomeDashboardCard(role)+renderHomeShortcuts(role)+renderHomeActivityFeed(role)+renderProfileSetupNudge(role)+renderHomeSchedule(role)+opportunitySection+activeSection
    +'</div>'+bottomNav('home')
},

featureHub:function(){
  var role=state.role||'worker',items=[];
  if(jobFeedRole(role))items.push(['briefcase','فرصت‌های مناسب من','فقط کارهای مرتبط با پروفایل',"go('relevantJobs')"]);
  if(role==='store')items.push(['truck','سفارش‌ها و استعلام‌ها','پیگیری درخواست‌های مشتریان',"go('orders')"],['plus','ثبت کالای تازه','افزودن کالا یا به‌روزرسانی موجودی',"go('myProducts')"]);
  else if(role==='materialsSupplier')items.push(['truck','سفارش‌ها و استعلام‌ها','پیگیری درخواست‌های مشتریان',"go('orders')"],['plus','ثبت محصول جدید','افزودن محصول یا به‌روزرسانی موجودی',"go('myProducts')"]);
  else if(role==='machinery')items.push(['truck','سفارش‌ها و استعلام‌ها','پیگیری درخواست‌های مشتریان',"go('orders')"],['plus','ثبت خدمت جدید','افزودن دستگاه یا خدمت تازه',"go('myProducts')"]);
  else items.push(['plus','ثبت آگهی عمومی','پیدا کردن کار، نیرو یا مشاور',"go('newRequest')"]);
  if(calendarType(role))items.push(['calendar',calendarType(role)==='availability'?'تقویم دسترسی':'تقویم و رزروها','ثبت روز آزاد و برنامه‌های هماهنگ‌شده',"go('calendar')"]);
  items=items.concat([['check','درخواست‌ها','تأیید، رد و پیگیری درخواست‌های ارسالی و دریافتی',"go('requestsCenter')"],['shield','کارت اعتبار من','سن، سابقه، پروژه‌ها، نظرها و امتیاز بلوک',"openTrustCard('self')"],['building','کارهای من','همکاری‌ها و پروژه‌های در حال پیگیری',"go('myProjects')"],['search','جست‌وجو و اکسپلور','پیدا کردن افراد و خدمات نزدیک',"openDataPage('explore','در حال آماده‌کردن نتایج مرتبط')"],['message','پیام‌ها','گفتگوها و هماهنگی‌های امن',"openDataPage('messages','در حال دریافت پیام‌ها')"],['bell','اعلان‌ها','پاسخ‌ها و تغییر وضعیت‌ها',"go('notifications')"],['portfolio','نمونه‌کارها','مدیریت عکس‌ها و سابقهٔ اجرا',"go('portfolio')"],['wrench','وضعیت برنامه','اینترنت، همگام‌سازی و دسترسی‌ها',"go('systemStatus')"],['user','پروفایل من','اطلاعات، تنظیمات و حساب',"go('profile')"]]);
  return topbar('همه امکانات','هر کاری را از یک جای ساده شروع کنید')+'<div class="page"><div class="feature-hub-grid">'+items.map(function(item){return '<button class="feature-tile" onclick="'+item[3]+'"><i>'+icon(item[0],17)+'</i><b>'+esc(item[1])+'</b><span>'+esc(item[2])+'</span></button>'}).join('')+'</div></div>';
},

relevantJobs:function(){
  var jobs=relevantJobItems(),role=state.role||'worker',categories=profileAdCategories();
  return topbar('کارهای مناسب من','پیشنهادشده برای '+activeRole().label)+'<div class="page"><div class="privacy-preview"><b>چرا این کارها را می‌بینید؟</b><p>بلوک نقش، مهارت‌ها، شهر و محدودهٔ فعالیت شما را با نیاز کارفرما مقایسه می‌کند. آگهی نامرتبط در این صفحه نمایش داده نمی‌شود.</p>'+(categories.length?'<div class="chip-row" style="margin-top:8px">'+categories.slice(0,4).map(function(value){return '<span class="chip chip-compact">'+esc(value)+'</span>'}).join('')+'</div>':'<button class="btn-ghost" onclick="startFullProfile()">تکمیل مهارت‌های پروفایل</button>')+'</div>'+(jobs.length?'<div class="jobs-grid">'+jobs.map(renderHomeJobCard).join('')+'</div>':'<div class="explore-empty"><i>'+icon('briefcase',22)+'</i><b>فعلاً کار هماهنگی پیدا نشد</b><p>با تکمیل مهارت‌ها و شهر فعالیت، پیشنهادهای دقیق‌تری دریافت می‌کنید.</p><button class="btn-ghost" onclick="startFullProfile()">تکمیل پروفایل</button></div>')+'</div>';
},

jobDetail:function(){
  var job=currentJobOpportunity(),sent=state.jobInterestIds.indexOf(job.id)>-1;
  return topbar('جزئیات فرصت کاری','هماهنگ با پروفایل شما')+'<div class="page"><div class="job-detail-hero"><span>فرصت پیشنهادی بلوک</span><h2>'+esc(job.title)+'</h2><p>'+esc(job.employer)+' · '+esc(job.city)+' · '+esc(job.distance).replace('.', '٫')+' کیلومتر از شما</p><div class="ad-preview-tags">'+job.skills.map(function(skill){return '<span>'+esc(skill)+'</span>'}).join('')+'</div></div><div class="job-facts"><div><span>دستمزد</span><b>'+esc(job.pay)+'</b></div><div><span>شروع</span><b>'+esc(job.start)+'</b></div><div><span>مدت تقریبی</span><b>'+esc(job.duration)+'</b></div><div><span>ارتباط</span><b>فقط چت بلوک</b></div></div><div class="ad-detail-section"><b>شرح کار</b><p>'+esc(job.description)+'</p></div><div class="chat-only-card"><i>'+icon('shield',17)+'</i><div><b>قبل از شروع هماهنگ کنید</b><p>دستمزد، ساعت کار، ایمنی، ابزار و زمان شروع را داخل چت بلوک روشن و ثبت کنید.</p></div></div><button class="btn-primary" '+(sent?'disabled':'')+' onclick="sendJobInterest(\''+job.id+'\')">'+(sent?'درخواست همکاری ارسال شده':'برای این کار آماده‌ام')+'</button><div style="height:8px"></div><button class="btn-secondary" onclick="openConversationForPerson(\''+job.person+'\')">گفتگو با کارفرما</button></div>';
},

trustCard:function(){
  var person=currentTrustPerson(),score=blockTrustScore(person),reviews=person.reviews||[],rating=Math.round((Number(person.rating)||0)/5*55),project=Math.round(Math.min(Number(person.completed)||0,40)/40*25),review=Math.round(Math.min(reviews.length,5)/5*10),identity=person.verified?10:0;
  return topbar('کارت هویت و اعتبار بلوک','اطلاعات عمومی و سابقهٔ واقعی')+'<div class="page">'+renderPublicTrustCard(person,state.trustPersonId||'self')+renderPublicSkillDetails(person,state.trustPersonId||'self')+'<div class="trust-explain"><h3>اعتبار '+score+' از ۱۰۰ چگونه محاسبه شده؟</h3><p>این امتیاز از میانگین نظرها، تعداد پروژه‌های تکمیل‌شده، تأیید هویت و فعالیت واقعی حساب در بلوک ساخته می‌شود. امتیاز بالا تضمین انجام کار نیست؛ شرایط قرارداد و ایمنی را جدا بررسی کنید.</p><div class="trust-meter"><i style="width:'+score+'%"></i></div><div class="trust-breakdown"><div><span>امتیاز همکاری‌ها</span><b>'+rating+' از ۵۵</b></div><div><span>پروژه‌های تکمیل‌شده</span><b>'+project+' از ۲۵</b></div><div><span>نظرهای ثبت‌شده</span><b>'+review+' از ۱۰</b></div><div><span>تأیید هویت</span><b>'+identity+' از ۱۰</b></div></div></div><div class="sec-head"><b>نظرها دربارهٔ این حساب</b><span style="font-size:.46rem;color:var(--muted)">'+reviews.length+' نظر</span></div>'+renderReviews(reviews)+'<div class="chat-safety">'+icon('lock',14)+'<span>شماره فقط وقتی روی این کارت نمایش داده می‌شود که صاحب پروفایل «نمایش شمارهٔ تماس» را در تنظیمات حریم خصوصی فعال کرده باشد.</span></div></div>';
},

requestsCenter:function(){
  var incoming=getIncomingRequests(),outgoing=getOutgoingRequests(),tab=state.requestTab||'incoming',items=tab==='incoming'?incoming:outgoing,empty=tab==='incoming'?'درخواست تازه‌ای برای پاسخ ندارید.':'هنوز درخواستی ارسال نکرده‌اید.';
  return topbar('درخواست‌ها','تأیید، رد و پیگیری در یک صفحه')+'<div class="page"><div class="request-tabs"><button class="'+(tab==='incoming'?'active':'')+'" onclick="setRequestTab(\'incoming\')">دریافتی‌ها'+(pendingRequestCount()?' · '+pendingRequestCount():'')+'</button><button class="'+(tab==='outgoing'?'active':'')+'" onclick="setRequestTab(\'outgoing\')">ارسالی‌ها · '+outgoing.length+'</button></div><div class="chat-safety">'+icon('info',14)+'<span>پیش از تأیید، دستمزد، زمان شروع، محل کار و شرایط ایمنی را در چت بلوک هماهنگ کنید.</span></div>'+(items.length?items.map(function(item){return renderRequestCard(item,tab)}).join(''):'<div class="empty-inbox"><i>'+icon('check',23)+'</i><b>همه‌چیز مرتب است</b><p>'+empty+'</p></div>')+'</div>';
},

loading:function(){return '<div class="page no-nav"><div class="system-state" style="padding-bottom:15px"><div class="hexlogo hexlogo-pulse" style="margin:0 auto 14px"><i></i></div><h2>'+esc(state.loadingLabel||'در حال بارگذاری')+'</h2><p>چند لحظه صبر کنید؛ اطلاعات مناسب حساب شما آماده می‌شود.</p></div><div class="skeleton-card"></div><div class="skeleton-card"></div><div class="skeleton-card" style="height:58px"></div></div>'},

offline:function(){return '<div class="page no-nav"><div class="system-state"><div class="system-state-art warning">'+icon('alert',31)+'</div><h2>اتصال اینترنت قطع است</h2><p>صفحه‌های ذخیره‌شده و اطلاعات پروفایل در دسترس‌اند؛ ارسال پیام، درخواست و دریافت اطلاعات تازه بعد از اتصال انجام می‌شود.</p><button class="btn-primary" onclick="retryConnection()">بررسی دوبارهٔ اتصال</button><div style="height:8px"></div><button class="btn-secondary" onclick="back()">ادامه با اطلاعات ذخیره‌شده</button></div></div>'},

unavailable:function(){return '<div class="page no-nav"><div class="system-state"><div class="system-state-art danger">'+icon('wrench',31)+'</div><h2>این بخش فعلاً در دسترس نیست</h2><p>اطلاعات شما از بین نرفته است. دوباره تلاش کنید یا اگر مشکل ادامه داشت از پشتیبانی بلوک کمک بگیرید.</p><button class="btn-primary" onclick="state.page=state.unavailableTarget&&PAGES[state.unavailableTarget]?state.unavailableTarget:\'home\';render()">تلاش دوباره</button><div style="height:8px"></div><button class="btn-secondary" onclick="go(\'supportCenter\')">ارتباط با پشتیبانی</button></div></div>'},

permissionDenied:function(){var a=state.accessState||{};return '<div class="page no-nav"><div class="system-state"><div class="system-state-art warning">'+icon('lock',31)+'</div><h2>'+esc(a.title||'اجازهٔ دسترسی ندارید')+'</h2><p>'+esc(a.message||'این صفحه یا قابلیت برای نقش یا سطح دسترسی فعلی شما فعال نیست.')+'</p><button class="btn-primary" onclick="state.stack=[];go(\''+esc(a.backTarget||'home')+'\')">رفتن به بخش مرتبط</button><div style="height:8px"></div><button class="btn-secondary" onclick="state.stack=[];go(\'home\')">بازگشت به خانه</button></div></div>'},

systemStatus:function(){
  var prefs=state.permissionPrefs,status=function(value){return value==='granted'?'فعال':value==='denied'?'خاموش':'نیازمند اجازه'};
  return topbar('وضعیت برنامه و دسترسی‌ها','اینترنت، همگام‌سازی و مجوزها')+'<div class="page"><div class="calendar-summary"><span>وضعیت فعلی</span><h2>'+(state.online?'همه خدمات اصلی آماده‌اند':'برنامه در حالت آفلاین است')+'</h2><p>'+(state.online?'اطلاعات تازه قابل دریافت و درخواست‌ها قابل ارسال هستند.':'پس از وصل‌شدن اینترنت، درخواست‌ها و پیام‌ها دوباره همگام می‌شوند.')+'</p></div><div class="system-check"><i>'+icon(state.online?'check':'alert',15)+'</i><div><b>اتصال اینترنت</b><span>برای پیام، اعلان و اطلاعات تازه</span></div><em>'+(state.online?'متصل':'قطع')+'</em></div><button class="system-check" style="width:100%;font-family:inherit" onclick="requestPermission(\'location\')"><i>'+icon('pin',15)+'</i><div><b>موقعیت تقریبی</b><span>برای نمایش افراد و کارهای نزدیک</span></div><em>'+status(prefs.location)+'</em></button><button class="system-check" style="width:100%;font-family:inherit" onclick="requestPermission(\'camera\')"><i>'+icon('portfolio',15)+'</i><div><b>دوربین</b><span>برای عکس پروفایل و نمونه‌کار</span></div><em>'+status(prefs.camera)+'</em></button><button class="system-check" style="width:100%;font-family:inherit" onclick="requestPermission(\'microphone\')"><i>'+icon('mic',15)+'</i><div><b>میکروفن</b><span>برای ضبط و ارسال پیام صوتی</span></div><em>'+status(prefs.microphone)+'</em></button><button class="system-check" style="width:100%;font-family:inherit" onclick="requestPermission(\'files\')"><i>'+icon('doc',15)+'</i><div><b>فایل‌ها و تصاویر</b><span>برای مدارک و پیوست گفت‌وگو</span></div><em>'+status(prefs.files)+'</em></button><div class="chat-safety">'+icon('shield',14)+'<span>دسترسی‌ها فقط هنگام استفاده از همان قابلیت درخواست می‌شوند و هر زمان قابل خاموش‌کردن هستند.</span></div></div>';
},

myProjects:function(){
  var role=state.role||'worker';
  var list=getProjects(role);
  var rows=list.length?list.map(function(p,idx){return '<div class="list-row" onclick="openProjectDetail('+idx+')"><div class="ricon">'+icon('building',16)+'</div><div class="rcopy"><b>'+esc(p.title)+'</b><span>'+esc(p.who)+'</span></div><span class="badge badge-'+p.stage+'">'+STAGE_LABELS[p.stage]+'</span></div>'}).join(''):'<p style="font-size:.6rem">هنوز پروژه‌ای ثبت نشده است.</p>';
  return topbar('کارهای فعال من')+'<div class="page">'+rows+'</div>';
},

notifications:function(){
  var list=getNotifications(),filter=state.notificationFilter||'all',unread=unreadNotifCount();
  var entries=list.map(function(n,idx){return {n:n,idx:idx}}).filter(function(entry){var n=entry.n;if(filter==='all')return true;if(filter==='unread')return !n.read;if(filter==='account')return n.type==='account'||n.type==='profile';return n.type===filter});
  var lastDay='',rows=entries.map(function(entry){var n=entry.n,day=n.day||'امروز',dayTitle=day!==lastDay?'<div class="notification-day">'+esc(day)+'</div>':'';lastDay=day;return dayTitle+'<div class="notif-row '+(n.read?'':'unread')+'" onclick="openNotification('+entry.idx+')"><div class="ricon">'+icon(n.icon,16)+'</div><div class="rcopy" style="flex:1"><b>'+esc(n.title)+'</b><p>'+esc(n.sub)+'</p><span>'+esc(n.time)+'</span>'+(n.action?'<em class="notif-action">'+esc(n.action)+' ‹</em>':'')+'</div>'+(n.read?'':'<span class="notif-dot"></span>')+'</div>'}).join('');
  var tabs=[['all','همه'],['unread','خوانده‌نشده'],['message','پیام‌ها'],['project','پروژه‌ها'],['account','حساب']];
  return topbar('اعلان‌ها','پیام‌ها، پروژه‌ها و وضعیت حساب')+'<div class="page"><div class="message-head"><div><b style="font-size:.65rem;color:var(--ink)">مرکز اعلان‌های بلوک</b><p style="font-size:.5rem;margin-top:2px">هر اعلان شما را مستقیم به بخش مربوط می‌برد.</p></div><button class="icon-btn" aria-label="تنظیمات اعلان" onclick="go(\'notificationSettings\')">'+icon('gear',16)+'</button></div>'
    +'<div class="notification-summary"><div><strong>'+unread+'</strong><span>اعلان خوانده‌نشده</span></div><div><strong>'+list.length+'</strong><span>اعلان اخیر</span></div></div>'
    +'<div class="inbox-summary"><span>اعلان‌های مهم را از دست ندهید.</span><button onclick="markAllNotificationsRead()">خواندن همه</button></div>'
    +'<div class="message-tabs">'+tabs.map(function(tab){return '<button class="message-tab'+(filter===tab[0]?' active':'')+'" onclick="setNotificationFilter(\''+tab[0]+'\')">'+tab[1]+'</button>'}).join('')+'</div>'
    +(rows||'<div class="empty-inbox"><i>'+icon('bell',23)+'</i><b>اعلانی در این بخش نیست</b><p>اعلان‌های تازهٔ همین دسته اینجا نمایش داده می‌شوند.</p></div>')+'</div>';
},

notificationSettings:function(){
  var prefs=getNotificationPrefs(),items=[['messages','پیام‌های تازه','برای پیام‌های خوانده‌نشده و پاسخ‌های جدید'],['projects','پروژه و آگهی','پیشنهاد، رزرو، تغییر وضعیت و پاسخ به آگهی'],['profile','پروفایل و اعتبار','تأیید مدارک، امتیاز و تکمیل پروفایل'],['system','اعلان‌های ضروری بلوک','امنیت حساب و تغییرات مهم سرویس'],['sound','صدا و لرزش','هشدار صوتی برای اعلان‌های تازه']];
  return topbar('تنظیمات اعلان‌ها','انتخاب کنید چه چیزی شما را باخبر کند')+'<div class="page"><div class="chat-safety">'+icon('shield',15)+'<span>اعلان‌های امنیتی مهم همیشه داخل برنامه نمایش داده می‌شوند.</span></div><div class="setting-section-title">موضوع اعلان‌ها</div>'+items.map(function(item,idx){return '<div class="notification-pref"><div><b>'+item[1]+'</b><p>'+item[2]+'</p></div><div class="switch '+(prefs[item[0]]?'on':'')+'" role="switch" aria-checked="'+(prefs[item[0]]?'true':'false')+'" onclick="toggleNotificationPref(\''+item[0]+'\')"><i></i></div></div>'}).join('')+'</div>';
},

profilePhoto:function(){
  var role=state.role||'worker',photo=state.values.profilePhoto;
  return topbar('عکس پروفایل','این مرحله از ثبت‌نام جداست')+'<div class="page"><div class="profile-photo-card"><div class="profile-photo-preview">'+(photo?'<img src="'+photo+'" alt="عکس انتخاب‌شده">':esc(activeRole().initials||'ب'))+'</div><h2>یک عکس روشن از خودتان</h2><p>صورت یا نشان مجموعه واضح باشد. هر زمان خواستید می‌توانید عکس را تغییر دهید.</p><label class="btn-secondary" style="display:flex;align-items:center;justify-content:center;gap:7px;cursor:pointer">'+icon('portfolio',16)+' '+(photo?'انتخاب عکس دیگر':'انتخاب عکس')+'<input type="file" accept="image/*" style="display:none" onchange="handlePhotoField(this,\'profilePhoto\')"></label><div style="height:9px"></div><button class="btn-primary" '+(photo?'':'disabled')+' onclick="saveProfilePhoto()">ذخیره عکس</button></div></div>';
},

portfolio:function(){
  var role=state.role||'worker';
  var items=getPortfolio(role);
  var intro=state.portfolioSetupCompleted?'':'<div class="privacy-preview"><b>نمونه‌کار از ثبت‌نام جداست</b><p>فقط یک کار واقعی را با عنوان و عکس اضافه کنید. اگر موارد فعلی کافی‌اند، آن‌ها را تأیید کنید.</p></div>';
  return topbar('نمونه‌کارها','بعد از ثبت‌نام و قابل ویرایش')+'<div class="page">'+intro+renderPortfolioCards(items)+'<div style="height:14px"></div><button class="btn-primary" onclick="openPortfolioSheet()">'+icon('plus',14)+' افزودن نمونه‌کار</button>'+(state.portfolioSetupCompleted?'':'<div style="height:8px"></div><button class="btn-secondary" onclick="markPortfolioSetupDone()">همین موارد کافی است</button>')+'</div>';
},

guarantor:function(){
  var role=state.role||'worker';
  var list=getGuarantors(role);
  var rows=list.length?list.map(function(g){return '<div class="list-row"><div class="ricon">'+icon('shield',16)+'</div><div class="rcopy"><b>'+esc(g.name)+'</b><span>'+esc(g.relation)+'</span></div><span class="badge badge-'+(g.status==='confirmed'?'inprogress':'agreed')+'">'+(g.status==='confirmed'?'تأیید شده':'در انتظار')+'</span></div>'}).join(''):'<p style="font-size:.6rem;margin-bottom:12px">هنوز معرفی اضافه نکرده‌اید.</p>';
  return topbar('اعتبار و قیم')
  +'<div class="page"><div class="card" style="margin-bottom:14px"><b style="font-size:.66rem">معرف یا قیم چیست؟</b><p style="font-size:.55rem;margin-top:4px;line-height:1.7">فردی که شما را می‌شناسد و اعتبار شما را نزد بلوک تأیید می‌کند. هرچه معرف بیشتری داشته باشید، اعتماد کارفرماها به شما بیشتر می‌شود.</p></div>'
  +'<div class="sec-head"><b>معرف‌های شما</b></div>'+rows
  +'<button class="btn-secondary" style="margin-top:6px" onclick="openGuarantorSheet()">'+icon('plus',14)+' افزودن معرف</button></div>';
},

calendar:function(){
  var role=state.role||'worker';
  var type=calendarType(role);
  var data=getCalendar(role);
  if(type==='availability'){
    var strip='<div class="cal-strip">'+data.days.map(function(d,i){
      var cls=d.status==='available'?'cal-available':d.status==='booked'?'cal-booked':'cal-off';
      return '<button class="cal-pill '+cls+'" onclick="openAvailabilityDaySheet('+i+')"><span>'+DAY_NAMES[i]+'</span><b>'+d.date+'</b><em>'+(d.status==='available'?esc(d.time||'آزاد'):d.status==='booked'?'رزرو':'بسته')+'</em></button>';
    }).join('')+'</div>';
    var legend='<div class="cal-legend"><span><i class="dot-available"></i>آزاد</span><span><i class="dot-booked"></i>رزروشده</span><span><i class="dot-off"></i>غیرفعال</span></div>';
    var reqHead='<div class="sec-head"><b>درخواست‌های رزرو</b></div>';
    var reqs=data.requests.length?data.requests.map(function(request,i){var status=request.status||'pending';return '<div class="calendar-request"><div class="calendar-request-head"><i>'+icon('calendar',15)+'</i><div><b>'+esc(request.title)+'</b><span>'+esc(request.date)+' · '+esc(request.who)+'</span></div>'+trustStatus(status)+'</div>'+(status==='pending'?'<div class="calendar-request-actions"><button class="accept" onclick="acceptRequest('+i+')">'+icon('check',11)+' تأیید هماهنگی</button><button class="decline" onclick="declineRequest('+i+')">رد درخواست</button></div>':'<div class="privacy-preview" style="margin:9px 0 0"><p>پاسخ شما ثبت شده و برای طرف مقابل اعلان ارسال شده است.</p></div>')+'</div>'}).join(''):'<div class="privacy-preview"><b>درخواست تازه‌ای ندارید</b><p>وقتی کارفرما یکی از روزهای آزاد پروفایل عمومی شما را انتخاب کند، درخواست اینجا نمایش داده می‌شود.</p></div>';
    var availableCount=data.days.filter(function(day){return day.status==='available'}).length;
    return topbar('تقویم دسترسی','روز و زمان مناسب برای هماهنگی')
    +'<div class="page"><div class="calendar-summary"><span>مرداد ۱۴۰۵</span><h2>'+availableCount+' روز آزاد ثبت شده</h2><p>یک روز را لمس کنید و «صبح»، «عصر» یا «تمام روز» را انتخاب کنید. همین زمان‌ها در پروفایل عمومی شما دیده می‌شوند.</p></div>'+strip+legend+'<div class="chat-safety">'+icon('lock',14)+'<span>روزهای رزروشده قفل می‌شوند تا هماهنگی شما به‌اشتباه تغییر نکند.</span></div>'+reqHead+reqs+'</div>';
  }
  var rows=data.length?'<div class="calendar-booking-grid">'+data.map(function(booking,i){return '<article class="calendar-booking" onclick="openBookingSheet('+i+')"><i>'+icon('calendar',15)+'</i><b>'+esc(booking.title)+'</b><span>'+esc(booking.date)+' · '+esc(booking.time)+'<br>'+esc(booking.who)+'</span></article>'}).join('')+'</div>':'<div class="privacy-preview"><b>هنوز برنامه‌ای ثبت نشده است</b><p>با دکمهٔ زیر اولین رزرو یا برنامه را اضافه کنید.</p></div>';
  return topbar(type==='appointments'?'رزروهای من':'تقویم پروژه‌ها')
  +'<div class="page"><div class="calendar-summary"><span>برنامهٔ نزدیک</span><h2>'+(data[0]?esc(data[0].title):'برنامه‌ای ندارید')+'</h2><p>'+(data[0]?esc(data[0].date)+' · '+esc(data[0].time)+' · '+esc(data[0].who):'زمان هماهنگی جدید را ثبت کنید تا فراموش نشود.')+'</p></div>'+rows+'<button class="btn-secondary" style="margin-top:12px" onclick="openBookingSheet(-1)">'+icon('plus',14)+' افزودن برنامه</button></div>';
},

myProducts:function(){
  var schema=activeRole(),colKey=schema.primaryCollection,col=schema.collections&&schema.collections[colKey];
  var title=col?col.label:'کالاها و خدمات';
  return '<div class="page" style="padding-top:16px"><div class="message-head"><h2>'+esc(title)+'</h2></div><p style="font-size:.5rem;color:var(--muted);margin:-6px 2px 12px">افزودن سریع، نمایش عمومی و ویرایش قیمت از همین‌جا</p>'
  +renderMyProductsPreview()
  +'</div>'+bottomNav('myProducts');
},
orders:function(){
  var orders=getOrders(),isBusiness=BUSINESS_ROLES.indexOf(state.role)>-1;
  var rows=orders.length?orders.map(function(o,index){return '<div class="list-row" onclick="openOrderDetail('+index+')"><div class="ricon">'+icon('truck',16)+'</div><div class="rcopy"><b>'+esc(o.title)+'</b><span>'+esc(o.who)+' · '+esc(o.date)+'</span></div><span class="badge badge-'+o.status+'">'+esc(ORDER_STATUS_LABEL[o.status])+'</span></div>'}).join(''):'<div class="empty-inbox"><i>'+icon('truck',23)+'</i><b>هنوز سفارشی ثبت نشده است</b><p>سفارش‌ها و استعلام‌های مشتریان اینجا نمایش داده می‌شوند.</p></div>';
  if(isBusiness){
    return '<div class="page" style="padding-top:16px"><div class="message-head"><h2>سفارش‌ها و استعلام‌ها</h2></div><p style="font-size:.5rem;color:var(--muted);margin:-6px 2px 12px">هر سفارش را باز و پاسخ خود را ثبت کنید</p>'+rows+'</div>'+bottomNav('orders');
  }
  return topbar('سفارش‌ها و استعلام‌ها','هر سفارش را باز و پاسخ خود را ثبت کنید')+'<div class="page">'+rows+'</div>';
},

orderDetail:function(){
  var order=currentOrder();if(!order)return topbar('جزئیات سفارش')+'<div class="page"><div class="empty-inbox"><b>سفارش پیدا نشد</b><p>ممکن است سفارش حذف یا جابه‌جا شده باشد.</p></div></div>';
  var status=order.status==='confirmed'?'accepted':order.status==='declined'?'declined':'pending';
  return topbar('جزئیات سفارش',ORDER_STATUS_LABEL[order.status])+'<div class="page"><div class="job-detail-hero"><span>سفارش یا استعلام</span><h2>'+esc(order.title)+'</h2><p>'+esc(order.who)+' · '+esc(order.date)+'</p></div><div class="job-facts"><div><span>وضعیت</span><b>'+esc(ORDER_STATUS_LABEL[order.status])+'</b></div><div><span>روش ارتباط</span><b>چت بلوک</b></div><div><span>آماده‌سازی</span><b>پس از تأیید شما</b></div><div><span>پرداخت</span><b>پس از توافق</b></div></div><div class="chat-safety">'+icon('info',14)+'<span>پیش از تأیید، موجودی، قیمت نهایی، هزینهٔ ارسال و زمان تحویل را بررسی کنید.</span></div>'+(order.status==='pending'?'<div class="request-actions"><button class="accept" onclick="respondToOrder(\'accepted\')">'+icon('check',12)+' تأیید سفارش</button><button class="decline" onclick="respondToOrder(\'declined\')">رد سفارش</button></div>':'<div class="privacy-preview"><b>'+trustStatus(status)+'</b><p>پاسخ شما ثبت شده و در اعلان‌های طرف مقابل نمایش داده می‌شود.</p></div>')+'</div>';
},

postProject:function(){
  var role=state.role||'worker';
  var meta=projectMeta(role);
  var d=state.projectDraft;
  var target=state.projectTarget?PEOPLE_SEED[state.projectTarget]:null;
  var categoryOptions=(target&&target.skills&&target.skills.length)?target.skills:PROJECT_CATEGORIES;
  var chips=categoryOptions.map(function(c){return '<div class="chip'+(d.category===c?' active':'')+'" onclick="setProjectCategory(\''+c+'\')">'+esc(c)+'</div>'}).join('');
  var cities=PROVINCE_CITIES[d.province]||[];
  var provinceOptions=PROVINCES.map(function(v){return '<option value="'+esc(v)+'" '+(d.province===v?'selected':'')+'>'+esc(v)+'</option>'}).join('');
  var cityOptions=cities.map(function(v){return '<option value="'+esc(v)+'" '+(d.city===v?'selected':'')+'>'+esc(v)+'</option>'}).join('');
  var suggestedRate=target&&(target.rateAmount||(target.skillDetails&&target.skillDetails[0]&&target.skillDetails[0].rateAmount));
  var targetTitle=target&&target.requestKind==='service'?'درخواست خدمت از '+target.name:'ثبت پروژه برای '+(target?target.name:'');
  return topbar(target?targetTitle:meta.title)
  +'<div class="page">'
  +(target?'<div class="card" style="margin-bottom:14px;display:flex;align-items:center;gap:10px"><div class="avatar" style="width:34px;height:34px;font-size:.58rem;border-radius:11px">'+esc(target.initials)+'</div><p style="font-size:.58rem">این '+(target.requestKind==='service'?'درخواست خدمت':'پروژه')+' مستقیماً برای <b style="color:var(--ink)">'+esc(target.name)+'</b> ارسال می‌شود.</p></div>':'')
  +'<div class="field"><label>'+meta.fieldLabel+'</label><input class="input" value="'+esc(d.title||'')+'" oninput="setProjectField(\'title\',this.value)" placeholder="مثلاً اجرای نمای ساختمان مسکونی"></div>'
  +'<div class="field"><label>دسته‌بندی</label><div class="chip-row">'+chips+'</div></div>'
  +'<div class="field"><label>استان</label><select class="input" onchange="setProjectProvince(this.value)"><option value="">انتخاب استان</option>'+provinceOptions+'</select></div>'
  +'<div class="field"><label>شهر</label><select class="input" onchange="setProjectField(\'city\',this.value)" '+(!d.province?'disabled':'')+'><option value="">'+(d.province?'انتخاب شهر':'ابتدا استان را انتخاب کنید')+'</option>'+cityOptions+'</select></div>'
  +'<div class="field"><label>'+meta.priceLabel+' (اختیاری)</label><input class="input" value="'+esc(d.price||'')+'" oninput="setProjectField(\'price\',this.value)" placeholder="'+(suggestedRate?'دستمزد ایشان از '+esc(suggestedRate)+' — می‌توانید همین یا بیشتر پیشنهاد دهید':'مبلغ تقریبی، اگر مشخص است')+'"></div>'
  +'<div class="field"><label>توضیحات</label><textarea class="textarea" oninput="setProjectField(\'desc\',this.value)" placeholder="جزئیات بیشتر برای طرف مقابل بنویسید…">'+esc(d.desc||'')+'</textarea></div>'
  +'</div>'
  +'<div class="dock"><button class="btn-primary" onclick="submitProject()">'+(target?'ارسال به '+target.name:'انتشار')+'</button></div>';
},

projectDone:function(){
  var target=state.projectTarget?PEOPLE_SEED[state.projectTarget]:null;
  return '<div class="page no-nav">'
  +'<div class="state"><div class="state-symbol">'+icon('check',30)+'</div><h2>با موفقیت ارسال شد</h2><p>'+(target?esc(target.name)+' این درخواست را در بلوک می‌بیند و می‌تواند مستقیم با شما هماهنگ کند.':'افراد و کسب‌وکارهای مرتبط در بلوک آن را می‌بینند و می‌توانند مستقیم با شما در ارتباط باشند.')+'</p></div>'
  +'<div style="padding:0 6px;margin-top:18px">'
  +(target?'<button class="btn-primary" onclick="state.projectDraft={};var t=state.projectTarget;state.projectTarget=null;state.stack=[];openPersonProfile(t)">بازگشت به پروفایل</button><div style="height:8px"></div><button class="btn-secondary" onclick="state.projectDraft={};state.projectTarget=null;state.stack=[];go(\'home\')">رفتن به داشبورد</button>':'<button class="btn-primary" onclick="state.projectDraft={};state.stack=[];go(\'home\')">بازگشت به داشبورد</button>')
  +'</div>'
  +'</div>'
},

explore:function(){
  var mode=ensureExploreMode();
  var modeSwitch='<div class="explore-mode-switch" data-active="'+(mode==='jobs'?'0':'1')+'"><div class="explore-mode-thumb"></div><button class="'+(mode==='jobs'?'active':'')+'" onclick="setExploreMode(\'jobs\')"><i>'+icon('briefcase',14)+'</i>پیدا کردن کار</button><button class="'+(mode==='workers'?'active':'')+'" onclick="setExploreMode(\'workers\')"><i>'+icon('users',14)+'</i>پیدا کردن نیرو</button></div>';

  if(mode==='jobs'){
    var jobs=filteredJobOpportunities(),jq=ensureJobQuick();
    var jobBody=jobs.length?'<div class="explore-section-head"><b>فرصت‌های کاری</b><span>'+jobs.length+' مورد</span></div><div class="jobs-grid">'+jobs.map(renderHomeJobCard).join('')+'</div>':'<div class="explore-empty"><i>'+icon('briefcase',22)+'</i><b>فعلاً کاری پیدا نشد</b><p>عبارت جست‌وجو یا فیلترها را تغییر دهید.</p></div>';
    return '<div class="page explore-page">'
    +'<div class="explore-head"><div><span>جست‌وجوی ساده</span><h2>دنبال چه کاری هستید؟</h2></div></div>'
    +modeSwitch
    +'<div class="explore-search">'+icon('search',18)+'<input id="exploreSearchInput" value="'+esc(state.exploreQuery)+'" oninput="setExploreQuery(this.value)" placeholder="مثلاً جوشکاری، اسکلت فلزی یا شهر"></div>'
    +'<div class="explore-toolbar"><button class="explore-filter-btn" onclick="openJobFilters()">'+icon('gear',15)+' فیلترها و شهر'+(exploreJobFilterCount()?'<span class="explore-filter-count">'+exploreJobFilterCount()+'</span>':'')+'</button><button class="explore-sort-btn" onclick="cycleExploreSort()">↕ '+esc(EXPLORE_SORT_LABELS[state.exploreSort])+'</button></div>'
    +jobBody
    +'</div>'+bottomNav('explore');
  }

  var items=filteredExploreItems();
  var f=ensureExploreFilters(),active=exploreActiveCount()>0||Boolean((state.exploreQuery||'').trim());
  var toggleBtn='<button class="explore-view-btn" onclick="setExploreView(\''+(state.exploreView==='cards'?'map':'cards')+'\')">'+icon(state.exploreView==='cards'?'eye':'building',14)+(state.exploreView==='cards'?'نقشه':'کارت‌ها')+'</button>';
  var body='';
  if(state.exploreView==='map'){
    var pins=items.map(function(it){return '<div class="mappin" style="right:'+it.x+'%;top:'+it.y+'%" onclick="'+openExploreItem(it)+'"><i></i><span>'+esc(it.title)+'</span></div>'}).join('');
    body='<div class="explore-section-head"><b>'+items.length+' نتیجه روی نقشه</b><span>برای مشاهده لمس کنید</span></div>'+(items.length?'<div class="mapbox">'+pins+'</div>':renderExploreEmpty());
  }else if(!items.length){
    body=renderExploreEmpty();
  }else{
    if(!active){
      var featured=items[0],ready=items.filter(function(item){return item.availability==='now'||item.availability==='today'}).slice(0,4);
      body='<div class="explore-section-head"><b>پیشنهاد مناسب شما</b><span>براساس پروفایل</span></div>'+renderExploreFeature(featured)
        +(ready.length?'<div class="explore-section-head"><b>آمادهٔ همکاری</b><span>'+ready.length+' گزینه نزدیک</span></div><div class="discovery-rail">'+ready.map(renderExploreMini).join('')+'</div>':'')
        +'<div class="explore-section-head"><b>نتیجه‌ها</b><span>'+items.length+' مورد</span></div><div class="discovery-grid">'+items.filter(function(item){return item!==featured}).map(renderExploreCard).join('')+'</div>';
    }else{
      body='<div class="explore-section-head"><b>نتایج جست‌وجو</b><span>'+items.length+' گزینه پیدا شد</span></div><div class="discovery-grid">'+items.map(renderExploreCard).join('')+'</div>';
    }
  }
  return '<div class="page explore-page">'
  +'<div class="explore-head"><div><span>جست‌وجوی ساده</span><h2>دنبال چه نیرویی هستید؟</h2></div>'+toggleBtn+'</div>'
  +modeSwitch
  +'<div class="explore-search">'+icon('search',18)+'<input id="exploreSearchInput" value="'+esc(state.exploreQuery)+'" oninput="setExploreQuery(this.value)" placeholder="مثلاً جوشکار، پروژه یا شهر"></div>'
  +'<div class="explore-toolbar"><button class="explore-filter-btn" onclick="openExploreFilters()">'+icon('gear',15)+' فیلترها و نقش'+(exploreActiveCount()?'<span class="explore-filter-count">'+exploreActiveCount()+'</span>':'')+'</button><button class="explore-sort-btn" onclick="cycleExploreSort()">↕ '+esc(EXPLORE_SORT_LABELS[state.exploreSort])+'</button></div>'
  +renderExploreActiveFilters()+body
  +'</div>'
  +bottomNav('explore')
},

viewProfile:function(){
  var id=state.viewingPerson;
  var p=PEOPLE_SEED[id]||PEOPLE_SEED.karimi;
  var blocked=isBlocked(id);
  var head=renderPublicTrustCard(p,id)
   +(blocked?'<div class="card" style="margin-bottom:14px;border-color:var(--danger)"><b style="font-size:.62rem;color:var(--danger)">این کاربر را مسدود کرده‌اید</b><p style="font-size:.55rem;margin-top:3px">تا وقتی مسدود است، امکان گفتگو یا ارسال درخواست وجود ندارد.</p></div>':'')
   +'<div class="card" style="margin-bottom:16px"><p style="font-size:.6rem;line-height:1.8">'+esc(p.bio)+'</p></div>';

  var mid='';
  if(p.personType==='professional'){
    mid+=renderPublicSkillDetails(p,id)
     +(blocked?'':renderPublicBookingCalendar(id,p))
     +'<div class="sec-head"><b>نمونه‌کارها</b></div>'+renderPortfolioCards(p.portfolio)
     +(p.history&&p.history.length?'<div class="sec-head"><b>پیشینهٔ کاری</b></div>'+p.history.map(function(h){return '<div class="list-row" style="cursor:default"><div class="ricon">'+icon('building',16)+'</div><div class="rcopy"><b>'+esc(h)+'</b></div></div>'}).join(''):'')
     +'<div class="sec-head"><b>نظرات کارفرماها</b></div>'+renderReviews(p.reviews)
     +(p.guarantorNames&&p.guarantorNames.length?'<div class="sec-head"><b>معرف‌ها</b></div>'+p.guarantorNames.map(function(g){return '<div class="list-row" style="cursor:default"><div class="ricon">'+icon('shield',16)+'</div><div class="rcopy"><b>'+esc(g)+'</b></div></div>'}).join(''):'');
  } else if(p.personType==='store'){
    mid+='<div class="sec-head"><b>محصولات و خدمات</b></div>'
     +p.products.map(function(prod,i){return '<div class="list-row" onclick="'+(blocked?'':"openProductOrderSheet('"+id+"',"+i+")")+'"><div class="ricon">'+icon('truck',16)+'</div><div class="rcopy"><b>'+esc(prod.name)+'</b><span>'+esc(prod.price)+' / '+esc(prod.unit)+'</span></div><button class="btn-ghost" '+(blocked?'disabled style="opacity:.4"':'')+'>سفارش</button></div>'}).join('')
     +'<div class="sec-head"><b>نظرات مشتریان</b></div>'+renderReviews(p.reviews);
  } else if(p.personType==='materialsSupplier'){
    mid+='<div class="sec-head"><b>محصولات قابل نوبت‌دهی</b></div><p style="font-size:.52rem;color:var(--muted);margin:-8px 2px 10px">برای هر محصول، مقدار، محل تحویل و ساعت خالی را انتخاب کنید.</p>'
     +p.products.map(function(prod,i){return '<div class="list-row" onclick="'+(blocked?'':"openDeliveryRequestSheet('"+id+"',"+i+")")+'"><div class="ricon">'+icon('calendar',16)+'</div><div class="rcopy"><b>'+esc(prod.name)+'</b><span>'+esc(prod.price)+' / '+esc(prod.unit)+'</span></div><button class="btn-ghost" '+(blocked?'disabled style="opacity:.4"':'')+'>رزرو نوبت</button></div>'}).join('')
     +'<div class="sec-head"><b>نظرات مشتریان</b></div>'+renderReviews(p.reviews);
  } else {
    mid+='<div class="sec-head"><b>نیازهای فعال</b></div>'
     +(p.openNeeds&&p.openNeeds.length?p.openNeeds.map(function(n){return '<div class="card" style="margin-bottom:8px"><b style="font-size:.64rem">'+esc(n.title)+'</b><p style="font-size:.55rem;margin-top:3px">'+esc(n.city)+' · بودجه: '+esc(n.budget)+'</p><button class="btn-secondary" style="margin-top:8px" '+(blocked?'disabled':'')+' onclick="openTargetedProject(\''+id+'\',\''+esc(n.title).replace(/'/g,"")+'\')">ارسال پیشنهاد برای این نیاز</button></div>'}).join(''):'<p style="font-size:.6rem;margin-bottom:12px">در حال حاضر نیاز فعالی ثبت نکرده‌اند.</p>')
     +'<div class="sec-head"><b>نظرات همکاران قبلی</b></div>'+renderReviews(p.reviews);
  }

  mid+='<div style="text-align:center;margin-top:6px"><button class="btn-ghost" style="color:var(--danger)" onclick="openReportSheet(\''+id+'\')">گزارش یا مسدودکردن این کاربر</button></div>';

  return topbarWithAction(p.name,null,null,blocked?'':'<button class="topbar-action-btn '+(isSaved(id)?'active':'')+'" aria-label="ذخیره در علاقه‌مندی‌ها" onclick="toggleSaved(\''+id+'\')">'+icon('heart',17)+'</button>')+'<div class="page" style="padding-bottom:34px">'+head+mid+'</div>'
  +(blocked?'':'<button class="chat-fab" aria-label="شروع گفتگو" onclick="openConversationForPerson(\''+id+'\')">'+icon('message',21)+'</button>');
},

newRequest:function(){
  var role=state.role||'worker',roleLabel=roleSchemas[role]?roleSchemas[role].label:'کاربر بلوک';
  return '<div class="page publish-page">'
  +'<div class="publish-head"><span>ثبت آگهی عمومی</span><h2>چه کاری می‌خواهید انجام دهید؟</h2><p>فقط یکی از سه گزینه را انتخاب کنید. اطلاعات ثبت‌شدهٔ '+esc(roleLabel)+' به‌صورت خودکار استفاده می‌شود.</p></div>'
  +'<div class="publish-section-title"><b>یک گزینه را انتخاب کنید</b><span>ساده و سریع</span></div>'
  +'<div class="publish-option-list">'
  +'<div class="publish-option orange" onclick="startAd(\'work\')"><i>'+icon('briefcase',18)+'</i><div class="publish-option-copy"><b>پیدا کردن کار</b><p>مهارت‌ها و سابقهٔ من نمایش داده شود تا کارفرماها بتوانند با من گفتگو کنند</p></div><span>‹</span></div>'
  +'<div class="publish-option mint" onclick="startAd(\'workforce\')"><i>'+icon('users',18)+'</i><div class="publish-option-copy"><b>پیدا کردن نیروی کار</b><p>برای پروژه به کارگر، متخصص، مهندس، پیمانکار یا خدمات ماشین‌آلات نیاز دارم</p></div><span>‹</span></div>'
  +'<div class="publish-option violet" onclick="startAd(\'consult\')"><i>'+icon('drafting',18)+'</i><div class="publish-option-copy"><b>پرسش تخصصی و مشاوره</b><p>برای مطرح‌کردن سؤال، شرح مسئله و دریافت پاسخ از گروه مرتبط</p></div><span>‹</span></div>'
  +'</div>'
  +'<div class="publish-route-note"><i>'+icon('check',15)+'</i><div><b>نیازی به واردکردن دوبارهٔ مشخصات نیست</b><p>بلوک مهارت‌ها، سابقه، محل فعالیت و دستمزد ثبت‌شده را از پروفایل شما به آگهی اضافه می‌کند.</p></div></div>'
  +'</div>'
  +bottomNav('newRequest')
},

createAd:function(){
  var d=state.adDraft,config=activeAdConfig(),step=state.adStep,content='',isConsult=d.type==='consult',isWork=d.type==='work',profile=adProfileSnapshot();
  if(step===0){
    content='<div class="ad-step-copy"><span>مرحله ۱ از ۲</span><h2>'+(isConsult?'سؤال خود را بنویسید':isWork?'آگهی کار شما آماده است':'نیروی موردنیاز را مشخص کنید')+'</h2><p>'+(isConsult?'عنوان و توضیح کوتاه، برای شروع کافی است.':isWork?'فقط مخاطبان را انتخاب کنید؛ بقیهٔ اطلاعات از پروفایل شما می‌آید.':'مخاطبان و محل پروژه را مشخص کنید؛ بقیهٔ اطلاعات قبلی استفاده می‌شود.')+'</p></div>'
      +(!isConsult?'<div class="fixed-ad-title"><span>عنوان ثابت آگهی</span><b>'+esc(d.title)+'</b><p>برای ساده‌تر شدن ثبت، نیازی به نوشتن عنوان تازه نیست.</p></div>':'')
      +'<div class="ad-block'+(state.adWarnings.targetRole?' ad-block-warning':'')+'"><div class="ad-block-head"><b>'+adAudienceTitle(d.type)+' '+requiredMark()+'</b><p>'+(isWork?'نقش خودتان دوباره پرسیده نمی‌شود؛ فقط کارفرماهایی را انتخاب کنید که آگهی را ببینند.':'برای ارسال اعلان، یک تا سه گروه مرتبط را انتخاب کنید.')+'</p></div>'+renderAdAudienceChoices()+'</div>'
      +renderAdProfileNotice()
      +(isConsult?'<div class="ad-form-note"><b>عنوان روشن، پاسخ دقیق‌تری می‌گیرد</b><p>مثال: «علت ترک مورب کنار پنجره چیست؟»</p></div><div class="'+adFieldClass('title')+'"><label>عنوان پرسش '+requiredMark()+'</label><input class="input" value="'+esc(d.title||'')+'" oninput="setAdField(\'title\',this.value);state.adWarnings.title=false" placeholder="مثلاً علت ترک مورب کنار پنجره چیست؟"></div>':'')
      +(d.type==='workforce'?renderAdLocationFields():'')
      +'<div class="field"><label>محدودهٔ اطلاع‌رسانی</label>'+renderAdChoiceChips(isConsult?['داخل شهر','کل استان','تمام استان‌ها']:['داخل شهر','تا ۳۰ کیلومتر','کل استان','تمام استان‌ها'],'range')+'</div>'
      +(isConsult?'':'<div class="field"><label>روش دستمزد</label><p class="field-help">از شرایط دستمزد ثبت‌شده در پروفایل یا گزینهٔ توافقی انتخاب کنید.</p>'+renderAdChoiceChips(profileRateOptions(),'budget')+'</div><div class="field"><label>زمان شروع</label>'+renderAdChoiceChips(['فوری','امروز','این هفته','با هماهنگی'],'startTime')+'</div>')
      +'<div class="chat-only-card"><i>'+icon('message',17)+'</i><div><b>ارتباط اولیه در چت بلوک</b><p>پیام متنی و صوتی فعال است؛ شماره فقط وقتی نمایش داده می‌شود که صاحب پروفایل آن را از تنظیمات حریم خصوصی عمومی کرده باشد.</p></div></div>'
      +'<div class="'+adFieldClass('description')+'"><label>'+(isConsult?'توضیحات پرسش':isWork?'توضیح کوتاه':'توضیحات کار')+' '+(isWork?'<span class="optional">اختیاری</span>':requiredMark())+'</label><textarea class="textarea" oninput="setAdField(\'description\',this.value);state.adWarnings.description=false" placeholder="'+(isConsult?'مسئله و شرایطی را که به پاسخ دقیق کمک می‌کند بنویسید…':isWork?'اگر نکته‌ای دربارهٔ نوع کار یا شرایط همکاری دارید بنویسید…':'نوع کار، مدت تقریبی و شرایط پروژه را کوتاه بنویسید…')+'">'+esc(d.description||'')+'</textarea></div>'
      +renderAdAttachmentField();
  }else{
    content='<div class="ad-step-copy"><span>مرحله ۲ از ۲</span><h2>مرور و انتشار</h2><p>اطلاعات زیر در اکسپلور نمایش داده می‌شود و برای مخاطبان انتخاب‌شده اعلان می‌رود.</p></div>'+renderAdReview();
  }
  return topbar(config.label,'ثبت آگهی عمومی',step?'previousAdStep()':'back()')+'<div class="page ad-page">'+renderAdProgress()+content+'</div><div class="ad-dock"><button class="btn-primary" onclick="'+(step===1?'publishAd()':'nextAdStep()')+'">'+(step===0?'مرور آگهی':'انتشار آگهی و ارسال اعلان')+'</button></div>';
},

adDetail:function(){
  var ad=currentAdDetail();
  if(!ad||!ad.isAd)return topbar('جزئیات آگهی')+'<div class="page"><div class="explore-empty"><b>این آگهی در دسترس نیست</b><p>ممکن است حذف یا ویرایش شده باشد.</p></div></div>';
  var profile=ad.profile||{},categories=profile.categories||[],target=(ad.targetRoles||[]).map(function(role){return AD_ROLE_LABELS[role]||role}).join('، '),isConsult=ad.adType==='consult',isWork=ad.adType==='work';
  var audienceLabel=isConsult?'پاسخ‌دهندگان':isWork?'مخاطبان آگهی':'نیروی موردنظر';
  var projectDetails=isConsult?'':'<div><span>روش دستمزد</span><b>'+esc(ad.budget||'توافقی')+'</b></div><div><span>'+(isWork?'شروع همکاری':'زمان شروع')+'</span><b>'+esc(ad.startTime||'با هماهنگی')+'</b></div><div><span>'+(isWork?'محل فعالیت':'محل پروژه')+'</span><b>'+esc(ad.city)+(ad.province?'، '+esc(ad.province):'')+'</b></div>';
  return topbar('جزئیات آگهی',ad.resultLabel)
    +'<div class="page ad-detail-page">'
    +'<div class="ad-detail-hero tone-'+esc(ad.tone)+'"><span>'+esc(ad.resultLabel)+'</span><h2>'+esc(ad.title)+'</h2><p>'+esc(isConsult?ad.range:(ad.city+(ad.province?'، '+ad.province:'')))+' · '+esc(ad.availabilityLabel)+'</p><div class="ad-preview-tags">'+(ad.categories||[ad.category]).map(function(value){return '<span>'+esc(value)+'</span>'}).join('')+'<span>'+esc(audienceLabel)+': '+esc(target)+'</span></div></div>'
    +renderPublicTrustCard(adTrustPerson(ad),'ad')
    +'<div class="ad-detail-grid"><div><span>مهارت‌ها و حوزه‌های مرتبط</span><b>'+esc((ad.categories||[ad.category]).join('، '))+'</b></div><div><span>'+esc(audienceLabel)+'</span><b>'+esc(target)+'</b></div>'+projectDetails+'<div><span>محدوده اعلان</span><b>'+esc(ad.range||'داخل شهر')+'</b></div></div>'
    +(ad.description?'<div class="ad-detail-section"><b>'+(isConsult?'شرح کامل پرسش':isWork?'توضیح کارجو':'توضیحات کار')+'</b><p>'+esc(ad.description)+'</p>'+(ad.attachment?'<img class="ad-detail-image" src="'+ad.attachment+'" alt="تصویر پیوست پرسش">':'')+'</div>':'')
    +'<div class="ad-detail-section profile-context"><b>اطلاعات مرتبط از پروفایل ثبت‌کننده</b><p>حوزه‌ها: '+esc(categories.join('، ')||ad.category)+'</p>'+(profile.experience?'<p>سابقه ثبت‌شده: '+esc(profile.experience)+'</p>':'')+(profile.city?'<p>محل ثبت‌شده: '+esc(profile.city)+'</p>':'')+'</div>'
    +'<div class="chat-only-card"><i>'+icon('message',17)+'</i><div><b>ارتباط اولیه در چت امن بلوک</b><p>چت و پیام صوتی فعال است؛ نمایش شماره فقط طبق تنظیم حریم خصوصی صاحب پروفایل انجام می‌شود.</p></div></div>'
    +renderAgreementCard(ad)
    +'</div><div class="dock"><button class="btn-primary" onclick="startAdChat(\''+ad.id+'\')">'+(ad.status==='matched'?'رفتن به گفت‌وگوی پروژه':'شروع گفت‌وگو درباره این آگهی')+'</button></div>';
},

adPublished:function(){
  var ad=state.lastPublishedAd||{title:'آگهی شما',audience:0,roles:[],city:'',skills:[]};
  return '<div class="page no-nav"><div class="state"><div class="state-symbol">'+icon('check',30)+'</div><h2>آگهی منتشر شد</h2><p>«'+esc(ad.title)+'» اکنون در اکسپلور دیده می‌شود.</p></div>'
    +'<div class="ad-success-flow"><span>ثبت آگهی</span><i></i><span>نمایش در اکسپلور</span><i></i><span>ارسال اعلان</span></div>'
    +'<div class="ad-success-audience"><b>'+esc(ad.audience)+' اعلان هدفمند ارسال شد</b><p>مخاطبان: '+esc(ad.roles.join('، '))+' · محدوده: '+esc(ad.city||'انتخاب‌شده')+'</p></div>'
    +'<button class="btn-primary" onclick="viewPublishedAd()">دیدن آگهی در اکسپلور</button><div style="height:8px"></div><button class="btn-secondary" onclick="state.adDraft={};state.stack=[];go(\'home\')">بازگشت به داشبورد</button></div>';
},

messages:function(){
  var conversations=filteredConversations(),unread=unreadMessageCount(),tabs=[['all','همه'],['unread','خوانده‌نشده'],['project','پروژه‌ها'],['service','خدمات و سفارش'],['archived','بایگانی']];
  var rows=conversations.map(renderConversationCard).join('');
  return '<div class="page" style="padding-top:16px"><div class="message-head"><h2>پیام‌ها</h2><div class="head-actions"><button class="icon-btn" aria-label="تنظیمات پیام" onclick="go(\'messageSettings\')">'+icon('gear',16)+'</button></div></div>'
    +'<div class="inbox-search">'+icon('search',16)+'<input id="messageSearch" aria-label="جست‌وجوی پیام‌ها" value="'+esc(state.messageQuery||'')+'" oninput="setMessageQuery(this.value)" placeholder="جست‌وجوی نام، پروژه یا متن پیام"></div>'
    +'<div class="inbox-summary"><span>'+unread+' پیام خوانده‌نشده</span><button onclick="markAllMessagesRead()">خواندن همه</button></div>'
    +'<div class="message-tabs">'+tabs.map(function(tab){return '<button class="message-tab'+((state.messageFilter||'all')===tab[0]?' active':'')+'" onclick="setMessageFilter(\''+tab[0]+'\')">'+tab[1]+'</button>'}).join('')+'</div>'
    +(rows||'<div class="empty-inbox"><i>'+icon('message',24)+'</i><b>گفت‌وگویی پیدا نشد</b><p>عبارت جست‌وجو یا فیلتر را تغییر دهید.</p></div>')+'</div>'+bottomNav('messages')
},

chat:function(){
  var c=activeConversation(),prefs=getMessagePrefs(),bubbles=c.messages.map(function(m){
    var date=m.date?'<div class="chat-day">'+esc(m.date)+'</div>':'';
    if(m.type==='system')return '<div class="system-message">'+esc(m.text)+'</div>';
    var meta='<div class="bubble-meta"><span>'+esc(m.time||'')+'</span>'+(m.mine&&prefs.readReceipts?'<span>✓✓ '+esc(m.status||'')+'</span>':'')+'</div>';
    if(m.image)return date+'<div class="bubble'+(m.mine?'':' other')+'" style="padding:6px"><img src="'+m.image+'" alt="تصویر ارسال‌شده" style="width:160px;border-radius:11px;display:block">'+meta+'</div>';
    if(m.file)return date+'<div class="bubble'+(m.mine?'':' other')+'"><div class="message-file"><i>'+icon('doc',16)+'</i><div><b>'+esc(m.file)+'</b><span>'+esc(m.fileSize||'فایل پیوست')+'</span></div></div>'+meta+'</div>';
    if(m.audioUrl)return date+'<div class="bubble'+(m.mine?'':' other')+'"><div class="voice-message"><i>'+icon('play',14)+'</i><div><div class="voice-wave">'+[5,11,16,8,14,18,9,13,6,15,10,17].map(function(height){return '<span style="height:'+height+'px"></span>'}).join('')+'</div><audio controls preload="metadata" src="'+m.audioUrl+'" style="width:175px;height:28px"></audio><small>پیام صوتی · '+esc(m.duration||'۰:۰۱')+'</small></div></div>'+meta+'</div>';
    return date+'<div class="bubble'+(m.mine?'':' other')+'">'+esc(m.text)+meta+'</div>';
  }).join('');
  var context=c.context?'<div class="chat-context-card" onclick="openConversationContext()"><i>'+icon(c.context.icon||'briefcase',17)+'</i><div><b>'+esc(c.context.title)+'</b><p>'+esc(c.context.label+(c.context.meta?' · '+c.context.meta:''))+'</p></div><span>‹</span></div>':'';
  var header=topbar(c.name,(c.online?'آنلاین':'آخرین فعالیت '+c.time),'back()');
  if(c.personId)header=header.replace('<div class="topbar-title">','<div class="topbar-title" style="cursor:pointer" onclick="openPersonProfile(\''+c.personId+'\')">');
  var ad=c.adId?EXPLORE_ITEMS.find(function(item){return item.id===c.adId}):null;
  return header+'<button class="icon-btn chat-menu-btn" aria-label="مدیریت گفت‌وگو" onclick="openConversationActions()">'+icon('more',17)+'</button>'
  +'<div class="page no-nav" style="padding-top:14px;padding-bottom:86px">'+context+(ad?renderAgreementCard(ad):'')+'<div class="chat-thread">'+bubbles+'</div></div>'
  +'<div class="composer"><label class="composer-action" aria-label="ارسال تصویر">'+icon('portfolio',17)+'<input type="file" accept="image/*" style="display:none" onchange="handleChatPhoto(this)"></label><label class="composer-action" aria-label="ارسال فایل">'+icon('doc',17)+'<input type="file" style="display:none" onchange="handleChatDocument(this)"></label><button class="composer-action '+(state.voiceRecording?'recording':'')+'" aria-label="'+(state.voiceRecording?'پایان و ارسال پیام صوتی':'شروع پیام صوتی')+'" onclick="toggleVoiceRecording()">'+icon('mic',17)+'</button><input id="chatInput" aria-label="متن پیام" placeholder="پیام یا ویس بفرستید…" onkeydown="if(event.key===\'Enter\')sendChatText()"><button class="sendbtn" aria-label="ارسال پیام" onclick="sendChatText()">'+icon('send',16)+'</button></div>'
},

messageSettings:function(){
  var prefs=getMessagePrefs(),items=[['readReceipts','نمایش وضعیت خوانده‌شدن','در پیام‌های ارسالی، وضعیت تحویل و خوانده‌شدن دیده شود.'],['relatedOnly','اولویت با گفت‌وگوهای مرتبط','پیام‌های متصل به آگهی، پروژه و سفارش بالاتر نمایش داده شوند.'],['mediaAuto','نمایش خودکار رسانه','تصاویر دریافتی بدون لمس کاربر نمایش داده شوند.']];
  return topbar('تنظیمات پیام‌ها','حریم خصوصی و مدیریت صندوق پیام')+'<div class="page"><div class="chat-safety">'+icon('shield',15)+'<span>همهٔ گفت‌وگوها پیام صوتی دارند؛ نمایش شماره از تنظیمات حریم خصوصی هر کاربر کنترل می‌شود.</span></div><div class="setting-section-title">رفتار پیام‌ها</div>'+items.map(function(item){return '<div class="notification-pref"><div><b>'+item[1]+'</b><p>'+item[2]+'</p></div><div class="switch '+(prefs[item[0]]?'on':'')+'" role="switch" aria-checked="'+(prefs[item[0]]?'true':'false')+'" onclick="toggleMessagePref(\''+item[0]+'\')"><i></i></div></div>'}).join('')+'<div class="setting-section-title">ایمنی</div><div class="list-row" onclick="go(\'blockedUsers\')"><div class="ricon" style="color:var(--danger);background:var(--danger-soft)">'+icon('alert',16)+'</div><div class="rcopy"><b>کاربران مسدودشده</b><span>'+state.blockedUsers.length+' کاربر</span></div><span class="rarrow">‹</span></div></div>';
},

profile:function(){
  var r=activeRole(),role=state.role||'worker',displayName=displayNameFor(role),completion=state.profileComplete?Math.max(88,r.completion||0):(r.completion||35),phone=state.values.signupPhone||'شمارهٔ تأییدشده';
  var professional=settingsRow('shield','کارت هویت و اعتبار من','سن، سابقه، پروژه‌ها، نظرها و امتیاز بلوک',"openTrustCard('self')")+settingsRow('heart','علاقه‌مندی‌های من',ensureSavedPeople().length+' مورد ذخیره‌شده',"go('savedProfiles')")+settingsRow('shield','معرف‌ها و قیم',getGuarantors(role).length+' معرف ثبت‌شده',"go('guarantor')")+settingsRow('doc','ویرایش اطلاعات پروفایل','مشخصات فردی، شهر و اطلاعات تخصصی',"go('editProfile')")+settingsRow('user','عکس پروفایل',state.values.profilePhoto?'ثبت شده و قابل تغییر':'هنوز اضافه نشده',"go('profilePhoto')")+settingsRow('eye','پیش‌نمایش پروفایل عمومی','همان چیزی که دیگران از شما می‌بینند',"go('myPublicProfile')")+settingsRow('portfolio','نمونه‌کارها',getPortfolio(role).length+' مورد ثبت‌شده',"go('portfolio')")+settingsRow('building','کارها و پروژه‌های من',getProjects(role).length+' مورد',"go('myProjects')")+settingsRow('users','نقش‌های حساب','نقش فعال: '+r.label,"go('roleManagement')");
  var communication=settingsRow('check','درخواست‌ها',pendingRequestCount()+' درخواست نیازمند پاسخ',"go('requestsCenter')")+settingsRow('bell','تنظیمات اعلان‌ها',unreadNotifCount()+' اعلان خوانده‌نشده',"go('notificationSettings')")+settingsRow('message','تنظیمات پیام‌ها',unreadMessageCount()+' پیام خوانده‌نشده',"go('messageSettings')");
  var account=settingsRow('lock','حساب و امنیت',phone,"go('accountSecurity')")+settingsRow('eye','حریم خصوصی','نمایش پروفایل، موقعیت و وضعیت آنلاین',"go('privacySettings')")+settingsRow('alert','کاربران مسدودشده',state.blockedUsers.length+' کاربر',"go('blockedUsers')")+settingsRow('shield','قوانین و حریم خصوصی',legalAcceptanceText(),"go('legalCenter')");
  var support=settingsRow('sun','نمایش و خوانایی',state.mode==='dark'?'حالت تیره':'حالت روشن',"go('settings')")+settingsRow('wrench','وضعیت برنامه و دسترسی‌ها',state.online?'آنلاین و آماده':'اینترنت قطع است',"go('systemStatus')")+settingsRow('help','راهنما و پرسش‌های متداول','پاسخ به سؤال‌های استفاده از بلوک',"go('helpCenter')")+settingsRow('message','پشتیبانی بلوک','گفت‌وگو یا گزارش مشکل',"go('supportCenter')")+settingsRow('info','دربارهٔ بلوک','نسخه، مأموریت و اطلاعات برنامه',"go('aboutApp')");
  return '<div class="page" style="padding-top:16px"><div class="message-head"><h2>من</h2><button class="icon-btn" aria-label="مدیریت حساب" onclick="go(\'accountManagement\')">'+icon('gear',16)+'</button></div>'
    +'<div class="profile-hero" role="button" tabindex="0" style="cursor:pointer" onclick="openTrustCard(\'self\')"><div class="profile-identity">'+renderMyAvatar(role)+'<div class="profile-copy"><h2>'+esc(displayName)+'</h2><p>'+esc(r.profileTitle||r.label)+' · '+esc(displayCityFor(role))+'</p><div class="profile-status-row"><span class="status-pill">'+icon('phone',10)+' موبایل تأییدشده</span><span class="status-pill '+(state.profileComplete?'':'warning')+'">'+icon(state.profileComplete?'check':'alert',10)+' '+(state.profileComplete?'اطلاعات اصلی ثبت‌شده':'نیازمند تکمیل')+'</span></div></div></div><div class="profile-progress"><div class="profile-progress-head"><b>کامل‌بودن پروفایل</b><span>'+completion+'٪</span></div><div class="profile-progress-track"><i style="width:'+completion+'%"></i></div></div></div>'
    +'<div class="profile-actions"><button class="profile-action" onclick="go(\'editProfile\')"><i>'+icon('doc',15)+'</i><b>ویرایش پروفایل</b><span>اطلاعات و تخصص‌ها</span></button><button class="profile-action" onclick="go(\'myPublicProfile\')"><i>'+icon('eye',15)+'</i><b>نمایش عمومی</b><span>پیش‌نمایش برای دیگران</span></button></div>'
    +'<div class="settings-group-title">پروفایل و فعالیت حرفه‌ای</div><div class="settings-group">'+professional+'</div><div class="settings-group-title">ارتباطات</div><div class="settings-group">'+communication+'</div><div class="settings-group-title">حساب و حریم خصوصی</div><div class="settings-group">'+account+'</div><div class="settings-group-title">برنامه و پشتیبانی</div><div class="settings-group">'+support+'</div><div class="settings-group">'+settingsRow('logout','خروج و مدیریت حساب','خروج یا درخواست حذف حساب',"go('accountManagement')",true)+'</div><div class="version-row">بلوک · نسخهٔ نمایشی ۱.۲</div></div>'+bottomNav('profile')
},

savedProfiles:function(){
  var ids=ensureSavedPeople(),people=ids.map(function(id){return PEOPLE_SEED[id]}).filter(Boolean);
  var body=people.length?people.map(function(p,i){
    var id=ids[i];
    return '<div class="list-row" onclick="openTrustCard(\''+id+'\')"><div class="avatar">'+esc(p.initials)+'</div><div class="rcopy"><b>'+esc(p.name)+'</b><span>'+esc(p.role||'')+' · '+esc(p.location||'')+'</span></div><button class="topbar-action-btn active" style="margin:0" aria-label="حذف از علاقه‌مندی‌ها" onclick="event.stopPropagation();toggleSaved(\''+id+'\')">'+icon('heart',15)+'</button></div>';
  }).join(''):'<div class="explore-empty"><i>'+icon('heart',22)+'</i><b>هنوز کسی را ذخیره نکرده‌اید</b><p>روی پروفایل هر شخص، آیکون قلب را لمس کنید تا اینجا اضافه شود.</p></div>';
  return topbar('علاقه‌مندی‌های من',people.length+' مورد ذخیره‌شده')+'<div class="page">'+body+'</div>';
},
editProfile:function(){
  var schema=activeRole();
  var rows=schema.steps.filter(function(s){return !s.review}).map(function(s,idx){
    return '<div class="list-row" onclick="openEditStep('+idx+')"><div class="ricon">'+icon('doc',16)+'</div><div class="rcopy"><b>'+esc(s.title)+'</b><span>'+esc(stepSummary(s))+'</span></div><span class="rarrow">‹</span></div>';
  }).join('');
  return topbar('ویرایش پروفایل')
  +'<div class="page">'
  +'<div class="chat-safety">'+icon('lock',14)+'<span>نام، نام خانوادگی و شهر فعالیت بخشی از احراز هویت (KYC) شما هستند و از همین صفحه قابل تغییر نیستند. برای اصلاح آن‌ها با پشتیبانی بلوک در تماس باشید.</span></div>'
  +renderMyRatePreview()
  +renderMyProductsPreview()
  +'<div class="sec-head"><b>اطلاعات تخصصی</b></div>'
  +rows
  +'</div>'
},

myPublicProfile:function(){
  var role=state.role||'worker',r=activeRole(),categories=profileAdCategories(),items=getPortfolio(role),prefs=getAccountPrefs();
  var trust=myTrustPerson(role);
  return topbar('پیش‌نمایش پروفایل عمومی','نمایش برای کارفرماها و کاربران دیگر')+'<div class="page">'+(prefs.publicProfile?'':'<div class="chat-safety">'+icon('lock',14)+'<span>پروفایل عمومی شما خاموش است؛ این صفحه فقط پیش‌نمایش شخصی است.</span></div>')+renderPublicTrustCard(trust,'self')
    +(categories.length?'<div class="sec-head"><b>حوزه‌ها و مهارت‌ها</b></div><div class="chip-row" style="margin-bottom:14px">'+categories.map(function(value){return '<span class="chip chip-compact">'+esc(value)+'</span>'}).join('')+'</div>':'<div class="privacy-preview"><b>هنوز مهارتی برای نمایش ثبت نشده</b><p>از ویرایش پروفایل، حوزه‌ها و مهارت‌های خود را اضافه کنید.</p></div>')
    +renderPublicSkillDetails(trust,'self')+renderMyRatePreview()+renderMyProductsPreview()+renderOwnPublicAvailability(role)+(items.length?'<div class="sec-head"><b>نمونه‌کارها</b></div>'+renderPortfolioCards(items):'')+'<button class="btn-secondary" onclick="go(\'editProfile\')">ویرایش اطلاعات قابل نمایش</button></div>';
},

roleManagement:function(){
  var current=state.role||'worker',roles=mvpVisibleRoles.concat(['company']).filter(function(value,index,array){return array.indexOf(value)===index&&roleSchemas[value]});
  return topbar('نقش‌های حساب','نقش فعال، داشبورد و پیشنهادها را تعیین می‌کند')+'<div class="page"><div class="privacy-preview"><b>یک حساب، چند نقش</b><p>برای نمونه می‌توانید هم پیمانکار و هم ارائه‌دهندهٔ خدمات ماشین‌آلات باشید. با تغییر نقش فعال، اطلاعات همان نقش در داشبورد نمایش داده می‌شود.</p></div>'+roles.map(function(role){var schema=roleSchemas[role],active=role===current;return '<button class="settings-row" style="border:1px solid '+(active?'var(--accent)':'var(--line)')+';border-radius:14px;margin-bottom:8px;background:'+(active?'var(--accent-soft)':'var(--surface)')+'" onclick="switchAccountRole(\''+role+'\')"><i class="settings-row-icon">'+icon(mapIcon(schema.icon),16)+'</i><span class="settings-row-copy"><b>'+esc(schema.label)+'</b><span>'+esc(schema.summary||schema.profileTitle||'پروفایل مستقل این نقش')+'</span></span>'+(active?'<span class="status-pill">فعال</span>':'<span class="settings-row-arrow">انتخاب</span>')+'</button>'}).join('')+'<div class="chat-safety">'+icon('info',14)+'<span>اطلاعات تخصصی هر نقش باید جداگانه از بخش ویرایش پروفایل کامل شود.</span></div></div>';
},

accountSecurity:function(){
  var phone=state.values.signupPhone||'شمارهٔ موبایل تأییدشده';
  return topbar('حساب و امنیت','ورود، هویت و دستگاه‌های فعال')+'<div class="page"><div class="account-card"><div class="account-card-head"><i>'+icon('phone',16)+'</i><div><b>شماره موبایل</b><span>'+esc(phone)+'</span></div><button class="btn-ghost" onclick="openChangePhoneSheet()">تغییر</button></div><div class="account-fact"><span>وضعیت</span><b>تأییدشده با کد یک‌بارمصرف</b></div></div><div class="account-card"><div class="account-card-head"><i>'+icon('shield',16)+'</i><div><b>هویت و مدارک</b><span>'+(state.profileComplete?'اطلاعات اصلی تکمیل شده است':'بخشی از اطلاعات هنوز ناقص است')+'</span></div><button class="btn-ghost" onclick="go(\'editProfile\')">بررسی</button></div></div><div class="setting-section-title">نشست‌های فعال</div><div class="account-card"><div class="account-card-head"><i>'+icon('phone',16)+'</i><div><b>این دستگاه</b><span>فعال اکنون · ورود با شمارهٔ تأییدشده</span></div><span class="status-pill">فعلی</span></div></div><div class="chat-safety">'+icon('lock',14)+'<span>بلوک برای ورود رمز ثابت نگه نمی‌دارد؛ هر ورود با کد یک‌بارمصرف انجام می‌شود.</span></div><button class="btn-secondary" onclick="go(\'accountManagement\')">خروج و مدیریت حساب</button></div>';
},

privacySettings:function(){
  var prefs=getAccountPrefs(),items=[['publicProfile','نمایش پروفایل عمومی','نام نمایشی، نقش، شهر، مهارت‌ها و نمونه‌کارها'],['publicPhone','نمایش شمارهٔ تماس','در کارت هویت و اعتبار عمومی نمایش داده شود؛ در غیر این صورت خصوصی می‌ماند'],['publicAge','نمایش سن یا قدمت مجموعه','در کارت هویت و اعتبار عمومی نمایش داده شود'],['publicBirthPlace','نمایش محل تولد یا محل ثبت','در کارت عمومی نمایش داده شود؛ آدرس دقیق نمایش داده نمی‌شود'],['onlineStatus','نمایش وضعیت آنلاین','دیگران می‌توانند آنلاین‌بودن شما را در چت ببینند'],['preciseLocation','نمایش موقعیت دقیق','به‌جای شهر، محدودهٔ دقیق‌تر نمایش داده شود'],['activitySuggestions','پیشنهادهای شخصی‌سازی‌شده','از فعالیت شما برای پیشنهاد پروژه و متخصص مرتبط استفاده شود']];
  return topbar('حریم خصوصی','کنترل اطلاعاتی که دیگران می‌بینند')+'<div class="page"><div class="privacy-preview"><b>اطلاعات خصوصی</b><p>شمارهٔ موبایل شما فقط وقتی روی کارت عمومی نمایش داده می‌شود که «نمایش شمارهٔ تماس» را زیر همین صفحه فعال کنید؛ در غیر این صورت کاملاً خصوصی می‌ماند و در هیچ‌جای اپ دیده نمی‌شود.</p></div>'+items.map(function(item){return '<div class="notification-pref"><div><b>'+item[1]+'</b><p>'+item[2]+'</p></div><div class="switch '+(prefs[item[0]]?'on':'')+'" role="switch" aria-checked="'+(prefs[item[0]]?'true':'false')+'" onclick="toggleAccountPref(\''+item[0]+'\')"><i></i></div></div>'}).join('')+'<button class="btn-secondary" style="margin-top:6px" onclick="go(\'myPublicProfile\')">دیدن پیش‌نمایش پروفایل عمومی</button><div class="setting-section-title">اطلاعات و حقوق شما</div><div class="settings-group">'+settingsRow('doc','سیاست حریم خصوصی','چه داده‌ای جمع می‌شود و چرا',"go('privacyPolicy')")+settingsRow('shield','قوانین استفاده','حقوق و مسئولیت کاربران',"go('terms')")+'</div></div>';
},

blockedUsers:function(){
  var ids=state.blockedUsers.slice(),rows=ids.map(function(id){var person=PEOPLE_SEED[id];return '<div class="list-row"><div class="avatar" style="width:38px;height:38px;font-size:.55rem;border-radius:12px">'+esc(person?person.initials:'؟')+'</div><div class="rcopy"><b>'+esc(person?person.name:'کاربر بلوک')+'</b><span>امکان پیام و درخواست متقابل غیرفعال است</span></div><button class="btn-ghost" onclick="unblockUser(\''+id+'\')">رفع مسدودیت</button></div>'}).join('');
  return topbar('کاربران مسدودشده','مدیریت ارتباطات ناخواسته')+'<div class="page">'+(rows||'<div class="empty-inbox"><i>'+icon('shield',23)+'</i><b>کاربری مسدود نشده است</b><p>از صفحهٔ پروفایل یا منوی هر گفت‌وگو می‌توانید کاربر را گزارش یا مسدود کنید.</p></div>')+'</div>';
},

legalCenter:function(){
  var accepted=isLegalCurrent();
  return topbar('قوانین و حریم خصوصی','مرکز شفافیت بلوک')+'<div class="page"><div class="legal-hero"><i>'+icon('shield',18)+'</i><h2>همکاری روشن و امن</h2><p>قوانین بلوک مشخص می‌کند چه اطلاعاتی نمایش داده می‌شود، کاربران چه مسئولیتی دارند و چه محتوایی مجاز نیست.</p><div class="legal-meta"><span>نسخهٔ '+LEGAL_VERSION+'</span><span>به‌روزرسانی '+LEGAL_UPDATED+'</span></div></div><div class="legal-acceptance-card"><i>'+icon(accepted?'check':'alert',16)+'</i><div><b>'+(accepted?'قوانین فعلی را پذیرفته‌اید':'پذیرش قوانین ثبت نشده است')+'</b><p>'+(accepted?'نسخهٔ '+esc(state.acceptedLegalVersion||LEGAL_VERSION)+' · '+esc(state.legalAcceptedAt):'برای ادامهٔ استفاده، نسخهٔ فعلی را مطالعه و تأیید کنید.')+'</p></div></div><div class="settings-group">'+settingsRow('doc','قوانین استفاده','شرایط حساب، آگهی، گفتگو و مسئولیت‌ها',"go('terms')")+settingsRow('lock','سیاست حریم خصوصی','جمع‌آوری، استفاده و کنترل داده‌ها',"go('privacyPolicy')")+settingsRow('users','قواعد انتشار و رفتار','محتوای مجاز و اصول تعامل',"go('communityRules')")+settingsRow('shield','نحوهٔ محاسبهٔ امتیاز بلوک','فرمول اعتبار و راه افزایش آن',"go('scoreGuide')")+'</div>'+(!accepted?'<button class="btn-primary" onclick="acceptCurrentLegal()">پذیرش نسخهٔ فعلی قوانین</button>':'<div class="chat-safety">'+icon('check',14)+'<span>اگر قوانین به‌طور مهم تغییر کند، پیش از ادامه دوباره از شما تأیید می‌گیریم.</span></div>')+'</div>';
},

terms:function(){
  return topbar('قوانین استفاده','نسخهٔ '+LEGAL_VERSION+' · '+LEGAL_UPDATED)+'<div class="page"><div class="legal-hero"><i>'+icon('doc',18)+'</i><h2>قوانین استفاده از بلوک</h2><p>این قوانین برای همهٔ کاربران عادی، مهندسان، متخصصان، کارگران، پیمانکاران، شرکت‌ها، فروشگاه‌ها و ارائه‌دهندگان خدمات ماشین‌آلات اجرا می‌شود.</p></div><section class="legal-section"><h3>۱. حساب و هویت</h3><p>هر حساب باید با شماره موبایل معتبر ساخته شود. نام، نقش، تخصص، مدارک و سوابق باید متعلق به همان شخص یا مجموعه و تا حد امکان دقیق و به‌روز باشد.</p></section><section class="legal-section"><h3>۲. آگهی، پروژه و خدمات</h3><ul><li>عنوان، توضیحات، محل، دستمزد و شرایط کار نباید گمراه‌کننده باشد.</li><li>ثبت آگهی تکراری، جعلی، غیرقانونی یا نامرتبط مجاز نیست.</li><li>تصاویر و مدارک باید متعلق به ثبت‌کننده یا دارای اجازهٔ انتشار باشند.</li></ul></section><section class="legal-section"><h3>۳. گفتگو و رفتار</h3><p>توهین، تهدید، تبعیض، مزاحمت، هرزنامه و درخواست اطلاعات غیرضروری ممنوع است. هماهنگی اولیه و تبادل مدارک بهتر است داخل چت امن بلوک انجام شود.</p></section><section class="legal-section"><h3>۴. مسئولیت همکاری</h3><p>بلوک بستر معرفی و ارتباط است. تصمیم نهایی دربارهٔ انتخاب طرف مقابل، قرارداد، قیمت، ایمنی کارگاه، بیمه، مجوز و پرداخت بر عهدهٔ کاربران است. نشان تأیید هویت به معنی تضمین کیفیت یا انجام تعهدات نیست.</p></section><section class="legal-section"><h3>۵. ایمنی و گزارش</h3><p>کار ناایمن، جعل مدرک یا درخواست خلاف قانون می‌تواند به حذف محتوا، محدودشدن حساب یا ارجاع به مراجع مسئول منجر شود. کاربران می‌توانند از پروفایل و گفت‌وگو تخلف را گزارش کنند.</p></section><section class="legal-section"><h3>۶. تغییر قوانین</h3><p>تغییرهای مهم با اعلان داخل برنامه اطلاع داده می‌شود و در صورت نیاز، تأیید دوبارهٔ کاربر گرفته خواهد شد.</p></section>'+(!isLegalCurrent()?'<button class="btn-primary" onclick="acceptCurrentLegal()">مطالعه کردم و می‌پذیرم</button>':'<div class="legal-acceptance-card"><i>'+icon('check',16)+'</i><div><b>این نسخه پذیرفته شده است</b><p>'+esc(state.legalAcceptedAt)+'</p></div></div>')+'</div>';
},

privacyPolicy:function(){
  return topbar('سیاست حریم خصوصی','نسخهٔ '+LEGAL_VERSION+' · '+LEGAL_UPDATED)+'<div class="page"><div class="legal-hero"><i>'+icon('lock',18)+'</i><h2>داده‌های شما چگونه استفاده می‌شود؟</h2><p>بلوک فقط اطلاعات لازم برای ساخت حساب، تطبیق پروژه‌ها، ارتباط امن و افزایش اعتماد را استفاده می‌کند.</p></div><section class="legal-section"><h3>اطلاعاتی که دریافت می‌کنیم</h3><ul><li>شماره موبایل، نام، نقش و محل فعالیت</li><li>مهارت، سابقه، دستمزد، نمونه‌کار و مدارک انتخابی</li><li>آگهی‌ها، درخواست‌ها، پیام‌ها و گزارش‌های ثبت‌شده</li><li>اطلاعات فنی لازم برای امنیت و عملکرد برنامه</li></ul></section><section class="legal-section"><h3>هدف استفاده</h3><p>تأیید حساب، نمایش پروفایل، پیشنهاد کاربران و پروژه‌های مرتبط، ارسال اعلان، پیشگیری از سوءاستفاده و بهبود تجربهٔ بلوک.</p></section><section class="legal-section"><h3>اطلاعات عمومی و خصوصی</h3><p>نام نمایشی، نقش، شهر، مهارت، سابقه، دستمزد انتخابی و نمونه‌کار می‌تواند عمومی باشد. شماره موبایل و مدارک هویتی به‌طور پیش‌فرض عمومی نیست. کاربر می‌تواند از تنظیمات حریم خصوصی، گزینهٔ «نمایش شمارهٔ تماس» را فعال کند تا شماره‌اش روی کارت عمومی نمایش داده شود؛ در هر زمان قابل خاموش‌کردن است.</p></section><section class="legal-section"><h3>پیام‌ها و ایمنی</h3><p>پیام‌های متنی، صوتی و فایل‌ها برای تحویل به طرف مقابل و رسیدگی به گزارش‌های ایمنی نگهداری می‌شوند. بلوک محتوای گفت‌وگو را به‌عنوان پروفایل عمومی یا آگهی نمایش نمی‌دهد.</p></section><section class="legal-section"><h3>کنترل کاربر</h3><p>کاربر می‌تواند اطلاعات پروفایل را ویرایش، نمایش عمومی را خاموش، نمایش شمارهٔ تماس را در هر زمان قطع، افراد را مسدود و درخواست حذف حساب ثبت کند. برخی سوابق ممکن است برای امنیت، حل اختلاف یا الزام قانونی برای مدت لازم نگهداری شوند.</p></section><section class="legal-section"><h3>اشتراک‌گذاری محدود</h3><p>اطلاعات فقط برای ارائهٔ فنی سرویس، الزام قانونی یا رسیدگی به خطر و تخلف جدی با ارائه‌دهندگان ضروری یا مراجع مسئول به اشتراک گذاشته می‌شود.</p></section></div>';
},

communityRules:function(){
  return topbar('قواعد انتشار و رفتار','اصول جامعهٔ حرفه‌ای بلوک')+'<div class="page"><div class="legal-hero"><i>'+icon('users',18)+'</i><h2>رفتار حرفه‌ای در بلوک</h2><p>هدف این قواعد، جلوگیری از آگهی‌های بی‌کیفیت و ایجاد همکاری امن در صنعت ساختمان است.</p></div><section class="legal-section"><h3>محتوای مجاز</h3><ul><li>نیاز واقعی پروژه، پرسش تخصصی یا معرفی خدمت واقعی</li><li>عنوان روشن، توضیح کافی، تصویر مرتبط و قیمت قابل‌فهم</li><li>مدارک و نمونه‌کار متعلق به خود کاربر یا مجموعه</li></ul></section><section class="legal-section"><h3>محتوای غیرمجاز</h3><ul><li>هویت، مجوز، سابقه یا قیمت جعلی و گمراه‌کننده</li><li>استخدام یا همکاری تبعیض‌آمیز و خلاف قانون</li><li>کار ناایمن، کالای ممنوع، جعل مدرک یا درخواست پرداخت مشکوک</li><li>هرزنامه، تبلیغ تکراری و جمع‌آوری شماره تماس کاربران</li></ul></section><section class="legal-section"><h3>رسیدگی</h3><p>گزارش‌ها بررسی می‌شوند و بسته به شدت تخلف، محتوا محدود، آگهی حذف یا حساب موقتاً یا دائماً بسته می‌شود.</p></section></div>';
},

scoreGuide:function(){
  return topbar('نحوهٔ محاسبهٔ امتیاز بلوک','شفاف، قابل‌پیش‌بینی و بر پایهٔ عملکرد واقعی')+'<div class="page"><div class="legal-hero"><i>'+icon('shield',18)+'</i><h2>امتیاز بلوک از ۱۰۰</h2><p>امتیازی که روی کارت هویت و اعتبار هر کاربر نمایش داده می‌شود، از چهار بخش زیر محاسبه می‌شود. هیچ بخشی از این امتیاز با پرداخت پول یا تبلیغ قابل خرید نیست.</p></div>'
    +'<section class="legal-section"><h3>۱. میانگین امتیاز کاربران (۵۵٪ از نمرهٔ نهایی)</h3><p>میانگین ستارهٔ نظراتی که سایر کاربران پس از همکاری برای شما ثبت می‌کنند، مبنای اصلی امتیاز بلوک است. هرچه میانگین ستاره‌ها (از ۵) بالاتر باشد، سهم بیشتری از این ۵۵ امتیاز را می‌گیرید.</p></section>'
    +'<section class="legal-section"><h3>۲. پروژه‌های تکمیل‌شده در بلوک (۲۵٪ از نمرهٔ نهایی)</h3><p>تعداد پروژه یا سفارشی که از ابتدا تا پایان داخل بلوک انجام و ثبت شده باشد. این بخش تا سقف ۴۰ پروژه محاسبه می‌شود؛ یعنی از ۴۰ پروژهٔ تکمیل‌شده به بعد، امتیاز بیشتری از این بخش اضافه نمی‌شود.</p></section>'
    +'<section class="legal-section"><h3>۳. تعداد نظرات ثبت‌شده (۱۰٪ از نمرهٔ نهایی)</h3><p>صرف داشتن نظر (جدا از میانگین ستاره‌اش) هم امتیاز دارد، چون نشان می‌دهد سابقهٔ شما در بلوک با نظر واقعی کاربران دیگر تأیید شده. این بخش تا سقف ۵ نظر محاسبه می‌شود.</p></section>'
    +'<section class="legal-section"><h3>۴. تأیید هویت (۱۰٪ از نمرهٔ نهایی)</h3><p>اگر هویت شما در بلوک تأیید شده باشد، ۱۰ امتیاز ثابت به‌طور کامل به نمرهٔ نهایی اضافه می‌شود؛ در غیر این صورت این بخش صفر است.</p></section>'
    +'<section class="legal-section"><h3>راه‌های افزایش امتیاز</h3><ul><li>پروفایل و مدارک خود را برای تأیید هویت کامل کنید.</li><li>پروژه‌ها و سفارش‌ها را تا پایان و از طریق خود بلوک هماهنگ و تکمیل کنید.</li><li>از طرف مقابل بخواهید پس از پایان همکاری، نظر واقعی خود را در بلوک ثبت کند.</li><li>با ارائهٔ خدمت باکیفیت، میانگین ستارهٔ نظرات خود را بالا نگه دارید.</li></ul></section>'
    +'<div class="chat-safety">'+icon('info',14)+'<span>این امتیاز فقط بر اساس سابقهٔ واقعی داخل بلوک محاسبه می‌شود و نشان تضمین قانونی یا مالی برای هیچ همکاری نیست.</span></div></div>';
},

helpCenter:function(){
  var items=[['چطور پروفایل کامل‌تری داشته باشم؟','از بخش «من ← ویرایش پروفایل» سابقهٔ کلی، مهارت‌ها، دستمزد، مدارک و نمونه‌کار را کامل کنید.'],['چرا بعضی آگهی‌ها برای من نمایش داده نمی‌شود؟','بلوک آگهی‌ها را با نقش، مهارت، شهر و محدودهٔ فعالیت پروفایل شما تطبیق می‌دهد.'],['چطور کاربر یا پیام نامناسب را گزارش کنم؟','از منوی بالای گفت‌وگو یا انتهای پروفایل فرد، گزینهٔ گزارش یا مسدودکردن را بزنید.'],['آیا شماره موبایل من نمایش داده می‌شود؟','در پروفایل و آگهی نمایش داده نمی‌شود. داخل چت فقط با اجازهٔ خودتان، همراه با ساعت مناسب تماس نمایش داده می‌شود و هر زمان می‌توانید آن را متوقف کنید.'],['پیام صوتی چطور ارسال می‌شود؟','در همهٔ گفت‌وگوها روی علامت میکروفن بزنید؛ برای پایان و ارسال، دوباره همان علامت را لمس کنید.'],['چطور قوانین را دوباره ببینم؟','از «من ← قوانین و حریم خصوصی» نسخهٔ فعلی و وضعیت پذیرش خود را مشاهده کنید.']];
  return topbar('راهنما و پرسش‌های متداول','پاسخ سریع برای استفاده از بلوک')+'<div class="page">'+items.map(function(item,index){var open=state.helpOpen===index;return '<div class="faq-item"><button class="faq-question" onclick="toggleHelp('+index+')"><span>'+item[0]+'</span><span>'+(open?'−':'+')+'</span></button>'+(open?'<div class="faq-answer">'+item[1]+'</div>':'')+'</div>'}).join('')+'<div class="settings-group-title">هنوز پاسخ نگرفتید؟</div><button class="btn-primary" onclick="go(\'supportCenter\')">ارتباط با پشتیبانی بلوک</button></div>';
},

supportCenter:function(){
  return topbar('پشتیبانی بلوک','راهنمایی، پیگیری و گزارش مشکل')+'<div class="page"><div class="legal-hero"><i>'+icon('message',18)+'</i><h2>چطور می‌توانیم کمک کنیم؟</h2><p>برای سؤال دربارهٔ حساب، آگهی، پیام‌ها یا گزارش تخلف از مسیر مناسب استفاده کنید.</p></div><div class="settings-group">'+settingsRow('message','گفت‌وگو با پشتیبانی','پاسخ و پیگیری داخل پیام‌های بلوک','openSupportChat()')+settingsRow('alert','گزارش مشکل برنامه','صفحه یا عملکردی که درست کار نمی‌کند','openIssueSheet()')+settingsRow('help','پرسش‌های متداول','پاسخ‌های کوتاه و کاربردی',"go('helpCenter')")+'</div><div class="privacy-preview"><b>برای گزارش کاربر</b><p>از منوی همان گفت‌وگو یا صفحهٔ پروفایل استفاده کنید تا اطلاعات مرتبط همراه گزارش ارسال شود.</p></div></div>';
},

aboutApp:function(){
  return topbar('دربارهٔ بلوک','اکوسیستم صنعت ساختمان')+'<div class="page"><div class="legal-hero"><i>'+icon('building',18)+'</i><h2>بلوک</h2><p>فضایی برای پیدا کردن نیروی پروژه، متخصص، پیمانکار، مهندس، خدمات ماشین‌آلات و تأمین‌کنندهٔ مصالح با پروفایل شفاف و ارتباط امن.</p><div class="legal-meta"><span>نسخهٔ نمایشی ۱.۲</span><span>زبان فارسی</span></div></div><div class="settings-group">'+settingsRow('shield','قوانین استفاده','نسخهٔ '+LEGAL_VERSION,"go('terms')")+settingsRow('lock','حریم خصوصی','کنترل و استفاده از داده‌ها',"go('privacyPolicy')")+settingsRow('users','قواعد جامعه','انتشار و رفتار حرفه‌ای',"go('communityRules')")+'</div><div class="version-row">ساخته‌شده برای همکاری روشن‌تر در صنعت ساختمان</div></div>';
},

accountManagement:function(){
  var reasons=['دیگر استفاده نمی‌کنم','حساب دیگری دارم','نگرانی حریم خصوصی','مشکل فنی','دلیل دیگر'];
  return topbar('خروج و مدیریت حساب','کنترل نشست و حذف حساب')+'<div class="page"><div class="account-card"><div class="account-card-head"><i>'+icon('logout',16)+'</i><div><b>خروج از حساب</b><span>اطلاعات حساب حذف نمی‌شود.</span></div></div><button class="btn-secondary" style="margin-top:11px" onclick="openLogoutSheet()">خروج از این دستگاه</button></div><div class="danger-zone"><h3>حذف حساب</h3><p>با ثبت این درخواست، پروفایل عمومی غیرفعال و فرایند حذف اطلاعات آغاز می‌شود. این اقدام با خروج ساده متفاوت است.</p><div class="chip-row">'+reasons.map(function(reason){return '<button class="chip '+(state.deleteReason===reason?'active':'')+'" onclick="setDeleteReason(\''+reason+'\')">'+reason+'</button>'}).join('')+'</div><div class="confirm-check '+(state.deleteConfirm?'active':'')+'" role="checkbox" aria-checked="'+(state.deleteConfirm?'true':'false')+'" onclick="toggleDeleteConfirm()"><i>'+(state.deleteConfirm?icon('check',12):'')+'</i><span>می‌دانم که پس از حذف، دسترسی به پروفایل، آگهی‌ها و پیام‌های حساب را از دست می‌دهم.</span></div><button class="btn-secondary" style="color:var(--danger);border-color:var(--danger)" onclick="deleteAccount()">ثبت درخواست حذف حساب</button></div></div>';
},

settings:function(){
  var sizes=[['standard','استاندارد'],['large','بزرگ'],['larger','بزرگ‌تر']];
  return topbar('نمایش و خوانایی','تنظیم ظاهر برنامه برای شرایط مختلف')+'<div class="page"><div class="notification-pref"><div><b>حالت تیره</b><p>مناسب کار شبانه و محیط‌های کم‌نور</p></div><div class="switch '+(state.mode==='dark'?'on':'')+'" role="switch" aria-checked="'+(state.mode==='dark'?'true':'false')+'" onclick="setMode(\''+(state.mode==='dark'?'light':'dark')+'\')"><i></i></div></div><div class="account-card"><div class="account-card-head"><i>'+icon('doc',16)+'</i><div><b>اندازهٔ نوشته</b><span>اندازهٔ مناسب برای خواندن متن‌ها</span></div></div><div class="chip-row" style="margin-top:11px">'+sizes.map(function(size){return '<button class="chip '+(state.textSize===size[0]?'active':'')+'" aria-pressed="'+(state.textSize===size[0]?'true':'false')+'" onclick="setTextSize(\''+size[0]+'\')">'+size[1]+'</button>'}).join('')+'</div></div><div class="notification-pref"><div><b>کنتراست بیشتر</b><p>مرزها و نوشته‌های کم‌رنگ واضح‌تر شوند</p></div><div class="switch '+(state.highContrast?'on':'')+'" role="switch" aria-checked="'+(state.highContrast?'true':'false')+'" onclick="toggleHighContrast()"><i></i></div></div><div class="notification-pref"><div><b>کاهش حرکت</b><p>انیمیشن‌ها و حرکت نشان‌ها کمتر شود</p></div><div class="switch '+(state.reduceMotion?'on':'')+'" role="switch" aria-checked="'+(state.reduceMotion?'true':'false')+'" onclick="toggleReduceMotion()"><i></i></div></div><div class="account-card" style="margin-top:18px;border-color:var(--danger)"><div class="account-card-head"><i>'+icon('wrench',16)+'</i><div><b>شروع تست جدید</b><span>پاک کردن پیشرفت فعلی و شروع از صفحه اول — برای تحویل دستگاه به تستر بعدی</span></div></div><button class="btn-secondary" style="margin-top:11px;width:100%" onclick="resetTestSession()">پاک کردن و شروع دوباره</button></div></div>';
}

};

function openLoginSheet(){
  openSheet('<h3>ورود امن به بلوک</h3><p>کد یک‌بارمصرف فقط برای ورود شما پیامک می‌شود.</p><div class="field"><label>شماره موبایل</label><input class="input" dir="ltr" placeholder="09xx xxx xxxx"></div><button class="btn-primary" onclick="closeSheet();openOtpSheet()">دریافت کد ورود</button>')
}
function openOtpSheet(){
  setTimeout(function(){
    openSheet('<h3>کد تأیید را وارد کنید</h3><p>کد ۴ رقمی به شماره شما پیامک شد.</p><div class="otp-row"><input maxlength="1"><input maxlength="1"><input maxlength="1"><input maxlength="1"></div><button class="btn-primary" onclick="completeLogin()">تأیید و ورود</button>')
  },200)
}

var STATE_SNAPSHOT_KEY='block-test-session';
var STATE_SNAPSHOT_EXCLUDE=['voiceRecorder','voiceStream','voiceChunks'];
function saveStateSnapshot(){
  try{
    var copy={};
    for(var k in state){if(STATE_SNAPSHOT_EXCLUDE.indexOf(k)===-1)copy[k]=state[k]}
    sessionStorage.setItem(STATE_SNAPSHOT_KEY,JSON.stringify(copy));
  }catch(e){}
}
function restoreStateSnapshot(){
  try{
    var raw=sessionStorage.getItem(STATE_SNAPSHOT_KEY);
    if(!raw)return;
    var saved=JSON.parse(raw);
    for(var k in saved){state[k]=saved[k]}
    if(state.page==='loading'){state.page=state.loadingTarget||'home';state.loadingTarget=null}
  }catch(e){}
}
function resetTestSession(){
  try{sessionStorage.removeItem(STATE_SNAPSHOT_KEY)}catch(e){}
  location.reload();
}

function render(){
  var view=document.getElementById('view');
  var pageChanged=state.lastRenderedPage!==state.page;
  var active=document.activeElement;
  var activeId=active&&active.id?active.id:null;
  var selStart=active&&typeof active.selectionStart==='number'?active.selectionStart:null;
  var selEnd=active&&typeof active.selectionEnd==='number'?active.selectionEnd:null;
  var page=PAGES[state.page]||PAGES.unavailable;
  view.innerHTML=page()+renderNetworkBanner();
  saveStateSnapshot();
  if(pageChanged){
    var scroller=view.querySelector('.page');
    var phone=document.getElementById('phone');
    if(scroller)scroller.scrollTop=0;
    if(phone)phone.scrollTop=0;
    requestAnimationFrame(function(){if(scroller)scroller.scrollTop=0;if(phone)phone.scrollTop=0});
    state.lastRenderedPage=state.page;
  }
  if(activeId){
    var el=document.getElementById(activeId);
    if(el){el.focus&&el.focus();if(selStart!=null&&el.setSelectionRange){try{el.setSelectionRange(selStart,selEnd)}catch(e){}}}
  }
}
window.addEventListener('offline',function(){state.online=false;render()});
window.addEventListener('online',function(){state.online=true;render();toast('اتصال اینترنت برقرار شد')});
window.addEventListener('error',function(e){showDebugError((e.error&&e.error.stack)||e.message||'خطای ناشناخته',e.filename,e.lineno,e.colno)});
window.addEventListener('unhandledrejection',function(e){showDebugError('Promise rejected: '+(e.reason&&e.reason.stack||e.reason),'',0,0)});
function showDebugError(text,file,line,col){
  var box=document.getElementById('debugError');
  if(!box){
    box=document.createElement('div');
    box.id='debugError';
    box.style.cssText='position:fixed;left:8px;right:8px;bottom:8px;z-index:999;background:#3a0d0d;color:#ffd7d7;border:1px solid #c0392b;border-radius:10px;padding:10px 12px;font-family:monospace;font-size:11px;max-height:40vh;overflow:auto;direction:ltr;text-align:left;white-space:pre-wrap;word-break:break-all';
    document.body.appendChild(box);
  }
  var line2=(file?('\n@ '+file.split('/').pop()+':'+line+':'+col):'');
  var entry=document.createElement('div');
  entry.style.cssText='margin-bottom:8px;padding-bottom:8px;border-bottom:1px solid #c0392b55';
  entry.textContent=(new Date()).toLocaleTimeString()+' — '+text+line2;
  box.appendChild(entry);
  var closeBtn=document.getElementById('debugErrorClose');
  if(!closeBtn){
    closeBtn=document.createElement('button');
    closeBtn.id='debugErrorClose';
    closeBtn.textContent='بستن پیام‌های خطا';
    closeBtn.style.cssText='display:block;width:100%;margin-top:6px;background:#c0392b;color:#fff;border:none;border-radius:8px;padding:6px;font-family:inherit;font-size:11px';
    closeBtn.onclick=function(){box.remove()};
    box.appendChild(closeBtn);
  } else {
    box.appendChild(closeBtn);
  }
}
restoreStateSnapshot();
var savedMode='dark',savedTextSize='large',savedHighContrast=true;
try{savedMode=localStorage.getItem('block-mode')||'dark';savedTextSize=localStorage.getItem('block-text-size')||'large';savedHighContrast=(localStorage.getItem('block-high-contrast')||'true')!=='false'}catch(e){}
state.textSize=savedTextSize;state.highContrast=savedHighContrast;
document.documentElement.style.fontSize=savedTextSize==='large'?'17.5px':savedTextSize==='larger'?'19px':'16px';
document.getElementById('phone').setAttribute('data-contrast',savedHighContrast?'high':'normal');
setMode(savedMode);
</script>
</body></html>
