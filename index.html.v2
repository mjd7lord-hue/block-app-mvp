var EXPLORE_SKILLS=['اجرای نما','تأمین مصالح','خاک‌برداری','گودبرداری','نظارت ساختمان','مدیریت اجرا','جوشکاری','بازسازی'];
var EXPLORE_ROLE_LABELS={all:'همه',engineer:'مهندس',machinery:'ماشین‌آلات',store:'مصالح',materialsSupplier:'تأمین صنعتی',contractor:'شرکت/پیمانکار',specialist:'متخصص',worker:'نیروی کار',general:'درخواست‌ها'};
var EXPLORE_SORT_LABELS={recommended:'پیشنهاد بلوک',nearest:'نزدیک‌ترین',rating:'بیشترین امتیاز',experience:'باتجربه‌ترین',available:'زودترین شروع'};
function setExploreCity(c,fromSheet){state.exploreCity=c;if(fromSheet)openExploreFilters();else render()}
function setExploreRole(r,fromSheet){state.exploreRole=r;if(fromSheet)openExploreFilters();else render()}
function setExploreView(v){state.exploreView=v;render()}
function setExploreQuery(v){state.exploreQuery=v;render()}
function ensureExploreFilters(){
  if(!state.exploreFilters)state.exploreFilters={skills:[],experience:'all',availability:'all',range:'all',resultType:'all',verified:false,rating:'all'};
  return state.exploreFilters;
}
function setExploreFilter(key,value,fromSheet){ensureExploreFilters()[key]=value;if(fromSheet)openExploreFilters();else render()}
function toggleExploreSkill(value){
  var filters=ensureExploreFilters(),index=filters.skills.indexOf(value);
  if(index>-1)filters.skills.splice(index,1);else filters.skills.push(value);
  openExploreFilters();
}
function toggleExploreQuick(key){
  var filters=ensureExploreFilters();
  if(key==='near')filters.range=filters.range==='5'?'all':'5';
  if(key==='available')filters.availability=filters.availability==='now'?'all':'now';
  if(key==='verified')filters.verified=!filters.verified;
  render();
}
function clearExploreFilters(includeQuery){
  state.exploreCity='all';state.exploreRole='all';state.exploreSort='recommended';
  if(includeQuery)state.exploreQuery='';
  state.exploreFilters={skills:[],experience:'all',availability:'all',range:'all',resultType:'all',verified:false,rating:'all'};
  closeSheet();render();
}
function removeExploreFilter(key,value){
  var f=ensureExploreFilters();
  if(key==='role')state.exploreRole='all';
  else if(key==='city')state.exploreCity='all';
  else if(key==='skill')f.skills=f.skills.filter(function(skill){return skill!==value});
  else if(key==='verified')f.verified=false;
  else f[key]='all';
  render();
}
function exploreActiveCount(){
  var f=ensureExploreFilters(),count=f.skills.length;
  if(state.exploreRole!=='all')count++;if(state.exploreCity!=='all')count++;
  ['experience','availability','range','resultType','rating'].forEach(function(key){if(f[key]!=='all')count++});
  if(f.verified)count++;
  return count;
}
function cycleExploreSort(){
  var keys=['recommended','nearest','rating','experience','available'];
  state.exploreSort=keys[(keys.indexOf(state.exploreSort)+1)%keys.length];render();
}
function availabilityRank(value){return {now:0,today:1,week:2,flexible:3}[value]||4}
function filteredExploreItems(){
  var q=(state.exploreQuery||'').trim(),f=ensureExploreFilters();
  var items=EXPLORE_ITEMS.filter(function(i){
    if(i.status==='matched')return false;
    if(MVP_HIDE_BUSINESS_ROLES&&BUSINESS_ROLES.indexOf(i.role)>-1)return false;
    var matchesCity=state.exploreCity==='all'||i.city===state.exploreCity;
    var matchesRole=state.exploreRole==='all'||i.role===state.exploreRole||(i.targetRoles||[]).indexOf(state.exploreRole)>-1;
    var matchesRange=f.range==='all'||i.distance<=Number(f.range);
    var matchesSkill=!f.skills.length||f.skills.some(function(skill){return i.skills.indexOf(skill)>-1});
    var matchesExperience=f.experience==='all'||(f.experience==='junior'&&i.experienceYears<3)||(f.experience==='mid'&&i.experienceYears>=3&&i.experienceYears<=7)||(f.experience==='senior'&&i.experienceYears>7);
    var matchesAvailability=f.availability==='all'||i.availability===f.availability||(f.availability==='today'&&i.availability==='now');
    var matchesType=f.resultType==='all'||i.resultType===f.resultType;
    var matchesTrust=(!f.verified||i.verified)&&(f.rating==='all'||i.rating>=4.5);
    var haystack=i.title+' '+i.sub+' '+i.city+' '+i.skills.join(' ')+' '+(roleSchemas[i.role]?roleSchemas[i.role].label:'');
    return matchesCity&&matchesRole&&matchesRange&&matchesSkill&&matchesExperience&&matchesAvailability&&matchesType&&matchesTrust&&(!q||haystack.indexOf(q)>-1);
  });
  return items.sort(function(a,b){
    if(state.exploreSort==='nearest')return a.distance-b.distance;
    if(state.exploreSort==='rating')return b.rating-a.rating;
    if(state.exploreSort==='experience')return b.experienceYears-a.experienceYears;
    if(state.exploreSort==='available')return availabilityRank(a.availability)-availabilityRank(b.availability);
    return Number(b.featured)-Number(a.featured)||b.rating-a.rating||a.distance-b.distance;
  });
}
function exploreOptionChip(label,active,onclick){return '<button class="filter-option'+(active?' active':'')+'" onclick="'+onclick+'">'+esc(label)+(active?icon('check',11):'')+'</button>'}
function exploreJobFilterCount(){var q=ensureJobQuick();return (q.near?1:0)+(q.soon?1:0)+(q.projectBased?1:0)+(state.exploreCity!=='all'?1:0)}
function openJobFilters(){
  var q=ensureJobQuick();
  var cities=['all','قشم','بندرعباس'].map(function(key){return exploreOptionChip(key==='all'?'همه شهرها':key,state.exploreCity===key,"setExploreCity('"+key+"',true)")}).join('');
  var quick=exploreOptionChip('نزدیک من',q.near,"toggleJobQuick('near')")+exploreOptionChip('شروع زود',q.soon,"toggleJobQuick('soon')")+exploreOptionChip('پروژه‌ای',q.projectBased,"toggleJobQuick('projectBased')");
  var html='<div class="filter-sheet-head"><div><h3>فیلترهای فرصت‌های کاری</h3><p>'+exploreJobFilterCount()+' فیلتر فعال</p></div><button class="sheet-close" aria-label="بستن" onclick="closeSheet()">×</button></div>'
    +'<div class="explore-filter-scroll">'
    +'<div class="filter-group"><b>شهر</b><div class="filter-options">'+cities+'</div></div>'
    +'<div class="filter-group"><b>فیلتر سریع</b><div class="filter-options">'+quick+'</div></div>'
    +'</div><div class="filter-sheet-actions"><button class="filter-clear" onclick="state.jobQuick={near:false,soon:false,projectBased:false};state.exploreCity=\'all\';render();closeSheet();openJobFilters()">پاک کردن</button><button class="filter-apply" onclick="closeSheet();render()">نمایش '+filteredJobOpportunities().length+' نتیجه</button></div>';
  openSheet(html);
}
function openExploreFilters(){
  var f=ensureExploreFilters();
  var roles=['all'].concat(mvpVisibleRoles).map(function(key){return exploreOptionChip(EXPLORE_ROLE_LABELS[key],state.exploreRole===key,"setExploreRole('"+key+"',true)")}).join('');
  var cities=['all','قشم','بندرعباس'].map(function(key){return exploreOptionChip(key==='all'?'همه شهرها':key,state.exploreCity===key,"setExploreCity('"+key+"',true)")}).join('');
  var ranges=[['all','همه فاصله‌ها'],['5','تا ۵ کیلومتر'],['15','تا ۱۵ کیلومتر'],['30','تا ۳۰ کیلومتر']].map(function(item){return exploreOptionChip(item[1],f.range===item[0],"setExploreFilter('range','"+item[0]+"',true)")}).join('');
  var skills=EXPLORE_SKILLS.map(function(skill){return exploreOptionChip(skill,f.skills.indexOf(skill)>-1,"toggleExploreSkill('"+skill+"')")}).join('');
  var experience=[['all','همه'],['junior','کمتر از ۳ سال'],['mid','۳ تا ۷ سال'],['senior','بیش از ۷ سال']].map(function(item){return exploreOptionChip(item[1],f.experience===item[0],"setExploreFilter('experience','"+item[0]+"',true)")}).join('');
  var availability=[['all','هر زمان'],['now','همین حالا'],['today','امروز'],['week','این هفته'],['flexible','با هماهنگی']].map(function(item){return exploreOptionChip(item[1],f.availability===item[0],"setExploreFilter('availability','"+item[0]+"',true)")}).join('');
  var types=[['all','همه نتایج'],['provider','متخصص و مجری'],['opportunity','فرصت پروژه'],['store','فروشگاه']].map(function(item){return exploreOptionChip(item[1],f.resultType===item[0],"setExploreFilter('resultType','"+item[0]+"',true)")}).join('');
  var trust=exploreOptionChip('فقط تأییدشده‌ها',f.verified,"setExploreFilter('verified',"+(!f.verified)+",true)")+exploreOptionChip('امتیاز ۴٫۵ به بالا',f.rating==='4.5',"setExploreFilter('rating','"+(f.rating==='4.5'?'all':'4.5')+"',true)");
  var html='<div class="filter-sheet-head"><div><h3>فیلترهای جست‌وجو</h3><p>'+exploreActiveCount()+' فیلتر فعال · انتخاب دقیق‌تر، نتیجهٔ بهتر</p></div><button class="sheet-close" aria-label="بستن" onclick="closeSheet()">×</button></div>'
    +'<div class="explore-filter-scroll">'
    +'<div class="filter-group"><b>نقش کاربران</b><div class="filter-options">'+roles+'</div></div>'
    +'<div class="filter-group"><b>شهر</b><div class="filter-options">'+cities+'</div></div>'
    +'<div class="filter-group"><b>محدوده</b><div class="filter-options">'+ranges+'</div></div>'
    +'<div class="filter-group"><b>مهارت‌ها</b><div class="filter-options">'+skills+'</div></div>'
    +'<div class="filter-group"><b>سابقه</b><div class="filter-options">'+experience+'</div></div>'
    +'<div class="filter-group"><b>در دسترس بودن</b><div class="filter-options">'+availability+'</div></div>'
    +'<div class="filter-group"><b>نوع نتیجه <span>پیشنهاد بلوک</span></b><div class="filter-options">'+types+'</div></div>'
    +'<div class="filter-group"><b>اعتبار <span>پیشنهاد بلوک</span></b><div class="filter-options">'+trust+'</div></div>'
    +'</div><div class="filter-sheet-actions"><button class="filter-clear" onclick="clearExploreFilters()">پاک کردن</button><button class="filter-apply" onclick="closeSheet();render()">نمایش '+filteredExploreItems().length+' نتیجه</button></div>';
  openSheet(html);
}

