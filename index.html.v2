function calendarType(role){return CALENDAR_TYPE[role]||null}
/* Independent per-machine day calendar (machinery role): each machine gets its own bookable strip, shown right on the public profile. */
function getMachineCalendar(idx){
  var machine=(state.collections.machines||[])[idx];
  if(!machine)return [];
  if(!machine._cal){
    machine._cal=[0,1,2,3,4].map(function(i){return {date:(12+i)+' مرداد',status:i===1?'booked':'available',time:i===1?'رزروشده':''}});
  }
  return machine._cal;
}
function cycleMachineDay(machineIdx,dayIdx){
  var machine=(state.collections.machines||[])[machineIdx];if(!machine)return;
  var day=getMachineCalendar(machineIdx)[dayIdx];if(!day)return;
  if(day.status==='booked'){toast('این روز قبلاً رزرو شده است');return}
  var order=['available','off'];
  day.status=order[(order.indexOf(day.status)+1)%order.length];
  render();
}
function renderMachineCalendarStrip(idx){
  var days=getMachineCalendar(idx);
  var strip=days.map(function(d,i){
    var cls=d.status==='available'?'cal-available':d.status==='booked'?'cal-booked':'cal-off';
    return '<div class="cal-pill '+cls+'" onclick="event.stopPropagation();cycleMachineDay('+idx+','+i+')"><span>'+esc(d.date.split(' ')[0])+'</span><b>'+(d.status==='booked'?'رزرو':d.status==='off'?'خاموش':'آزاد')+'</b></div>';
  }).join('');
  return '<div class="machine-cal-label">تقویم رزرو همین دستگاه</div><div class="cal-strip machine-cal-strip">'+strip+'</div>';
}
function getCalendar(role){
  if(!state.calendar[role]){
    var type=calendarType(role);
    if(type==='availability'){
      state.calendar[role]=cloneData(AVAILABILITY_SEED[role]||{days:[],requests:[]});
      state.calendar[role].days.forEach(function(day,index){day.label=day.label||availabilityDayLabel(index,day);if(day.status==='available'&&!day.time)day.time=index%2?'عصر':'تمام روز'});
      state.calendar[role].requests.forEach(function(request){request.status=request.status||'pending'});
    }
    else if(type==='bookings')state.calendar[role]=cloneData(BOOKING_SEED[role]||[]);
    else if(type==='appointments')state.calendar[role]=cloneData(APPOINTMENT_SEED);
    else state.calendar[role]=[];
  }
  return state.calendar[role];
}
function getOrders(){if(!state.calendar._orders)state.calendar._orders=cloneData(ORDER_SEED);return state.calendar._orders}

function availabilityDayLabel(index,day){return (DAY_NAMES[index]||'روز')+' '+day.date+' مرداد'}
function openAvailabilityDaySheet(idx){
  var data=getCalendar(state.role||'worker');
  if(!data||!data.days){toast('تقویم در دسترس نیست؛ صفحه را دوباره باز کنید');return}
  var day=data.days[idx];
  if(!day)return;
  if(day.status==='booked'){toast('این روز قبلاً رزرو شده و قابل تغییر نیست');return}
  state.availabilityDraft={index:idx,status:day.status,time:day.time||'تمام روز'};
  var choices=[['صبح','صبح'],['عصر','عصر'],['تمام روز','تمام روز'],['off','در دسترس نیستم']];
  var html='<h3>برنامهٔ '+esc(availabilityDayLabel(idx,day))+'</h3><p>زمانی را انتخاب کنید که واقعاً امکان هماهنگی و شروع کار دارید.</p><div class="availability-sheet-grid">'+choices.map(function(choice){var active=choice[0]==='off'?state.availabilityDraft.status==='off':state.availabilityDraft.status==='available'&&state.availabilityDraft.time===choice[0];return '<button class="'+(active?'active':'')+'" onclick="saveAvailabilityDay('+idx+',\''+choice[0]+'\')">'+choice[1]+'</button>'}).join('')+'</div><button class="btn-secondary" onclick="closeSheet()">انصراف</button>';
  openSheet(html);
}
function saveAvailabilityDay(idx,value){
  var data=getCalendar(state.role||'worker');
  if(!data||!data.days)return;
  var day=data.days[idx];
  if(!day||day.status==='booked')return;
  day.status=value==='off'?'off':'available';day.time=value==='off'?'':value;day.label=availabilityDayLabel(idx,day);
  closeSheet();render();toast(value==='off'?'این روز غیرفعال شد':'زمان آزاد شما ثبت شد');
}
function cycleDay(idx){openAvailabilityDaySheet(idx)}
function acceptRequest(idx){
  var data=getCalendar(state.role||'worker'),request=data.requests[idx];if(!request||request.status&&request.status!=='pending')return;request.status='accepted';
  if(request){var day=data.days.find(function(item){return request.date.indexOf(item.date)>-1});if(day){day.status='booked';day.time=request.date.split('·')[1]||day.time||'هماهنگ‌شده'}getNotifications().unshift({title:'زمان همکاری تأیید شد',sub:request.title+' · '+request.date,time:'همین حالا',day:'امروز',read:false,icon:'calendar',type:'project',target:'calendar',action:'دیدن تقویم'});toast('زمان هماهنگی تأیید شد')}
  render();
}
function declineRequest(idx){var data=getCalendar(state.role||'worker'),request=data.requests[idx];if(!request||request.status&&request.status!=='pending')return;request.status='declined';getNotifications().unshift({title:'درخواست هماهنگی رد شد',sub:request.title+' · '+request.date,time:'همین حالا',day:'امروز',read:false,icon:'alert',type:'project',target:'calendar',action:'دیدن تقویم'});toast('درخواست هماهنگی رد شد');render()}

function openBookingSheet(idx){
  state.draftBookingIndex=idx;
  var list=getCalendar(state.role||'worker');
  state.draftBooking=idx>-1?Object.assign({},list[idx]):{title:'',date:'',time:'',who:''};
  renderBookingSheet();
}
function setBookingDraft(k,v){state.draftBooking[k]=v}
function renderBookingSheet(){
  var b=state.draftBooking;
  var html='<h3>'+(state.draftBookingIndex>-1?'ویرایش رزرو':'افزودن رزرو دستی')+'</h3>'
   +'<div style="overflow:auto;flex:1;margin-bottom:14px;padding-left:2px">'
   +'<div class="field"><label>عنوان</label><input class="input" value="'+esc(b.title)+'" oninput="setBookingDraft(\'title\',this.value)"></div>'
   +'<div class="field"><label>تاریخ</label><input class="input" placeholder="مثلاً دوشنبه ۱۹ مرداد" value="'+esc(b.date)+'" oninput="setBookingDraft(\'date\',this.value)"></div>'
   +'<div class="field"><label>ساعت</label><input class="input" placeholder="مثلاً ۰۹:۰۰" value="'+esc(b.time)+'" oninput="setBookingDraft(\'time\',this.value)"></div>'
   +'<div class="field"><label>طرف مقابل</label><input class="input" placeholder="نام کارفرما یا مشتری" value="'+esc(b.who)+'" oninput="setBookingDraft(\'who\',this.value)"></div>'
   +'</div><button class="btn-primary" onclick="saveBookingSheet()">ذخیره</button>'
   +(state.draftBookingIndex>-1?'<div style="height:8px"></div><button class="btn-secondary" style="color:var(--danger);border-color:var(--danger)" onclick="deleteBookingSheet()">حذف این رزرو</button>':'');
  openSheet(html);
}
function saveBookingSheet(){
  var list=getCalendar(state.role||'worker');
  if(!state.draftBooking.title){toast('عنوان را وارد کنید');return}
  if(state.draftBookingIndex>-1)list[state.draftBookingIndex]=state.draftBooking;else list.push(state.draftBooking);
  closeSheet();render();
}
function deleteBookingSheet(){getCalendar(state.role||'worker').splice(state.draftBookingIndex,1);closeSheet();render()}

function setProjectField(k,v){state.projectDraft[k]=v}
function setProjectCategory(v){state.projectDraft.category=v;render()}
function setProjectProvince(v){state.projectDraft.province=v;state.projectDraft.city='';render()}
function submitProject(){
  if(!state.projectDraft.title){toast('لطفاً عنوان را وارد کنید');return}
  var who=state.projectTarget?PEOPLE_SEED[state.projectTarget].name:'در انتظار پیشنهاد';
  getProjects(state.role).push({title:state.projectDraft.title,who:who,personId:state.projectTarget||null,stage:'proposed',rating:0,direction:'outgoing'});
  addOutgoingRequest('project',state.projectDraft.title,who,state.projectDraft.category||'درخواست پروژه');
  go('projectDone');
}

function startAd(type){
  type=AD_CONFIG[type]?type:'work';
  state.adStep=0;
  state.adWarnings={};
  var profile=adProfileSnapshot(),categories=profile.categories;
  state.adDraft={type:type,targetRole:'',targetRoles:[],categories:categories.slice(),title:adFixedTitle(type),province:profile.province||'',city:profile.city||'',range:type==='consult'?'تمام استان‌ها':profile.city?'داخل شهر':'تمام استان‌ها',budget:profileRateOptions()[0]||'توافقی',startTime:'با هماهنگی',description:'',attachment:null,contact:'چت بلوک'};
  go('createAd');
}
function adFixedTitle(type){return type==='work'?'دنبال کار هستم':type==='workforce'?'دنبال نیروی کار هستم':''}
function activeAdConfig(){return AD_CONFIG[state.adDraft.type]||AD_CONFIG.work}
function changeAdType(type){
  if(!AD_CONFIG[type])return;
  var categories=profileAdCategories(),profile=adProfileSnapshot();
  state.adDraft.type=type;state.adDraft.targetRole='';state.adDraft.targetRoles=[];state.adDraft.categories=categories.slice();state.adDraft.title=adFixedTitle(type);state.adDraft.province=profile.province||'';state.adDraft.city=profile.city||'';state.adDraft.range=type==='consult'?'تمام استان‌ها':profile.city?'داخل شهر':'تمام استان‌ها';state.adDraft.attachment=null;state.adWarnings={};render();
}
function setAdField(key,value){state.adDraft[key]=value}
function chooseAdField(key,value){state.adDraft[key]=value;if(state.adWarnings)state.adWarnings[key]=false;render()}
function setAdProvince(value){state.adDraft.province=value;state.adDraft.city='';state.adWarnings.province=false;render()}
function chooseAdRole(role){
  var values=state.adDraft.targetRoles||(state.adDraft.targetRoles=[]),index=values.indexOf(role);
  if(index>-1)values.splice(index,1);
  else if(values.length>=3){toast('حداکثر سه گزینه می‌توانید انتخاب کنید');return}
  else values.push(role);
  state.adDraft.targetRole=values[0]||'';
  state.adWarnings.targetRole=false;
  render();
}
function uniqueText(values){
  var seen={};return values.filter(function(value){value=String(value||'').trim();if(!value||seen[value])return false;seen[value]=true;return true});
}
function profileAdCategories(){
  var role=state.role||'worker',keys={
    general:['generalNeeds'],contractor:['projectTypes','contractorServices','crewSkills'],company:['projectTypes','contractorServices','crewSkills'],
    engineer:['engineerTitles','qualifications','engineeringBranch'],specialist:['specialistFields'],worker:['workerFields'],
    machinery:['machineActivities'],store:['materialCategories']
  }[role]||[],values=[];
  keys.forEach(function(key){var value=state.values[key];if(Array.isArray(value))values=values.concat(value);else if(value)values.push(value)});
  var schema=roleSchemas[role],collectionKeys=schema&&schema.collections?Object.keys(schema.collections):[];
  collectionKeys.forEach(function(key){
    var col=schema.collections[key],items=state.collections[key]||[];
    items.forEach(function(item){var value=item[col.titleKey];if(value)values.push(value)});
  });
  return uniqueText(values);
}
function profileRateOptions(){
  var values=[];
  ['rateType','rate','wageType'].forEach(function(key){if(state.values[key])values.push(state.values[key])});
  Object.keys(state.collections||{}).forEach(function(key){(state.collections[key]||[]).forEach(function(item){if(item.rateType)values.push(item.rateType);else if(item.rate)values.push(item.rate)})});
  return uniqueText(values.concat(['توافقی']));
}
function profileExperienceSummary(){
  return String(state.values.overallExperienceCustom||state.values.overallExperience||'').trim();
}
function profileSkillDetails(){
  var role=state.role||'worker',schema=roleSchemas[role]||{},details=[];
  Object.keys(schema.collections||{}).forEach(function(key){
    var col=schema.collections[key],items=state.collections[key]||[];
    items.forEach(function(item){
      var name=item[col.titleKey]||item[col.syncFieldKey]||'',experience=item.experience||item.relatedExperience||'',rateType=item.rateType||item.rate||item.wageType||'',rateAmount=item.rateAmount||item.amount||'';
      if(name)details.push({name:name,experience:experience||'سابقهٔ این مهارت هنوز تکمیل نشده',rateType:rateType||'دستمزد توافقی',rateAmount:rateAmount||rateType||'توافقی'});
    });
  });
  return details;
}
function adProfileSnapshot(){
  var role=state.role||'worker',schema=roleSchemas[role]||roleSchemas.worker;
  var savedCity=state.values.generalCity||state.values.workCity||state.values.quickCity||state.values.city||state.values.activityCity||'';
  var savedProvince=state.values.workProvince||state.values.province||'';
  var trust=myTrustPerson(role);
  return {name:displayNameFor(role)||schema.name,initials:schema.initials,role:role,roleLabel:schema.label,profileTitle:schema.profileTitle||schema.label,province:savedProvince,city:savedCity,categories:trust.skills||profileAdCategories(),experience:trust.experience,skillDetails:trust.skillDetails||[],verified:!!state.profileComplete,rating:trust.rating,completed:trust.completed,age:trust.age,birthPlace:trust.birthPlace,reviews:trust.reviews};
}
function adMissingForStep(step){
  var d=state.adDraft,missing=[];
  if(step===0){
    if(!(d.targetRoles||[]).length)missing.push('targetRole');
    if(!profileAdCategories().length||!(d.categories||[]).length)missing.push('category');
    if(d.type==='consult'&&!(d.title||'').trim())missing.push('title');
    if(d.type!=='work'&&!(d.description||'').trim())missing.push('description');
    if(d.type==='workforce'){if(!(d.province||'').trim())missing.push('province');if(!(d.city||'').trim())missing.push('city')}
  }
  return missing;
}
function nextAdStep(){
  var missing=adMissingForStep(state.adStep);
  if(missing.length){missing.forEach(function(key){state.adWarnings[key]=true});render();toast(state.adDraft.type==='consult'?'عنوان، توضیحات و پاسخ‌دهندگان را کامل کنید':state.adDraft.type==='work'?'مخاطبان را انتخاب و مهارت‌های پروفایل را کامل کنید':'نیروی موردنظر، توضیحات و محل پروژه را کامل کنید');return}
  if(state.adStep<1)state.adStep++;render();
}
function previousAdStep(){if(state.adStep>0){state.adStep--;render()}else back()}
function adAudienceCount(){
  var roles=state.adDraft.targetRoles||[],count=roles.reduce(function(sum,role){return sum+(AD_ROLE_COUNTS[role]||8)},0);
  if(state.adDraft.type==='workforce'&&state.adDraft.city)count=Math.round(count*.65);
  if((state.adDraft.categories||[]).length)count=Math.round(count*.78);
  return roles.length?Math.max(4,count):0;
}
function adRoleNames(){return (state.adDraft.targetRoles||[]).map(function(role){return AD_ROLE_LABELS[role]||role})}
function openMaterialDiscovery(){
  state.exploreRole='store';state.exploreQuery='';state.exploreView='cards';
  state.exploreFilters={skills:[],experience:'all',availability:'all',range:'15',resultType:'store',verified:true,rating:'all'};
  go('explore');setTimeout(function(){toast('فروشگاه‌های نزدیک و تأییدشده نمایش داده شدند')},80);
}
function publishAd(){
  var missing=adMissingForStep(0);
  if(missing.length){missing.forEach(function(key){state.adWarnings[key]=true});state.adStep=0;render();toast(state.adDraft.type==='consult'?'عنوان، توضیحات و پاسخ‌دهندگان را کامل کنید':state.adDraft.type==='work'?'مخاطبان را انتخاب و اطلاعات تخصصی پروفایل را کامل کنید':'نیروی موردنظر، توضیحات و محل پروژه را کامل کنید');return}
  var d=state.adDraft,config=activeAdConfig(),roles=(d.targetRoles||[]).slice(),profile=adProfileSnapshot();
  var title=(d.title||adFixedTitle(d.type)).trim(),city=d.type==='consult'?d.range:d.type==='work'?(profile.city||profile.province||d.range):d.city.trim(),skills=d.categories.slice();
  var audience=adAudienceCount();
  var availabilityLabel=d.type==='consult'?'پاسخ در چت بلوک':d.type==='work'?'آمادهٔ همکاری':(d.startTime||'با هماهنگی');
  var item={id:'ad-'+Date.now(),isAd:true,title:title,sub:d.description||config.exploreSub,icon:config.icon,city:city,province:d.type==='work'?(profile.province||''):(d.province||''),role:roles[0],ownerRole:state.role||'worker',targetRoles:roles,profile:profile,x:34,y:42,skills:skills,categories:skills,category:skills.join('، '),description:d.description||'',attachment:d.type==='consult'?(d.attachment||null):null,budget:d.type==='consult'?'':(d.budget||'توافقی'),range:d.range,startTime:d.type==='consult'?'':d.startTime,contact:'چت بلوک؛ نمایش شماره طبق تنظیم حریم خصوصی آگهی‌دهنده',experienceYears:1,experienceLabel:profile.experience||'آگهی تازه',availability:d.type==='consult'||d.type==='work'?'flexible':d.startTime==='فوری'?'now':d.startTime==='امروز'?'today':'week',availabilityLabel:availabilityLabel,distance:2.3,resultType:'opportunity',resultLabel:config.shortLabel,verified:profile.verified,rating:null,tone:config.tone,featured:true,isFresh:true,adType:d.type,status:'active',agreement:null};
  EXPLORE_ITEMS.unshift(item);
  getProjects(state.role||'worker').push({title:title,who:'منتظر پاسخ مخاطبان',personId:null,stage:'proposed',rating:0,direction:'outgoing'});
  getNotifications().unshift({title:'آگهی منتشر شد',sub:'برای '+audience+' کاربر مرتبط در محدودهٔ '+d.range+' اعلان ارسال شد',time:'همین حالا',day:'امروز',read:false,icon:'bell',type:'project',target:'adPublished',action:'مشاهدهٔ نتیجه'});
  state.lastPublishedAd={id:item.id,title:title,city:city,audience:audience,roles:adRoleNames(),categories:skills,type:d.type};
  state.page='adPublished';render();
}
function handleAdAttachment(input){
  var file=input.files&&input.files[0];if(!file)return;
  var reader=new FileReader();reader.onload=function(event){state.adDraft.attachment=event.target.result;render()};reader.readAsDataURL(file);
}
function viewPublishedAd(){
  state.exploreRole='all';state.exploreView='cards';state.exploreQuery='';
  state.exploreFilters={skills:[],experience:'all',availability:'all',range:'all',resultType:'opportunity',verified:false,rating:'all'};
  state.stack=[];state.page='explore';render();
}
function openExploreItem(item){return item.isAd?"openAdDetail('"+item.id+"')":"openPersonProfile('"+item.person+"')"}
function openAdDetail(id){state.viewingAdId=id;go('adDetail')}
function currentAdDetail(){return EXPLORE_ITEMS.find(function(item){return item.id===state.viewingAdId})||state.lastPublishedAd}
function startAdChat(id){
  var ad=EXPLORE_ITEMS.find(function(item){return item.id===id});if(!ad)return;
  var conversation=getConversations().find(function(c){return c.adId===id});
  if(!conversation){var profile=ad.profile||{},conversationId='conversation-'+id;conversation={id:conversationId,adId:id,personId:ad.person||null,name:profile.name||ad.title,initials:profile.initials||'ب',verified:!!profile.verified,online:true,type:'project',unread:0,pinned:false,muted:false,archived:false,time:'اکنون',lastMessage:'گفت‌وگو دربارهٔ این آگهی شروع شد',context:{icon:ad.icon||'building',label:ad.adType==='consult'?'پرسش تخصصی':ad.adType==='work'?'آگهی پیدا کردن کار':'آگهی نیروی کار',title:ad.title,meta:(ad.city||'')+(ad.range?' · '+ad.range:''),adId:id},messages:[{type:'system',text:'این گفت‌وگو دربارهٔ «'+ad.title+'» ایجاد شد. جزئیات آگهی در بالای صفحه در دسترس است.'}]};getConversations().unshift(conversation)}
  state.adChatId=id;state.currentConversationId=conversation.id;go('chat');
}

function agreementForAd(ad){return ad&&ad.agreement||null}
function requestAdAgreement(id){
  var ad=EXPLORE_ITEMS.find(function(item){return item.id===id});if(!ad||ad.status==='matched')return;
  if(ad.agreement&&ad.agreement.viewerConfirmed){toast('تأیید شما قبلاً ثبت شده است');return}
  ad.agreement={viewerConfirmed:true,ownerConfirmed:false,status:'pending',createdAt:'همین حالا',viewerName:displayNameFor(state.role||'worker'),ownerName:(ad.profile&&ad.profile.name)||'ثبت‌کنندهٔ آگهی'};
  var request={id:'agree-'+ad.id,type:'agreement',adId:ad.id,title:'تأیید همکاری · '+ad.title,from:displayNameFor(state.role||'worker'),detail:'پس از تأیید شما، آگهی از اکسپلور خارج و همکاری برای هر دو طرف به پروژه‌ها اضافه می‌شود.',status:'pending'};
  getIncomingRequests().unshift(request);
  var c=getConversations().find(function(item){return item.adId===id});if(c)c.messages.push({type:'system',text:'یک طرف همکاری را تأیید کرد. برای شروع رسمی پروژه، تأیید طرف دوم لازم است.'});
  getNotifications().unshift({title:'تأیید اول همکاری ثبت شد',sub:'«'+ad.title+'» منتظر تأیید طرف دوم است.',time:'همین حالا',day:'امروز',read:false,icon:'check',type:'project',target:'requestsCenter',action:'پیگیری توافق'});
  render();toast('تأیید شما ثبت شد؛ منتظر تأیید طرف مقابل باشید');
}
function respondToAgreementRequest(item,status){
  var ad=EXPLORE_ITEMS.find(function(candidate){return candidate.id===item.adId});if(!ad||!ad.agreement)return;
  item.status=status;
  if(status==='accepted'){
    ad.agreement.ownerConfirmed=true;ad.agreement.status='confirmed';finalizeAdAgreement(ad);
  }else{
    ad.agreement.viewerConfirmed=false;ad.agreement.ownerConfirmed=false;ad.agreement.status='declined';
    var c=getConversations().find(function(candidate){return candidate.adId===ad.id});if(c)c.messages.push({type:'system',text:'طرف مقابل فعلاً توافق همکاری را تأیید نکرد. آگهی همچنان در اکسپلور فعال است.'});
    getNotifications().unshift({title:'توافق کاری تأیید نشد',sub:'آگهی «'+ad.title+'» همچنان فعال است.',time:'همین حالا',day:'امروز',read:false,icon:'alert',type:'project',target:'adDetail',action:'دیدن آگهی'});render();toast('درخواست توافق رد شد و آگهی فعال ماند');
  }
}
function finalizeAdAgreement(ad){
  if(!ad||!ad.agreement||!ad.agreement.viewerConfirmed||!ad.agreement.ownerConfirmed)return;
  ad.status='matched';ad.featured=false;ad.agreement.completedAt='همین حالا';
  var role=state.role||'worker',projects=getProjects(role),exists=projects.some(function(project){return project.adId===ad.id});
  if(!exists)projects.unshift({adId:ad.id,title:ad.title,who:(ad.profile&&ad.profile.name)||'همکار بلوک',stage:'agreed',rating:0,direction:'mutual',bothParties:true});
  var ownerRole=ad.ownerRole||ad.profile&&ad.profile.role;if(ownerRole&&ownerRole!==role){var ownerProjects=getProjects(ownerRole);if(!ownerProjects.some(function(project){return project.adId===ad.id}))ownerProjects.unshift({adId:ad.id,title:ad.title,who:displayNameFor(role),stage:'agreed',rating:0,direction:'mutual',bothParties:true})}
  var c=getConversations().find(function(candidate){return candidate.adId===ad.id});if(c)c.messages.push({type:'system',text:'توافق هر دو طرف ثبت شد. آگهی از اکسپلور خارج و این همکاری به پروژه‌های هر دو طرف اضافه شد.'});
  getNotifications().unshift({title:'همکاری دوطرفه تأیید شد',sub:'«'+ad.title+'» به پروژه‌های هر دو طرف اضافه و از اکسپلور خارج شد.',time:'همین حالا',day:'امروز',read:false,icon:'check',type:'project',target:'myProjects',action:'دیدن پروژه'});
  render();toast('توافق کامل شد؛ پروژه برای هر دو طرف ثبت شد');
}
function renderAgreementCard(ad){
  if(!ad||ad.adType==='consult')return '';
  var agreement=agreementForAd(ad),viewer=!!(agreement&&agreement.viewerConfirmed),owner=!!(agreement&&agreement.ownerConfirmed),complete=viewer&&owner;
  return '<div class="agreement-card"><div class="agreement-card-head"><i>'+icon('check',16)+'</i><div><b>ثبت توافق و شروع رسمی همکاری</b><p>'+(complete?'توافق دوطرفه ثبت شده و این کار به پروژه‌های هر دو طرف اضافه شده است.':'بعد از هماهنگی در چت، هر دو طرف باید جداگانه تأیید کنند.')+'</p></div></div><div class="agreement-parties"><div class="agreement-party '+(viewer?'confirmed':'')+'"><span>تأیید درخواست‌دهنده</span><b>'+icon(viewer?'check':'calendar',10)+(viewer?'تأیید شده':'در انتظار')+'</b></div><div class="agreement-party '+(owner?'confirmed':'')+'"><span>تأیید ثبت‌کنندهٔ آگهی</span><b>'+icon(owner?'check':'calendar',10)+(owner?'تأیید شده':'در انتظار')+'</b></div></div>'+(complete?'<div class="agreement-complete">آگهی از اکسپلور خارج شد</div>':viewer?'<button class="btn-secondary" style="margin-top:10px" onclick="go(\'requestsCenter\')">پیگیری تأیید طرف مقابل</button>':'<button class="btn-primary" onclick="requestAdAgreement(\''+ad.id+'\')">من این همکاری را تأیید می‌کنم</button>')+'</div>';
}

function setStartCoordination(k,v){state.startCoordinationDraft[k]=v}
function openStartCoordinationSheet(idx){
  var p=getProjects(state.role)[idx];
  state.startCoordinationIndex=idx;
  state.startCoordinationDraft={date:p.startDate||'',note:p.startNote||''};
  var html='<h3>هماهنگی زمان شروع</h3>'
    +'<p>این زمان پس از توافق اولیهٔ کار، بین کارفرما و متخصص نهایی می‌شود.</p>'
    +'<div class="field"><label>زمان پیشنهادی شروع</label><input class="input" value="'+esc(state.startCoordinationDraft.date)+'" oninput="setStartCoordination(\'date\',this.value)" placeholder="مثلاً شنبه ۲۵ مرداد، ساعت ۸"></div>'
    +'<div class="field"><label>یادداشت هماهنگی (اختیاری)</label><textarea class="textarea" oninput="setStartCoordination(\'note\',this.value)" placeholder="مثلاً قبل از شروع، بازدید کارگاه انجام شود">'+esc(state.startCoordinationDraft.note)+'</textarea></div>'
    +'<button class="btn-primary" onclick="saveStartCoordination()">ارسال برای تأیید طرف مقابل</button>';
  openSheet(html);
}
function saveStartCoordination(){
  if(!state.startCoordinationDraft.date){toast('زمان پیشنهادی را وارد کنید');return}
  var p=getProjects(state.role)[state.startCoordinationIndex];
  p.startDate=state.startCoordinationDraft.date;
  p.startNote=state.startCoordinationDraft.note;
  p.startStatus='در انتظار تأیید طرف مقابل';
  addOutgoingRequest('calendar','تأیید زمان شروع · '+p.title,p.who,p.startDate);
  closeSheet();render();toast('زمان پیشنهادی برای طرف مقابل ارسال شد');
}

/* ---------- active projects & ratings ---------- */
var STAGE_ORDER=['proposed','agreed','inprogress','done'];
var STAGE_LABELS={proposed:'در انتظار پاسخ',agreed:'توافق شد',inprogress:'در حال اجرا',done:'تکمیل شد',declined:'رد شده'};
var PROJECT_SEED={
  engineer:[{title:'نظارت پروژهٔ ویلایی',who:'کارفرما: احمدی',stage:'inprogress',rating:0},{title:'بازدید فونداسیون',who:'پیمانکار توکلی',stage:'agreed',rating:0},{title:'مشاورهٔ سازه',who:'کارفرما: رضایی',stage:'done',rating:0}],
  contractor:[{title:'اجرای نمای مسکونی',who:'کارفرما: قاسمی',stage:'inprogress',rating:0},{title:'بازسازی آپارتمان',who:'کارفرما: نوری',stage:'proposed',rating:0},{title:'ساخت انباری',who:'کارفرما: صادقی',stage:'done',rating:0}],
  machinery:[{title:'خاک‌برداری محوطهٔ کارگاه',who:'کارگاه قشم',stage:'inprogress',rating:0},{title:'بتن‌ریزی فونداسیون',who:'پیمانکار فرد',stage:'agreed',rating:0},{title:'عملیات بالابری سازه',who:'شرکت بنا',stage:'done',rating:5}],
  store:[{title:'سفارش سیمان',who:'کارگاه توکلی',stage:'inprogress',rating:0},{title:'سفارش آهن‌آلات',who:'پیمانکار رضایی',stage:'proposed',rating:0}],
  specialist:[{title:'جوشکاری اسکلت فلزی',who:'پیمانکار رضایی',stage:'inprogress',rating:0},{title:'نصب کابینت',who:'کارفرما: احمدی',stage:'done',rating:0}],
  worker:[{title:'نازک‌کاری واحد ۳',who:'کارگاه توکلی',stage:'inprogress',rating:0},{title:'کاشی‌کاری حمام',who:'کارفرما: نوری',stage:'done',rating:4}],
  general:[{title:'بازسازی آشپزخانه',who:'پیمانکار توکلی',stage:'agreed',rating:0},{title:'ساخت ویلا',who:'مهندس کریمی',stage:'inprogress',rating:0},{title:'تعمیر سرویس بهداشتی',who:'استادکار رضایی',stage:'done',rating:0}]
};
function getProjects(role){if(!state.projects[role])state.projects[role]=cloneData(PROJECT_SEED[role]||[]);return state.projects[role]}
function advanceStage(idx){
  var list=getProjects(state.role);var p=list[idx];
  var i=STAGE_ORDER.indexOf(p.stage);
  if(i<STAGE_ORDER.length-1){p.stage=STAGE_ORDER[i+1];render();
    if(p.stage==='done'&&!p.rating)setTimeout(function(){openRatingSheet(idx)},250);
  }
}
function acceptProjectRequest(idx){var p=getProjects(state.role)[idx];if(!p||p.stage!=='proposed')return;p.stage='agreed';getNotifications().unshift({title:'همکاری تأیید شد',sub:p.title+' · '+p.who,time:'همین حالا',day:'امروز',read:false,icon:'check',type:'project',target:'myProjects',action:'هماهنگی شروع'});renderProjectSheet(idx);toast('درخواست تأیید شد')}
function declineProjectRequest(idx){var p=getProjects(state.role)[idx];if(!p||p.stage!=='proposed')return;p.stage='declined';getNotifications().unshift({title:'درخواست رد شد',sub:p.title+' · '+p.who,time:'همین حالا',day:'امروز',read:false,icon:'alert',type:'project',target:'myProjects',action:'دیدن کارها'});renderProjectSheet(idx);toast('درخواست رد شد')}
function cancelProjectRequest(idx){var p=getProjects(state.role)[idx];if(!p||p.stage!=='proposed')return;p.stage='declined';renderProjectSheet(idx);toast('درخواست ارسالی لغو شد')}
function stepper(currentStage){
  var idx=STAGE_ORDER.indexOf(currentStage);
  var html='<div class="stepper">';
  STAGE_ORDER.forEach(function(s,i){
    html+='<div class="stepdot '+(i<=idx?'done':'')+'">'+(i<=idx?icon('check',10):(i+1))+'</div>';
    if(i<STAGE_ORDER.length-1)html+='<div class="stepline '+(i<idx?'done':'')+'"></div>';
  });
  html+='</div><div class="steplabels">'+STAGE_ORDER.map(function(s){return '<span>'+STAGE_LABELS[s]+'</span>'}).join('')+'</div>';
  return html;
}
function openProjectDetail(idx){
  var list=getProjects(state.role);var p=list[idx];
  if(!p)return;
  var coordination='';
  if(p.stage==='agreed'||p.stage==='inprogress'){
    coordination='<div class="card" style="margin-bottom:14px;border-color:var(--accent)"><div style="display:flex;align-items:flex-start;gap:9px"><div style="color:var(--accent);margin-top:1px">'+icon('calendar',16)+'</div><div style="flex:1"><b style="font-size:.64rem">زمان شروع همکاری</b>'
      +(p.startDate?'<p style="font-size:.56rem;margin-top:4px;color:var(--ink)">'+esc(p.startDate)+'</p><span style="display:block;font-size:.5rem;color:var(--accent);margin-top:3px">'+esc(p.startStatus||'هماهنگ‌شده')+'</span>':'<p style="font-size:.54rem;line-height:1.7;margin-top:4px">پس از توافق اولیه، زمان شروع را با طرف مقابل هماهنگ کنید.</p>')
      +'</div></div><button class="btn-secondary" style="margin-top:10px" onclick="openStartCoordinationSheet('+idx+')">'+(p.startDate?'ویرایش زمان پیشنهادی':'هماهنگی زمان شروع')+'</button></div>';
  }else if(p.stage==='done'&&p.startDate){
    coordination='<div class="card" style="margin-bottom:14px"><b style="font-size:.64rem">زمان شروع ثبت‌شده</b><p style="font-size:.56rem;margin-top:4px">'+esc(p.startDate)+'</p></div>';
  }
  var requestAction=p.stage==='proposed'?(p.direction==='outgoing'?'<div class="privacy-preview"><b>منتظر پاسخ طرف مقابل</b><p>وقتی درخواست تأیید یا رد شود، در اعلان‌ها به شما خبر می‌دهیم.</p></div><button class="btn-secondary" style="color:var(--danger);border-color:var(--danger)" onclick="cancelProjectRequest('+idx+')">لغو درخواست</button>':'<div class="request-actions"><button class="accept" onclick="acceptProjectRequest('+idx+')">'+icon('check',12)+' تأیید درخواست</button><button class="decline" onclick="declineProjectRequest('+idx+')">رد درخواست</button></div>'):p.stage==='declined'?'<div class="privacy-preview"><b style="color:var(--danger)">این درخواست رد شده است</b><p>در صورت نیاز می‌توانید از پیام‌ها دربارهٔ دلیل یا شرایط تازه گفتگو کنید.</p></div>':p.stage!=='done'?'<button class="btn-primary" onclick="advanceStage('+idx+');renderProjectSheet('+idx+')">انتقال به مرحلهٔ بعد</button>':(p.rating?'<div style="text-align:center"><p style="font-size:.6rem;margin-bottom:6px">امتیاز ثبت‌شده</p>'+starsStatic(p.rating)+(p.reviewComment?'<p style="font-size:.56rem;color:var(--muted);margin-top:8px;line-height:1.8">«'+esc(p.reviewComment)+'»</p>':'')+'</div>':'<button class="btn-primary" onclick="openRatingSheet('+idx+')">ثبت امتیاز</button>');
  var body=(p.stage==='declined'?'':stepper(p.stage))
    +'<div class="card" style="margin-bottom:14px"><b style="font-size:.66rem">'+esc(p.who)+'</b><p style="font-size:.55rem;margin-top:3px">وضعیت فعلی: '+STAGE_LABELS[p.stage]+'</p></div>'
    +coordination
    +requestAction;
  openSheet('<h3>'+esc(p.title)+'</h3>'+body);
}
function renderProjectSheet(idx){openProjectDetail(idx)}
function starsStatic(n){var out='<div class="stars-static">';for(var i=1;i<=5;i++)out+='<svg class="star '+(i<=n?'on':'')+'" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.1 6.3 6.9 1-5 4.9 1.2 6.9-6.2-3.3-6.2 3.3 1.2-6.9-5-4.9 6.9-1z"/></svg>';out+='</div>';return out}
function openRatingSheet(idx){
  state.ratingIndex=idx;state.ratingDraft={value:0,comment:''};
  renderRatingSheet();
}
function setRatingValue(v){state.ratingDraft.value=v;renderRatingSheet()}
function setRatingComment(v){state.ratingDraft.comment=v}
function renderRatingSheet(){
  var list=getProjects(state.role);var p=list[state.ratingIndex];
  var starsHtml='<div class="stars">';
  for(var i=1;i<=5;i++)starsHtml+='<svg class="star '+(i<=state.ratingDraft.value?'on':'')+'" onclick="setRatingValue('+i+')" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.1 6.3 6.9 1-5 4.9 1.2 6.9-6.2-3.3-6.2 3.3 1.2-6.9-5-4.9 6.9-1z"/></svg>';
  starsHtml+='</div>';
  var html='<h3>امتیاز به '+esc(p.who)+'</h3><p>پروژهٔ «'+esc(p.title)+'» تکمیل شد. تجربهٔ همکاری چطور بود؟</p>'+starsHtml
    +'<div class="field"><textarea class="textarea" placeholder="نظر شما (اختیاری)" oninput="setRatingComment(this.value)">'+esc(state.ratingDraft.comment)+'</textarea></div>'
    +'<button class="btn-primary" onclick="submitRating()">ثبت امتیاز</button>';
  openSheet(html);
}
function submitRating(){
  var list=getProjects(state.role);
  var p=list[state.ratingIndex];
  var value=state.ratingDraft.value||5,comment=(state.ratingDraft.comment||'').trim();
  p.rating=value;
  p.reviewComment=comment;
  var target=p.personId&&PEOPLE_SEED[p.personId];
  if(target){
    if(!target.reviews)target.reviews=[];
    target.reviews.unshift({from:displayNameFor(state.role)||'کاربر بلوک',rating:value,comment:comment||'بدون توضیح تکمیلی.',date:'همین حالا'});
  }
  closeSheet();render();toast(target?'امتیاز و نظر شما برای '+target.name+' ثبت شد':'امتیاز شما ثبت شد');
}

/* ---------- guarantor / trust ---------- */
var GUARANTOR_SEED={
  worker:[{name:'استاد جواد رحیمی',relation:'استادکار سابق',status:'confirmed'}],
  specialist:[{name:'شرکت بنای قشم',relation:'کارفرمای قبلی',status:'confirmed'}]
};
function getGuarantors(role){if(!state.guarantors[role])state.guarantors[role]=cloneData(GUARANTOR_SEED[role]||[]);return state.guarantors[role]}
function openGuarantorSheet(){
  state.guarantorDraft={name:'',relation:'',phone:''};
  renderGuarantorSheet();
}
function setGuarantorDraft(k,v){state.guarantorDraft[k]=v}
function renderGuarantorSheet(){
  var d=state.guarantorDraft;
  var html='<h3>افزودن معرف / قیم</h3><p>فردی که شما را می‌شناسد و اعتبار شما را در بلوک تأیید می‌کند.</p>'
    +'<div class="field"><label>نام معرف</label><input class="input" value="'+esc(d.name)+'" oninput="setGuarantorDraft(\'name\',this.value)"></div>'
    +'<div class="field"><label>نسبت</label><input class="input" placeholder="مثلاً استادکار سابق، کارفرمای قبلی" value="'+esc(d.relation)+'" oninput="setGuarantorDraft(\'relation\',this.value)"></div>'
    +'<div class="field"><label>شماره تماس</label><input class="input" dir="ltr" placeholder="09xx xxx xxxx" value="'+esc(d.phone)+'" oninput="setGuarantorDraft(\'phone\',this.value)"></div>'
    +'<button class="btn-primary" onclick="saveGuarantor()">ارسال درخواست تأیید</button>';
  openSheet(html);
}
function saveGuarantor(){
  if(!state.guarantorDraft.name){toast('نام معرف را وارد کنید');return}
  var list=getGuarantors(state.role);
  list.push({name:state.guarantorDraft.name,relation:state.guarantorDraft.relation,status:'pending'});
  closeSheet();render();toast('درخواست برای معرف ارسال شد');
}

/* ---------- notifications ---------- */
var NOTIF_SEED=[
  {title:'درخواست رزرو جدید',sub:'کارگاه توکلی برای ۲ روز نازک‌کاری درخواست داد',time:'۱۰ دقیقه پیش',day:'امروز',read:false,icon:'calendar',type:'project',target:'calendar',action:'بررسی درخواست'},
  {title:'پیام جدید از مهندس کریمی',sub:'باشه، فردا ساعت ۹ سر پروژه‌ام',time:'۱ ساعت پیش',day:'امروز',read:false,icon:'message',type:'message',conversationId:'karimi',action:'بازکردن پیام'},
  {title:'امتیاز جدید دریافت کردید',sub:'کارفرما احمدی به شما ۵ ستاره داد',time:'دیروز',day:'دیروز',read:true,icon:'check',type:'profile',target:'profile',action:'دیدن پروفایل'},
  {title:'مدرک هویتی تأیید شد',sub:'پروفایل شما اعتبار بیشتری گرفت',time:'۲ روز پیش',day:'این هفته',read:true,icon:'shield',type:'account',target:'profile',action:'مشاهده وضعیت'}
];
function getNotifications(){if(!state.notifications)state.notifications=cloneData(NOTIF_SEED);return state.notifications}
function unreadNotifCount(){return getNotifications().filter(function(n){return !n.read}).length}
function setNotificationFilter(value){state.notificationFilter=value;render()}
function markAllNotificationsRead(){getNotifications().forEach(function(n){n.read=true});render();toast('همهٔ اعلان‌ها خوانده شد')}
function openNotification(idx){
  var item=getNotifications()[idx];if(!item)return;item.read=true;
  if(item.conversationId){openConversation(item.conversationId);return}
  if(item.target){go(item.target);return}
  render();toast('جزئیات اعلان نمایش داده شد');
}
function getNotificationPrefs(){if(!state.notificationPrefs)state.notificationPrefs={messages:true,projects:true,profile:true,system:true,sound:true};return state.notificationPrefs}
function toggleNotificationPref(key){var prefs=getNotificationPrefs();prefs[key]=!prefs[key];render()}

/* ---------- portfolio ---------- */
var PORTFOLIO_SEED={
  worker:[{title:'نازک‌کاری واحد مسکونی',city:'قشم',color:'var(--tone-mint)',image:null},{title:'کاشی‌کاری حمام',city:'بندرعباس',color:'var(--accent2)',image:null}],
  engineer:[{title:'نظارت پروژهٔ ویلایی',city:'قشم',color:'var(--tone-mint)',image:null}],
  contractor:[{title:'اجرای نمای مسکونی',city:'قشم',color:'var(--accent2)',image:null},{title:'بازسازی آپارتمان',city:'بندرعباس',color:'var(--tone-mint)',image:null}]
};
function getPortfolio(role){if(!state.portfolio[role])state.portfolio[role]=cloneData(PORTFOLIO_SEED[role]||[]);return state.portfolio[role]}
function openPortfolioSheet(){
  state.portfolioDraft={title:'',city:'',image:null};
  renderPortfolioSheet();
}
function setPortfolioDraft(k,v){state.portfolioDraft[k]=v}
function handlePortfolioPhoto(input){
  var f=input.files&&input.files[0];if(!f)return;
  var reader=new FileReader();
  reader.onload=function(e){state.portfolioDraft.image=e.target.result;renderPortfolioSheet()};
  reader.readAsDataURL(f);
}
function renderPortfolioSheet(){
  var d=state.portfolioDraft;
  var html='<h3>افزودن نمونه‌کار</h3>'
    +'<div class="field"><label>عنوان</label><input class="input" value="'+esc(d.title)+'" oninput="setPortfolioDraft(\'title\',this.value)"></div>'
    +'<div class="field"><label>شهر</label><input class="input" value="'+esc(d.city)+'" oninput="setPortfolioDraft(\'city\',this.value)"></div>'
    +'<div class="field"><label>عکس</label>'+(d.image?'<img src="'+d.image+'" alt="پیش‌نمایش عکس نمونه‌کار" style="width:100%;height:100px;object-fit:cover;border-radius:12px;margin-bottom:8px">':'')+'<label class="btn-secondary" style="display:flex;align-items:center;justify-content:center;cursor:pointer">انتخاب عکس<input type="file" accept="image/*" style="display:none" onchange="handlePortfolioPhoto(this)"></label></div>'
    +'<button class="btn-primary" onclick="savePortfolio()">ذخیره</button>';
  openSheet(html);
}
function savePortfolio(){
  if(!state.portfolioDraft.title){toast('عنوان را وارد کنید');return}
  getPortfolio(state.role).push(state.portfolioDraft);
  state.portfolioSetupCompleted=true;state.dashboardSetupDismissed=false;
  closeSheet();render();toast('نمونه‌کار ذخیره شد');
}
function markPortfolioSetupDone(){state.portfolioSetupCompleted=true;state.dashboardSetupDismissed=false;render();toast('نمونه‌کارهای پروفایل تأیید شد')}

/* ---------- chat ---------- */
var CONVERSATION_SEED=[
  {id:'karimi',personId:'karimi',name:'مهندس کریمی',initials:'م.ک',verified:true,online:true,type:'project',unread:2,pinned:true,muted:false,archived:false,time:'۰۹:۱۲',lastMessage:'باشه، فردا ساعت ۹ سر پروژه‌ام',context:{icon:'building',label:'پروژه',title:'نظارت ویلای ساحلی',meta:'قشم · فردا ساعت ۹',target:'calendar'},messages:[
    {type:'system',text:'این گفت‌وگو برای هماهنگی پروژه «نظارت ویلای ساحلی» ایجاد شد.'},
    {date:'امروز',mine:false,text:'سلام رضا، برای فردا آماده‌ای؟',time:'۰۸:۵۰'},
    {mine:true,text:'سلام مهندس، بله کاملاً آماده‌ام',time:'۰۹:۰۱',status:'خوانده شد'},
    {mine:false,text:'باشه، فردا ساعت ۹ سر پروژه‌ام',time:'۰۹:۱۲'}]},
  {id:'bandar-store',personId:'bandarStore',name:'تأمین مصالح بندر',initials:'ت.ب',verified:true,online:false,type:'service',unread:1,pinned:false,muted:false,archived:false,time:'دیروز',lastMessage:'فاکتور سیمان را ارسال کردم',context:{icon:'truck',label:'سفارش',title:'سیمان تیپ ۲ · ۵۰ کیسه',meta:'تحویل در کارگاه',target:'orders'},messages:[
    {type:'system',text:'این گفت‌وگو به سفارش مصالح شما متصل است.'},
    {date:'دیروز',mine:false,text:'موجودی تأیید شد و امکان ارسال امروز داریم.',time:'۱۴:۲۰'},
    {mine:false,file:'پیش‌فاکتور سیمان.pdf',fileSize:'۲۴۰ کیلوبایت',time:'۱۴:۲۲'},
    {mine:false,text:'فاکتور سیمان را ارسال کردم',time:'۱۴:۲۳'}]},
  {id:'qeshm-tools',personId:'qeshmTools',name:'ماشین‌آلات سنگین ساحل',initials:'م.س',verified:true,online:true,type:'service',unread:0,pinned:false,muted:false,archived:false,time:'دوشنبه',lastMessage:'برای خاک‌برداری فردا آماده‌ایم',context:{icon:'gear',label:'خدمت',title:'خاک‌برداری محوطه',meta:'یک شیفت · قشم',target:'calendar'},messages:[
    {type:'system',text:'هماهنگی خدمت ماشین‌آلات داخل چت بلوک انجام می‌شود.'},
    {date:'دوشنبه',mine:true,text:'برای محوطه حدود ۸ ساعت کار نیاز داریم.',time:'۱۰:۱۰',status:'خوانده شد'},
    {mine:false,text:'برای خاک‌برداری فردا آماده‌ایم',time:'۱۰:۳۵'}]},
  {id:'block-support',personId:null,name:'پشتیبانی بلوک',initials:'ب',verified:true,online:true,type:'support',unread:0,pinned:false,muted:false,archived:false,time:'شنبه',lastMessage:'در صورت نیاز اینجا پیام بفرستید',context:{icon:'shield',label:'پشتیبانی',title:'راهنمای استفاده و گزارش مشکل',meta:'پاسخ‌گویی داخل بلوک'},messages:[
    {type:'system',text:'این فضای امن برای ارتباط با پشتیبانی بلوک است.'},
    {date:'شنبه',mine:false,text:'سلام، در صورت نیاز اینجا پیام بفرستید.',time:'۱۲:۰۰'}]}
];
function getConversations(){if(!state.conversations)state.conversations=cloneData(CONVERSATION_SEED);return state.conversations}
function findConversation(id){return getConversations().find(function(c){return c.id===id})}
function unreadMessageCount(){return getConversations().reduce(function(total,c){return total+(c.archived?0:(c.unread||0))},0)}
function getMessagePrefs(){if(!state.messagePrefs)state.messagePrefs={readReceipts:true,relatedOnly:true,mediaAuto:false};return state.messagePrefs}
function toggleMessagePref(key){var prefs=getMessagePrefs();prefs[key]=!prefs[key];render()}
function setMessageFilter(value){state.messageFilter=value;render()}
function setMessageQuery(value){state.messageQuery=value;clearTimeout(window._messageSearchTimer);window._messageSearchTimer=setTimeout(function(){render();requestAnimationFrame(function(){var input=document.getElementById('messageSearch');if(input){input.focus();input.setSelectionRange(input.value.length,input.value.length)}})},180)}
function filteredConversations(){
  var q=(state.messageQuery||'').trim().toLowerCase(),filter=state.messageFilter||'all';
  return getConversations().filter(function(c){
    if(filter==='archived'){if(!c.archived)return false}else if(c.archived)return false;
    if(filter==='unread'&&!(c.unread>0))return false;
    if(filter==='project'&&c.type!=='project')return false;
    if(filter==='service'&&c.type!=='service')return false;
    if(q&&([c.name,c.lastMessage,c.context&&c.context.title].join(' ').toLowerCase().indexOf(q)===-1))return false;
    return true;
  }).sort(function(a,b){return Number(!!b.pinned)-Number(!!a.pinned)});
}
function markAllMessagesRead(){getConversations().forEach(function(c){c.unread=0});render();toast('همهٔ پیام‌ها خوانده شد')}
function openConversation(id){var c=findConversation(id);if(!c)return;c.unread=0;state.currentConversationId=id;state.adChatId=c.adId||null;go('chat')}
function openConversationForPerson(personId){
  var existing=getConversations().find(function(c){return c.personId===personId&&!c.adId});if(existing){openConversation(existing.id);return}
  var person=PEOPLE_SEED[personId];if(!person)return;
  var id='person-'+personId,c={id:id,personId:personId,name:person.name,initials:person.initials,verified:!!person.verified,online:false,type:person.personType==='store'?'service':'project',unread:0,pinned:false,muted:false,archived:false,time:'اکنون',lastMessage:'گفت‌وگوی تازه',context:{icon:'user',label:'پروفایل',title:person.role,meta:person.location||'',target:'viewProfile'},messages:[{type:'system',text:'این گفت‌وگو از پروفایل «'+person.name+'» شروع شد. برای هماهنگی امن، اطلاعات پروژه را داخل بلوک ثبت کنید.'}]};
  getConversations().unshift(c);openConversation(id);
}
function activeConversation(){return findConversation(state.currentConversationId)||getConversations()[0]}
function sendChatText(){
  var el=document.getElementById('chatInput');if(!el)return;
  var v=(el.value||'').trim();if(!v)return;
  var c=activeConversation();c.messages.push({mine:true,text:v,time:'اکنون',status:'ارسال شد'});c.lastMessage=v;c.time='اکنون';c.archived=false;
  el.value='';render();
}
function handleChatPhoto(input){
  var f=input.files&&input.files[0];if(!f)return;
  var reader=new FileReader();
  reader.onload=function(e){var c=activeConversation();c.messages.push({mine:true,image:e.target.result,time:'اکنون',status:'ارسال شد'});c.lastMessage='تصویر ارسال شد';c.time='اکنون';render()};
  reader.readAsDataURL(f);
}
function handleChatDocument(input){var f=input.files&&input.files[0];if(!f)return;var c=activeConversation();c.messages.push({mine:true,file:f.name,fileSize:Math.max(1,Math.round(f.size/1024))+' کیلوبایت',time:'اکنون',status:'ارسال شد'});c.lastMessage='فایل: '+f.name;c.time='اکنون';render()}
function voiceDuration(seconds){seconds=Math.max(1,Math.round(seconds||1));return Math.floor(seconds/60)+':'+String(seconds%60).padStart(2,'0')}
async function toggleVoiceRecording(){
  if(state.voiceRecording){if(state.voiceRecorder&&state.voiceRecorder.state!=='inactive')state.voiceRecorder.stop();return}
  if(!navigator.mediaDevices||!navigator.mediaDevices.getUserMedia||typeof MediaRecorder==='undefined'){toast('ضبط صدا در این دستگاه پشتیبانی نمی‌شود');return}
  try{
    state.voiceStream=await navigator.mediaDevices.getUserMedia({audio:true});state.permissionPrefs.microphone='granted';state.voiceChunks=[];
    var recorder=new MediaRecorder(state.voiceStream);state.voiceRecorder=recorder;state.voiceStartedAt=Date.now();state.voiceRecording=true;
    recorder.ondataavailable=function(event){if(event.data&&event.data.size)state.voiceChunks.push(event.data)};
    recorder.onstop=function(){
      var duration=(Date.now()-state.voiceStartedAt)/1000,blob=new Blob(state.voiceChunks,{type:recorder.mimeType||'audio/webm'}),url=URL.createObjectURL(blob),c=activeConversation();
      c.messages.push({mine:true,audioUrl:url,duration:voiceDuration(duration),time:'اکنون',status:'ارسال شد'});c.lastMessage='پیام صوتی';c.time='اکنون';
      (state.voiceStream&&state.voiceStream.getTracks()||[]).forEach(function(track){track.stop()});state.voiceRecording=false;state.voiceRecorder=null;state.voiceStream=null;state.voiceChunks=[];render();toast('پیام صوتی ارسال شد');
    };
    recorder.start();render();toast('ضبط شروع شد؛ برای ارسال دوباره میکروفن را لمس کنید');
  }catch(error){state.permissionPrefs.microphone='denied';render();toast('برای پیام صوتی، دسترسی میکروفن را فعال کنید')}
}
function chatPhoneNumber(){var value=state.values.signupPhone||(state.values.phones&&state.values.phones[0])||'۰۹۱۲ ۳۴۵ ۶۷۸۹';return String(value)}
function setPhoneShareHour(value){state.phoneShareDraft.hours=value;renderPhoneShareSheet()}
function renderPhoneShareSheet(){
  var options=['۸ تا ۱۲','۱۴ تا ۱۸','۱۸ تا ۲۱','فقط با هماهنگی قبلی در چت'];
  var html='<h3>اشتراک شماره با اجازهٔ شما</h3><p>شماره فقط در همین گفت‌وگو نمایش داده می‌شود. زمان مناسب تماس را هم مشخص کنید.</p><div class="field"><label>شماره‌ای که نمایش داده می‌شود</label><input class="input" dir="ltr" value="'+esc(state.phoneShareDraft.phone||chatPhoneNumber())+'" oninput="state.phoneShareDraft.phone=this.value"></div><div class="field"><label>زمان مناسب تماس</label><div class="chip-row">'+options.map(function(option){return '<button class="chip '+(state.phoneShareDraft.hours===option?'active':'')+'" onclick="setPhoneShareHour(\''+option+'\')">'+option+'</button>'}).join('')+'</div></div><div class="chat-safety">'+icon('phone',14)+'<span>طرف مقابل باید خارج از این ساعت‌ها ابتدا در چت هماهنگ کند.</span></div><button class="btn-primary" onclick="confirmPhoneShare()">تأیید و نمایش شماره</button>';
  openSheet(html);
}
function openPhoneShareSheet(){state.phoneShareDraft={phone:chatPhoneNumber(),hours:'فقط با هماهنگی قبلی در چت'};renderPhoneShareSheet()}
function requestPhoneShare(){var c=activeConversation();c.phoneShare=c.phoneShare||{};if(c.phoneShare.status==='requested'){toast('درخواست شماره قبلاً ارسال شده است');return}c.phoneShare.status='requested';c.messages.push({type:'system',text:'درخواست نمایش شماره تماس ارسال شد. شماره فقط پس از اجازهٔ صاحب شماره نمایش داده می‌شود.'});c.lastMessage='درخواست شماره تماس';render();toast('درخواست شماره ارسال شد')}
function confirmPhoneShare(){var c=activeConversation();c.phoneShare={status:'shared',phone:state.phoneShareDraft.phone||chatPhoneNumber(),hours:state.phoneShareDraft.hours||'فقط با هماهنگی قبلی در چت'};c.messages.push({type:'system',text:'شماره تماس با اجازهٔ صاحب شماره در همین گفتگو نمایش داده شد. تماس فقط در بازهٔ تعیین‌شده انجام شود.'});closeSheet();render();toast('شماره فقط در همین گفتگو نمایش داده شد')}
function revokePhoneShare(){var c=activeConversation();if(!c.phoneShare)return;c.phoneShare.status='hidden';c.phoneShare.phone='';c.messages.push({type:'system',text:'نمایش شماره تماس توسط صاحب شماره متوقف شد.'});render();toast('نمایش شماره متوقف شد')}
function approveRequestedPhoneShare(){openPhoneShareSheet()}
function renderChatContactCard(c){
  var share=c.phoneShare||{},shared=share.status==='shared',requested=share.status==='requested';
  return '<div class="chat-contact-card"><div class="chat-contact-head"><i>'+icon('phone',15)+'</i><div><b>تماس تلفنی با اجازهٔ صاحب شماره</b><p>'+(shared?'شماره فقط در همین گفت‌وگو و همراه با زمان مناسب تماس نمایش داده شده است.':requested?'درخواست ارسال شده؛ صاحب شماره باید نمایش آن را تأیید کند.':'شماره به‌صورت پیش‌فرض خصوصی است. می‌توانید درخواست کنید یا شمارهٔ خودتان را نمایش دهید.')+'</p></div></div>'+(shared?'<div class="shared-phone"><div><a href="tel:'+esc(share.phone).replace(/\s/g,'')+'">'+esc(share.phone)+'</a><span>زمان مناسب تماس: '+esc(share.hours)+'</span></div><button onclick="revokePhoneShare()">توقف نمایش</button></div>':'<div class="chat-contact-actions"><button class="request" onclick="requestPhoneShare()">'+(requested?'درخواست ارسال شده':'درخواست شماره')+'</button><button class="share" onclick="'+(requested?'approveRequestedPhoneShare()':'openPhoneShareSheet()')+'">'+(requested?'تأیید و نمایش شماره':'اشتراک شمارهٔ من')+'</button></div>')+'</div>';
}
function openConversationContext(){var c=activeConversation();if(!c||!c.context)return;if(c.adId){state.viewingAdId=c.adId;go('adDetail');return}if(c.context.target==='viewProfile'&&c.personId){openPersonProfile(c.personId);return}if(c.context.target&&PAGES[c.context.target]){go(c.context.target);return}toast('جزئیات مرتبط نمایش داده شد')}
function toggleConversationMute(id){var c=findConversation(id);if(!c)return;c.muted=!c.muted;closeSheet();render();toast(c.muted?'اعلان این گفت‌وگو بی‌صدا شد':'اعلان این گفت‌وگو فعال شد')}
function toggleConversationPin(id){var c=findConversation(id);if(!c)return;c.pinned=!c.pinned;closeSheet();render();toast(c.pinned?'گفت‌وگو سنجاق شد':'گفت‌وگو از سنجاق خارج شد')}
function archiveConversation(id){var c=findConversation(id);if(!c)return;c.archived=true;closeSheet();state.stack=[];state.page='messages';render();toast('گفت‌وگو بایگانی شد')}
function openConversationActions(){var c=activeConversation();if(!c)return;var profileAction=c.personId?'<button class="btn-secondary" onclick="closeSheet();openPersonProfile(\''+c.personId+'\')">مشاهدهٔ پروفایل</button><div style="height:8px"></div>':'';openSheet('<h3>مدیریت گفت‌وگو</h3><p>'+esc(c.name)+'</p>'+profileAction+'<button class="btn-secondary" onclick="toggleConversationPin(\''+c.id+'\')">'+(c.pinned?'برداشتن سنجاق':'سنجاق‌کردن گفت‌وگو')+'</button><div style="height:8px"></div><button class="btn-secondary" onclick="toggleConversationMute(\''+c.id+'\')">'+(c.muted?'فعال‌کردن اعلان':'بی‌صداکردن اعلان')+'</button><div style="height:8px"></div><button class="btn-secondary" onclick="archiveConversation(\''+c.id+'\')">انتقال به بایگانی</button>'+(c.personId?'<div style="height:8px"></div><button class="btn-ghost" style="color:var(--danger)" onclick="openReportSheet(\''+c.personId+'\')">گزارش یا مسدودکردن کاربر</button>':'') )}

