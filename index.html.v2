function ensureCollectionPhoto(roleKey,collectionKey,label){
  var collection=roleSchemas[roleKey]&&roleSchemas[roleKey].collections&&roleSchemas[roleKey].collections[collectionKey];
  if(collection&&!collection.fields.some(function(field){return field.kind==='photo'}))collection.fields.push({kind:"photo",key:"image",label:label||"عکس",optional:true});
}
ensureCollectionPhoto("machinery","machines","عکس واقعی دستگاه");
ensureCollectionPhoto("store","materials","عکس محصول یا بسته‌بندی");
ensureCollectionPhoto("contractor","projects","عکس پروژه");
ensureCollectionPhoto("company","projects","عکس پروژه");

/* ---- Selection-to-detail continuity across professional roles ---- */
function configureSyncedCollection(roleKey,collectionKey,sourceValueKey,syncFieldKey,requiredKeys){
  var col=roleSchemas[roleKey]&&roleSchemas[roleKey].collections&&roleSchemas[roleKey].collections[collectionKey];
  if(!col)return;
  col.syncFromValueKey=sourceValueKey;
  col.syncFieldKey=syncFieldKey||col.titleKey;
  col.requiredKeys=requiredKeys||col.requiredKeys||[col.titleKey];
  col.fields.forEach(function(field){if(col.requiredKeys.indexOf(field.key)>-1)field.optional=false});
  col.emptyHint="انتخاب‌های مرحلهٔ قبل اینجا خودکار نمایش داده می‌شوند. هر مورد را باز کنید و جزئیاتش را کامل کنید.";
}
function replaceRateFields(col,typeLabel,amountLabel){
  if(!col)return;
  col.fields=col.fields.filter(function(field){return field.key!=="rate"&&field.key!=="rateType"&&field.key!=="rateAmount"});
  col.fields.push(
    {key:"rateType",label:typeLabel||"روش محاسبه دستمزد",options:["ساعتی","روزانه","شیفتی","متری","پروژه‌ای","توافقی"]},
    {key:"rateAmount",label:amountLabel||"مبلغ دستمزد پیشنهادی",placeholder:"مثلاً ۲٬۵۰۰٬۰۰۰ تومان",ltr:true,optional:true}
  );
  (col.seeds||[]).forEach(function(seed,index){
    seed.rateType=seed.rateType||seed.rate||"توافقی";
    seed.rateAmount=seed.rateAmount||(index?"۲٬۰۰۰٬۰۰۰ تومان":"۲٬۵۰۰٬۰۰۰ تومان");
    delete seed.rate;
  });
}
function capabilityCollection(label,singular,sourceValueKey){
  return {label:label,singular:singular,addLabel:"افزودن خدمت",icon:"briefcase",titleKey:"service",syncFromValueKey:sourceValueKey,syncFieldKey:"service",
    emptyHint:"خدمات انتخاب‌شده در مرحلهٔ قبل اینجا نمایش داده می‌شوند. هر خدمت را باز کنید و سابقه و مبلغ آن را کامل کنید.",
    summaryKeys:["experience","rateType","rateAmount"],requiredKeys:["service","experience","rateType"],
    fields:[
      {key:"service",label:"عنوان خدمت",allowCustom:true,placeholder:"عنوان خدمت را انتخاب کنید یا بنویسید"},
      {key:"experience",label:"سابقه مرتبط با همین خدمت",options:["کمتر از ۲ سال","۲ تا ۵ سال","۵ تا ۱۰ سال","بیش از ۱۰ سال"]},
      {key:"rateType",label:"روش محاسبه دستمزد",options:["روزانه","متری","پروژه‌ای","درصدی","توافقی"]},
      {key:"rateAmount",label:"مبلغ پیشنهادی",placeholder:"مثلاً ۱۵٬۰۰۰٬۰۰۰ تومان",ltr:true,optional:true},
      {key:"scope",label:"توضیح کوتاه خدمت",placeholder:"دامنهٔ کار و مواردی که تحویل می‌دهید",optional:true}
    ],seeds:[]};
}
function insertDetailStepAfterControl(roleKey,controlKey,step){
  var schema=roleSchemas[roleKey];
  if(!schema||schema.steps.some(function(item){return item.collection===step.collection}))return;
  var index=schema.steps.findIndex(function(item){return (item.controls||[]).some(function(control){return control.key===controlKey})});
  if(index>-1)schema.steps.splice(index+1,0,step);
}

replaceRateFields(roleSchemas.specialist.collections.skills,"روش محاسبه دستمزد","مبلغ دستمزد پیشنهادی");
roleSchemas.specialist.collections.skills.summaryKeys=["experience","level","rateType","rateAmount"];
configureSyncedCollection("specialist","skills","specialistFields","name",["name","experience","level","rateType"]);

replaceRateFields(roleSchemas.worker.collections.skills,"روش محاسبه دستمزد","مبلغ دستمزد پیشنهادی");
roleSchemas.worker.collections.skills.summaryKeys=["experience","level","rateType","rateAmount"];
configureSyncedCollection("worker","skills","workerFields","name",["name","experience","shift","rateType"]);

replaceRateFields(roleSchemas.engineer.collections.services,"روش محاسبه تعرفه","مبلغ تعرفه پیشنهادی");
roleSchemas.engineer.collections.services.summaryKeys=["grade","experience","rateType","rateAmount"];
configureSyncedCollection("engineer","services","engineerTitles","service",["service","experience","rateType"]);

configureSyncedCollection("machinery","machines","machineActivities","activity",["activity","type","brandModel","capacity","operator","rate","status"]);
configureSyncedCollection("store","materials","materialCategories","category",["category","name","brand","unit","stock","price","delivery","status"]);

roleSchemas.contractor.collections.capabilities=capabilityCollection("خدمات و سابقه اجرایی","خدمت اجرایی","contractorServices");
insertDetailStepAfterControl("contractor","contractorServices",{title:"جزئیات خدمات و سابقه",desc:"تمام خدمات انتخاب‌شده را جداگانه ویرایش کنید و سابقه و مبلغ پیشنهادی هرکدام را وارد کنید.",note:"مبلغ هر خدمت در پروفایل عمومی شما نمایش داده می‌شود و بعداً قابل ویرایش است.",collection:"capabilities"});
roleSchemas.company.collections.capabilities=capabilityCollection("خدمات و سابقه شرکت","خدمت شرکت","contractorServices");
insertDetailStepAfterControl("company","contractorServices",{title:"جزئیات خدمات شرکت",desc:"تمام خدمات انتخاب‌شده را جداگانه ویرایش کنید و سابقه و مبلغ پیشنهادی هرکدام را وارد کنید.",note:"مبلغ هر خدمت در پروفایل عمومی شرکت نمایش داده می‌شود و بعداً قابل ویرایش است.",collection:"capabilities"});

/* ---- Citizenship-aware birthplace and simpler first steps ---- */
Object.keys(roleSchemas).forEach(function(roleKey){
  var schema=roleSchemas[roleKey],firstStep=(schema.steps||[])[0];
  if(!firstStep||!firstStep.controls)return;

  firstStep.controls=firstStep.controls.filter(function(control){return control.key!=="cooperation"});
  if(firstStep.title==="معرفی کارگر")firstStep.desc="اطلاعات پایه و هویتی خود را وارد کنید.";

  var provinceIndex=firstStep.controls.findIndex(function(control){return control.key==="birthProvince"});
  if(provinceIndex<0)return;
  var provinceControl=firstStep.controls[provinceIndex];
  provinceControl.label="محل تولد";
  provinceControl.options=PROVINCES.slice();
  provinceControl.disabledWhen="foreignNational";
  provinceControl.disabledHint="برای اتباع خارجی غیرفعال است؛ کشور محل تولد را وارد کنید.";

  if(!firstStep.controls.some(function(control){return control.key==="foreignNational"})){
    firstStep.controls.splice(provinceIndex,0,{kind:"toggle",key:"foreignNational",label:"اتباع خارجی هستم"});
    provinceIndex++;
  }
  var countryControl=firstStep.controls.find(function(control){return control.key==="birthCountry"});
  if(countryControl){
    countryControl.label="کشور محل تولد";
    countryControl.placeholder="نام کشور را وارد کنید";
    countryControl.optional=false;
    countryControl.conditionalOn="foreignNational";
  }
});

/* Page three of the worker flow is removed; useful choices move to work areas. */
var workerPresenceStep=roleSchemas.worker.steps.find(function(step){return step.title==="شرایط حضور در کارگاه"});
var workerAreasStep=roleSchemas.worker.steps.find(function(step){return step.title==="حوزه‌های کاری"});
if(workerPresenceStep&&workerAreasStep){
  var workerPresenceControls=(workerPresenceStep.controls||[]).filter(function(control){return control.key==="teamStatus"||control.key==="shifts"});
  workerPresenceControls.forEach(function(control){
    if(control.key==="teamStatus")control.label="نحوه حضور در کارگاه";
    if(control.key==="shifts")control.label="ترجیح شیفت برای پیشنهادهای کاری آینده";
  });
  workerAreasStep.controls=(workerAreasStep.controls||[]).concat(workerPresenceControls);
  workerAreasStep.desc="نوع کار، نحوه حضور و ترجیح شیفت خود را در یک صفحه مشخص کنید.";
  roleSchemas.worker.steps=roleSchemas.worker.steps.filter(function(step){return step!==workerPresenceStep});
}

/* Heavy machinery is a service provider: the fleet performs the work and is never listed for rent. */
var machinerySchema=roleSchemas.machinery;
machinerySchema.summary="ارائهٔ خدمات اجرایی با ماشین‌آلات";
machinerySchema.profileTitle="خدمات اجرایی ماشین‌آلات سنگین";
machinerySchema.actions=[
  ["ناوگان ماشین‌آلات","7 دستگاه ثبت‌شده","loader"],
  ["پروژه‌های خدماتی","2 خدمت فعال","calendar"],
  ["سرویس و نگهداری","1 اقدام نزدیک","tools"],
  ["اپراتورها و مدارک","4 اپراتور تأییدشده","users"]
];
machinerySchema.dashboard={
  title:"خاک‌برداری پروژهٔ ساحل",live:"در حال اجرا",progress:89,
  facts:[["شروع عملیات","08:00"],["ساعت کارکرد","12h"],["اپراتور","1 نفر"]],
  actions:[["ناوگان","loader"],["ماموریت‌ها","calendar"],["سرویس","tools"],["درآمد","wallet"]],
  feed:[["درخواست خدمت جدید","عملیات لودر WA470 · فردا","calendar"],["یادآوری سرویس دوره‌ای","جرثقیل 10 تن","alert"]]
};
var machineryCollection=machinerySchema.collections.machines;
machineryCollection.label="ماشین‌آلات آمادهٔ خدمت";
machineryCollection.addLabel="افزودن ماشین به خدمات";
machineryCollection.emptyHint="حوزه‌های فعالیت انتخاب‌شده اینجا نمایش داده می‌شوند. برای هر خدمت، ماشین، اپراتور و تعرفه را کامل کنید.";
machineryCollection.fields.forEach(function(field){
  if(field.key==="operator"){
    field.label="نحوهٔ اجرای خدمت";
    field.options=["با اپراتور مجموعه","با اپراتور تخصصی پروژه","با تیم کامل اجرا"];
  }
  if(field.key==="rate"){
    field.label="تعرفهٔ پایهٔ خدمت";
    field.placeholder="ساعتی، شیفتی یا پروژه‌ای";
  }
  if(field.key==="status"){
    field.label="وضعیت پذیرش خدمت";
    field.options=["آماده پذیرش خدمت","در حال اجرای خدمت","در سرویس","غیرفعال"];
  }
});
(machineryCollection.seeds||[]).forEach(function(seed,index){
  seed.operator=index===2?"با تیم کامل اجرا":"با اپراتور مجموعه";
  seed.status=index===2?"در حال اجرای خدمت":"آماده پذیرش خدمت";
});
var machineryIntro=machinerySchema.steps[0];
var machineryOwnerType=(machineryIntro.controls||[]).find(function(control){return control.key==="ownerType"});
if(machineryOwnerType)machineryOwnerType.options=["مالک و مجری خدمات ماشین‌آلات","شرکت خدمات ماشین‌آلات","پیمانکار ماشین‌آلات","اپراتور دارای دستگاه"];
var machineryPhones=(machineryIntro.controls||[]).find(function(control){return control.key==="phones"});
if(machineryPhones)machineryPhones.label="شماره‌های تماس کاری";
machineryIntro.title="معرفی ارائه‌دهندهٔ خدمات ماشین‌آلات";
machineryIntro.desc="مشخص کنید خدمات اجرایی را به‌صورت شخصی، پیمانکاری یا شرکتی انجام می‌دهید.";
var machineryFleetStep=machinerySchema.steps.find(function(step){return step.collection==="machines"});
if(machineryFleetStep){
  machineryFleetStep.title="ماشین‌ها و خدمات قابل اجرا";
  machineryFleetStep.desc="برای هر حوزه، دستگاه و اپراتوری را ثبت کنید که همان خدمت را برای مشتری انجام می‌دهند.";
}
var machineryConditions=machinerySchema.steps.find(function(step){return (step.controls||[]).some(function(control){return control.key==="minimumRental"})});
if(machineryConditions){
  machineryConditions.title="شرایط ارائهٔ خدمت و مدارک";
  machineryConditions.desc="بیمه، معاینه فنی، حداقل حجم کار و محدودهٔ اعزام را مشخص کنید.";
  var minimumService=machineryConditions.controls.find(function(control){return control.key==="minimumRental"});
  minimumService.key="minimumService";
  minimumService.label="حداقل حجم یا مدت خدمت";
  minimumService.options=["یک ساعت کاری","نیم‌شیفت","یک شیفت","یک روز کاری","چندروزه","پروژه‌ای"];
}
var machineryFleetSummary=machinerySchema.steps.find(function(step){return step.title==="ناوگان شما در یک نگاه"});
if(machineryFleetSummary){
  var operatorCount=(machineryFleetSummary.controls||[]).find(function(control){return control.key==="operatorCount"});
  if(operatorCount){operatorCount.label="اپراتورهای فعال";operatorCount.options=["خودم اپراتور هستم","1 نفر","2 تا 5 نفر","بیش از 5 نفر"]}
}
var machineryReview=machinerySchema.steps.find(function(step){return step.review});
if(machineryReview){
  machineryReview.title="مرور خدمات ماشین‌آلات";
  machineryReview.desc="دستگاه‌ها، اپراتورها، تعرفه‌ها و خدمات قابل اجرا پیش از انتشار مرور می‌شوند.";
}
var generalNeedsStep=roleSchemas.general.steps.find(function(step){return (step.controls||[]).some(function(control){return control.key==="generalNeeds"})});
if(generalNeedsStep){
  var generalNeedsControl=generalNeedsStep.controls.find(function(control){return control.key==="generalNeeds"});
  generalNeedsControl.options=generalNeedsControl.options.map(function(option){return option==="اجاره ماشین‌آلات"?"دریافت خدمات ماشین‌آلات":option});
}

/* One overall experience answer per profile; experience for each skill remains in its detail record. */
var OVERALL_EXPERIENCE_ROLES=["worker","specialist","engineer","contractor","company","machinery","store"];
OVERALL_EXPERIENCE_ROLES.forEach(function(roleKey){
  var schema=roleSchemas[roleKey];if(!schema)return;
  var targetStep=null;
  (schema.steps||[]).forEach(function(step){
    if(!step.controls)return;
    var hadOverall=step.controls.some(function(control){return ["experience","experienceBand","careerStartDate","overallExperience"].indexOf(control.key)>-1});
    step.controls=step.controls.filter(function(control){return ["experience","experienceBand","careerStartDate","overallExperience","overallExperienceCustom"].indexOf(control.key)===-1});
    if(hadOverall&&!targetStep)targetStep=step;
  });
  if(!targetStep)targetStep=(schema.steps||[]).find(function(step){return step.controls&&!step.review&&step.title!=="محل انجام وظیفه"});
  if(!targetStep)return;
  var organization=["company","machinery","store"].indexOf(roleKey)>-1;
  targetStep.controls.push({kind:"single",key:"overallExperience",label:organization?"سابقهٔ کلی فعالیت مجموعه":"سابقهٔ کلی کار",options:["بدون سابقه","کمتر از ۱ سال","۱ تا ۳ سال","۳ تا ۵ سال","۵ تا ۱۰ سال","۱۰ تا ۲۰ سال","بیش از ۲۰ سال"]});
});



Object.keys(roleSchemas).forEach(function(roleKey){
  var schema=roleSchemas[roleKey];if(!schema||!schema.steps||!schema.steps.length)return;
  var introStep=schema.steps[0];if(!introStep.controls||introStep.controls.length<=7)return;
  var identityKeys=["companyName","firstName","lastName","gender","birthDate","foreignNational","birthProvince","birthCountry"];
  var identityControls=introStep.controls.filter(function(c){return identityKeys.indexOf(c.key)>-1});
  var restControls=introStep.controls.filter(function(c){return identityKeys.indexOf(c.key)===-1});
  if(!restControls.length)return;
  introStep.controls=identityControls;
  var secondStep={title:"شرایط و ترجیحات",desc:"چند انتخاب سریع دربارهٔ نوع فعالیت و همکاری شما.",controls:restControls};
  schema.steps.splice(1,0,secondStep);
});

/* Profile photo and portfolio belong to the dashboard, not the registration flow. */
var TRAVEL_ACTIVITY_ROLES=["worker","specialist","engineer","contractor","company","machinery"];
Object.keys(roleSchemas).forEach(function(roleKey){
  var schema=roleSchemas[roleKey];
  schema.steps=(schema.steps||[]).filter(function(step){
    var isProfilePhoto=(step.controls||[]).some(function(control){return control.key==="profilePhoto"});
    return !isProfilePhoto&&step.collection!=="portfolioItems";
  });

  /* Remove duplicate travel questions from later steps. */
  if(TRAVEL_ACTIVITY_ROLES.indexOf(roleKey)>-1){
    schema.steps.forEach(function(step){
      if(step.controls)step.controls=step.controls.filter(function(control){return control.key!=="travel"});
    });
  }

  var locationStep=schema.steps.find(function(step){
    return (step.controls||[]).some(function(control){return control.key==="workProvince"});
  });
  if(!locationStep)return;

  var baseControls=(locationStep.controls||[]).filter(function(control){
    return ["activityRadius","travelReady","travelRange"].indexOf(control.key)===-1;
  });
  if(TRAVEL_ACTIVITY_ROLES.indexOf(roleKey)>-1){
    locationStep.title="محدودهٔ فعالیت";
    locationStep.desc="محدودهٔ معمول کار را انتخاب کنید. رفتن به شهرهای دورتر جداگانه مشخص می‌شود.";
    locationStep.controls=baseControls.concat([
      {kind:"single",key:"activityRadius",label:"محدودهٔ معمول کار",options:["فقط همین شهر","شهرهای نزدیک (تا ۵۰ کیلومتر)","تمام استان"]},
      {kind:"toggle",key:"travelReady",label:"برای کار مناسب، به محدودهٔ دورتر هم می‌روم",help:"این گزینه فقط برای پروژه‌های خارج از محدودهٔ معمول شماست."},
      {kind:"single",key:"travelRange",label:"در صورت سفر، تا کجا می‌روید؟",conditionalOn:"travelReady",options:["استان‌های هم‌جوار","چند استان دورتر با هماهنگی","هر جای ایران"]}
    ]);
  }else{
    locationStep.title=roleKey==="store"?"محل فروشگاه":"محل شما";
    locationStep.desc=roleKey==="store"?"استان و شهر اصلی فروشگاه را انتخاب کنید.":"برای دیدن نتیجه‌های نزدیک‌تر، استان و شهر خود را انتخاب کنید.";
    locationStep.controls=baseControls;
  }
});

Object.keys(roleSchemas).forEach(function(roleKey){
  var schema=roleSchemas[roleKey];
  (schema.steps||[]).forEach(function(step){
    var isLocationStep=(step.controls||[]).some(function(control){return control.key==="workProvince"});
    if(isLocationStep&&schema.professional){
      step.skippable=false;
    }
    if(schema.professional&&!step.skippable&&step.controls){
      step.requiredControls=step.controls.filter(function(control){
        return !control.optional&&control.kind!=="photo"&&control.kind!=="toggle"&&!customOptionLinks[control.key]&&String(control.label||"").indexOf("اختیاری")===-1;
      }).map(function(control){return control.key});
    }
  });
});


