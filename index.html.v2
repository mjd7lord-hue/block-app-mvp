const roleOrder=["engineer","contractor","specialist","worker","general","machinery","store","materialsSupplier"];
const BUSINESS_ROLES=["machinery","store","materialsSupplier"];
/* MVP: hide the 3 business/supplier roles from every user-facing entry point (role picker, explore).
   All their logic/schemas/pages stay intact — flip this back to false to bring them back for a future update. */
const MVP_HIDE_BUSINESS_ROLES=true;
