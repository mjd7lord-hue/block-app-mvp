};
function getIncomingRequests(){var role=state.role||'worker';if(!state.incomingRequests)state.incomingRequests={};if(!state.incomingRequests[role])state.incomingRequests[role]=cloneData(REQUEST_SEED[role]||[]);return state.incomingRequests[role]}
function getOutgoingRequests(){return state.outgoingRequests.filter(function(item){return item.role===(state.role||'worker')})}
function addOutgoingRequest(type,title,to,detail){var item={id:'out-'+Date.now()+'-'+Math.random().toString(16).slice(2),role:state.role||'worker',type:type,title:title,to:to,detail:detail||'',status:'pending'};state.outgoingRequests.unshift(item);return item}
function pendingRequestCount(){return getIncomingRequests().filter(function(item){return item.status==='pending'}).length}
function setRequestTab(tab){state.requestTab=tab;render()}
function respondToRequest(id,status){
  var item=getIncomingRequests().find(function(request){return request.id===id});if(!item||item.status!=='pending')return;
  if(item.type==='agreement'&&item.adId){respondToAgreementRequest(item,status);return}
  item.status=status;
  if(status==='accepted')getProjects(state.role||'worker').unshift({title:item.title,who:item.from,stage:'agreed',rating:0,direction:'incoming'});
  getNotifications().unshift({title:status==='accepted'?'درخواست تأیید شد':'درخواست رد شد',sub:item.title+' · '+item.from,time:'همین حالا',day:'امروز',read:false,icon:status==='accepted'?'check':'alert',type:'project',target:'requestsCenter',action:'دیدن درخواست‌ها'});
  render();toast(status==='accepted'?'درخواست تأیید و به کارهای شما اضافه شد':'درخواست رد شد');
}
function cancelOutgoingRequest(id){var item=getOutgoingRequests().find(function(request){return request.id===id});if(!item||item.status!=='pending')return;item.status='declined';render();toast('درخواست ارسالی لغو شد')}

